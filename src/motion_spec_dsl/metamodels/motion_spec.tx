// Motion Specification DSL Grammar

Model:
    imports*=Import
    namespaces*=NamespaceDeclare
    specs+=Specification
;

Specification:
    MotionSpec | ConstraintHandler
;

MotionSpec:
    "MOTION_SPEC" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        ("MOVE"    ":" move=STRING)?
        "CONTEXT"  "{" context*=MotionContextDecl[","] "}"
        sections+=ConstraintSection
    "}"
;

ConstraintSection:
    WhenSection | WhileSection | UntilSection
;

WhenSection: "WHEN" "{" constraints*=ConstraintSpecification[","]? "}" ;
WhileSection: "WHILE" "{" constraints*=ConstraintSpecification[","]? "}" ;
UntilSection: "UNTIL" "{" constraints*=ConstraintSpecification[","]? "}" ;

MotionContextDecl:
    WorldContextDecl | PreContextDecl | SpecContextDecl | PostContextDecl
;

WorldContextDecl:
    name=IRI_TRUNK ":" "World" "{" declaration+=WorldQuantity[","] "}"
;

PreContextDecl:
    name=IRI_TRUNK ":" "Pre" "{" declaration+=ValueVariable[","] "}"
;

SpecContextDecl:
    name=IRI_TRUNK ":" "Spec" "{" declaration+=ValueVariable[","] "}"
;

PostContextDecl:
    name=IRI_TRUNK ":" "Post" "{" declaration+=ValueVariable[","] "}"
;

WorldQuantity:
    name=IRI_TRUNK ":" type=WorldQuantityType
    ("{" props=GeometricProps "}")?
;

WorldQuantityType:
    "VelocityTwist"              |
    "Wrench"                     |
    "Pose"                       |
    "KinematicChain"             |
    "Frame"                      |
    "Gravity"
;

GeometricProps:
    pairs+=GeoPropPair[","]
;

GeoPropPair:
    (key=GeoPropKey "=" value=IRI_TRUNK)
;

GeoPropKey:
    "of" | "wrt" | "ref-point" | "as-seen-by"
;

ValueVariable:
    name=IRI_TRUNK ":" type=QuantityType value=QuantityValue?
;

QuantityValue:
    ScalarQuantity | VectorQuantity
;

ScalarQuantity:
    "=" value=FLOAT unit=Unit
;

VectorQuantity:
    "{"
    "x" "=" x=FLOAT ","
    "y" "=" y=FLOAT ","
    "z" "=" z=FLOAT unit=Unit
    "}"
;

QuantityType:
    "AngularVelocity" |
    "LinearVelocity"  |
    "Force"           |
    "Torque"          |
    "LinearDistance"  |
    "Angle"           |
    "Vector"
;

ConstraintSpecification:
    name=IRI_TRUNK ":" ("keeping")? view=View expr=ConstraintExpression
;

ConstraintExpression:
    EqualityConstraint | GreaterThanConstraint | LessThanConstraint | BilateralConstraint
;

View:
    quantity=[WorldQuantity|ScopedName]
    ("." subspace=SubSpace ("." axis=Axis)?)
;

SubSpace:
    "angvel"      |
    "linvel"      |
    "torque"      |
    "force"       |
    "orientation" |
    "position"
;

Axis:
    "x" | "y" | "z"
;

ContextRef:
    '[' valRef=[ValueVariable:FQN] quantityValue=QuantityValue? ']'
  | value=[ValueVariable:FQN]
;

EqualityConstraint:
    "equal" "to" reference=ContextRef
;

GreaterThanConstraint:
    ("greater" "than" | "is" "larger" "than") threshold=ContextRef
;

LessThanConstraint:
    ("less" "than" | "is" "smaller" "than") threshold=ContextRef
;

BilateralConstraint:
    "between" lower=ContextRef "and" upper=ContextRef
;


// Constraint Handler

ConstraintHandler:
    "CONSTRAINT_HANDLER" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        "CONTEXT"      "{" context*=HandlerContextDecl[","] "}"
        "MOTION"       ":" motion=[MotionSpec|IRI_TRUNK]
        ("MONITORS"    "{" monitors*=MonitorEntry[","]? "}")?
        "CONTROLLERS"  "{" controllers+=ControllerEntry[","]? "}"
        "SOLVER"       solver=SolverSpec
    "}"
;

HandlerContextDecl:
    WorldContextDecl | SpecContextDecl
;

MonitorEntry:
    name=IRI_TRUNK ":" monitor" constraint=ConstraintRef "and"
    (
        ("trigger" "event" event=IRI_TRUNK "when" "active") |
        ("set" "flag" flag=IRI_TRUNK "while" "active")
    )
;

ControllerEntry:
    name=IRI_TRUNK ":" type="PID" "{"
        params=ControllerParams
    "}"
    ("outputs" output_type=QuantityType)?
    ("apply" "at" apply_at=[ContextRef])?
    ("feed" "to" feed_scope=ControllerFeedScope feed_kind=QuantityType)?
;

ControllerFeedScope:
    "cartesian" | "base"
;

ControllerParams:
    "constraint" ":" constraint=ConstraintRef ","
    "Kp" ":" kp=FLOAT ","
    "Ki" ":" ki=FLOAT ","
    "Kd" ":" kd=FLOAT
    ("," "decay" ":" decay=FLOAT)?
;

ConstraintRef:
    motion=[MotionSpec|IRI_TRUNK] "." name=IRI_TRUNK
;

SolverSpec:
    "{" (ArmSolverSpec | BaseSolverSpec) "}"
;

ArmSolverSpec:
    "algorithm"   ":" algorithm=SolverAlgorithm                 ","
    "chain"       ":" chain=[WorldQuantity|ScopedName]          ","
    "root"        ":" root=[WorldQuantity|ScopedName]           ","
    "gravity"     ":" gravity=[WorldQuantity|ScopedName] "equal to" gravity_value=ContextRef
;

SolverAlgorithm:
    "Vereshchagin" | "NewtonEuler"
;

BaseSolverSpec:
    (
        "velocity-composition" ":" "{" velocity_solvers+=VelocitySolverEntry[","] "}"
        ("," "force-distribution" ":" "{" force_solvers+=ForceSolverEntry[","] "}")?
    )
    |
    (
        "force-distribution" ":" "{" force_solvers+=ForceSolverEntry[","] "}"
    )
;

VelocitySolverEntry:
    name=IRI_TRUNK ":" "VelocityCompositionSolver" "{"
        "configuration" ":" configuration=IRI_TRUNK ","
        "velocity"      ":" "World" "[" velocity=IRI_TRUNK "]"
    "}"
;

ForceSolverEntry:
    name=IRI_TRUNK ":" "ForceDistributionSolver" "{"
        "configuration" ":" configuration=IRI_TRUNK ","
        "force"         ":" "World" "[" force=IRI_TRUNK "]"
    "}"
;


// Compact DSL unit spellings only. Verbose QUDT spellings belong in JSON-LD,
// not authored .rob_mot files.
Unit:
    "rad/s" | "m/s2" | "m/s" | "cm/s" | "deg/s" |
    "Nm"    | "rad"  | "deg" | "cm"   | "m"     | "N"
;


FQN: IRI_TRUNK+["."];
ScopedName: IRI_TRUNK "." IRI_TRUNK;
Import: "import" importURI=STRING;
Comment: /\/\/.*$/;
NamespaceDeclare: "ns" name=IRI_TRUNK "=" uri=STRING ;
IRI_TRUNK: /[^\d\W][\w-]*(?<![- ])/;
