// Motion Specification DSL Grammar

Model:
    imports*=Import
    namespaces*=NamespaceDeclare
    specs+=Specification
;

Specification:
    EnvironmentSpec | ContextSpec | MotionSpec | ConstraintHandler
;

EnvironmentSpec:
    "ENVIRONMENT" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        "runtime" ":" runtime=EnvironmentRuntime
        ("," "ASSETS" "{" assets+=EnvironmentAsset[","] "}")?
        ("," "ASSEMBLY" "{" assembly+=EnvironmentAssembly[","] "}")?
    "}"
;

EnvironmentRuntime:
    "MuJoCo" | "RealRobot"
;

EnvironmentAsset:
    name=IRI_TRUNK ":" type=EnvironmentAssetType "{"
        ("model" ":" model=RobotModel ",")?
        ("xml" ":" xml=STRING)?
        (","? "urdf" ":" urdf=STRING)?
        (","? "body" ":" body=IRI_TRUNK)?
    "}"
;

EnvironmentAssetType:
    "RobotAsset" | "AttachmentAsset" | "SceneObject"
;

EnvironmentAssembly:
    name=IRI_TRUNK ":" "<" asset=[EnvironmentAsset|FQN] ">" "{"
        entries*=EnvironmentAssemblyEntry[","]
    "}"
;

EnvironmentAssemblyEntry:
    EnvironmentAttachEntry | EnvironmentPositionEntry | EnvironmentOrientationEntry |
    EnvironmentFreeEntry | EnvironmentToolBodyEntry | EnvironmentTcpSiteEntry |
    EnvironmentChainEntry | EnvironmentBodyEntry | EnvironmentShapeEntry |
    EnvironmentSizeEntry | EnvironmentMassEntry | EnvironmentFrictionEntry
;

EnvironmentAttachEntry:
    "attach" "<" attachment=[EnvironmentAsset|FQN] ">" "to" attach_to=IRI_TRUNK
    ("{" entries*=EnvironmentAttachmentEntry[","] "}")?
;

EnvironmentAttachmentEntry:
    EnvironmentAttachmentPrefixEntry | EnvironmentAttachmentPositionEntry |
    EnvironmentAttachmentOrientationEntry | EnvironmentAttachmentActuatorEntry |
    EnvironmentAttachmentOpenCommandEntry | EnvironmentAttachmentCloseCommandEntry
;

EnvironmentAttachmentPrefixEntry:
    "prefix" ":" value=IRI_TRUNK
;

EnvironmentAttachmentPositionEntry:
    "position" ":" value=PositionValue
;

EnvironmentAttachmentOrientationEntry:
    "orientation" ":" value=OrientationValue
;

EnvironmentAttachmentActuatorEntry:
    "actuator" ":" value=IRI_TRUNK
;

EnvironmentAttachmentOpenCommandEntry:
    "open" ":" value=FLOAT
;

EnvironmentAttachmentCloseCommandEntry:
    "closed" ":" value=FLOAT
;

EnvironmentPositionEntry:
    "position" ":" value=PositionValue
;

EnvironmentOrientationEntry:
    "orientation" ":" value=OrientationValue
;

EnvironmentFreeEntry:
    "free" ":" value=BOOL
;

EnvironmentToolBodyEntry:
    "tool-body" ":" value=IRI_TRUNK
;

EnvironmentTcpSiteEntry:
    "tcp-site" ":" value=IRI_TRUNK
;

EnvironmentBodyEntry:
    "body" ":" value=IRI_TRUNK
;

EnvironmentShapeEntry:
    "shape" ":" value=SceneObjectShape
;

SceneObjectShape:
    "box" | "sphere" | "cylinder"
;

EnvironmentSizeEntry:
    "size" ":" value=PositionValue
;

EnvironmentMassEntry:
    "mass" ":" value=FLOAT
;

EnvironmentFrictionEntry:
    "friction" ":" value=FrictionValue
;

FrictionValue:
    "{" (terms*=FrictionTerm[","])? "}"
;

FrictionTerm:
    axis=FrictionAxis ":" value=FLOAT
;

FrictionAxis:
    "slide" | "torsion" | "roll"
;

EnvironmentChainEntry:
    "chain" ":" "{" "root" ":" root=IRI_TRUNK "," "end" ":" end=IRI_TRUNK "}"
;

ContextSpec:
    "CONTEXT" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        context*=MotionContextDecl[","]
    "}"
;

PositionValue:
    "{" (terms*=PositionTerm[","])? "}"
;

PositionTerm:
    axis=LinearAxis ":" (ref=ContextRef | value=FLOAT unit=LinearDistanceUnit)
;

LinearAxis:
    "x" | "y" | "z"
;

LinearDistanceUnit:
    "m"
;

OrientationValue:
    "{" (terms*=OrientationTerm[","])? "}"
;

OrientationTerm:
    axis=AngularAxis ":" (ref=ContextRef | value=FLOAT unit=AngleUnit)
;

AngularAxis:
    "roll" | "pitch" | "yaw"
;

AngleUnit:
    "rad" | "deg"
;

RobotModel: "KinovaGen3" | "Kelo";

MotionSpec:
    "MOTION_SPEC" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        ("MOVE"       ":" move=STRING)?
        ("TRAJECTORY" ":" trajectory=TrajectorySpec)?
        "CONTEXT"  "{" context*=MotionContextItem[","] "}"
        sections+=ConstraintSection
    "}"
;

TrajectorySpec:
    type=TrajectoryType
;

TrajectoryType: "Lerp" ;

ConstraintSection:
    WhenSection | WhileSection | UntilSection
;

WhenSection:  "WHEN"  "{" constraints*=ConstraintItem[","]? "}" ;
WhileSection: "WHILE" "{" constraints*=ConstraintItem[","]? "}" ;
UntilSection: "UNTIL" (logic=UntilLogic)? "{" constraints*=ConstraintItem[","]? "}" ;
UntilLogic:   "any" | "all" ;

ConstraintItem: ConstraintSpecification | ConstraintAlias | ConstraintReference ;
ConstraintAlias: name=IRI_TRUNK ":" "<" ref=ConstraintRef ">" ;
ConstraintReference: "<" ref=ConstraintRef ">" ;

MotionContextDecl:
    QuantityContextDecl
;

MotionContextItem:
    MotionContextDecl | ContextDeclReference
;

ContextDeclReference:
    "<" ref=[QuantityContextDecl|FQN] ">"
;

QuantityContextDecl:
    WorldContextDecl | PreContextDecl | SpecContextDecl | PostContextDecl
;

WorldContextDecl:
    name=IRI_TRUNK ":" "World" "{" declaration+=WorldQuantityItem[","] "}"
;

PreContextDecl:
    name=IRI_TRUNK ":" "Pre" "{" declaration+=ContextQuantityItem[","] "}"
;

SpecContextDecl:
    name=IRI_TRUNK ":" "Spec" "{" declaration+=ContextQuantityItem[","] "}"
;

PostContextDecl:
    name=IRI_TRUNK ":" "Post" "{" declaration+=ContextQuantityItem[","] "}"
;

WorldQuantityItem:
    WorldQuantityAlias | WorldQuantityReference | WorldQuantity
;

WorldQuantityAlias:
    name=IRI_TRUNK ":" "<" ref=[WorldQuantity|FQN] ">"
;

WorldQuantityReference:
    "<" ref=[WorldQuantity|FQN] ">"
;

ContextQuantityItem:
    ContextQuantityAlias | ContextQuantityReference | ContextQuantity
;

ContextQuantityAlias:
    name=IRI_TRUNK ":" "<" ref=[ContextQuantity|FQN] ">"
;

ContextQuantityReference:
    "<" ref=[ContextQuantity|FQN] ">"
;

WorldQuantity:
    name=IRI_TRUNK ":" type=WorldQuantityType
    ("{" props=GeometricProps "}")?
;

WorldQuantityType:
    "VelocityTwist"              |
    "Wrench"                     |
    "Pose"                       |
    "JointPosition"              |
    "KinematicChain"             |
    "Frame"                      |
    "SceneObject"                |
    "Link"                       |
    "Gravity"
;

GeometricProps:
    pairs+=GeoPropPair[","]
;

GeoPropPair:
    (key=GeoPropKey ":" value=IRI_TRUNK)
;

GeoPropKey:
    "of" | "wrt" | "ref-point" | "as-seen-by"
;

ContextQuantity:
    name=IRI_TRUNK ":" type=ContextQuantityType value=ContextQuantityValue?
;

ContextQuantityType:
    QuantityType | SnapshotQuantityType | "Trajectory" | "TrajectoryProgress"
;

SnapshotQuantityType:
    "Pose" | "Position" | "Orientation"
;

ContextQuantityValue:
    QuantityValue | SnapshotValue | TrajectoryValue | PoseValue
;

QuantityValue:
    ScalarQuantity | VectorQuantity
;

ScalarQuantity:
    "=" value=FLOAT unit=Unit
;

VectorQuantity:
    "{"
    "x" "=" x=FLOAT ","
    "y" "=" y=FLOAT ","
    "z" "=" z=FLOAT unit=Unit
    "}"
;

SnapshotValue:
    "=" "Snapshot" "of" source=View ("+" offset=ContextRef)?
;

QuantityType:
    "AngularVelocity" |
    "LinearVelocity"  |
    "Force"           |
    "Torque"          |
    "Distance"        |
    "LinearDistance"  |
    "Angle"           |
    "AngularDistance" |
    "Vector"
;

TrajectoryValue:
    "=" lerp=LerpSpec
;

LerpSpec:
    "Lerp" "{"
        "start" ":" start=ContextRef ","
        "goal"  ":" goal=ContextRef  ","
        "alpha" ":" alpha=ContextRef
    "}"
;

PoseValue:
    "{"
        "position" ":" position=PositionValue ","
        "orientation" ":" orientation=OrientationValue
    "}"
;

ConstraintSpecification:
    disabled?='@disable' name=IRI_TRUNK ":" ("keeping")? view=View expr=ConstraintExpression
;

ConstraintExpression:
    EqualityConstraint | GreaterThanConstraint | LessThanConstraint | BilateralConstraint
;

View:
    (
        "distance" "between"
        "<" distance_from=[WorldQuantity|FQN] ">"
        "and"
        "<" distance_to=[WorldQuantity|FQN] ">"
    )
    |
    (
        "<" quantity=[WorldQuantity|FQN] ">"
        ("." subspace=SubSpace ("." axis=Axis)?)?
    )
;

SubSpace:
    "angvel"      |
    "linvel"      |
    "torque"      |
    "force"       |
    "orientation" |
    "position"
;

Axis:
    "x" | "y" | "z" | "roll" | "pitch" | "yaw"
;

ContextRef:
    "[" quantity=[ContextQuantity:FQN] literal_value=QuantityValue? "]"
  | "<" quantity=[ContextQuantity|ScopedName] ">" ("." subspace=SubSpace ("." axis=Axis)?)?
  | context_scope=ContextScope "[" inline_quantity=ContextQuantity "]"
;

ContextScope:
    "Pre" | "Spec" | "Post"
;

EqualityConstraint:
    "equal" "to" reference=ContextRef
;

GreaterThanConstraint:
    ("greater" "than" | "is" "larger" "than" | "away" "from") threshold=ContextRef
;

LessThanConstraint:
    ("less" "than" | "is" "smaller" "than" | "up" "to") threshold=ContextRef
;

BilateralConstraint:
    "between" lower=ContextRef "and" upper=ContextRef
;


// Constraint Handler

ConstraintHandler:
    "CONSTRAINT_HANDLER" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        "CONTEXT"      "{" context*=HandlerContextItem[","] "}"
        "MOTION"       ":" "<" motion=[MotionSpec|IRI_TRUNK] ">"
        "CONTROL_MODE" ":" control_mode=HandlerControlMode
        ("MONITORS"    "{" monitors*=MonitorEntry[","]? "}")?
        "CONTROLLERS"  "{" controllers*=ControllerItem[","]? "}"
        "SOLVERS"      "{" solvers+=SolverItem[","] "}"
    "}"
;

ControllerItem:
    ControllerAlias | ControllerReference | ControllerEntry
;

ControllerAlias:
    name=IRI_TRUNK ":" "<" ref=ControllerRef ">"
;

ControllerReference:
    "<" ref=ControllerRef ">"
;

SolverItem:
    SolverAlias | SolverReference | SolverEntry
;

SolverAlias:
    name=IRI_TRUNK ":" "<" ref=SolverRef ">"
;

SolverReference:
    "<" ref=SolverRef ">"
;

HandlerContextDecl:
    WorldContextDecl | SpecContextDecl
;

HandlerContextItem:
    HandlerContextDecl | ContextDeclReference
;

MonitorEntry:
    name=IRI_TRUNK ":" "monitor" "<" constraint=MonitorTarget ">" "and"
    (
        ("trigger" "event" event=IRI_TRUNK "when" "active") |
        ("set" "flag" flag=IRI_TRUNK "while" "active")
    )
;

ControllerEntry:
    name=IRI_TRUNK ":" type=ControllerType "{"
        params=ControllerParams
    "}"
    ("as" command_type=QuantityType)?
    ("apply" "at" "<" apply_at=[WorldQuantity|ScopedName] ">")?
    ("via" "<" solver=SolverRef ">")?
;

ControllerType:
    "PID" | "Impedance" | "ABAG" | "FeedForward"
;

ControllerParams:
    "constraint" ":" "<" constraint=ConstraintRef ">"
    ("," terms*=ControllerParam[","])?
;

ControllerParam:
    name=ControllerParamName (("=" | ":") value=FLOAT)
;

ControllerParamName:
    "Kp" | "Ki" | "Kd" | "Stiffness" | "Damping" | "decay"
;

HandlerControlMode:
    "JointTorque"
;

MonitorTarget:
    UntilMonitorRef | ConstraintRef
;

UntilMonitorRef:
    motion=[MotionSpec|IRI_TRUNK] "." "until"
;

ConstraintRef:
    motion=[MotionSpec|IRI_TRUNK] "." constraint=[ConstraintSpecification|IRI_TRUNK]
;

ControllerRef:
    handler=[ConstraintHandler|IRI_TRUNK] "." controller=[ControllerEntry|IRI_TRUNK]
;

SolverRef:
    (handler=[ConstraintHandler|IRI_TRUNK] ".")? solver=[SolverEntry|IRI_TRUNK]
;

SolverEntry:
    name=IRI_TRUNK ":" "Solver" "{"
        "robot"     ":" robot=RobotRef ","
        "algorithm" ":" algorithm=SolverAlgorithm
        ("," "root"      ":" root=RobotAnchorRef
            ("," "end"  ":" end=RobotAnchorRef)?
            "," "gravity" ":" "<" gravity=[WorldQuantity|ScopedName] ">" "equal to" gravity_value=ContextRef
        )?
    "}"
;

RobotRef:
    "<" environment_robot=EnvironmentRobotRef ">"
;

EnvironmentRobotRef:
    environment=[EnvironmentSpec|IRI_TRUNK] "." assembly=IRI_TRUNK
;

RobotAnchorRef:
    "<" environment_robot=EnvironmentRobotRef "." "chain" "." anchor=RobotAnchor ">"
;

RobotAnchor:
    "root" | "end"
;

SolverAlgorithm:
    "ACHD" | "RNE" | "CommandForwarding" | "VelocityDistribution" | "ForceDistribution"
;


// Compact DSL unit spellings only. Verbose QUDT spellings belong in JSON-LD,
// not authored .rob_mot files.
Unit:
    "rad/s" | "m/s2" | "m/s" | "cm/s" | "deg/s" |
    "Nm"    | "rad"  | "deg" | "cm"   | "m"     | "N"
;


FQN: IRI_TRUNK+["."];
ScopedName: IRI_TRUNK+["."];
Import: "import" importURI=STRING;
Comment: /\/\/.*$/;
NamespaceDeclare: "ns" name=IRI_TRUNK "=" uri=STRING ;
IRI_TRUNK: /[^\d\W][\w-]*(?<![- ])/;
