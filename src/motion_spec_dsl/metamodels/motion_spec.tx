// Motion Specification DSL Grammar

Model:
    imports*=Import
    namespaces*=NamespaceDeclare
    specs+=Specification
;

Specification:
    MotionSpec | ConstraintHandler
;

MotionSpec:
    "MOTION_SPEC" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        ("MOVE"    ":" move=STRING)?
        "CONTEXT"  "{" context*=MotionContextDecl[","] "}"
        "WHEN"     when=WhenSection
        "WHILE"    while_=WhileSection
        "UNTIL"    until=UntilSection
    "}"
;

WhenSection:  "{" constraints*=ConstraintSpecification[","]? "}" ;
WhileSection: "{" constraints+=ConstraintSpecification[","]? "}" ;
UntilSection: "{" constraints*=ConstraintSpecification[","]? "}" ;

MotionContextDecl:
    WorldContextDecl | PreContextDecl | SpecContextDecl | PostContextDecl
;

ConstraintHandler:
    "CONSTRAINT_HANDLER" "(" "ns" "=" ns=[NamespaceDeclare|ID] ")" name=IRI_TRUNK "{"
        "CONTEXT"      "{" context*=HandlerContextDecl[","] "}"
        "MOTION"       ":" "@"motion=[MotionSpec|IRI_TRUNK]
        ("MONITORS"    "{" monitors*=MonitorEntry[","]? "}")?
        "CONTROLLERS"  "{" controllers+=ControllerEntry[","]? "}"
        "SOLVER"       solver=SolverSpec
    "}"
;

HandlerContextDecl:
    WorldContextDecl | SpecContextDecl
;

WorldContextDecl:
    label=IRI_TRUNK ":" "World" decl=WorldDeclarationList
;

PreContextDecl:
    label=IRI_TRUNK ":" "Pre" decl=ValueDeclarationList
;

SpecContextDecl:
    label=IRI_TRUNK ":" "Spec" decl=ValueDeclarationList
;

PostContextDecl:
    label=IRI_TRUNK ":" "Post" decl=ValueDeclarationList
;

WorldDeclarationList:
    "{" declaration+=WorldQuantity[","] "}"
;

WorldQuantity:
    name=IRI_TRUNK ":" type=WorldQuantityType
    ("{" props=GeometricProps "}")?
;

WorldQuantityType:
    "VelocityTwist"              |
    "Wrench"                     |
    "Pose"                       |
    "KinematicChain"             |
    "Frame"                      |
    "UniformGravitationalField"
;

GeometricProps:
    pairs+=GeoPropPair[","]
;

GeoPropPair:
    (key=GeoPropKey "=" value=IRI_TRUNK)
;

GeoPropKey:
    "of" | "wrt" | "ref-point" | "as-seen-by"
;

ValueDeclarationList:
    "{" declaration+=ValueVariable[","] "}"
;

ValueVariable:
    name=IRI_TRUNK ":" type=QuantityType value=QuantityValue?
;

QuantityValue:
    ScalarQuantity | VectorQuantity
;

ScalarQuantity:
    "=" value=FLOAT unit=Unit
;

VectorQuantity:
    "{"
    "x" "=" x=FLOAT ","
    "y" "=" y=FLOAT ","
    "z" "=" z=FLOAT unit=Unit
    "}"
;

QuantityType:
    "AngularVelocity" |
    "LinearVelocity"  |
    "Force"           |
    "Torque"          |
    "LinearDistance"  |
    "Angle"           |
    "Vector"
;

ConstraintSpecification:
    name=IRI_TRUNK ":" ("keeping")? view=QuantityRef expr=ConstraintExpression
;

ConstraintExpression:
    EqualityConstraint | GreaterThanConstraint | LessThanConstraint | BilateralConstraint
;

QuantityRef:
    quantity=[WorldQuantity:IRI_TRUNK]
    ("." property=QuantityProperty ("." axis=Axis)?)*
;

QuantityProperty:
    "angular"  |
    "linear"   |
    "torque"   |
    "force"    |
    "rotation" |
    "distance"
;

Axis:
    "x" | "y" | "z"
;

ContextLookup:
    PreLookup | SpecLookup | PostLookup
;

EqualityConstraint:
    "equal" "to" reference=ContextLookup
;

GreaterThanConstraint:
    ("greater" "than" | "is" "larger" "than") threshold=ContextLookup
;

LessThanConstraint:
    ("less" "than" | "is" "smaller" "than") threshold=ContextLookup
;

BilateralConstraint:
    "between" lower=ContextLookup "and" upper=ContextLookup
;

PreLookup:
    "Pre"   "[" variable=IRI_TRUNK value=QuantityValue? "]"
;

SpecLookup:
    "Spec"  "[" variable=IRI_TRUNK value=QuantityValue? "]"
;

PostLookup:
    "Post"  "[" variable=IRI_TRUNK value=QuantityValue? "]"
;


// Constraint Handler

MonitorEntry:
    "monitor" constraint=IRI_TRUNK "and"
    (
        ("trigger" "event" event=IRI_TRUNK "when" "active") |
        ("set" "flag" flag=IRI_TRUNK "while" "active")
    )
;

ControllerEntry:
    name=IRI_TRUNK ":" type=ControllerType "{"
        params=ControllerParams
    "}"
    ("outputs" output_type=ControllerOutputType)?
    ("apply" "at" "World" "[" apply_at=IRI_TRUNK "]")?
    ("feed" "to" feed_scope=ControllerFeedScope feed_kind=ControllerFeedKind)?
;

ControllerType:
    "PID"
;

ControllerOutputType:
    "force" | "acceleration" | "velocity"
;

ControllerFeedScope:
    "cartesian" | "base"
;

ControllerFeedKind:
    "force" | "acceleration" | "velocity"
;

ControllerParams:
    "constraint" ":" constraint=IRI_TRUNK ","
    "Kp" ":" kp=FLOAT ","
    "Ki" ":" ki=FLOAT ","
    "Kd" ":" kd=FLOAT
    ("," "decay" ":" decay=FLOAT)?
;

SolverSpec:
    "{" (ArmSolverSpec | BaseSolverSpec) "}"
;

SolverAlgorithm:
    "Vereshchagin" | "NewtonEuler"
;

ArmSolverSpec:
    "algorithm"   ":" algorithm=SolverAlgorithm            ","
    "chain"       ":" "World" "[" chain=IRI_TRUNK "]"      ","
    "root"        ":" "World" "[" root=IRI_TRUNK "]"       ","
    "gravity"     ":" "World" "[" gravity=IRI_TRUNK "]" "equal to" gravity_value=SpecLookup
;

BaseSolverSpec:
    (
        "velocity-composition" ":" "{" velocity_solvers+=VelocitySolverEntry[","] "}"
        ("," "force-distribution" ":" "{" force_solvers+=ForceSolverEntry[","] "}")?
    )
    |
    (
        "force-distribution" ":" "{" force_solvers+=ForceSolverEntry[","] "}"
    )
;

VelocitySolverEntry:
    name=IRI_TRUNK ":" "VelocityCompositionSolver" "{"
        "configuration" ":" configuration=IRI_TRUNK ","
        "velocity"      ":" "World" "[" velocity=IRI_TRUNK "]"
    "}"
;

ForceSolverEntry:
    name=IRI_TRUNK ":" "ForceDistributionSolver" "{"
        "configuration" ":" configuration=IRI_TRUNK ","
        "force"         ":" "World" "[" force=IRI_TRUNK "]"
    "}"
;


// Compact DSL unit spellings only. Verbose QUDT spellings belong in JSON-LD,
// not authored .rob_mot files.
Unit:
    "rad/s" | "m/s2" | "m/s" | "cm/s" | "deg/s" |
    "Nm"    | "rad"  | "deg" | "cm"   | "m"     | "N"
;


FQN: IRI_TRUNK+["."];
Import: "import" importURI=STRING;
Comment: /\/\/.*$/;
NamespaceDeclare: "ns" name=IRI_TRUNK "=" uri=STRING ;
IRI_TRUNK: /[^\d\W][\w-]*\b/;
