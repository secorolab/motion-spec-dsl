// Motion Specification DSL Grammar

Model:
    imports*=Import
    namespaces*=NamespaceDeclare
    specs+=Specification
;

Specification:
    EnvironmentSpec | ContextSpec | MotionSpec | ConstraintHandler
;

EnvironmentSpec:
    "ENVIRONMENT" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        "runtime" ":" runtime=EnvironmentRuntime
        ("," "ASSETS" "{" assets+=EnvironmentAsset[","] "}")?
        ("," "ASSEMBLY" "{" assembly+=EnvironmentAssembly[","] "}")?
        ("," "TRACE" trace=EnvironmentTrace)?
    "}"
;

EnvironmentTrace:
    "{"
        "enabled" ":" enabled=BOOL
        ("," "length" ":" length=INT)?
        ("," "color" ":" color=ColorValue)?
        ("," "ee" ":" "[" targets+=IRI_TRUNK[","] "]")?
    "}"
;

EnvironmentRuntime:
    "MuJoCo" | "RealRobot"
;

EnvironmentAsset:
    name=IRI_TRUNK ":" type=EnvironmentAssetType ("{"
        ("model" ":" model=RobotModel ",")?
        ("xml" ":" xml=STRING)?
        (","? "urdf" ":" urdf=STRING)?
    "}")?
;

EnvironmentAssetType:
    "RobotAsset" | "AttachmentAsset" | "SceneObject"
;

EnvironmentAssembly:
    type=EnvironmentAssemblyType name=IRI_TRUNK "using" "<" asset=[EnvironmentAsset|FQN] ">"
    ("{" entries*=EnvironmentAssemblyEntry[","] "}")?
;

EnvironmentAssemblyType:
    "Object" | "Robot" | "Attachment"
;

EnvironmentAssemblyEntry:
    EnvironmentPositionEntry | EnvironmentOrientationEntry |
    EnvironmentFreeEntry | EnvironmentToolBodyEntry | EnvironmentTcpSiteEntry |
    EnvironmentFtSensorEntry |
    EnvironmentChainEntry | EnvironmentShapeEntry | EnvironmentSizeEntry |
    EnvironmentMassEntry | EnvironmentFrictionEntry | EnvironmentColorEntry |
    EnvironmentAttachTargetEntry | EnvironmentAttachmentPrefixEntry |
    EnvironmentAttachmentActuatorEntry
;

EnvironmentAttachTargetEntry:
    "attach-to" ":" target=EnvironmentAttachTargetRef
;

EnvironmentAttachTargetRef:
    "<" assembly=[EnvironmentAssembly|FQN] ">" "." kind=AttachTargetKind "(" name=IRI_TRUNK ")"
;

AttachTargetKind:
    "body" | "site" | "frame"
;

EnvironmentAttachmentPrefixEntry:
    "prefix" ":" value=IRI_TRUNK
;

EnvironmentAttachmentActuatorEntry:
    "actuator" ":" value=IRI_TRUNK
;


EnvironmentPositionEntry:
    "position" ":" value=PositionValue
;

EnvironmentOrientationEntry:
    "orientation" ":" value=OrientationValue
;

EnvironmentFreeEntry:
    "free" ":" value=BOOL
;

EnvironmentToolBodyEntry:
    "tool-body" ":" value=IRI_TRUNK
;

EnvironmentTcpSiteEntry:
    "tcp-site" ":" value=IRI_TRUNK
;

EnvironmentFtSensorEntry:
    "ft-sensor" ":" name=IRI_TRUNK "frame-site" frame_site=IRI_TRUNK
;

EnvironmentShapeEntry:
    "shape" ":" value=SceneObjectShape
;

SceneObjectShape:
    "Box" | "Sphere" | "Cylinder"
;

EnvironmentSizeEntry:
    "size" ":" value=PositionValue
;

EnvironmentMassEntry:
    "mass" ":" value=FLOAT
;

EnvironmentColorEntry:
    "color" ":" value=ColorValue
;

ColorValue:
    "{" (terms*=ColorTerm[","])? "}"
;

ColorTerm:
    channel=ColorChannel ":" value=FLOAT
;

ColorChannel:
    "r" | "g" | "b" | "a"
;

EnvironmentFrictionEntry:
    "friction" ":" value=FrictionValue
;

FrictionValue:
    "{" (terms*=FrictionTerm[","])? "}"
;

FrictionTerm:
    axis=FrictionAxis ":" value=FLOAT
;

FrictionAxis:
    "slide" | "torsion" | "roll"
;

EnvironmentChainEntry:
    "chain" ":" "{" "root" ":" root=IRI_TRUNK "," "end" ":" end=IRI_TRUNK "}"
;

ContextSpec:
    "CONTEXT" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        context*=MotionContextDecl[","]
    "}"
;

PositionValue:
    "{" (terms*=PositionTerm[","])? "}"
;

PositionTerm:
    axis=LinearAxis ":" (value=FLOAT unit=LinearDistanceUnit | ref=ContextRef)
;

LinearAxis:
    "x" | "y" | "z"
;

LinearDistanceUnit:
    "m"
;

OrientationValue:
    "{" (terms*=OrientationTerm[","])? "}"
;

OrientationTerm:
    axis=AngularAxis ":" (value=FLOAT unit=AngleUnit | ref=ContextRef)
;

AngularAxis:
    "roll" | "pitch" | "yaw"
;

AngleUnit:
    "rad" | "deg"
;

RobotModel: "KinovaGen3" | "Kelo";

MotionSpec:
    "MOTION_SPEC" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        ("MOVE"       ":" move=STRING)?
        ("TRAJECTORY" ":" trajectory=TrajectorySpec)?
        "CONTEXT"  "{" context*=MotionContextItem[","] "}"
        sections+=ConstraintSection
    "}"
;

TrajectorySpec:
    type=TrajectoryType
;

TrajectoryType: "Lerp" | "Circle" | "Arc" | "Helix" | "Figure8" ;

ConstraintSection:
    WhenSection | WhileSection | UntilSection
;

WhenSection:  "WHEN"  (logic=WhenLogic)? "{" constraints*=ConstraintItem[","]? "}" ;
WhileSection: "WHILE" "{" constraints*=ConstraintItem[","]? "}" ;
UntilSection: "UNTIL" (logic=UntilLogic)? "{" constraints*=ConstraintItem[","]? "}" ;
WhenLogic:    "any" | "all" ;
UntilLogic:   "any" | "all" ;

ConstraintItem: ConstraintSpecification | ConstraintAlias ;
ConstraintAlias: (name=IRI_TRUNK ":")? "<" ref=ConstraintRef ">" ;

MotionContextDecl:
    QuantityContextDecl
;

MotionContextItem:
    MotionContextDecl | ContextDeclReference
;

ContextDeclReference:
    "<" ref=[QuantityContextDecl|FQN] ">"
;

QuantityContextDecl:
    WorldContextDecl | PreContextDecl | SpecContextDecl | PostContextDecl
;

WorldContextDecl:
    name=IRI_TRUNK ":" "World" "{" declaration+=WorldQuantityItem[","] "}"
;

PreContextDecl:
    name=IRI_TRUNK ":" "Pre" "{" declaration+=ContextQuantityItem[","] "}"
;

SpecContextDecl:
    name=IRI_TRUNK ":" "Spec" "{" declaration+=ContextQuantityItem[","] "}"
;

PostContextDecl:
    name=IRI_TRUNK ":" "Post" "{" declaration+=ContextQuantityItem[","] "}"
;

WorldQuantityItem:
    WorldQuantityAlias | WorldQuantity
;

WorldQuantityAlias:
    (name=IRI_TRUNK ":")? "<" ref=[WorldQuantity|FQN] ">"
;

ContextQuantityItem:
    ContextQuantityAlias | ContextQuantity
;

ContextQuantityAlias:
    (name=IRI_TRUNK ":")? "<" ref=[ContextQuantity|FQN] ">"
;

WorldQuantity:
    name=IRI_TRUNK ":" type=WorldQuantityType
    ("{" props=GeometricProps "}")?
;

WorldQuantityType:
    "VelocityTwist"              |
    "Wrench"                     |
    "ExternalForceMagnitude"     |
    "ExternalForce"              |
    "Pose"                       |
    "JointPosition"              |
    "KinematicChain"             |
    "Frame"                      |
    "SceneObject"                |
    "Link"                       |
    "Gravity"
;

GeometricProps:
    pairs+=GeoPropPair[","]
;

GeoPropPair:
    (key=GeoPropKey ":" value=IRI_TRUNK)
;

GeoPropKey:
    "of" | "wrt" | "ref-point" | "as-seen-by" | "ft-sensor" | "deadband"
;

ContextQuantity:
    name=IRI_TRUNK ":" type=ContextQuantityType ("{" props=GeometricProps "}")? value=ContextQuantityValue?
;

ContextQuantityType:
    QuantityType | SnapshotQuantityType | "Trajectory" | "TrajectoryProgress" | "VelocityProfile" | "Admittance"
;

SnapshotQuantityType:
    "Pose" | "Position" | "Orientation"
;

ContextQuantityValue:
    AdmittanceSpec | QuantityValue | SnapshotValue | TrajectoryValue | ProfileSpec | PoseValue
;

// Admittance reference quantity: a virtual mass-damper(-spring) filter turning a
// measured external-force axis into a per-axis velocity setpoint. Sibling of
// ProfileSpec (VelocityProfile); consumed as a velocity constraint's reference.
AdmittanceSpec:
    "{"
        "force" ":" force=View ","
        "mass" "=" mass=FLOAT ","
        "damping" "=" damping=FLOAT
        ("," "stiffness" "=" stiffness=FLOAT)?
        ("," "max-velocity" "=" max_velocity=FLOAT (max_velocity_unit=Unit)?)?
    "}"
;

QuantityValue:
    ScalarQuantity | VectorQuantity
;

ScalarQuantity:
    "=" value=FLOAT unit=Unit
;

VectorQuantity:
    "{"
    "x" "=" x=FLOAT ","
    "y" "=" y=FLOAT ","
    "z" "=" z=FLOAT (unit=Unit)?
    "}"
;

// Snapshot sampling clock: `on task` (default) samples once/holds for the run;
// `on entry` re-samples on each state (re-)entry of the owning motion.
SnapshotValue:
    "=" "Snapshot" "of" source=View ("+" offset=ContextRef)? ("on" clock=SnapshotClock)?
;

SnapshotClock:
    "task" | "entry"
;

QuantityType:
    "AngularVelocity"     |
    "LinearVelocity"      |
    "LinearAcceleration"  |
    "LinearJerk"          |
    "Force"               |
    "Torque"              |
    "Distance"            |
    "LinearDistance"      |
    "Angle"               |
    "AngularDistance"     |
    "Direction"           |
    "FreeVector"          |
    "Duration"
;

TrajectoryValue:
    "=" (lerp=LerpSpec | circle=CircleSpec | arc=ArcSpec | helix=HelixSpec | figure8=Figure8Spec)
;

LerpSpec:
    "Lerp" "{"
        "start" ":" start=ContextRef ","
        "goal"  ":" goal=ContextRef  ","
        "alpha" ":" alpha=ContextRef
        ("," "profile" ":" profile=EasingProfile)?
    "}"
;

EasingProfile: "Linear" | "EaseIn" | "EaseOut" | "EaseInOut" ;

ProfileSpec:
    "=" "Profile" "{"
        "max_velocity" ":" max_velocity=ContextRef ","
        "max_acceleration" ":" max_acceleration=ContextRef
        ("," "measured_velocity" ":" measured_velocity=View)?
        ("," "max_jerk" ":" max_jerk=ContextRef)?
        ("," "shape" ":" shape=VelocityProfileShape)?
    "}"
;

VelocityProfileShape: "Trapezoidal" | "SCurve" ;

CircleSpec:
    "Circle" "{"
        "start"        ":" start=ContextRef        ","
        "center"       ":" center=ContextRef       ","
        "plane-normal" ":" plane_normal=ContextRef ","
        "alpha"        ":" alpha=ContextRef
    "}"
;

ArcSpec:
    "Arc" "{"
        "start"        ":" start=ContextRef        ","
        "end"          ":" end=ContextRef          ","
        "amplitude"    ":" amplitude=ContextRef    ","
        "plane-normal" ":" plane_normal=ContextRef ","
        "alpha"        ":" alpha=ContextRef
    "}"
;

HelixSpec:
    "Helix" "{"
        "start"       ":" start=ContextRef       ","
        "center"      ":" center=ContextRef      ","
        "axis"        ":" axis=ContextRef        ","
        "pitch"       ":" pitch=ContextRef       ","
        "revolutions" ":" revolutions=ContextRef ","
        "alpha"       ":" alpha=ContextRef
    "}"
;

Figure8Spec:
    "Figure8" "{"
        "anchor"       ":" anchor=ContextRef       ","
        "radius"       ":" radius=ContextRef       ","
        "plane-normal" ":" plane_normal=ContextRef ","
        "alpha"        ":" alpha=ContextRef
        ("," "form" ":" form=Figure8Form)?
    "}"
;

Figure8Form: "Gerono" | "Bernoulli" ;

PoseValue:
    "{"
        "position" ":" position=PositionValue ","
        "orientation" ":" orientation=OrientationValue
    "}"
;

ConstraintSpecification:
    disabled?='@disable' name=IRI_TRUNK ":"
    ("keeping")? view=View expr=ConstraintExpression
;

ConstraintExpression:
    EqualityConstraint | GreaterThanConstraint | LessThanConstraint | BilateralConstraint
;

View:
    (
        "distance" "between"
        "<" distance_from=[WorldQuantity|FQN] ">"
        "and"
        "<" distance_to=[WorldQuantity|FQN] ">"
    )
    |
    is_elapsed?="elapsed"
    |
    (
        "<" quantity=[WorldQuantity|FQN] ">"
        ("." subspace=SubSpace ("." axis=Axis)?)?
    )
;

SubSpace:
    "angvel"      |
    "linvel"      |
    "torque"      |
    "force"       |
    "pose"        |
    "orientation" |
    "position"
;

Axis:
    "x" | "y" | "z" | "roll" | "pitch" | "yaw"
;

ContextRef:
    "[" quantity=[ContextQuantity:FQN] literal_value=QuantityValue? "]"
  | "<" quantity=[ContextQuantity|ScopedName] ">" ("." subspace=SubSpace ("." axis=Axis)?)?
  | context_scope=ContextScope "[" inline_quantity=ContextQuantity "]"
  | bare=BareScalar
;

BareScalar: value=FLOAT unit=Unit ;

ContextScope:
    "Pre" | "Spec" | "Post"
;

EqualityConstraint:
    "equal" "to" reference=ContextRef
;

GreaterThanConstraint:
    ("greater" "than" | "is" "larger" "than" | "away" "from") threshold=ContextRef
;

LessThanConstraint:
    ("less" "than" | "is" "smaller" "than" | "up" "to") threshold=ContextRef
;

BilateralConstraint:
    "between" lower=ContextRef "and" upper=ContextRef
;


// Constraint Handler

ConstraintHandler:
    "CONSTRAINT_HANDLER" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        "CONTEXT"      "{" context*=HandlerContextItem[","] "}"
        "MOTION"       ":" "<" motion=[MotionSpec|IRI_TRUNK] ">"
        "CONTROL_MODE" ":" control_mode=HandlerControlMode
        "CONTROL_PERIOD" ":" control_period=BareScalar
        ("MONITORS"    "{" monitors*=MonitorEntry[","]? "}")?
        "CONTROLLERS"  "{" controllers*=ControllerItem[","]? "}"
        "SOLVERS"      "{" solvers+=SolverItem[","] "}"
    "}"
;

ControllerItem:
    ControllerAlias | ControllerEntry
;

ControllerAlias:
    (name=IRI_TRUNK ":")? "<" ref=ControllerRef ">"
;

SolverItem:
    SolverAlias | SolverEntry
;

SolverAlias:
    (name=IRI_TRUNK ":")? "<" ref=SolverRef ">"
;

HandlerContextDecl:
    WorldContextDecl | SpecContextDecl
;

HandlerContextItem:
    HandlerContextDecl | ContextDeclReference
;

MonitorEntry:
    name=IRI_TRUNK ":" "monitor" "<" constraint=MonitorTarget ">" "and"
    (
        ("trigger" "event" event=EventName "when" "active"
            ("fallback" "<" fallback=[MotionSpec|IRI_TRUNK] ">")?) |
        ("set" "flag" flag=IRI_TRUNK "while" "active")
    )
;

EventName:
    (ns=[NamespaceDeclare|IRI_TRUNK] ".")? name=IRI_TRUNK
;

ControllerEntry:
    name=IRI_TRUNK ":" type=ControllerType "{"
        params=ControllerParams
    "}"
    ("as" command_type=QuantityType)?
    ("apply" "at" "<" apply_at=[WorldQuantity|ScopedName] ">")?
    ("via" "<" solver=SolverRef ">")?
;

ControllerType:
    "PID" | "Impedance" | "ABAG" | "FeedForward"
;

ControllerParams:
    "constraint" ":" "<" constraint=ConstraintRef ">"
    ("," "profile" ":" profile=ContextRef)?
    ("," terms*=ControllerParam[","])?
;

ControllerParam:
    name=ControllerParamName (("=" | ":") value=FLOAT)
;

ControllerParamName:
    "Kp" | "Ki" | "Kd" | "Stiffness" | "Damping" | "decay"
;

HandlerControlMode:
    "JointTorque"
;

MonitorTarget:
    UntilMonitorRef | WhenMonitorRef | ConstraintRef
;

UntilMonitorRef:
    motion=[MotionSpec|IRI_TRUNK] "." "until"
;

WhenMonitorRef:
    motion=[MotionSpec|IRI_TRUNK] "." "when"
;

ConstraintRef:
    motion=[MotionSpec|IRI_TRUNK] "." constraint=[ConstraintSpecification|IRI_TRUNK]
;

ControllerRef:
    handler=[ConstraintHandler|IRI_TRUNK] "." controller=[ControllerEntry|IRI_TRUNK]
;

SolverRef:
    (handler=[ConstraintHandler|IRI_TRUNK] ".")? solver=[SolverEntry|IRI_TRUNK]
;

SolverEntry:
    name=IRI_TRUNK ":" "Solver" "{"
        "robot"     ":" robot=RobotRef ","
        "algorithm" ":" algorithm=SolverAlgorithm
        ("," "root"      ":" root=RobotAnchorRef
            ("," "end"  ":" end=RobotAnchorRef)?
            "," "gravity" ":" "<" gravity=[WorldQuantity|ScopedName] ">" "equal to" gravity_value=ContextRef
        )?
    "}"
;

RobotRef:
    "<" environment_robot=EnvironmentRobotRef ">"
;

EnvironmentRobotRef:
    environment=[EnvironmentSpec|IRI_TRUNK] "." assembly=IRI_TRUNK
;

RobotAnchorRef:
    "<" environment_robot=EnvironmentRobotRef "." "chain" "." anchor=RobotAnchor ">"
;

RobotAnchor:
    "root" | "end"
;

SolverAlgorithm:
    "ACHD" | "RNE" | "CommandForwarding" | "VelocityDistribution" | "ForceDistribution"
;


// Compact DSL unit spellings only. Verbose QUDT spellings belong in JSON-LD,
// not authored .rob_mot files.
Unit:
    "rad/s" | "m/s3" | "m/s2" | "m/s" | "cm/s" | "deg/s" |
    "Nm"    | "rad"  | "deg" | "cm"   | "ms" | "m" | "s" | "N"
;


FQN: IRI_TRUNK+["."];
ScopedName: IRI_TRUNK+["."];
Import: "import" importURI=STRING;
Comment: /\/\/.*$/;
NamespaceDeclare: "ns" name=IRI_TRUNK "=" uri=STRING ;
IRI_TRUNK: /[^\d\W][\w-]*(?<![- ])/;
