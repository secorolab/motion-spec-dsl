// Motion Specification DSL Grammar

Model:
    imports*=Import
    namespaces*=NamespaceDeclare
    specs+=Specification
;

Specification:
    RobotSpec | MotionSpec | ConstraintHandler
;

RobotSpec:
    "ROBOT" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        "type" ":" type=RobotType ","
        (
            "model" ":" model=RobotModel ","
            "urdf" ":" urdf=STRING ","
            chain=RobotChainComponent
            |
            "urdf" ":" urdf=STRING ","
            base=RobotBaseComponent
            ("," "manipulators" ":" "{" manipulators+=RobotManipulatorComponent[","] "}")?
        )
    "}"
;

RobotType:
    "Manipulator" | "MobileBase" | "MobileManipulator"
;

RobotModel: "KinovaGen3" | "Kelo";

RobotBaseComponent:
    "base" ":" "{" "model" ":" model=RobotModel "," "chain" ":" "{" "root" ":" root=IRI_TRUNK "}" "}"
;

RobotChainComponent:
    "chain" ":" "{" "root" ":" root=IRI_TRUNK ("," "end" ":" end=IRI_TRUNK)? "}"
;

RobotManipulatorComponent:
    name=IRI_TRUNK ":" "{" "model" ":" model=RobotModel "," "chain" ":" "{" "root" ":" root=IRI_TRUNK "," "end" ":" end=IRI_TRUNK "}" "}"
;

MotionSpec:
    "MOTION_SPEC" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        ("MOVE"    ":" move=STRING)?
        "CONTEXT"  "{" context*=MotionContextDecl[","] "}"
        sections+=ConstraintSection
    "}"
;

ConstraintSection:
    WhenSection | WhileSection | UntilSection
;

WhenSection:  "WHEN"  "{" constraints*=ConstraintItem[","]? "}" ;
WhileSection: "WHILE" "{" constraints*=ConstraintItem[","]? "}" ;
UntilSection: "UNTIL" (logic=UntilLogic)? "{" constraints*=ConstraintItem[","]? "}" ;
UntilLogic:   "any" | "all" ;

ConstraintItem: ConstraintSpecification | ConstraintAlias | ConstraintReference ;
ConstraintAlias: name=IRI_TRUNK ":" "<" ref=ConstraintRef ">" ;
ConstraintReference: "<" ref=ConstraintRef ">" ;

MotionContextDecl:
    WorldContextDecl | PreContextDecl | SpecContextDecl | PostContextDecl
;

WorldContextDecl:
    name=IRI_TRUNK ":" "World" "{" declaration+=WorldQuantityItem[","] "}"
;

PreContextDecl:
    name=IRI_TRUNK ":" "Pre" "{" declaration+=ContextQuantityItem[","] "}"
;

SpecContextDecl:
    name=IRI_TRUNK ":" "Spec" "{" declaration+=ContextQuantityItem[","] "}"
;

PostContextDecl:
    name=IRI_TRUNK ":" "Post" "{" declaration+=ContextQuantityItem[","] "}"
;

WorldQuantityItem:
    WorldQuantityAlias | WorldQuantityReference | WorldQuantity
;

WorldQuantityAlias:
    name=IRI_TRUNK ":" "<" ref=[WorldQuantity|FQN] ">"
;

WorldQuantityReference:
    "<" ref=[WorldQuantity|FQN] ">"
;

ContextQuantityItem:
    ContextQuantityAlias | ContextQuantityReference | ContextQuantity
;

ContextQuantityAlias:
    name=IRI_TRUNK ":" "<" ref=[ContextQuantity|FQN] ">"
;

ContextQuantityReference:
    "<" ref=[ContextQuantity|FQN] ">"
;

WorldQuantity:
    name=IRI_TRUNK ":" type=WorldQuantityType
    ("{" props=GeometricProps "}")?
;

WorldQuantityType:
    "VelocityTwist"              |
    "Wrench"                     |
    "Pose"                       |
    "JointPosition"              |
    "KinematicChain"             |
    "Frame"                      |
    "Link"                       |
    "Gravity"
;

GeometricProps:
    pairs+=GeoPropPair[","]
;

GeoPropPair:
    (key=GeoPropKey ":" value=IRI_TRUNK)
;

GeoPropKey:
    "of" | "wrt" | "ref-point" | "as-seen-by"
;

ContextQuantity:
    name=IRI_TRUNK ":" type=ContextQuantityType value=ContextQuantityValue?
;

ContextQuantityType:
    QuantityType | SnapshotQuantityType
;

SnapshotQuantityType:
    "Pose" | "Position" | "Orientation"
;

ContextQuantityValue:
    QuantityValue | SnapshotValue
;

QuantityValue:
    ScalarQuantity | VectorQuantity
;

ScalarQuantity:
    "=" value=FLOAT unit=Unit
;

VectorQuantity:
    "{"
    "x" "=" x=FLOAT ","
    "y" "=" y=FLOAT ","
    "z" "=" z=FLOAT unit=Unit
    "}"
;

SnapshotValue:
    "=" "Snapshot" "of" source=View
;

QuantityType:
    "AngularVelocity" |
    "LinearVelocity"  |
    "Force"           |
    "Torque"          |
    "Distance"        |
    "LinearDistance"  |
    "Angle"           |
    "AngularDistance" |
    "Vector"
;

ConstraintSpecification:
    name=IRI_TRUNK ":" ("keeping")? view=View expr=ConstraintExpression
;

ConstraintExpression:
    EqualityConstraint | GreaterThanConstraint | LessThanConstraint | BilateralConstraint
;

View:
    (
        "distance" "between"
        "<" distance_from=[WorldQuantity|FQN] ">"
        "and"
        "<" distance_to=[WorldQuantity|FQN] ">"
    )
    |
    (
        "<" quantity=[WorldQuantity|FQN] ">"
        ("." subspace=SubSpace ("." axis=Axis)?)?
    )
;

SubSpace:
    "angvel"      |
    "linvel"      |
    "torque"      |
    "force"       |
    "orientation" |
    "position"
;

Axis:
    "x" | "y" | "z" | "roll" | "pitch" | "yaw"
;

ContextRef:
    "[" quantity=[ContextQuantity:FQN] literal_value=QuantityValue? "]"
  | "<" quantity=[ContextQuantity|ScopedName] ">"
  | context_scope=ContextScope "[" inline_quantity=ContextQuantity "]"
;

ContextScope:
    "Pre" | "Spec" | "Post"
;

EqualityConstraint:
    "equal" "to" reference=ContextRef
;

GreaterThanConstraint:
    ("greater" "than" | "is" "larger" "than" | "away" "from") threshold=ContextRef
;

LessThanConstraint:
    ("less" "than" | "is" "smaller" "than" | "up" "to") threshold=ContextRef
;

BilateralConstraint:
    "between" lower=ContextRef "and" upper=ContextRef
;


// Constraint Handler

ConstraintHandler:
    "CONSTRAINT_HANDLER" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        "CONTEXT"      "{" context*=HandlerContextDecl[","] "}"
        "MOTION"       ":" "<" motion=[MotionSpec|IRI_TRUNK] ">"
        ("MONITORS"    "{" monitors*=MonitorEntry[","]? "}")?
        "CONTROLLERS"  "{" controllers*=ControllerItem[","]? "}"
        "SOLVERS"      "{" solvers+=SolverItem[","] "}"
    "}"
;

ControllerItem:
    ControllerAlias | ControllerReference | ControllerEntry
;

ControllerAlias:
    name=IRI_TRUNK ":" "<" ref=ControllerRef ">"
;

ControllerReference:
    "<" ref=ControllerRef ">"
;

SolverItem:
    SolverAlias | SolverReference | SolverEntry
;

SolverAlias:
    name=IRI_TRUNK ":" "<" ref=SolverRef ">"
;

SolverReference:
    "<" ref=SolverRef ">"
;

HandlerContextDecl:
    WorldContextDecl | SpecContextDecl
;

MonitorEntry:
    name=IRI_TRUNK ":" "monitor" "<" constraint=ConstraintRef ">" "and"
    (
        ("trigger" "event" event=IRI_TRUNK "when" "active") |
        ("set" "flag" flag=IRI_TRUNK "while" "active")
    )
;

ControllerEntry:
    name=IRI_TRUNK ":" type="PID" "{"
        params=ControllerParams
    "}"
    ("as" command_type=QuantityType)?
    ("for" control_mode=ControllerMode)?
    ("apply" "at" "<" apply_at=[WorldQuantity|ScopedName] ">")?
    ("via" "<" solver=SolverRef ">")?
;

ControllerParams:
    "constraint" ":" "<" constraint=ConstraintRef ">" ","
    "Kp" "=" kp=FLOAT ","
    "Ki" "=" ki=FLOAT ","
    "Kd" "=" kd=FLOAT
    ("," "decay" ":" decay=FLOAT)?
;

ControllerMode:
    "Posture"
;

ConstraintRef:
    motion=[MotionSpec|IRI_TRUNK] "." constraint=[ConstraintSpecification|IRI_TRUNK]
;

ControllerRef:
    handler=[ConstraintHandler|IRI_TRUNK] "." controller=[ControllerEntry|IRI_TRUNK]
;

SolverRef:
    (handler=[ConstraintHandler|IRI_TRUNK] ".")? solver=[SolverEntry|IRI_TRUNK]
;

SolverEntry:
    name=IRI_TRUNK ":" "Solver" "{"
        "robot"     ":" robot=RobotRef ","
        "algorithm" ":" algorithm=SolverAlgorithm ","
        "root"      ":" root=RobotAnchorRef
        ("," "end"  ":" end=RobotAnchorRef)?
        "," "gravity" ":" "<" gravity=[WorldQuantity|ScopedName] ">" "equal to" gravity_value=ContextRef
    "}"
;

RobotRef:
    "<" (component=RobotComponentRef | robot=[RobotSpec|IRI_TRUNK]) ">"
;

RobotComponentRef:
    robot=[RobotSpec|IRI_TRUNK] "." component=IRI_TRUNK
;

RobotAnchorRef:
    "<" (
        robot=[RobotSpec|IRI_TRUNK] "." "chain" "." anchor=RobotAnchor
      | component=RobotComponentRef "." anchor=RobotAnchor
    ) ">"
;

RobotAnchor:
    "root" | "end"
;

SolverAlgorithm:
    "ACHD" | "RNE" | "VelocityDistribution" | "ForceDistribution"
;


// Compact DSL unit spellings only. Verbose QUDT spellings belong in JSON-LD,
// not authored .rob_mot files.
Unit:
    "rad/s" | "m/s2" | "m/s" | "cm/s" | "deg/s" |
    "Nm"    | "rad"  | "deg" | "cm"   | "m"     | "N"
;


FQN: IRI_TRUNK+["."];
ScopedName: IRI_TRUNK+["."];
Import: "import" importURI=STRING;
Comment: /\/\/.*$/;
NamespaceDeclare: "ns" name=IRI_TRUNK "=" uri=STRING ;
IRI_TRUNK: /[^\d\W][\w-]*(?<![- ])/;
