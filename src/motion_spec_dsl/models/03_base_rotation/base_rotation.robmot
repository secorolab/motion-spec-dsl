import "base_rotation.fsm"
import "../common/table_arm_sim.scenex"
ns app = "https://secorolab.github.io/models/base-rotation/"
ns fsm = "https://secorolab.github.io/models/base-rotation/fsm/"

exec-context (ns=app) base-rotation-exec {
    runs-scene: <table_arm_sim_scene_mjc>
    platform:   simulation { name: "MuJoCo" }
    config:     "robot.toml"
    timestep:   1.0 ms
}

context (ns=app) shared {
    world {
        pose pose-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        velocity-twist twist-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        velocity-twist twist-ee-tool {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <gripper.g_base.g_pinch>
        },
        joint-position joint-1 { joint: <kinova.joint_1>, normalization: (-pi, pi) rad },
        joint-position joint-2 { joint: <kinova.joint_2>, normalization: (-pi, pi) rad },
        joint-position joint-3 { joint: <kinova.joint_3>, normalization: (-pi, pi) rad },
        joint-position joint-4 { joint: <kinova.joint_4>, normalization: (-pi, pi) rad },
        joint-position joint-5 { joint: <kinova.joint_5>, normalization: (-pi, pi) rad },
        joint-position joint-6 { joint: <kinova.joint_6>, normalization: (-pi, pi) rad },
        joint-position joint-7 { joint: <kinova.joint_7>, normalization: (-pi, pi) rad }
    },
    spec {
        pose home-pose               = snapshot of <shared.world.pose-ee-base> on event <fsm.E_HOME_ENTERED>,
        pose look-pose               = [config.poses.look] for <shared.world.pose-ee-base>,
        // Gen3 joint_1 turns about -z of the base, so +120 deg turns the TCP -120 deg.
        angle q1-look                = 120 deg,
        angle q2-home                = 0.2618 rad,
        angle q3-home                = pi rad,
        angle q4-home                = -2.2689 rad,
        angle q5-home                = 0.0 rad,
        angle q6-home                = 0.9599 rad,
        angle q7-home                = pi / 2 rad,
        length position-band         = 0.02 m,
        angle orientation-band       = 0.05 rad,
        angle joint-band             = 2 deg,
        linear-velocity zero-linear  = 0.0 m/s,
        linear-velocity velocity-band = 0.005 m/s,
        angular-velocity zero-angular = 0.0 rad/s,
        angular-velocity angular-velocity-band = 0.01 rad/s,
        torque drive-limit           = 12.0 Nm,
        torque hold-limit            = 5.0 Nm,
        torque arm-torque-limit      = 35.0 Nm,
        torque elbow-torque-limit    = 10.0 Nm
    }
}

tolerances {
    position:         0.05 m,
    orientation:      0.05 rad,
    linear-velocity:  0.005 m/s,
    angular-velocity: 0.01 rad/s
}

guarded-motion (ns=app) home {
    description: "Hold the reset pose until the arm settles"
    context {}
    when {}
    while {
        hold-position:    keeping <shared.world.pose-ee-base>.position    equal to <shared.spec.home-pose>.position,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <shared.spec.home-pose>.orientation,
        hold-elbow:       keeping <shared.world.joint-3> equal to <shared.spec.q3-home>
    }
    until all {
        settled-x:  <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linear> within <shared.spec.velocity-band>,
        settled-y:  <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linear> within <shared.spec.velocity-band>,
        settled-z:  <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linear> within <shared.spec.velocity-band>,
        settled-rx: <shared.world.twist-ee-base>.angvel.x equal to <shared.spec.zero-angular> within <shared.spec.angular-velocity-band>,
        settled-ry: <shared.world.twist-ee-base>.angvel.y equal to <shared.spec.zero-angular> within <shared.spec.angular-velocity-band>,
        settled-rz: <shared.world.twist-ee-base>.angvel.z equal to <shared.spec.zero-angular> within <shared.spec.angular-velocity-band>
    }
}

guarded-motion (ns=app) joint-space {
    description: "Turn joint 1 by 120 degrees while holding joints 2 through 7"
    context { <shared.spec> }
    when {}
    while {
        drive-1: keeping <shared.world.joint-1> equal to <shared.spec.q1-look>,
        hold-2:  keeping <shared.world.joint-2> equal to <shared.spec.q2-home>,
        hold-3:  keeping <shared.world.joint-3> equal to <shared.spec.q3-home>,
        hold-4:  keeping <shared.world.joint-4> equal to <shared.spec.q4-home>,
        hold-5:  keeping <shared.world.joint-5> equal to <shared.spec.q5-home>,
        hold-6:  keeping <shared.world.joint-6> equal to <shared.spec.q6-home>,
        hold-7:  keeping <shared.world.joint-7> equal to <shared.spec.q7-home>
    }
    until all {
        at-position:    <shared.world.pose-ee-base>.position    equal to <shared.spec.look-pose>.position    within <shared.spec.position-band>,
        at-orientation: <shared.world.pose-ee-base>.orientation equal to <shared.spec.look-pose>.orientation within <shared.spec.orientation-band>
    }
}

guarded-motion (ns=app) cartesian-arc {
    description: "Follow the tool's arc back to the home pose"
    context {
        <shared.spec>,
        spec {
            pose start = snapshot of <shared.world.pose-ee-base> on event <fsm.E_ARC_ENTERED>,
            velocity-profile speed-profile = profile {
                max-velocity: 0.15 m/s,
                max-acceleration: 0.05 m/s^2,
                shape: trapezoidal
            },
            length arrive-band = 0.005 m,
            direction plane-normal { as-seen-by: <kinova.base_link.base_link_origin> } = (0.0, 0.0, -1.0),
            distance arc-height = 0.336836 m,
            path trajectory = arc {
                start: <spec.start>,
                end: <shared.spec.home-pose>,
                amplitude: <spec.arc-height>,
                plane-normal: <spec.plane-normal>
            }
        }
    }
    when {}
    while {
        tangent:     moving <shared.world.pose-ee-base> along <spec.trajectory> with <spec.speed-profile>,
        position:    keeping <shared.world.pose-ee-base>.position    on <spec.trajectory>,
        orientation: keeping <shared.world.pose-ee-base>.orientation on <spec.trajectory>,
        hold-elbow:  keeping <shared.world.joint-3> equal to <shared.spec.q3-home>
    }
    until all {
        at-position:    <shared.world.pose-ee-base>.position    equal to <shared.spec.home-pose>.position    within <spec.arrive-band>,
        at-orientation: <shared.world.pose-ee-base>.orientation equal to <shared.spec.home-pose>.orientation within <shared.spec.orientation-band>,
        stopped-x:  <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linear> within <shared.spec.velocity-band>,
        stopped-y:  <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linear> within <shared.spec.velocity-band>,
        stopped-z:  <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linear> within <shared.spec.velocity-band>,
        stopped-rx: <shared.world.twist-ee-base>.angvel.x equal to <shared.spec.zero-angular> within <shared.spec.angular-velocity-band>,
        stopped-ry: <shared.world.twist-ee-base>.angvel.y equal to <shared.spec.zero-angular> within <shared.spec.angular-velocity-band>,
        stopped-rz: <shared.world.twist-ee-base>.angvel.z equal to <shared.spec.zero-angular> within <shared.spec.angular-velocity-band>
    }
}

guarded-motion (ns=app) angular-velocity {
    description: "Turn about the base axis at a constant angular velocity to the look pose"
    context {
        spec {
            // In the pinch frame (x down, y along the sweep) a clockwise sweep is +x rate, -y travel.
            angular-velocity turn-rate = 0.0738 rad/s,
            linear-velocity travel-rate = -0.0497 m/s,
            length reach-band = 0.06 m,
            length target-x-lo = <shared.spec.look-pose>.position.x - <spec.reach-band>,
            length target-x-hi = <shared.spec.look-pose>.position.x + <spec.reach-band>,
            length target-y-lo = <shared.spec.look-pose>.position.y - <spec.reach-band>,
            length target-y-hi = <shared.spec.look-pose>.position.y + <spec.reach-band>
        }
    }
    when {}
    while {
        turn:        keeping <shared.world.twist-ee-tool>.angvel.x equal to <spec.turn-rate>,
        no-tilt-y:   keeping <shared.world.twist-ee-tool>.angvel.y equal to <shared.spec.zero-angular>,
        no-tilt-z:   keeping <shared.world.twist-ee-tool>.angvel.z equal to <shared.spec.zero-angular>,
        travel:      keeping <shared.world.twist-ee-tool>.linvel.y equal to <spec.travel-rate>,
        hold-height: keeping <shared.world.twist-ee-tool>.linvel.x equal to <shared.spec.zero-linear>,
        hold-radius: keeping <shared.world.twist-ee-tool>.linvel.z equal to <shared.spec.zero-linear>,
        hold-elbow:  keeping <shared.world.joint-3> equal to <shared.spec.q3-home>
    }
    until all {
        at-target-x: <shared.world.pose-ee-base>.position.x between <spec.target-x-lo> and <spec.target-x-hi>,
        at-target-y: <shared.world.pose-ee-base>.position.y between <spec.target-y-lo> and <spec.target-y-hi>
    }
}

// A state with no motion writes no torque, and nothing in this arm damps.
guarded-motion (ns=app) done {
    description: "Hold the look posture in joint space"
    context { <shared.spec> }
    when {}
    while {
        hold-1: keeping <shared.world.joint-1> equal to <shared.spec.q1-look>,
        hold-2: keeping <shared.world.joint-2> equal to <shared.spec.q2-home>,
        hold-3: keeping <shared.world.joint-3> equal to <shared.spec.q3-home>,
        hold-4: keeping <shared.world.joint-4> equal to <shared.spec.q4-home>,
        hold-5: keeping <shared.world.joint-5> equal to <shared.spec.q5-home>,
        hold-6: keeping <shared.world.joint-6> equal to <shared.spec.q6-home>,
        hold-7: keeping <shared.world.joint-7> equal to <shared.spec.q7-home>
    }
    until {
        settled: <shared.world.joint-1> equal to <shared.spec.q1-look> within <shared.spec.joint-band>
    }
}

constraint-handler (ns=app) handler-home {
    handles: <home>
    runs-in: <fsm.S_HOME>
    monitors {
        mon-home-settled: monitor <home.until> {
            satisfied for 0.3 s { trigger: event <fsm.E_HOME_SETTLED> }
        }
    }
    controllers {
        pid ctrl-home-hold-position    { constraint: <home.hold-position>,    Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-home-hold-orientation { constraint: <home.hold-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 },
        pid ctrl-home-hold-elbow {
            constraint: <home.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque
    }
    solvers {
        arm-achd-solver: serial-chain {
            agent:     <agents.arm1>,
            algorithm: achd,
            limits {   torque: saturation { max: <shared.spec.arm-torque-limit> } },
            gravity:   (0.0, 0.0, 9.81) m/s^2
        }
    }
}

constraint-handler (ns=app) handler-joint-space {
    handles: <joint-space>
    runs-in: <fsm.S_JOINT_SPACE>
    monitors {
        mon-joint-space-done: monitor <joint-space.until> {
            satisfied for 0.3 s { trigger: event <fsm.E_JOINT_SPACE_DONE> }
        }
    }
    controllers {
        // Kd, not Kp, is the speed limit: while saturated the turn settles at drive-limit / Kd.
        pid ctrl-joint-space-drive-1 { constraint: <joint-space.drive-1>, output-saturation: saturation { max: <shared.spec.drive-limit> }, Kp: 8,  Ki: 0, Kd: 40, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-joint-space-hold-2  { constraint: <joint-space.hold-2>,  output-saturation: saturation { max: <shared.spec.hold-limit> },  Kp: 20, Ki: 0, Kd: 8,  decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-joint-space-hold-3  { constraint: <joint-space.hold-3>,  output-saturation: saturation { max: <shared.spec.hold-limit> },  Kp: 20, Ki: 0, Kd: 8,  decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-joint-space-hold-4  { constraint: <joint-space.hold-4>,  output-saturation: saturation { max: <shared.spec.hold-limit> },  Kp: 20, Ki: 0, Kd: 8,  decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-joint-space-hold-5  { constraint: <joint-space.hold-5>,  output-saturation: saturation { max: <shared.spec.hold-limit> },  Kp: 20, Ki: 0, Kd: 8,  decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-joint-space-hold-6  { constraint: <joint-space.hold-6>,  output-saturation: saturation { max: <shared.spec.hold-limit> },  Kp: 20, Ki: 0, Kd: 8,  decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-joint-space-hold-7  { constraint: <joint-space.hold-7>,  output-saturation: saturation { max: <shared.spec.hold-limit> },  Kp: 20, Ki: 0, Kd: 8,  decay: 0, error-normalization: (-pi, pi) rad } as torque
    }
    solvers {
        arm-rne-solver: serial-chain {
            agent:     <agents.arm1>,
            algorithm: rne,
            gravity:   (0.0, 0.0, -9.81) m/s^2
        }
    }
}

constraint-handler (ns=app) handler-cartesian-arc {
    handles: <cartesian-arc>
    runs-in: <fsm.S_CARTESIAN_ARC>
    monitors {
        mon-cartesian-arc-done: monitor <cartesian-arc.until> {
            satisfied for 0.3 s { trigger: event <fsm.E_ARC_DONE> }
        }
    }
    controllers {
        pid ctrl-cartesian-arc-tangent     { constraint: <cartesian-arc.tangent>, Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        pid ctrl-cartesian-arc-position    { constraint: <cartesian-arc.position>,    measured-derivative: <shared.world.twist-ee-base>.linvel, Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-cartesian-arc-orientation { constraint: <cartesian-arc.orientation>, measured-derivative: <shared.world.twist-ee-base>.angvel, Kp: 120, Ki: 50,  Kd: 80, decay: 0 },
        pid ctrl-cartesian-arc-hold-elbow {
            constraint: <cartesian-arc.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque
    }
    solvers { <handler-home.arm-achd-solver> }
}

constraint-handler (ns=app) handler-angular-velocity {
    handles: <angular-velocity>
    runs-in: <fsm.S_ANGULAR_VELOCITY>
    monitors {
        mon-angular-velocity-done: monitor <angular-velocity.until> {
            satisfied for 0.3 s { trigger: event <fsm.E_ANGULAR_VELOCITY_DONE> }
        }
    }
    controllers {
        pid ctrl-angular-velocity-turn        { constraint: <angular-velocity.turn>,        Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        pid ctrl-angular-velocity-no-tilt-y   { constraint: <angular-velocity.no-tilt-y>,   Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        pid ctrl-angular-velocity-no-tilt-z   { constraint: <angular-velocity.no-tilt-z>,   Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        pid ctrl-angular-velocity-travel      { constraint: <angular-velocity.travel>,      Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        pid ctrl-angular-velocity-hold-height { constraint: <angular-velocity.hold-height>, Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        pid ctrl-angular-velocity-hold-radius { constraint: <angular-velocity.hold-radius>, Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        pid ctrl-angular-velocity-hold-elbow {
            constraint: <angular-velocity.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque
    }
    solvers { <handler-joint-space.arm-rne-solver> }
}

constraint-handler (ns=app) handler-done {
    handles: <done>
    runs-in: <fsm.S_DONE>
    monitors {
        mon-done-settled: monitor <done.until> {
            satisfied for 0.5 s { trigger: event <fsm.E_DONE_SETTLED> }
        }
    }
    controllers {
        pid ctrl-done-hold-1 { constraint: <done.hold-1>, output-saturation: saturation { max: <shared.spec.drive-limit> }, Kp: 20, Ki: 0, Kd: 8, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-done-hold-2 { constraint: <done.hold-2>, output-saturation: saturation { max: <shared.spec.hold-limit> },  Kp: 20, Ki: 0, Kd: 8, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-done-hold-3 { constraint: <done.hold-3>, output-saturation: saturation { max: <shared.spec.hold-limit> },  Kp: 20, Ki: 0, Kd: 8, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-done-hold-4 { constraint: <done.hold-4>, output-saturation: saturation { max: <shared.spec.hold-limit> },  Kp: 20, Ki: 0, Kd: 8, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-done-hold-5 { constraint: <done.hold-5>, output-saturation: saturation { max: <shared.spec.hold-limit> },  Kp: 20, Ki: 0, Kd: 8, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-done-hold-6 { constraint: <done.hold-6>, output-saturation: saturation { max: <shared.spec.hold-limit> },  Kp: 20, Ki: 0, Kd: 8, decay: 0, error-normalization: (-pi, pi) rad } as torque,
        pid ctrl-done-hold-7 { constraint: <done.hold-7>, output-saturation: saturation { max: <shared.spec.hold-limit> },  Kp: 20, Ki: 0, Kd: 8, decay: 0, error-normalization: (-pi, pi) rad } as torque
    }
    solvers { <handler-joint-space.arm-rne-solver> }
}
