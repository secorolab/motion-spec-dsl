ns fsm = "https://secorolab.github.io/models/arc-tracing-with-admittance/fsm/"

evt loop (ns=fsm) arc_tracing_with_admittance_fsm_events {
    evt E_STEP,
    evt E_RUN_STARTED,
    evt E_HOME_SETTLED,
    evt E_CONTACT,
    evt E_FORWARD_DONE,
    evt E_FORCE_DETECTED,
    evt E_FORCE_GONE,
    evt E_ARC_CONTACT,
    evt E_TABLE_CONTACT,
    evt E_HOME_ENTERED,
    evt E_TOUCHDOWN_ENTERED,
    evt E_FORWARD_ENTERED,
    evt E_ARC_STARTED,
    evt E_ARC_ENTERED,
    evt E_ADMITTANCE_ENTERED
}

fsm (ns=fsm) arc_tracing_with_admittance_fsm {
    description: "Home, descend to contact, move forward, trace an arc, yield to external force through admittance control, and trace a new arc to the target from where the push left the arm."

    states {
        S_START,
        S_HOME,
        S_TOUCHDOWN,
        S_FORWARD,
        S_ARC,
        S_ADMITTANCE,
        S_DONE
    }

    evt loop: <arc_tracing_with_admittance_fsm_events>

    start: <S_START>
    end:   <S_DONE>

    transitions {
        T_START_HOME        { from: <S_START>,      to: <S_HOME> },
        T_HOME_TOUCHDOWN    { from: <S_HOME>,       to: <S_TOUCHDOWN> },
        T_TOUCHDOWN_FORWARD { from: <S_TOUCHDOWN>,  to: <S_FORWARD> },
        T_FORWARD_ARC       { from: <S_FORWARD>,    to: <S_ARC> },
        T_ARC_ADMITTANCE    { from: <S_ARC>,        to: <S_ADMITTANCE> },
        T_ARC_DONE          { from: <S_ARC>,        to: <S_DONE> },
        T_ADMITTANCE_DONE   { from: <S_ADMITTANCE>, to: <S_DONE> },
        T_ADMITTANCE_ARC    { from: <S_ADMITTANCE>, to: <S_ARC> }
    }

    reactions {
        R_STEP_START {
            when: <arc_tracing_with_admittance_fsm_events.E_STEP>,
            do:   <T_START_HOME>,
            fires { <arc_tracing_with_admittance_fsm_events.E_RUN_STARTED>, <arc_tracing_with_admittance_fsm_events.E_HOME_ENTERED> }
        },
        R_HOME_SETTLED {
            when: <arc_tracing_with_admittance_fsm_events.E_HOME_SETTLED>,
            do:   <T_HOME_TOUCHDOWN>,
            fires { <arc_tracing_with_admittance_fsm_events.E_TOUCHDOWN_ENTERED> }
        },
        R_CONTACT {
            when: <arc_tracing_with_admittance_fsm_events.E_CONTACT>,
            do:   <T_TOUCHDOWN_FORWARD>,
            fires { <arc_tracing_with_admittance_fsm_events.E_FORWARD_ENTERED> }
        },
        R_FORWARD_DONE {
            when: <arc_tracing_with_admittance_fsm_events.E_FORWARD_DONE>,
            do:   <T_FORWARD_ARC>,
            fires { <arc_tracing_with_admittance_fsm_events.E_ARC_STARTED>, <arc_tracing_with_admittance_fsm_events.E_ARC_ENTERED> }
        },
        R_FORCE_DETECTED {
            when: <arc_tracing_with_admittance_fsm_events.E_FORCE_DETECTED>,
            do:   <T_ARC_ADMITTANCE>,
            fires { <arc_tracing_with_admittance_fsm_events.E_ADMITTANCE_ENTERED> }
        },
        R_ARC_CONTACT { when: <arc_tracing_with_admittance_fsm_events.E_ARC_CONTACT>, do: <T_ARC_DONE> },
        R_TABLE_CONTACT { when: <arc_tracing_with_admittance_fsm_events.E_TABLE_CONTACT>, do: <T_ADMITTANCE_DONE> },
        R_FORCE_GONE {
            when: <arc_tracing_with_admittance_fsm_events.E_FORCE_GONE>,
            do:   <T_ADMITTANCE_ARC>,
            fires { <arc_tracing_with_admittance_fsm_events.E_ARC_ENTERED> }
        }
    }
}
