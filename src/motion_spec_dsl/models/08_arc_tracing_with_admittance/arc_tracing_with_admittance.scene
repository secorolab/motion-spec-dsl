ns aas_env = "https://secorolab.github.io/models/environments/arc-tracing-with-admittance/"
ns aas_agn = "https://secorolab.github.io/models/agents/arc-tracing-with-admittance/"
ns aas_scene = "https://secorolab.github.io/models/scenes/arc-tracing-with-admittance/"

obj set (ns=aas_env) workspace_objects {
    object table
}

ws set (ns=aas_env) workspaces {
    workspace table_ws
}

agn set (ns=aas_agn) agents {
    agent kinova_ft_2f85
}

comp (ns=aas_env) table_workspace of ws <workspaces.table_ws> {
    obj <workspace_objects.table>
}

scene (ns=aas_scene) admittance_arc_scene {
    ws comp <table_workspace>
    agn set <agents>
}
