ns fsm = "https://secorolab.github.io/models/mobile-base-table-alignment/fsm/"

evt loop (ns=fsm) mobile_base_table_alignment_events {
    evt E_STEP,
    evt E_ALIGN_ENTERED,
    evt E_ALIGNED,
    evt E_CONTACT_LOST
}

fsm (ns=fsm) mobile_base_table_alignment_fsm {
    description: "Square the robot to the table it is holding, then stop."
    states { S_START, S_ALIGN, S_DONE }
    evt loop: <mobile_base_table_alignment_events>
    start: <S_START>
    end: <S_DONE>
    transitions {
        T_START_ALIGN { from: <S_START>, to: <S_ALIGN> },
        T_ALIGN_DONE  { from: <S_ALIGN>, to: <S_DONE> }
    }
    reactions {
        R_START {
            when: <mobile_base_table_alignment_events.E_STEP>,
            do:   <T_START_ALIGN>,
            fires { <mobile_base_table_alignment_events.E_ALIGN_ENTERED> }
        },
        R_ALIGNED { when: <mobile_base_table_alignment_events.E_ALIGNED>, do: <T_ALIGN_DONE> },
        R_CONTACT_LOST { when: <mobile_base_table_alignment_events.E_CONTACT_LOST>, do: <T_ALIGN_DONE> }
    }
}
