        pid ctrl-g2-normal { constraint: <grasp2.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        pid ctrl-g2-align { constraint: <grasp2.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        pid ctrl-g2-x { constraint: <grasp2.at-handle-x>, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-g2-y { constraint: <grasp2.at-handle-y>, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-g2-z { constraint: <grasp2.at-handle-z>, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        feed-forward ctrl-g2-gripper { constraint: <grasp2.close-gripper> } via <gripper1-solver>,

        pid ctrl-g2-elbow2 {
            constraint: <grasp2.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm2-solver>,
        pid ctrl-g2-align2 { constraint: <grasp2.align2-down>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-g2-spin2 { constraint: <grasp2.spin2>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-g2-x2 { constraint: <grasp2.hover2-x>, Kp: 150, Ki: 100, Kd: 30, decay: 0 } via <arm2-solver>,
        pid ctrl-g2-y2 { constraint: <grasp2.hover2-y>, Kp: 150, Ki: 100, Kd: 30, decay: 0 } via <arm2-solver>,
        feed-forward ctrl-g2-press { constraint: <grasp2.press2> } as force apply at <arm2_tree.press_pad> via <arm2-solver>
    }
    solvers {
        <handler-stage1.arm1-solver>,
        <handler-stage1.arm2-solver>,
        <handler-stage1.gripper1-solver>
    }
}

constraint-handler (ns=app) handler-pull2 {
    handles: <pull2>
