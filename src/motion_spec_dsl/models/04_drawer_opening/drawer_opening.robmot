            satisfied { trigger: event <dro.E_OPENED2> }
        },
        mon-overtravel2: monitor <pull2.overtravel> {
            satisfied { trigger: event <dro.E_OVERTRAVEL2> }
        },
        mon-grasp-lost2: monitor <pull2.grasp-lost> {
            satisfied for 0.1 s { trigger: event <dro.E_GRASP_LOST2> }
        },
        mon-press-lost2: monitor <pull2.press-lost> {
            satisfied for 0.1 s { trigger: event <dro.E_PRESS_LOST2> }
