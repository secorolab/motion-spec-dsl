// Borghesan et al. 2016, sec. VII: {o1a} the handle, {o2} the grasp frame.
import "drawer_opening.fsm"
import "drawer_opening.scenex"
ns app = "https://secorolab.github.io/models/drawer-opening/"
ns dro = "https://secorolab.github.io/models/drawer-opening/fsm/"

exec-context (ns=app) drawer-opening-exec {
    runs-scene: <drawer_scene_mjc>
    platform:   simulation { name: "MuJoCo" }
    config:     "robot.toml"
    timestep:   1.0 ms
}

tolerances {
    position:    0.01 m,
    orientation: 0.05 rad
}

context (ns=app) shared {
    world {
        pose pose-grasp {
            of:         <gripper1.g_base.g_pinch>,
            wrt:        <kinova1.base_link.base_link_origin>,
            as-seen-by: <kinova1.base_link.base_link_origin>
        },
        velocity-twist twist-grasp {
            of:         <gripper1.g_base.g_pinch>,
            wrt:        <kinova1.base_link.base_link_origin>,
            as-seen-by: <kinova1.base_link.base_link_origin>
        },
        pose pose-handle1 {
            of:         <drawer_graph.cabinet1.cabinet1_handle2>,
            wrt:        <kinova1.base_link.base_link_origin>,
            as-seen-by: <kinova1.base_link.base_link_origin>
        },
        pose pose-handle2 {
            of:         <drawer_graph.cabinet2.cabinet2_handle2>,
            wrt:        <kinova1.base_link.base_link_origin>,
            as-seen-by: <kinova1.base_link.base_link_origin>
        },
        joint-position gripper-pos {
            joint: <gripper1.g_left_driver_joint>
        },
        // The redundant joint: left free, the forearm sags onto the table.
        joint-position elbow1-angle {
            joint: <kinova1.joint_3>,
            normalization: (-pi, pi) rad
        },

        pose pose-flange2 {
            of:         <arm2_tree.press_pad.press_pad_origin>,
            wrt:        <kinova2.base_link.base_link_origin>,
            as-seen-by: <kinova2.base_link.base_link_origin>
        },
        wrench press-wrench {
            of:         <arm2_tree.press_pad.press_pad_origin>,
            ref-point:  <arm2_tree.press_pad.press_pad_origin>,
            as-seen-by: <kinova2.base_link.base_link_origin>
        },
        pose pose-press {
            of:         <drawer_graph.cabinet2.press_point>,
            wrt:        <kinova2.base_link.base_link_origin>,
            as-seen-by: <kinova2.base_link.base_link_origin>
        },
        joint-position elbow2-angle {
            joint: <kinova2.joint_3>,
            normalization: (-pi, pi) rad
        }
    },
    spec {
        // The 2f85 pads close along the pinch frame's y.
        direction grasp-normal { as-seen-by: <gripper1.g_base.g_pinch> } = (0, 1, 0),
        direction approach-axis { as-seen-by: <gripper1.g_base.g_pinch> } = (0, 0, 1),
        direction drawer-inward { as-seen-by: <kinova1.base_link.base_link_origin> } = (1, 0, 0),

        // Constants in the base frame: a solver reaches only frames on the arm's chain.
        direction handle-x-base { as-seen-by: <kinova1.base_link.base_link_origin> } = (-1, 0, 0),
        direction handle-y-base { as-seen-by: <kinova1.base_link.base_link_origin> } = (0, 0, -1),
        direction handle-z-base { as-seen-by: <kinova1.base_link.base_link_origin> } = (0, -1, 0),

        line handle1-hx { of: <drawer_graph.cabinet1.cabinet1_handle2>, along: <shared.spec.handle-x-base> },
        line handle1-hy { of: <drawer_graph.cabinet1.cabinet1_handle2>, along: <shared.spec.handle-y-base> },
        line handle1-hz { of: <drawer_graph.cabinet1.cabinet1_handle2>, along: <shared.spec.handle-z-base> },
        line handle2-hx { of: <drawer_graph.cabinet2.cabinet2_handle2>, along: <shared.spec.handle-x-base> },
        line handle2-hy { of: <drawer_graph.cabinet2.cabinet2_handle2>, along: <shared.spec.handle-y-base> },
        line handle2-hz { of: <drawer_graph.cabinet2.cabinet2_handle2>, along: <shared.spec.handle-z-base> },

        direction flange2-axis { as-seen-by: <arm2_tree.press_pad.press_pad_origin> } = (0, 0, 1),
        direction flange2-x { as-seen-by: <arm2_tree.press_pad.press_pad_origin> } = (1, 0, 0),
        direction down2 { as-seen-by: <kinova2.base_link.base_link_origin> } = (0, 0, -1),
        direction base2-y { as-seen-by: <kinova2.base_link.base_link_origin> } = (0, 1, 0),

        length at-handle    = 0.0 m,
        // The fingertips reach 27 mm past the pinch, exactly the bar-to-face distance.
        length grasp-standoff = 0.01 m,
        length reach-band   = 0.01 m,
        // At 3 mm the bar cams out of the closing pads.
        length center-band  = 0.002 m,
        length pre-dist     = 0.08 m,
        length pre-band     = 0.01 m,
        // Far enough out that the move to cabinet 2 clears cabinet 1, which slid out ~8 cm.
        length retreat-dist = 0.20 m,
        // 6 cm past the standoff: further out the drawer pitches on the shelf edge and jams.
        length pull-out     = 0.07 m,
        // Past one drawer length of travel the cabinet is coming along (cabinet.xml drawer box).
        length drawer-length = 0.124 m,
        // Along -x of the base: out of the cabinet.
        linear-velocity pull-velocity   = -0.05 m/s,
        linear-velocity pull-speed-band = 0.01 m/s,

        // ~1 mm into the 0.3007 m shelf: a deeper, stiffer descent slides the free cabinet.
        length hover-z      = 0.360 m,
        length press-z      = 0.2995 m,
        length press-gate-z = 0.3050 m,
        length hold-band    = 0.01 m,
        // Enough normal load that the pressed cabinet out-holds drawer 2's ~47 N.
        force press-force      = -50.0 N,
        force press-force-band = 5.0 N,

        angle aligned    = 1.5708 rad,
        angle align-band = 0.05 rad,
        angular-acceleration ori-acc-limit      = 50.0 rad/s^2,
        angular-acceleration ori-integral-limit = 10.0 rad/s^2,
        linear-acceleration pos-integral-limit = 0.5 m/s^2,
        linear-acceleration press-integral-limit = 4.0 m/s^2,
        // Moving sideways swings joints 1 and 5 together; faster than this they pass 2 rad/s.
        linear-acceleration transfer-acc-limit = 0.3 m/s^2,

        angle gripper-open    = 0.0 rad,
        angle gripper-closed  = 0.8 rad,
        angle gripper-band    = 0.05 rad,
        // Fully open, the upper finger hits the shelf above the bar.
        angle gripper-preclose = 0.45 rad,
        // Closing on air runs past the upper bound.
        angle grip-on-bar-lo  = 0.2 rad,
        angle grip-on-bar-hi  = 0.72 rad,

        angle elbow-angle-target  = pi rad,
        torque elbow-torque-limit = 10.0 Nm
    }
}

guarded-motion (ns=app) stage1 {
    description: "Arm 1 stages in front of cabinet 1's handle; arm 2 holds where it is"

    context {
        spec {
            length park2-x = snapshot of <shared.world.pose-flange2>.position.x on event <dro.E_STAGE1_ENTERED>,
            length park2-y = snapshot of <shared.world.pose-flange2>.position.y on event <dro.E_STAGE1_ENTERED>,
            length park2-z = snapshot of <shared.world.pose-flange2>.position.z on event <dro.E_STAGE1_ENTERED>
        }
    }

    when {}

    while {
        hold1-elbow: keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-pre-x: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle1-hx> equal to <shared.spec.pre-dist> within <shared.spec.reach-band>,
        at-handle-y: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle1-hy> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle1-hz> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        preclose-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-preclose> within <shared.spec.gripper-band>,

        hold2-elbow: keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>,
        align2-down: keeping angle between <shared.spec.flange2-axis> and <shared.spec.down2> equal to 0 rad,
        spin2: keeping angle between <shared.spec.flange2-x> and <shared.spec.base2-y> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        park2-x: keeping <shared.world.pose-flange2>.position.x equal to <spec.park2-x> within <shared.spec.hold-band>,
        park2-y: keeping <shared.world.pose-flange2>.position.y equal to <spec.park2-y> within <shared.spec.hold-band>,
        park2-z: keeping <shared.world.pose-flange2>.position.z equal to <spec.park2-z> within <shared.spec.hold-band>
    }

    until {
        at-pre: distance between <shared.world.pose-grasp> and <shared.world.pose-handle1> equal to <shared.spec.pre-dist> within <shared.spec.pre-band>
    }
}

guarded-motion (ns=app) approach1 {
    description: "Arm 1 slides onto cabinet 1's bar"

    context { }

    when {}

    while {
        hold1-elbow: keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-handle-x: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle1-hx> equal to <shared.spec.grasp-standoff> within <shared.spec.reach-band>,
        at-handle-y: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle1-hy> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle1-hz> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        preclose-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-preclose> within <shared.spec.gripper-band>,

        hold2-elbow: keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>,
        align2-down: keeping angle between <shared.spec.flange2-axis> and <shared.spec.down2> equal to 0 rad,
        spin2: keeping angle between <shared.spec.flange2-x> and <shared.spec.base2-y> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        park2-x: keeping <shared.world.pose-flange2>.position.x equal to <stage1.spec.park2-x> within <shared.spec.hold-band>,
        park2-y: keeping <shared.world.pose-flange2>.position.y equal to <stage1.spec.park2-y> within <shared.spec.hold-band>,
        park2-z: keeping <shared.world.pose-flange2>.position.z equal to <stage1.spec.park2-z> within <shared.spec.hold-band>
    }

    until all {
        centered-x: projection of <shared.world.pose-grasp> on <shared.spec.handle1-hx> equal to <shared.spec.grasp-standoff> within <shared.spec.center-band>,
        centered-y: projection of <shared.world.pose-grasp> on <shared.spec.handle1-hy> equal to <shared.spec.at-handle> within <shared.spec.center-band>,
        centered-z: projection of <shared.world.pose-grasp> on <shared.spec.handle1-hz> equal to <shared.spec.at-handle> within <shared.spec.center-band>
    }
}

guarded-motion (ns=app) grasp1 {
    description: "Arm 1 closes on cabinet 1's bar"

    context { }

    when {}

    while {
        hold1-elbow: keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-handle-x: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle1-hx> equal to <shared.spec.grasp-standoff> within <shared.spec.reach-band>,
        at-handle-y: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle1-hy> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle1-hz> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        close-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.gripper-band>,

        hold2-elbow: keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>,
        align2-down: keeping angle between <shared.spec.flange2-axis> and <shared.spec.down2> equal to 0 rad,
        spin2: keeping angle between <shared.spec.flange2-x> and <shared.spec.base2-y> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        park2-x: keeping <shared.world.pose-flange2>.position.x equal to <stage1.spec.park2-x> within <shared.spec.hold-band>,
        park2-y: keeping <shared.world.pose-flange2>.position.y equal to <stage1.spec.park2-y> within <shared.spec.hold-band>,
        park2-z: keeping <shared.world.pose-flange2>.position.z equal to <stage1.spec.park2-z> within <shared.spec.hold-band>
    }

    until {
        grasped all {
            grasped-on-bar: <shared.world.gripper-pos> between <shared.spec.grip-on-bar-lo> and <shared.spec.grip-on-bar-hi>
        },
        missed any {
            closed-on-air: <shared.world.gripper-pos> greater than <shared.spec.grip-on-bar-hi>
        }
    }
}

guarded-motion (ns=app) pull1 {
    description: "Arm 1 pulls cabinet 1's drawer while nothing holds the cabinet"

    context {
        spec {
            pose grasp-start = snapshot of <shared.world.pose-grasp> on event <dro.E_PULL1_ENTERED>
        }
    }

    when {}

    while {
        hold1-elbow: keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        pull-speed: keeping <shared.world.twist-grasp>.linvel.x equal to <shared.spec.pull-velocity> within <shared.spec.pull-speed-band>,
        at-handle-y: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle1-hy> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle1-hz> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        close-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.gripper-band>,

        hold2-elbow: keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>,
        align2-down: keeping angle between <shared.spec.flange2-axis> and <shared.spec.down2> equal to 0 rad,
        spin2: keeping angle between <shared.spec.flange2-x> and <shared.spec.base2-y> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        park2-x: keeping <shared.world.pose-flange2>.position.x equal to <stage1.spec.park2-x> within <shared.spec.hold-band>,
        park2-y: keeping <shared.world.pose-flange2>.position.y equal to <stage1.spec.park2-y> within <shared.spec.hold-band>,
        park2-z: keeping <shared.world.pose-flange2>.position.z equal to <stage1.spec.park2-z> within <shared.spec.hold-band>
    }

    until {
        opened all {
            opened-out: projection of <shared.world.pose-grasp> on <shared.spec.handle1-hx> greater than <shared.spec.pull-out>
        },
        overtravel any {
            travelled: distance between <shared.world.pose-grasp> and <spec.grasp-start> greater than <shared.spec.drawer-length>
        },
        grasp-lost any {
            off-bar: <shared.world.gripper-pos> outside <shared.spec.grip-on-bar-lo> and <shared.spec.grip-on-bar-hi>
        }
    }
}

guarded-motion (ns=app) retreat1 {
    description: "Arm 1 lets go of cabinet 1's bar and backs out to its staging point"

    context { }

    when {}

    while {
        hold1-elbow: keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        back-out-x: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle1-hx> equal to <shared.spec.retreat-dist> within <shared.spec.reach-band>,
        at-handle-y: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle1-hy> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle1-hz> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        open-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-open> within <shared.spec.gripper-band>,

        hold2-elbow: keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>,
        align2-down: keeping angle between <shared.spec.flange2-axis> and <shared.spec.down2> equal to 0 rad,
        spin2: keeping angle between <shared.spec.flange2-x> and <shared.spec.base2-y> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        park2-x: keeping <shared.world.pose-flange2>.position.x equal to <stage1.spec.park2-x> within <shared.spec.hold-band>,
        park2-y: keeping <shared.world.pose-flange2>.position.y equal to <stage1.spec.park2-y> within <shared.spec.hold-band>,
        park2-z: keeping <shared.world.pose-flange2>.position.z equal to <stage1.spec.park2-z> within <shared.spec.hold-band>
    }

    until {
        backed-out: projection of <shared.world.pose-grasp> on <shared.spec.handle1-hx> equal to <shared.spec.retreat-dist> within <shared.spec.pre-band>
    }
}

guarded-motion (ns=app) stage2 {
    description: "Arm 1 stages in front of cabinet 2's handle; arm 2 hovers over cabinet 2"

    context {
        spec {
            length press-x = snapshot of <shared.world.pose-press>.position.x on event <dro.E_STAGE2_ENTERED>,
            length press-y = snapshot of <shared.world.pose-press>.position.y on event <dro.E_STAGE2_ENTERED>
        }
    }

    when {}

    while {
        hold1-elbow: keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-pre-x: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle2-hx> equal to <shared.spec.pre-dist> within <shared.spec.reach-band>,
        at-handle-y: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle2-hy> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle2-hz> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        preclose-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-preclose> within <shared.spec.gripper-band>,

        hold2-elbow: keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>,
        align2-down: keeping angle between <shared.spec.flange2-axis> and <shared.spec.down2> equal to 0 rad,
        spin2: keeping angle between <shared.spec.flange2-x> and <shared.spec.base2-y> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        hover2-x: keeping <shared.world.pose-flange2>.position.x equal to <spec.press-x> within <shared.spec.hold-band>,
        hover2-y: keeping <shared.world.pose-flange2>.position.y equal to <spec.press-y> within <shared.spec.hold-band>,
        hover2-z: keeping <shared.world.pose-flange2>.position.z equal to <shared.spec.hover-z> within <shared.spec.hold-band>
    }

    until all {
        staged2-x: <shared.world.pose-flange2>.position.x equal to <spec.press-x> within <shared.spec.hold-band>,
        staged2-z: <shared.world.pose-flange2>.position.z equal to <shared.spec.hover-z> within <shared.spec.hold-band>,
        staged1: distance between <shared.world.pose-grasp> and <shared.world.pose-handle2> equal to <shared.spec.pre-dist> within <shared.spec.pre-band>
    }
}

guarded-motion (ns=app) press2 {
    description: "Arm 2 descends onto cabinet 2's top; arm 1 holds at the staging point"

    context { }

    when {}

    while {
        hold1-elbow: keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-pre-x: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle2-hx> equal to <shared.spec.pre-dist> within <shared.spec.reach-band>,
        at-handle-y: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle2-hy> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle2-hz> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        preclose-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-preclose> within <shared.spec.gripper-band>,

        hold2-elbow: keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>,
        align2-down: keeping angle between <shared.spec.flange2-axis> and <shared.spec.down2> equal to 0 rad,
        spin2: keeping angle between <shared.spec.flange2-x> and <shared.spec.base2-y> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        hover2-x: keeping <shared.world.pose-flange2>.position.x equal to <stage2.spec.press-x> within <shared.spec.hold-band>,
        hover2-y: keeping <shared.world.pose-flange2>.position.y equal to <stage2.spec.press-y> within <shared.spec.hold-band>,
        descend2-z: keeping <shared.world.pose-flange2>.position.z equal to <shared.spec.press-z> within <shared.spec.hold-band>
    }

    until {
        pressed: <shared.world.pose-flange2>.position.z less than <shared.spec.press-gate-z>
    }
}

guarded-motion (ns=app) approach2 {
    description: "Arm 1 slides onto cabinet 2's bar under the held press"

    context { }

    when {}

    while {
        hold1-elbow: keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-handle-x: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle2-hx> equal to <shared.spec.grasp-standoff> within <shared.spec.reach-band>,
        at-handle-y: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle2-hy> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle2-hz> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        preclose-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-preclose> within <shared.spec.gripper-band>,

        hold2-elbow: keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>,
        align2-down: keeping angle between <shared.spec.flange2-axis> and <shared.spec.down2> equal to 0 rad,
        spin2: keeping angle between <shared.spec.flange2-x> and <shared.spec.base2-y> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        hover2-x: keeping <shared.world.pose-flange2>.position.x equal to <stage2.spec.press-x> within <shared.spec.hold-band>,
        hover2-y: keeping <shared.world.pose-flange2>.position.y equal to <stage2.spec.press-y> within <shared.spec.hold-band>,
        press2: keeping <shared.world.press-wrench>.force.z equal to <shared.spec.press-force> within <shared.spec.press-force-band>
    }

    until all {
        centered-x: projection of <shared.world.pose-grasp> on <shared.spec.handle2-hx> equal to <shared.spec.grasp-standoff> within <shared.spec.center-band>,
        centered-y: projection of <shared.world.pose-grasp> on <shared.spec.handle2-hy> equal to <shared.spec.at-handle> within <shared.spec.center-band>,
        centered-z: projection of <shared.world.pose-grasp> on <shared.spec.handle2-hz> equal to <shared.spec.at-handle> within <shared.spec.center-band>
    }
}

guarded-motion (ns=app) grasp2 {
    description: "Arm 1 closes on cabinet 2's bar under the held press"

    context { }

    when {}

    while {
        hold1-elbow: keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-handle-x: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle2-hx> equal to <shared.spec.grasp-standoff> within <shared.spec.reach-band>,
        at-handle-y: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle2-hy> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle2-hz> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        close-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.gripper-band>,

        hold2-elbow: keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>,
        align2-down: keeping angle between <shared.spec.flange2-axis> and <shared.spec.down2> equal to 0 rad,
        spin2: keeping angle between <shared.spec.flange2-x> and <shared.spec.base2-y> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        hover2-x: keeping <shared.world.pose-flange2>.position.x equal to <stage2.spec.press-x> within <shared.spec.hold-band>,
        hover2-y: keeping <shared.world.pose-flange2>.position.y equal to <stage2.spec.press-y> within <shared.spec.hold-band>,
        press2: keeping <shared.world.press-wrench>.force.z equal to <shared.spec.press-force> within <shared.spec.press-force-band>
    }

    until {
        grasped all {
            grasped-on-bar: <shared.world.gripper-pos> between <shared.spec.grip-on-bar-lo> and <shared.spec.grip-on-bar-hi>
        },
        missed any {
            closed-on-air: <shared.world.gripper-pos> greater than <shared.spec.grip-on-bar-hi>
        }
    }
}

guarded-motion (ns=app) pull2 {
    description: "Arm 1 pulls cabinet 2's drawer while arm 2 holds the cabinet down"

    context {
        spec {
            pose grasp-start = snapshot of <shared.world.pose-grasp> on event <dro.E_PULL2_ENTERED>
        }
    }

    when {}

    while {
        hold1-elbow: keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        pull-speed: keeping <shared.world.twist-grasp>.linvel.x equal to <shared.spec.pull-velocity> within <shared.spec.pull-speed-band>,
        at-handle-y: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle2-hy> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle2-hz> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        close-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.gripper-band>,

        hold2-elbow: keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>,
        align2-down: keeping angle between <shared.spec.flange2-axis> and <shared.spec.down2> equal to 0 rad,
        spin2: keeping angle between <shared.spec.flange2-x> and <shared.spec.base2-y> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        hover2-x: keeping <shared.world.pose-flange2>.position.x equal to <stage2.spec.press-x> within <shared.spec.hold-band>,
        hover2-y: keeping <shared.world.pose-flange2>.position.y equal to <stage2.spec.press-y> within <shared.spec.hold-band>,
        press2: keeping <shared.world.press-wrench>.force.z equal to <shared.spec.press-force> within <shared.spec.press-force-band>
    }

    until {
        opened all {
            opened-out: projection of <shared.world.pose-grasp> on <shared.spec.handle2-hx> greater than <shared.spec.pull-out>
        },
        overtravel any {
            travelled: distance between <shared.world.pose-grasp> and <spec.grasp-start> greater than <shared.spec.drawer-length>
        },
        grasp-lost any {
            off-bar: <shared.world.gripper-pos> outside <shared.spec.grip-on-bar-lo> and <shared.spec.grip-on-bar-hi>
        },
        press-lost any {
            lifted: <shared.world.pose-flange2>.position.z greater than <shared.spec.press-gate-z>
        }
    }
}

guarded-motion (ns=app) release {
    description: "Open the gripper; both arms hold where they are"

    context {
        spec {
            length grasp-x0 = snapshot of <shared.world.pose-grasp>.position.x on event <dro.E_RELEASE_ENTERED>,
            length grasp-y0 = snapshot of <shared.world.pose-grasp>.position.y on event <dro.E_RELEASE_ENTERED>,
            length grasp-z0 = snapshot of <shared.world.pose-grasp>.position.z on event <dro.E_RELEASE_ENTERED>,
            length flange2-x0 = snapshot of <shared.world.pose-flange2>.position.x on event <dro.E_RELEASE_ENTERED>,
            length flange2-y0 = snapshot of <shared.world.pose-flange2>.position.y on event <dro.E_RELEASE_ENTERED>,
            length flange2-z0 = snapshot of <shared.world.pose-flange2>.position.z on event <dro.E_RELEASE_ENTERED>
        }
    }

    when {}

    while {
        hold1-elbow: keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        hold1-x: keeping <shared.world.pose-grasp>.position.x equal to <spec.grasp-x0> within <shared.spec.hold-band>,
        hold1-y: keeping <shared.world.pose-grasp>.position.y equal to <spec.grasp-y0> within <shared.spec.hold-band>,
        hold1-z: keeping <shared.world.pose-grasp>.position.z equal to <spec.grasp-z0> within <shared.spec.hold-band>,
        open-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-open> within <shared.spec.gripper-band>,

        hold2-elbow: keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>,
        align2-down: keeping angle between <shared.spec.flange2-axis> and <shared.spec.down2> equal to 0 rad,
        spin2: keeping angle between <shared.spec.flange2-x> and <shared.spec.base2-y> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        hold2-x: keeping <shared.world.pose-flange2>.position.x equal to <spec.flange2-x0> within <shared.spec.hold-band>,
        hold2-y: keeping <shared.world.pose-flange2>.position.y equal to <spec.flange2-y0> within <shared.spec.hold-band>,
        hold2-z: keeping <shared.world.pose-flange2>.position.z equal to <spec.flange2-z0> within <shared.spec.hold-band>
    }

    until {
        opened-gripper: <shared.world.gripper-pos> equal to <shared.spec.gripper-open> within <shared.spec.gripper-band>
    }
}

constraint-handler (ns=app) handler-stage1 {
    handles: <stage1>
    runs-in: <dro.S_STAGE1>
    monitors {
        mon-at-pre1: monitor <stage1.until> {
            satisfied for 0.5 s { trigger: event <dro.E_AT_PRE1> }
        }
    }
    controllers {
        pid ctrl-s1-elbow1 {
            constraint: <stage1.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm1-solver>,
        pid ctrl-s1-normal { constraint: <stage1.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        pid ctrl-s1-align { constraint: <stage1.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        pid ctrl-s1-x { constraint: <stage1.at-pre-x>, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-s1-y { constraint: <stage1.at-handle-y>, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-s1-z { constraint: <stage1.at-handle-z>, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        feed-forward ctrl-s1-gripper { constraint: <stage1.preclose-gripper> } via <gripper1-solver>,

        pid ctrl-s1-elbow2 {
            constraint: <stage1.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm2-solver>,
        pid ctrl-s1-align2 { constraint: <stage1.align2-down>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-s1-spin2 { constraint: <stage1.spin2>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-s1-x2 { constraint: <stage1.park2-x>, Kp: 80, Ki: 0, Kd: 24, decay: 0 } via <arm2-solver>,
        pid ctrl-s1-y2 { constraint: <stage1.park2-y>, integral-saturation: saturation { max: <shared.spec.pos-integral-limit> }, Kp: 80, Ki: 40, Kd: 24, decay: 0 } via <arm2-solver>,
        pid ctrl-s1-z2 { constraint: <stage1.park2-z>, integral-saturation: saturation { max: <shared.spec.pos-integral-limit> }, Kp: 80, Ki: 40, Kd: 24, decay: 0 } via <arm2-solver>
    }
    solvers {
        arm1-solver: serial-chain {
            agent:     <drawer_agents.arm1>,
            algorithm: achd,
            gravity:   (0.0, 0.0, 9.81) m/s^2
        },
        arm2-solver: serial-chain {
            agent:     <drawer_agents.arm2>,
            algorithm: achd,
            gravity:   (0.0, 0.0, 9.81) m/s^2
        },
        gripper1-solver: command-forwarding {
            agent: <drawer_agents.gripper1>
        }
    }
}

constraint-handler (ns=app) handler-approach1 {
    handles: <approach1>
    runs-in: <dro.S_APPROACH1>
    monitors {
        mon-at-handle1: monitor <approach1.until> {
            satisfied for 0.3 s { trigger: event <dro.E_AT_HANDLE1> }
        }
    }
    controllers {
        pid ctrl-a1-elbow1 {
            constraint: <approach1.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm1-solver>,
        pid ctrl-a1-normal { constraint: <approach1.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        pid ctrl-a1-align { constraint: <approach1.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        // No gravity load on x and z: an integral there only winds up on the slide-in.
        pid ctrl-a1-x { constraint: <approach1.at-handle-x>, Kp: 80, Ki: 0, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-a1-y { constraint: <approach1.at-handle-y>, integral-saturation: saturation { max: <shared.spec.pos-integral-limit> }, Kp: 80, Ki: 80, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-a1-z { constraint: <approach1.at-handle-z>, Kp: 80, Ki: 0, Kd: 24, decay: 0 } via <arm1-solver>,
        feed-forward ctrl-a1-gripper { constraint: <approach1.preclose-gripper> } via <gripper1-solver>,

        pid ctrl-a1-elbow2 {
            constraint: <approach1.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm2-solver>,
        pid ctrl-a1-align2 { constraint: <approach1.align2-down>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-a1-spin2 { constraint: <approach1.spin2>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-a1-x2 { constraint: <approach1.park2-x>, Kp: 80, Ki: 0, Kd: 24, decay: 0 } via <arm2-solver>,
        pid ctrl-a1-y2 { constraint: <approach1.park2-y>, integral-saturation: saturation { max: <shared.spec.pos-integral-limit> }, Kp: 80, Ki: 40, Kd: 24, decay: 0 } via <arm2-solver>,
        pid ctrl-a1-z2 { constraint: <approach1.park2-z>, integral-saturation: saturation { max: <shared.spec.pos-integral-limit> }, Kp: 80, Ki: 40, Kd: 24, decay: 0 } via <arm2-solver>
    }
    solvers {
        <handler-stage1.arm1-solver>,
        <handler-stage1.arm2-solver>,
        <handler-stage1.gripper1-solver>
    }
}

constraint-handler (ns=app) handler-grasp1 {
    handles: <grasp1>
    runs-in: <dro.S_GRASP1>
    monitors {
        mon-grasped1: monitor <grasp1.grasped> {
            satisfied for 0.5 s { trigger: event <dro.E_GRASPED1> }
        },
        mon-missed1: monitor <grasp1.missed> {
            satisfied for 0.2 s { trigger: event <dro.E_GRASP_MISSED1> }
        }
    }
    controllers {
        pid ctrl-g1-elbow1 {
            constraint: <grasp1.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm1-solver>,
        pid ctrl-g1-normal { constraint: <grasp1.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        pid ctrl-g1-align { constraint: <grasp1.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        pid ctrl-g1-x { constraint: <grasp1.at-handle-x>, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-g1-y { constraint: <grasp1.at-handle-y>, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-g1-z { constraint: <grasp1.at-handle-z>, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        feed-forward ctrl-g1-gripper { constraint: <grasp1.close-gripper> } via <gripper1-solver>,

        pid ctrl-g1-elbow2 {
            constraint: <grasp1.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm2-solver>,
        pid ctrl-g1-align2 { constraint: <grasp1.align2-down>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-g1-spin2 { constraint: <grasp1.spin2>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-g1-x2 { constraint: <grasp1.park2-x>, Kp: 80, Ki: 0, Kd: 24, decay: 0 } via <arm2-solver>,
        pid ctrl-g1-y2 { constraint: <grasp1.park2-y>, integral-saturation: saturation { max: <shared.spec.pos-integral-limit> }, Kp: 80, Ki: 40, Kd: 24, decay: 0 } via <arm2-solver>,
        pid ctrl-g1-z2 { constraint: <grasp1.park2-z>, integral-saturation: saturation { max: <shared.spec.pos-integral-limit> }, Kp: 80, Ki: 40, Kd: 24, decay: 0 } via <arm2-solver>
    }
    solvers {
        <handler-stage1.arm1-solver>,
        <handler-stage1.arm2-solver>,
        <handler-stage1.gripper1-solver>
    }
}

constraint-handler (ns=app) handler-pull1 {
    handles: <pull1>
    runs-in: <dro.S_PULL1>
    monitors {
        mon-opened1: monitor <pull1.opened> {
            satisfied { trigger: event <dro.E_OPENED1> }
        },
        mon-overtravel1: monitor <pull1.overtravel> {
            satisfied { trigger: event <dro.E_OVERTRAVEL1> }
        },
        mon-grasp-lost1: monitor <pull1.grasp-lost> {
            satisfied for 0.1 s { trigger: event <dro.E_GRASP_LOST1> }
        }
    }
    controllers {
        pid ctrl-p1-elbow1 {
            constraint: <pull1.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm1-solver>,
        pid ctrl-p1-normal { constraint: <pull1.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        pid ctrl-p1-align { constraint: <pull1.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        // The integral carries drawer 2's rail friction at constant speed.
        pid ctrl-p1-pull { constraint: <pull1.pull-speed>, Kp: 200, Ki: 200, Kd: 0, decay: 0 } via <arm1-solver>,
        pid ctrl-p1-y { constraint: <pull1.at-handle-y>, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-p1-z { constraint: <pull1.at-handle-z>, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        feed-forward ctrl-p1-gripper { constraint: <pull1.close-gripper> } via <gripper1-solver>,

        pid ctrl-p1-elbow2 {
            constraint: <pull1.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm2-solver>,
        pid ctrl-p1-align2 { constraint: <pull1.align2-down>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-p1-spin2 { constraint: <pull1.spin2>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-p1-x2 { constraint: <pull1.park2-x>, Kp: 80, Ki: 0, Kd: 24, decay: 0 } via <arm2-solver>,
        pid ctrl-p1-y2 { constraint: <pull1.park2-y>, integral-saturation: saturation { max: <shared.spec.pos-integral-limit> }, Kp: 80, Ki: 40, Kd: 24, decay: 0 } via <arm2-solver>,
        pid ctrl-p1-z2 { constraint: <pull1.park2-z>, integral-saturation: saturation { max: <shared.spec.pos-integral-limit> }, Kp: 80, Ki: 40, Kd: 24, decay: 0 } via <arm2-solver>
    }
    solvers {
        <handler-stage1.arm1-solver>,
        <handler-stage1.arm2-solver>,
        <handler-stage1.gripper1-solver>
    }
}

constraint-handler (ns=app) handler-retreat1 {
    handles: <retreat1>
    runs-in: <dro.S_RETREAT1>
    monitors {
        mon-retreated1: monitor <retreat1.until> {
            satisfied for 0.3 s { trigger: event <dro.E_RETREATED1> }
        }
    }
    controllers {
        pid ctrl-r1-elbow1 {
            constraint: <retreat1.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm1-solver>,
        pid ctrl-r1-normal { constraint: <retreat1.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        pid ctrl-r1-align { constraint: <retreat1.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        pid ctrl-r1-x { constraint: <retreat1.back-out-x>, output-saturation: saturation { max: <shared.spec.transfer-acc-limit> }, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-r1-y { constraint: <retreat1.at-handle-y>, output-saturation: saturation { max: <shared.spec.transfer-acc-limit> }, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-r1-z { constraint: <retreat1.at-handle-z>, output-saturation: saturation { max: <shared.spec.transfer-acc-limit> }, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        feed-forward ctrl-r1-gripper { constraint: <retreat1.open-gripper> } via <gripper1-solver>,

        pid ctrl-r1-elbow2 {
            constraint: <retreat1.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm2-solver>,
        pid ctrl-r1-align2 { constraint: <retreat1.align2-down>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-r1-spin2 { constraint: <retreat1.spin2>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-r1-x2 { constraint: <retreat1.park2-x>, Kp: 80, Ki: 0, Kd: 24, decay: 0 } via <arm2-solver>,
        pid ctrl-r1-y2 { constraint: <retreat1.park2-y>, integral-saturation: saturation { max: <shared.spec.pos-integral-limit> }, Kp: 80, Ki: 40, Kd: 24, decay: 0 } via <arm2-solver>,
        pid ctrl-r1-z2 { constraint: <retreat1.park2-z>, integral-saturation: saturation { max: <shared.spec.pos-integral-limit> }, Kp: 80, Ki: 40, Kd: 24, decay: 0 } via <arm2-solver>
    }
    solvers {
        <handler-stage1.arm1-solver>,
        <handler-stage1.arm2-solver>,
        <handler-stage1.gripper1-solver>
    }
}

constraint-handler (ns=app) handler-stage2 {
    handles: <stage2>
    runs-in: <dro.S_STAGE2>
    monitors {
        mon-staged2: monitor <stage2.until> {
            satisfied for 0.3 s { trigger: event <dro.E_STAGED2> }
        }
    }
    controllers {
        pid ctrl-s2-elbow1 {
            constraint: <stage2.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm1-solver>,
        pid ctrl-s2-normal { constraint: <stage2.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        pid ctrl-s2-align { constraint: <stage2.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        pid ctrl-s2-x { constraint: <stage2.at-pre-x>, output-saturation: saturation { max: <shared.spec.transfer-acc-limit> }, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-s2-y { constraint: <stage2.at-handle-y>, output-saturation: saturation { max: <shared.spec.transfer-acc-limit> }, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-s2-z { constraint: <stage2.at-handle-z>, output-saturation: saturation { max: <shared.spec.transfer-acc-limit> }, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        feed-forward ctrl-s2-gripper { constraint: <stage2.preclose-gripper> } via <gripper1-solver>,

        pid ctrl-s2-elbow2 {
            constraint: <stage2.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm2-solver>,
        pid ctrl-s2-align2 { constraint: <stage2.align2-down>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-s2-spin2 { constraint: <stage2.spin2>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-s2-x2 { constraint: <stage2.hover2-x>, Kp: 80, Ki: 0, Kd: 24, decay: 0 } via <arm2-solver>,
        pid ctrl-s2-y2 { constraint: <stage2.hover2-y>, integral-saturation: saturation { max: <shared.spec.pos-integral-limit> }, Kp: 80, Ki: 40, Kd: 24, decay: 0 } via <arm2-solver>,
        pid ctrl-s2-z2 { constraint: <stage2.hover2-z>, integral-saturation: saturation { max: <shared.spec.pos-integral-limit> }, Kp: 80, Ki: 40, Kd: 24, decay: 0 } via <arm2-solver>
    }
    solvers {
        <handler-stage1.arm1-solver>,
        <handler-stage1.arm2-solver>,
        <handler-stage1.gripper1-solver>
    }
}

constraint-handler (ns=app) handler-press2 {
    handles: <press2>
    runs-in: <dro.S_PRESS2>
    monitors {
        mon-pressed2: monitor <press2.until> {
            satisfied for 0.5 s { trigger: event <dro.E_PRESSED2> }
        }
    }
    controllers {
        pid ctrl-pr2-elbow1 {
            constraint: <press2.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm1-solver>,
        pid ctrl-pr2-normal { constraint: <press2.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        pid ctrl-pr2-align { constraint: <press2.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        pid ctrl-pr2-x { constraint: <press2.at-pre-x>, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-pr2-y { constraint: <press2.at-handle-y>, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-pr2-z { constraint: <press2.at-handle-z>, Kp: 80, Ki: 10, Kd: 24, decay: 0 } via <arm1-solver>,
        feed-forward ctrl-pr2-gripper { constraint: <press2.preclose-gripper> } via <gripper1-solver>,

        pid ctrl-pr2-elbow2 {
            constraint: <press2.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm2-solver>,
        pid ctrl-pr2-align2 { constraint: <press2.align2-down>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-pr2-spin2 { constraint: <press2.spin2>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-pr2-x2 { constraint: <press2.hover2-x>, Kp: 40, Ki: 0, Kd: 15, decay: 0 } via <arm2-solver>,
        pid ctrl-pr2-y2 { constraint: <press2.hover2-y>, Kp: 40, Ki: 0, Kd: 15, decay: 0 } via <arm2-solver>,
        pid ctrl-pr2-z2 { constraint: <press2.descend2-z>, integral-saturation: saturation { max: <shared.spec.press-integral-limit> }, Kp: 60, Ki: 30, Kd: 20, decay: 0 } via <arm2-solver>
    }
    solvers {
        <handler-stage1.arm1-solver>,
        <handler-stage1.arm2-solver>,
        <handler-stage1.gripper1-solver>
    }
}

constraint-handler (ns=app) handler-approach2 {
    handles: <approach2>
    runs-in: <dro.S_APPROACH2>
    monitors {
        mon-at-handle2: monitor <approach2.until> {
            satisfied for 0.3 s { trigger: event <dro.E_AT_HANDLE2> }
        }
    }
    controllers {
        pid ctrl-a2-elbow1 {
            constraint: <approach2.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm1-solver>,
        pid ctrl-a2-normal { constraint: <approach2.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        pid ctrl-a2-align { constraint: <approach2.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm1-solver>,
        pid ctrl-a2-x { constraint: <approach2.at-handle-x>, Kp: 80, Ki: 0, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-a2-y { constraint: <approach2.at-handle-y>, integral-saturation: saturation { max: <shared.spec.pos-integral-limit> }, Kp: 80, Ki: 80, Kd: 24, decay: 0 } via <arm1-solver>,
        pid ctrl-a2-z { constraint: <approach2.at-handle-z>, Kp: 80, Ki: 0, Kd: 24, decay: 0 } via <arm1-solver>,
        feed-forward ctrl-a2-gripper { constraint: <approach2.preclose-gripper> } via <gripper1-solver>,

        pid ctrl-a2-elbow2 {
            constraint: <approach2.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm2-solver>,
        pid ctrl-a2-align2 { constraint: <approach2.align2-down>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-a2-spin2 { constraint: <approach2.spin2>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 } via <arm2-solver>,
        pid ctrl-a2-x2 { constraint: <approach2.hover2-x>, Kp: 150, Ki: 100, Kd: 30, decay: 0 } via <arm2-solver>,
        pid ctrl-a2-y2 { constraint: <approach2.hover2-y>, Kp: 150, Ki: 100, Kd: 30, decay: 0 } via <arm2-solver>,
        feed-forward ctrl-a2-press { constraint: <approach2.press2> } as force apply at <arm2_tree.press_pad> via <arm2-solver>
    }
    solvers {
        <handler-stage1.arm1-solver>,
        <handler-stage1.arm2-solver>,
        <handler-stage1.gripper1-solver>
    }
}

constraint-handler (ns=app) handler-grasp2 {
    handles: <grasp2>
