import "drawer_opening.scene"
import "scene_dsl:robots/kinova_gen3_7dof.ktree"
import "scene_dsl:robots/robotiq_2f85.ktree"

ns dro_mjc = "https://secorolab.github.io/models/scenes/drawer-opening-mjc/"

ktree inst (ns=dro_mjc) kinova1 of <kinova_tree>
ktree inst (ns=dro_mjc) gripper1 of <gripper_tree>
ktree inst (ns=dro_mjc) kinova2 of <kinova_tree>

ktree (ns=dro_mjc) ft1_tree {
    root: <wrist_ft_body.wrist_ft_body_origin>
    body wrist_ft_body {
        frame wrist_ft_body_origin { }
        frame wrist_ft_site {
            pose wrist_ft_site_in_wrist_ft_body {
                wrt: <wrist_ft_body.wrist_ft_body_origin>
                xyz: (0.0, 0.0, 0.0325) m
                orientation: euler { angles: (0.0, 0.0, 0.0) unit: rad }
            }
        }
        frame wrist_ft_mount {
            pose wrist_ft_mount_in_wrist_ft_body {
                wrt: <wrist_ft_body.wrist_ft_body_origin>
                xyz: (0.0, 0.0, 0.065) m
                orientation: euler { angles: (0.0, 0.0, 0.0) unit: rad }
            }
        }
        // The measured 1.195 kg tool minus the gripper's MJCF mass.
        inertia {
            frame: <wrist_ft_site>
            mass: 0.133396 kg
            inertia-matrix: (
                (9.386e-5, 0.0, 0.0),
                (0.0, 9.386e-5, 0.0),
                (0.0, 0.0, 9.379e-5)
            ) kg*m^2
        }
    }
    joints { }
}

ktree (ns=dro_mjc) arm1_tree {
    root: <kinova1.base_link.base_link_origin>
    tree <kinova1>
    tree <ft1_tree>
    tree <gripper1>

    joints {
        fixed ft_on_pinch_site {
            parent: <kinova1.bracelet_link.pinch_site>
            child: <ft1_tree.wrist_ft_body.wrist_ft_body_origin>
        }
        fixed gripper_on_ft {
            parent: <ft1_tree.wrist_ft_body.wrist_ft_mount>
            child: <gripper1.g_base_mount.g_mount_interface>
        }
        serial {
            root: <kinova1.base_link.base_link_origin>
            tip: <gripper1.g_base.g_pinch>
        }
    }
}

// A near-massless marker body: the chain tip must be a declared body.
ktree (ns=dro_mjc) arm2_tree {
    root: <kinova2.base_link.base_link_origin>
    tree <kinova2>

    body press_pad {
        frame press_pad_origin { }
        inertia {
            frame: <press_pad_origin>
            mass: 0.001 kg
            inertia-matrix: (
                (1.0e-7, 0.0, 0.0),
                (0.0, 1.0e-7, 0.0),
                (0.0, 0.0, 1.0e-7)
            ) kg*m^2
        }
    }

    joints {
        fixed pad_on_flange {
            parent: <kinova2.bracelet_link.pinch_site>
            child: <press_pad.press_pad_origin>
        }
        serial {
            root: <kinova2.base_link.base_link_origin>
            tip: <press_pad.press_pad_origin>
        }
    }
}

ktree (ns=dro_mjc) world_tree {
    root: <world_body.world>
    tree <arm1_tree>
    tree <arm2_tree>

    body world_body {
        frame world { }
    }

    body table {
        frame table_top {
            pose table_top_in_world {
                wrt: <world_body.world>
                xyz: (0.0, 0.0, 0.72) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        // In line with cabinet 2: pulled off-axis, the stiff drawer racks and drags its cabinet.
        frame kinova1_mount {
            pose arm1_on_table {
                wrt: <table.table_top>
                xyz: (-0.35, 0.0, 0.0) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        frame kinova2_mount {
            pose arm2_on_table {
                wrt: <table.table_top>
                xyz: (0.58, 0.60, 0.0) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, -90) unit: deg }
            }
        }
        frame close_cam_mount {
            pose close_cam_mount_in_table_top {
                wrt: <table.table_top>
                xyz: (0.10, -1.15, 0.45) m
                orientation: euler { axes: xyz extrinsic angles: (80.14, 0.0, -2.49) unit: deg }
            }
        }
        frame table_com {
            pose table_com_in_table_top {
                wrt: <table.table_top>
                xyz: (0.0, 0.0, -0.05100416904566816) m
                orientation: quat {
                    xyzw: (0.7071067811865489, 0.0, 0.7071067811865489, 0.0)
                }
            }
        }
        inertia {
            frame: <table_com>
            mass: 84.26442414492935 kg
            inertia-matrix: (
                (32.454207471081375, 0.0, 0.0),
                (0.0, 21.92592723136972, 0.0),
                (0.0, 0.0, 12.75746156052865)
            ) kg*m^2
        }
    }

    joints {
        fixed table_on_world {
            parent: <world_body.world>
            child: <table.table_top>
        }
        fixed arm1_on_table {
            parent: <table.kinova1_mount>
            child: <kinova1.base_link.base_link_origin>
        }
        fixed arm2_on_table {
            parent: <table.kinova2_mount>
            child: <kinova2.base_link.base_link_origin>
        }
    }
}

scene inst (ns=dro_mjc) drawer_scene_mjc {
    scene: <drawer_scene>

    kgraph (ns=dro_mjc) drawer_graph {
        anchor: <world_tree.world_body.world>
        tree <world_tree>

        // Free-standing: no joint holds either cabinet to the table.
        body cabinet1 {
            frame cabinet1_origin {
                pose cabinet1_in_world {
                    wrt: <world_tree.world_body.world>
                    xyz: (0.58, -0.28, 0.72) m
                    orientation: euler { axes: xyz extrinsic angles: (0, 0, 180) unit: deg }
                }
            }
            // z along the bar, x the pull-out axis.
            frame cabinet1_handle2 {
                pose cabinet1_handle2_in_cabinet1 {
                    wrt: <cabinet1.cabinet1_origin>
                    xyz: (0.08129, 0.0, 0.154503) m
                    orientation: euler { axes: xyz extrinsic angles: (-90, 0, 0) unit: deg }
                }
            }
        }

        body cabinet2 {
            frame cabinet2_origin {
                pose cabinet2_in_world {
                    wrt: <world_tree.world_body.world>
                    xyz: (0.58, 0.0, 0.72) m
                    orientation: euler { axes: xyz extrinsic angles: (0, 0, 180) unit: deg }
                }
            }
            frame cabinet2_handle2 {
                pose cabinet2_handle2_in_cabinet2 {
                    wrt: <cabinet2.cabinet2_origin>
                    xyz: (0.08129, 0.0, 0.154503) m
                    orientation: euler { axes: xyz extrinsic angles: (-90, 0, 0) unit: deg }
                }
            }
            // Off the centreline so the two wrists keep clear of each other.
            frame press_point {
                pose press_point_in_cabinet2 {
                    wrt: <cabinet2.cabinet2_origin>
                    xyz: (0.05, -0.05, 0.297) m
                    orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
                }
            }
        }
    }

    obj <ws_objects.table> {
        model table-mjc as mjcf { sys path = 'table_low_friction.xml'
            map body <world_tree.table> to "table"
        }
    }

    obj <ws_objects.cabinet1> {
        model cabinet1-mjc as mjcf { sys path = 'src/mj_kdl_wrapper/assets/cabinet/cabinet.xml'
            map body <drawer_graph.cabinet1> to "root"
        }
    }

    obj <ws_objects.cabinet2> {
        model cabinet2-mjc as mjcf { sys path = 'src/mj_kdl_wrapper/assets/cabinet/cabinet.xml'
            map body <drawer_graph.cabinet2> to "root"
        }
    }

    agn <drawer_agents.arm1> {
        model arm1-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/assets/kinova_gen3/gen3.xml'
            map tree <kinova1> to "base_link"
        }

        model ft1-mjc as mjcf {
            sys path = '../ft_mount.xml'
            map tree <ft1_tree> to "wrist_ft_body"
        }

        force-torque wrist_ft {
            frame: <ft1_tree.wrist_ft_body.wrist_ft_site>
            observes: force torque
            update-rate: 1000.0 Hz
        }

        camera close {
            frame: <world_tree.table.close_cam_mount>
            type: rgb
            resolution: (1280, 720)
            fov: 55.0 deg
            update-rate: 30.0 Hz
        }
    }

    agn <drawer_agents.gripper1> {
        model gripper1-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/assets/robotiq_2f85/2f85.xml'
            map tree <gripper1> to "base_mount"
        }
    }

    agn <drawer_agents.arm2> {
        model arm2-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/assets/kinova_gen3/gen3.xml'
            map tree <kinova2> to "base_link"
        }
    }
}
