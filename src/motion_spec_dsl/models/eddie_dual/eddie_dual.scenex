import "eddie_dual.scene"
import "../eddie_base.ktree"
import "../kinova_gen3_7dof.ktree"

ns edu_mjc = "https://secorolab.github.io/models/scenes/eddie-dual-mjc/"

ktree inst (ns=edu_mjc) eddie of <eddie_base_tree>
ktree inst (ns=edu_mjc) left_arm of <kinova_tree>
ktree inst (ns=edu_mjc) right_arm of <kinova_tree>

// One tree per arm, because a tree states at most one joint composition and each arm is its own
// chain -- the same reason pick_place_dual wraps its two arms separately. The tip is the bracelet:
// there is no gripper on this robot, so the last link of the arm is the end-effector.
ktree (ns=edu_mjc) left_arm_tree {
    root: <left_arm.base_link.base_link_origin>
    tree <left_arm>
    joints {
        serial {
            root: <left_arm.base_link.base_link_origin>
            tip: <left_arm.bracelet_link.bracelet_link_origin>
        }
    }
}

ktree (ns=edu_mjc) right_arm_tree {
    root: <right_arm.base_link.base_link_origin>
    tree <right_arm>
    joints {
        serial {
            root: <right_arm.base_link.base_link_origin>
            tip: <right_arm.bracelet_link.bracelet_link_origin>
        }
    }
}

// The whole robot: the platform, and the two arms bolted to its tower. Rooted at the platform's
// ground frame, because that is what the scene stands the robot on -- nothing holds it there, and
// the MJCF's free joint is what lets it drive away.
//
// The platform declares no composition of its own: a castor base is a branching tree, and its
// solver is a force distribution rather than a chain.
ktree (ns=edu_mjc) eddie_dual_tree {
    root: <eddie.base_footprint.base_footprint_origin>
    tree <eddie>
    tree <left_arm_tree>
    tree <right_arm_tree>

    joints {
        fixed left_arm_on_tower {
            parent: <eddie.base_link.left_arm_attachment>
            child: <left_arm.base_link.base_link_origin>
        }
        fixed right_arm_on_tower {
            parent: <eddie.base_link.right_arm_attachment>
            child: <right_arm.base_link.base_link_origin>
        }
    }
}

scene inst (ns=edu_mjc) eddie_dual_scene_mjc {
    scene: <eddie_dual_scene>

    // The robot is a root of this graph in its own right: no joint holds it, so it stands where
    // the scene puts it and drives away from there. The table is the thing that stays put.
    kgraph (ns=edu_mjc) eddie_dual_graph {
        anchor: <world_body.world>
        tree <eddie_dual_tree>

        body world_body {
            frame world { }
        }

        body table {
            frame table_top {
                // Turned a quarter turn so its long 1.6 m edge faces the robot; the top is
                // 1.6 x 1.2 m, so unrotated the robot would meet the 1.2 m end.
                pose table_in_world {
                    wrt: <world_body.world>
                    xyz: (1.15, 0.0, 0.72) m
                    orientation: euler { axes: xyz extrinsic angles: (0, 0, 90) unit: deg }
                }
            }
            // table.xml states no <inertial>: MuJoCo derives these from the top and leg geoms,
            // so the tree has to carry them or nothing can answer for the body's mass.
            frame table_com {
                pose table_com_in_table_top {
                    wrt: <table.table_top>
                    xyz: (0.0, 0.0, -0.05100416904566816) m
                    orientation: quat {
                        xyzw: (0.7071067811865489, 0.0, 0.7071067811865489, 0.0)
                    }
                }
            }
            inertia {
                frame: <table_com>
                mass: 84.26442414492935 kg
                inertia-matrix: (
                    (32.454207471081375, 0.0, 0.0),
                    (0.0, 21.92592723136972, 0.0),
                    (0.0, 0.0, 12.75746156052865)
                ) kg*m^2
            }
        }
    }

    obj <ws_objects.table> {
        model table-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/assets/table.xml'
            map body <eddie_dual_graph.table> to "table"
        }
    }

    agn <agents.eddie> {
        model eddie-mjc as mjcf {
            sys path = 'src/eddie_description/mujoco/mobile_platform.xml'
            map tree <eddie> to "base"
        }
    }

    agn <agents.left_arm> {
        model left-arm-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/assets/kinova_gen3/gen3.xml'
            map tree <left_arm> to "base_link"
        }
    }

    agn <agents.right_arm> {
        model right-arm-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/assets/kinova_gen3/gen3.xml'
            map tree <right_arm> to "base_link"
        }
    }
}
