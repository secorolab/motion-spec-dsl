ns dro = "https://secorolab.github.io/models/drawer-open/fsm/"

evt loop (ns=dro) drawer_open_fsm_events {
    evt E_STEP,
    evt E_PREGRASP_ENTERED,
    evt E_AT_PRE,
    evt E_APPROACH_ENTERED,
    evt E_AT_HANDLE,
    evt E_GRASP_ENTERED,
    evt E_GRASPED,
    evt E_PULL_ENTERED,
    evt E_OPENED
}

// Borghesan's three states plus a staging one: come to a point in front of the handle first,
// then drive in along the opening axis -- the direct diagonal descent drags the fingertips
// down the cabinet face and they snag on the bars. Each transition is raised by the monitor
// of the state it leaves.
fsm (ns=dro) drawer_open_fsm {
    description: "Reach the drawer handle, grasp it, and pull the drawer open."

    states {
        S_START,
        S_PREGRASP,
        S_APPROACH,
        S_GRASP,
        S_PULL,
        S_DONE
    }

    evt loop: <drawer_open_fsm_events>

    start: <S_START>
    end:   <S_DONE>

    transitions {
        T_START_PRE      { from: <S_START>,    to: <S_PREGRASP> },
        T_PRE_APPROACH   { from: <S_PREGRASP>, to: <S_APPROACH> },
        T_APPROACH_GRASP { from: <S_APPROACH>, to: <S_GRASP> },
        T_GRASP_PULL     { from: <S_GRASP>,    to: <S_PULL> },
        T_PULL_DONE      { from: <S_PULL>,     to: <S_DONE> }
    }

    reactions {
        R_STEP_START { when: <drawer_open_fsm_events.E_STEP>,      do: <T_START_PRE>,      fires { <drawer_open_fsm_events.E_PREGRASP_ENTERED> } },
        R_AT_PRE     { when: <drawer_open_fsm_events.E_AT_PRE>,    do: <T_PRE_APPROACH>,   fires { <drawer_open_fsm_events.E_APPROACH_ENTERED> } },
        R_AT_HANDLE  { when: <drawer_open_fsm_events.E_AT_HANDLE>, do: <T_APPROACH_GRASP>, fires { <drawer_open_fsm_events.E_GRASP_ENTERED> } },
        R_GRASPED    { when: <drawer_open_fsm_events.E_GRASPED>,   do: <T_GRASP_PULL>,     fires { <drawer_open_fsm_events.E_PULL_ENTERED> } },
        R_OPENED     { when: <drawer_open_fsm_events.E_OPENED>,    do: <T_PULL_DONE> }
    }
}
