ns ljt = "https://secorolab.github.io/models/base-rotation-joint-space/fsm/"

evt loop (ns=ljt) base_rotation_joint_space_events {
    evt E_STEP,
    evt E_DONE,
    // Unconsumed: S_DONE is terminal, and every gate needs a monitor to fire something.
    evt E_REST_SETTLED
}

fsm (ns=ljt) base_rotation_joint_space_fsm {
    description: "Run one joint-1 look motion and stop."

    states { S_START, S_LOOK, S_DONE }
    evt loop: <base_rotation_joint_space_events>
    start: <S_START>
    end: <S_DONE>

    transitions {
        T_START_LOOK { from: <S_START>, to: <S_LOOK> },
        T_LOOK_DONE  { from: <S_LOOK>,  to: <S_DONE> }
    }

    reactions {
        R_START { when: <base_rotation_joint_space_events.E_STEP>, do: <T_START_LOOK> },
        R_DONE  { when: <base_rotation_joint_space_events.E_DONE>, do: <T_LOOK_DONE> }
    }
}
