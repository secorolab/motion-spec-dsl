ns cu = "https://secorolab.github.io/models/crf-unscrewing-kinova/fsm/"

evt loop (ns=cu) unscrew_fsm_events {
    evt E_STEP,
    evt E_FIND_ENTERED,
    evt E_FOUND,
    evt E_FIND_NOK,
    evt E_WAIT_ENTERED,
    evt E_WAITED,
    evt E_LOOSEN_ENTERED,
    evt E_LOOSENED,
    evt E_LOOSEN_NOK,
    evt E_DONE_ENTERED,
    evt E_FAULT_ENTERED,
    // Unconsumed: S_DONE and S_FAULT are terminal.
    evt E_REST_SETTLED,
    evt E_FAULT_SETTLED
}

// Deprag screwdriving sequence 4, "Soprano open": find, wait, loosen to angle. A step that
// runs past its supervision time or its torque upper limit ends the sequence in S_FAULT.
fsm (ns=cu) unscrew_fsm {
    description: "Seat the bit, wait, and loosen the screw by a quarter turn."

    states {
        S_START,
        S_FIND,
        S_WAIT,
        S_LOOSEN,
        S_FAULT,
        S_DONE
    }

    evt loop: <unscrew_fsm_events>

    start: <S_START>
    end:   <S_DONE>

    transitions {
        T_START_FIND   { from: <S_START>,  to: <S_FIND> },
        T_FIND_WAIT    { from: <S_FIND>,   to: <S_WAIT> },
        T_FIND_FAULT   { from: <S_FIND>,   to: <S_FAULT> },
        T_WAIT_LOOSEN  { from: <S_WAIT>,   to: <S_LOOSEN> },
        T_LOOSEN_DONE  { from: <S_LOOSEN>, to: <S_DONE> },
        T_LOOSEN_FAULT { from: <S_LOOSEN>, to: <S_FAULT> }
    }

    reactions {
        R_STEP_START { when: <unscrew_fsm_events.E_STEP>,       do: <T_START_FIND>,   fires { <unscrew_fsm_events.E_FIND_ENTERED> } },
        R_FOUND      { when: <unscrew_fsm_events.E_FOUND>,      do: <T_FIND_WAIT>,    fires { <unscrew_fsm_events.E_WAIT_ENTERED> } },
        R_FIND_NOK   { when: <unscrew_fsm_events.E_FIND_NOK>,   do: <T_FIND_FAULT>,   fires { <unscrew_fsm_events.E_FAULT_ENTERED> } },
        R_WAITED     { when: <unscrew_fsm_events.E_WAITED>,     do: <T_WAIT_LOOSEN>,  fires { <unscrew_fsm_events.E_LOOSEN_ENTERED> } },
        R_LOOSENED   { when: <unscrew_fsm_events.E_LOOSENED>,   do: <T_LOOSEN_DONE>,  fires { <unscrew_fsm_events.E_DONE_ENTERED> } },
        R_LOOSEN_NOK { when: <unscrew_fsm_events.E_LOOSEN_NOK>, do: <T_LOOSEN_FAULT>, fires { <unscrew_fsm_events.E_FAULT_ENTERED> } }
    }
}
