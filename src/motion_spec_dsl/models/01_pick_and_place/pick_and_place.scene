ns pps_env = "https://secorolab.github.io/models/environments/pick-and-place/"
ns pps_agn = "https://secorolab.github.io/models/agents/pick-and-place/"
ns pps_scene = "https://secorolab.github.io/models/scenes/pick-and-place/"

obj set (ns=pps_env) objects {
    object cube
}

obj set (ns=pps_env) ws_objects {
    object table
}

ws set (ns=pps_env) workspaces {
    workspace table_ws
}

agn set (ns=pps_agn) agents {
    agent arm1,
    agent gripper1
}

comp (ns=pps_env) comp_table of ws <workspaces.table_ws> {
    obj <ws_objects.table>
}

scene (ns=pps_scene) pick_and_place_scene {
    obj set <objects>
    ws comp <comp_table>
    agn set <agents>
}
