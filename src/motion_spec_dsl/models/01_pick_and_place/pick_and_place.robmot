import "pick_and_place.fsm"
import "pick_and_place.scenex"
ns app = "https://secorolab.github.io/models/pick-and-place/"
ns fsm = "https://secorolab.github.io/models/pick-and-place/fsm/"

exec-context (ns=app) pick-and-place-exec {
    runs-scene: <pick_and_place_scene_mjc>
    platform:   simulation { name: "MuJoCo" }
    config:     "robot.toml"
    timestep:   1.0 ms
}

context (ns=app) shared {
    world {
        pose pose-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        velocity-twist twist-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        pose pose-cube-base {
            of:         <pick_and_place_graph.cube>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        joint-position gripper-pos {
            joint: <gripper.g_left_driver_joint>
        },
        joint-position elbow-angle {
            joint: <kinova.joint_3>,
            normalization: (-pi, pi) rad
        }
    },
    spec {
        length satisfied-band      = 0.01 m,
        angle satisfied-band-rot   = 0.01 rad,
        angle grasp-rot-x          = pi rad,
        angle grasp-rot-y          = 0.0 rad,
        angle grasp-rot-z          = pi / 2 rad,
        pose grasp-ori-pose {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        } = {
            position: (0.0, 0.0, 0.0) m,
            orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
        },
        angle gripper-closed       = 0.8 rad,
        angle gripper-open         = 0.0 rad,
        length lost-dist           = 0.12 m,
        length place-x             = 0.40 m,
        length place-y             = 0.24 m,
        length place-above-z       = 0.22 m,
        pose home-pose             = [config.poses.home] for <shared.world.pose-ee-base>,
        angle elbow-angle-target   = pi rad,
        torque elbow-torque-limit  = 10.0 Nm,
        // Gen3 large-actuator peak torque.
        torque arm-torque-limit    = 39.0 Nm
    }
}

tolerances {
    linear-velocity:  0.01 m/s,
    position:         0.01 m,
    orientation:      0.01 rad
}

guarded-motion (ns=app) home {
    description: "Hold the TCP at the home pose the deployment states"

    context {
        <shared.spec>
    }

    when {}

    while {
        hold-position:    keeping <shared.world.pose-ee-base>.position    equal to <shared.spec.home-pose>.position within <shared.spec.satisfied-band>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <shared.spec.home-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold-elbow-angle: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        open-gripper:     keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>
    }

    until all {
        gripper-ready: <shared.world.gripper-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>
    }
}

guarded-motion (ns=app) pick-above {
    description: "Move TCP to the pre-grasp position above the cube along a path"

    context {
        spec {
            length above-z      = 0.26 m,
            linear-velocity min-approach-speed = 0.005 m/s,
            velocity-profile approach-profile = profile {
                max-velocity: 0.08 m/s,
                max-acceleration: 0.05 m/s^2,
                shape: trapezoidal
            },
            pose start-pose     = snapshot of <shared.world.pose-ee-base> on event <fsm.E_PICK_ABOVE_ENTERED>,
            length start-cube-x = snapshot of <shared.world.pose-cube-base>.position.x on event <fsm.E_PICK_ABOVE_ENTERED>,
            length start-cube-y = snapshot of <shared.world.pose-cube-base>.position.y on event <fsm.E_PICK_ABOVE_ENTERED>,
            pose goal-pose = {
                position: (<spec.start-cube-x>, <spec.start-cube-y>, <spec.above-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            },
            path approach-path = lerp {
                start: <spec.start-pose>,
                goal:  <spec.goal-pose>
            }
        }
    }

    when {}

    while {
        follow-tan: moving <shared.world.pose-ee-base> along <spec.approach-path> with <spec.approach-profile>,
        follow-lat: keeping <shared.world.pose-ee-base>.position    on <spec.approach-path> within <shared.spec.satisfied-band>,
        follow-ori: keeping <shared.world.pose-ee-base>.orientation on <spec.approach-path> within <shared.spec.satisfied-band-rot>,
        advance:    progress of <shared.world.pose-ee-base> along <spec.approach-path> more than <spec.min-approach-speed>,
        hold-elbow-angle: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>
    }

    until all {
        aligned-above: <shared.world.pose-ee-base>.position equal to <spec.goal-pose>.position within <shared.spec.satisfied-band>
    }
}

guarded-motion (ns=app) pick {
    description: "Lower TCP straight down to the grasp height at the cube"

    context {
        spec {
            length grasp-x = snapshot of <shared.world.pose-cube-base>.position.x on event <fsm.E_PICK_ENTERED>,
            length grasp-y = snapshot of <shared.world.pose-cube-base>.position.y on event <fsm.E_PICK_ENTERED>,
            length grasp-z = 0.015 m,
            length grasp-reach = 0.015 m
        }
    }

    when {}

    while {
        hold-x:     keeping <shared.world.pose-ee-base>.position.x  equal to <spec.grasp-x> within <shared.spec.satisfied-band>,
        hold-y:     keeping <shared.world.pose-ee-base>.position.y  equal to <spec.grasp-y> within <shared.spec.satisfied-band>,
        lower-z:    keeping <shared.world.pose-ee-base>.position.z  equal to <spec.grasp-z> within <shared.spec.satisfied-band>,
        follow-ori: keeping <shared.world.pose-ee-base>.orientation equal to <shared.spec.grasp-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold-elbow-angle: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>
    }

    until all {
        near-cube: distance between <shared.world.pose-ee-base> and <shared.world.pose-cube-base> less than <spec.grasp-reach>
    }
}

guarded-motion (ns=app) grasp-hold {
    description: "Hold TCP at the current base-frame pose while the gripper closes"

    context {
        spec {
            pose hold-pose        = snapshot of <shared.world.pose-ee-base> on event <fsm.E_GRASP_ENTERED>,
            // Pads stopped on the cube: past free swing, short of closing on air.
            angle grasp-threshold = 0.15 rad,
            angle grip-on-cube-hi = 0.70 rad
        }
    }

    when {}

    while {
        hold-x:           keeping <shared.world.pose-ee-base>.position.x equal to <spec.hold-pose>.position.x within <shared.spec.satisfied-band>,
        hold-y:           keeping <shared.world.pose-ee-base>.position.y equal to <spec.hold-pose>.position.y within <shared.spec.satisfied-band>,
        hold-z:           keeping <shared.world.pose-ee-base>.position.z equal to <spec.hold-pose>.position.z within <shared.spec.satisfied-band>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.hold-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold-elbow-angle: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        close-gripper:    keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>
    }

    until all {
        grasped: <shared.world.gripper-pos> between <spec.grasp-threshold> and <spec.grip-on-cube-hi>
    }
}

guarded-motion (ns=app) lift {
    description: "Raise TCP straight up while holding the cube"

    context {
        spec {
            length lift-z          = 0.32 m,
            length lifted-z        = 0.30 m,
            length lift-start-x    = snapshot of <shared.world.pose-ee-base>.position.x on event <fsm.E_LIFT_ENTERED>,
            length lift-start-y    = snapshot of <shared.world.pose-ee-base>.position.y on event <fsm.E_LIFT_ENTERED>
        }
    }

    when {}

    while {
        hold-x:           keeping <shared.world.pose-ee-base>.position.x  equal to <spec.lift-start-x> within <shared.spec.satisfied-band>,
        hold-y:           keeping <shared.world.pose-ee-base>.position.y  equal to <spec.lift-start-y> within <shared.spec.satisfied-band>,
        lift-z:           keeping <shared.world.pose-ee-base>.position.z  equal to <spec.lift-z> within <shared.spec.satisfied-band>,
        follow-ori:       keeping <shared.world.pose-ee-base>.orientation equal to <shared.spec.grasp-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold-elbow-angle: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        close-gripper:    keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>
    }

    until any {
        lifted:     <shared.world.pose-ee-base>.position.z greater than <spec.lifted-z>,
        grasp-lost: distance between <shared.world.pose-ee-base> and <shared.world.pose-cube-base> greater than <shared.spec.lost-dist>
    }
}

guarded-motion (ns=app) place-above {
    description: "Move TCP laterally to the pre-place position above the place location"

    context {
        spec {
            length place-y-gate = 0.20 m
        }
    }

    when {}

    while {
        reach-x:          keeping <shared.world.pose-ee-base>.position.x  equal to <shared.spec.place-x> within <shared.spec.satisfied-band>,
        reach-y:          keeping <shared.world.pose-ee-base>.position.y  equal to <shared.spec.place-y> within <shared.spec.satisfied-band>,
        reach-z:          keeping <shared.world.pose-ee-base>.position.z  equal to <shared.spec.place-above-z> within <shared.spec.satisfied-band>,
        align-ori:        keeping <shared.world.pose-ee-base>.orientation equal to <shared.spec.grasp-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold-elbow-angle: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        close-gripper:    keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>
    }

    until any {
        at-pre-place: <shared.world.pose-ee-base>.position.y greater than <spec.place-y-gate>,
        grasp-lost:   distance between <shared.world.pose-ee-base> and <shared.world.pose-cube-base> greater than <shared.spec.lost-dist>
    }
}

guarded-motion (ns=app) place {
    description: "Lower TCP with cube straight down to the place height"

    context {
        spec {
            length place-z   = 0.03 m
        }
    }

    when {}

    while {
        reach-x:          keeping <shared.world.pose-ee-base>.position.x  equal to <shared.spec.place-x> within <shared.spec.satisfied-band>,
        reach-y:          keeping <shared.world.pose-ee-base>.position.y  equal to <shared.spec.place-y> within <shared.spec.satisfied-band>,
        reach-z:          keeping <shared.world.pose-ee-base>.position.z  equal to <spec.place-z> within <shared.spec.satisfied-band>,
        align-ori:        keeping <shared.world.pose-ee-base>.orientation equal to <shared.spec.grasp-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold-elbow-angle: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        close-gripper:    keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>
    }

    until any {
        at-place:   <shared.world.pose-ee-base>.position.z equal to <spec.place-z> within <shared.spec.satisfied-band>,
        grasp-lost: distance between <shared.world.pose-ee-base> and <shared.world.pose-cube-base> greater than <shared.spec.lost-dist>
    }
}

guarded-motion (ns=app) open-grasp-hold {
    description: "Hold TCP at place pose while the gripper opens"

    context {
        spec {
            pose hold-pose = snapshot of <shared.world.pose-ee-base> on event <fsm.E_OPEN_ENTERED>
        }
    }

    when {}

    while {
        hold-x:           keeping <shared.world.pose-ee-base>.position.x equal to <spec.hold-pose>.position.x within <shared.spec.satisfied-band>,
        hold-y:           keeping <shared.world.pose-ee-base>.position.y equal to <spec.hold-pose>.position.y within <shared.spec.satisfied-band>,
        hold-z:           keeping <shared.world.pose-ee-base>.position.z equal to <spec.hold-pose>.position.z within <shared.spec.satisfied-band>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.hold-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold-elbow-angle: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        open-gripper:     keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>
    }

    until all {
        released: <shared.world.gripper-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>
    }
}

guarded-motion (ns=app) retreat {
    description: "Move TCP straight up to the pre-grasp height above the place location"

    context {
        spec {
            length retreat-z-lo = 0.20 m,
            length retreat-z-hi = 0.24 m
        }
    }

    when {}

    while {
        reach-x:          keeping <shared.world.pose-ee-base>.position.x  equal to <shared.spec.place-x> within <shared.spec.satisfied-band>,
        reach-y:          keeping <shared.world.pose-ee-base>.position.y  equal to <shared.spec.place-y> within <shared.spec.satisfied-band>,
        reach-z:          keeping <shared.world.pose-ee-base>.position.z  equal to <shared.spec.place-above-z> within <shared.spec.satisfied-band>,
        align-ori:        keeping <shared.world.pose-ee-base>.orientation equal to <shared.spec.grasp-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold-elbow-angle: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        open-gripper:     keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>
    }

    until all {
        at-retreat-settled: <shared.world.pose-ee-base>.position.z between <spec.retreat-z-lo> and <spec.retreat-z-hi>
    }
}

guarded-motion (ns=app) recover {
    description: "Fallback recovery: capture the current pose on entry and hold it"

    context {
        spec {
            pose hold-pose = snapshot of <shared.world.pose-ee-base> on event <fsm.E_RECOVER_ENTERED>
        }
    }

    when {}

    while {
        hold-x:           keeping <shared.world.pose-ee-base>.position.x equal to <spec.hold-pose>.position.x within <shared.spec.satisfied-band>,
        hold-y:           keeping <shared.world.pose-ee-base>.position.y equal to <spec.hold-pose>.position.y within <shared.spec.satisfied-band>,
        hold-z:           keeping <shared.world.pose-ee-base>.position.z equal to <spec.hold-pose>.position.z within <shared.spec.satisfied-band>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.hold-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold-elbow-angle: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>
    }

    until {}
}

constraint-handler (ns=app) handler-home {
    handles: <home>
    runs-in: <fsm.S_HOME>
    monitors {
        mon-home-done: monitor <home.until> {
            satisfied { trigger: event <fsm.E_PICK_ABOVE_READY> }
        }
    }

    controllers {
        pid ctrl-home-hold-position    { constraint: <home.hold-position>,    Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-home-hold-orientation { constraint: <home.hold-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 },
        pid ctrl-home-hold-elbow-angle {
            constraint: <home.hold-elbow-angle>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        feed-forward ctrl-home-open-gripper { constraint: <home.open-gripper> }
    }

    solvers {
        arm-solver: serial-chain {
            agent:     <agents.arm1>,
            algorithm: achd,
            limits {   torque: saturation { max: <shared.spec.arm-torque-limit> } },
            gravity:   (0.0, 0.0, 9.81) m/s^2
        },
        gripper-solver: command-forwarding {
            agent: <agents.gripper1>
        }
    }
}

constraint-handler (ns=app) handler-pick-above {
    handles: <pick-above>
    runs-in: <fsm.S_PICK_ABOVE>
    monitors {
        mon-pick-above-done: monitor <pick-above.until> {
            satisfied { trigger: event <fsm.E_PICK_READY> }
        },
        mon-pick-above-advancing: monitor <pick-above.advance> {
            satisfied { flag: pick-above-advancing }
        }
    }

    controllers {
        pid ctrl-pick-above-follow-tan { constraint: <pick-above.follow-tan>, Kp: 20,  Ki: 4,   Kd: 0,  decay: 0 },
        pid ctrl-pick-above-follow-lat { constraint: <pick-above.follow-lat>, measured-derivative: <shared.world.twist-ee-base>.linvel, Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-pick-above-follow-ori { constraint: <pick-above.follow-ori>, measured-derivative: <shared.world.twist-ee-base>.angvel, Kp: 120, Ki: 50,  Kd: 80, decay: 0 },
        pid ctrl-pick-above-hold-elbow-angle {
            constraint: <pick-above.hold-elbow-angle>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque
    }

    solvers {
        <handler-home.arm-solver>
    }
}

constraint-handler (ns=app) handler-pick {
    handles: <pick>
    runs-in: <fsm.S_PICK>
    monitors {
        mon-pick-done: monitor <pick.until> {
            satisfied { trigger: event <fsm.E_GRASP_READY> }
        }
    }

    controllers {
        pid ctrl-pick-hold-x     { constraint: <pick.hold-x>,     Kp: 200, Ki: 20, Kd: 40, decay: 0 },
        pid ctrl-pick-hold-y     { constraint: <pick.hold-y>,     Kp: 200, Ki: 30, Kd: 40, decay: 0 },
        pid ctrl-pick-lower-z    { constraint: <pick.lower-z>,    Kp: 12,  Ki: 5,  Kd: 15, decay: 0 },
        pid ctrl-pick-follow-ori { constraint: <pick.follow-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 },
        pid ctrl-pick-hold-elbow-angle {
            constraint: <pick.hold-elbow-angle>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque
    }

    solvers {
        <handler-home.arm-solver>
    }
}

constraint-handler (ns=app) handler-grasp-hold {
    handles: <grasp-hold>
    runs-in: <fsm.S_GRASP>
    monitors {
        mon-grasp-done: monitor <grasp-hold.until> {
            satisfied for 0.2 s { trigger: event <fsm.E_LIFT_READY> }
        }
    }

    controllers {
        pid ctrl-grasp-hold-hold-x           { constraint: <grasp-hold.hold-x>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-grasp-hold-hold-y           { constraint: <grasp-hold.hold-y>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-grasp-hold-hold-z           { constraint: <grasp-hold.hold-z>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-grasp-hold-hold-orientation { constraint: <grasp-hold.hold-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 },
        pid ctrl-grasp-hold-hold-elbow-angle {
            constraint: <grasp-hold.hold-elbow-angle>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        feed-forward ctrl-grasp-hold-close-gripper { constraint: <grasp-hold.close-gripper> }
    }

    solvers {
        <handler-home.arm-solver>,
        <handler-home.gripper-solver>
    }
}

constraint-handler (ns=app) handler-lift {
    handles: <lift>
    runs-in: <fsm.S_LIFT>
    monitors {
        mon-lift-done: monitor <lift.lifted> {
            satisfied { trigger: event <fsm.E_PLACE_ABOVE_READY> }
        },
        mon-lift-grasp-lost: monitor <lift.grasp-lost> {
            satisfied { trigger: event <fsm.E_GRASP_LOST_LIFT> }
        }
    }

    controllers {
        pid ctrl-lift-hold-x     { constraint: <lift.hold-x>,     Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-lift-hold-y     { constraint: <lift.hold-y>,     Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-lift-lift-z     { constraint: <lift.lift-z>,     Kp: 15,  Ki: 5,   Kd: 20, decay: 0 },
        pid ctrl-lift-follow-ori { constraint: <lift.follow-ori>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 },
        pid ctrl-lift-hold-elbow-angle {
            constraint: <lift.hold-elbow-angle>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        feed-forward ctrl-lift-close-gripper { constraint: <lift.close-gripper> }
    }

    solvers {
        <handler-home.arm-solver>,
        <handler-home.gripper-solver>
    }
}

constraint-handler (ns=app) handler-place-above {
    handles: <place-above>
    runs-in: <fsm.S_PLACE_ABOVE>
    monitors {
        mon-place-above-done: monitor <place-above.at-pre-place> {
            satisfied { trigger: event <fsm.E_PLACE_READY> }
        },
        mon-place-above-grasp-lost: monitor <place-above.grasp-lost> {
            satisfied { trigger: event <fsm.E_GRASP_LOST_PLACE_ABOVE> }
        }
    }

    controllers {
        pid ctrl-place-above-reach-x   { constraint: <place-above.reach-x>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 },
        pid ctrl-place-above-reach-y   { constraint: <place-above.reach-y>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 },
        pid ctrl-place-above-reach-z   { constraint: <place-above.reach-z>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 },
        pid ctrl-place-above-align-ori { constraint: <place-above.align-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 },
        pid ctrl-place-above-hold-elbow-angle {
            constraint: <place-above.hold-elbow-angle>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        feed-forward ctrl-place-above-close-gripper { constraint: <place-above.close-gripper> }
    }

    solvers {
        <handler-home.arm-solver>,
        <handler-home.gripper-solver>
    }
}

constraint-handler (ns=app) handler-place {
    handles: <place>
    runs-in: <fsm.S_PLACE>
    monitors {
        mon-place-done: monitor <place.at-place> {
            satisfied { trigger: event <fsm.E_OPEN_READY> }
        },
        mon-place-grasp-lost: monitor <place.grasp-lost> {
            satisfied { trigger: event <fsm.E_GRASP_LOST_PLACE> }
        }
    }

    controllers {
        pid ctrl-place-reach-x   { constraint: <place.reach-x>,   Kp: 140, Ki: 20, Kd: 55, decay: 0 },
        pid ctrl-place-reach-y   { constraint: <place.reach-y>,   Kp: 140, Ki: 20, Kd: 55, decay: 0 },
        pid ctrl-place-reach-z   { constraint: <place.reach-z>,   Kp: 60,  Ki: 15, Kd: 55, decay: 0 },
        pid ctrl-place-align-ori { constraint: <place.align-ori>, Kp: 180, Ki: 30, Kd: 120, decay: 0 },
        pid ctrl-place-hold-elbow-angle {
            constraint: <place.hold-elbow-angle>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        feed-forward ctrl-place-close-gripper { constraint: <place.close-gripper> }
    }

    solvers {
        <handler-home.arm-solver>,
        <handler-home.gripper-solver>
    }
}

constraint-handler (ns=app) handler-open-grasp-hold {
    handles: <open-grasp-hold>
    runs-in: <fsm.S_OPEN>
    monitors {
        mon-open-done: monitor <open-grasp-hold.until> {
            satisfied { trigger: event <fsm.E_RETREAT_READY> }
        }
    }

    controllers {
        pid ctrl-open-grasp-hold-hold-x           { constraint: <open-grasp-hold.hold-x>,           Kp: 140, Ki: 20, Kd: 55, decay: 0 },
        pid ctrl-open-grasp-hold-hold-y           { constraint: <open-grasp-hold.hold-y>,           Kp: 140, Ki: 20, Kd: 55, decay: 0 },
        pid ctrl-open-grasp-hold-hold-z           { constraint: <open-grasp-hold.hold-z>,           Kp: 140, Ki: 20, Kd: 55, decay: 0 },
        pid ctrl-open-grasp-hold-hold-orientation { constraint: <open-grasp-hold.hold-orientation>, Kp: 180, Ki: 30, Kd: 120, decay: 0 },
        pid ctrl-open-grasp-hold-hold-elbow-angle {
            constraint: <open-grasp-hold.hold-elbow-angle>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        feed-forward ctrl-open-grasp-hold-open-gripper { constraint: <open-grasp-hold.open-gripper> }
    }

    solvers {
        <handler-home.arm-solver>,
        <handler-home.gripper-solver>
    }
}

constraint-handler (ns=app) handler-retreat {
    handles: <retreat>
    runs-in: <fsm.S_RETREAT>
    monitors {
        mon-retreat-settled: monitor <retreat.until> {
            satisfied { trigger: event <fsm.E_RETREAT_SETTLED> }
        }
    }

    controllers {
        pid ctrl-retreat-reach-x   { constraint: <retreat.reach-x>,   Kp: 140, Ki: 20, Kd: 55, decay: 0 },
        pid ctrl-retreat-reach-y   { constraint: <retreat.reach-y>,   Kp: 140, Ki: 20, Kd: 55, decay: 0 },
        pid ctrl-retreat-reach-z   { constraint: <retreat.reach-z>,   Kp: 60,  Ki: 15, Kd: 55, decay: 0 },
        pid ctrl-retreat-align-ori { constraint: <retreat.align-ori>, Kp: 180, Ki: 30, Kd: 120, decay: 0 },
        pid ctrl-retreat-hold-elbow-angle {
            constraint: <retreat.hold-elbow-angle>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        feed-forward ctrl-retreat-open-gripper { constraint: <retreat.open-gripper> }
    }

    solvers {
        <handler-home.arm-solver>,
        <handler-home.gripper-solver>
    }
}

constraint-handler (ns=app) handler-recover {
    handles: <recover>
    runs-in: <fsm.S_RECOVER>
    monitors {
        mon-recover-hold: monitor <recover.hold-x> {
            satisfied for 0.1 s { trigger: event <fsm.E_RECOVER> }
        }
    }

    controllers {
        pid ctrl-recover-hold-x           { constraint: <recover.hold-x>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-recover-hold-y           { constraint: <recover.hold-y>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-recover-hold-z           { constraint: <recover.hold-z>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-recover-hold-orientation { constraint: <recover.hold-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 },
        pid ctrl-recover-hold-elbow-angle {
            constraint: <recover.hold-elbow-angle>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque
    }

    solvers {
        <handler-home.arm-solver>
    }
}
