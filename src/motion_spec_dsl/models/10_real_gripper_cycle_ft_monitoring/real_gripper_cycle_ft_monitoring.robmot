import "real_gripper_cycle_ft_monitoring.fsm"
import "../common/table_arm_real.scenex"
ns app = "https://secorolab.github.io/models/real-gripper-cycle-ft-monitoring/"
ns fsm = "https://secorolab.github.io/models/real-gripper-cycle-ft-monitoring/fsm/"

exec-context (ns=app) real-gripper-cycle-ft-monitoring-exec {
    runs-scene: <table_arm_real_scene_mjc>
    platform:   real-world {
                    <agents.arm1> realized by KinovaGen3,
                    <agents.gripper1> realized by Robotiq2F85,
                    <wrist_ft> realized by RobotiqFT300s
                }
    config:     "robot.toml"
    timestep:   1.0 ms
}

context (ns=app) shared {
    world {
        pose pose-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        joint-position gripper-pos {
            joint: <gripper.g_left_driver_joint>
        },
        wrench ext-force {
            ref-point:  <ft_tree.wrist_ft_body.wrist_ft_site>,
            as-seen-by: <kinova.base_link.base_link_origin>,
            ft-sensor:  <wrist_ft>,
            re-tare-on: { <fsm.E_RUN_STARTED> }
        }
    },
    spec {
        angle gripper-closed       = 0.8 rad,
        angle gripper-open         = 0.0 rad,
        angle grasp-threshold      = 0.65 rad,
        length pinch-moved-band    = 0.05 m,
        force force-threshold      = 10.0 N,
        force neg-force-threshold  = -10.0 N
    }
}

tolerances {
    position:         0.05 m,
    orientation:      0.01 rad
}

guarded-motion (ns=app) close-cycle {
    description: "Close the gripper; monitor the pinch pose and the FT sensor"

    context {
        spec {
            pose start-pose = snapshot of <shared.world.pose-ee-base> on event <fsm.E_CLOSE_ENTERED>
        }
    }

    when {}

    while {
        close-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed>,
        pinch-moved: distance between <shared.world.pose-ee-base> and <spec.start-pose> greater than <shared.spec.pinch-moved-band>,
        force-z: <shared.world.ext-force>.force.z outside <shared.spec.neg-force-threshold> and <shared.spec.force-threshold>
    }

    until {
        closed: <shared.world.gripper-pos> greater than <shared.spec.grasp-threshold>
    }
}

guarded-motion (ns=app) open-cycle {
    description: "Open the gripper; monitor the pinch pose and the FT sensor"

    context {
        spec {
            pose start-pose = snapshot of <shared.world.pose-ee-base> on event <fsm.E_OPEN_ENTERED>
        }
    }

    when {}

    while {
        open-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-open>,
        pinch-moved: distance between <shared.world.pose-ee-base> and <spec.start-pose> greater than <shared.spec.pinch-moved-band>,
        force-z: <shared.world.ext-force>.force.z outside <shared.spec.neg-force-threshold> and <shared.spec.force-threshold>
    }

    until {
        opened: <shared.world.gripper-pos> equal to <shared.spec.gripper-open>
    }
}

constraint-handler (ns=app) handler-close-cycle {
    handles: <close-cycle>
    runs-in: <fsm.S_CLOSE>
    monitors {
        mon-close-cycle-done: monitor <close-cycle.until> {
            satisfied for 0.3 s { trigger: event <fsm.E_GRIPPER_CLOSED> }
        },
        mon-close-cycle-pinch-moved: monitor <close-cycle.pinch-moved> {
            satisfied for 0.3 s { trigger: event <fsm.E_PINCH_MOVED> }
        },
        mon-close-cycle-force-z: monitor <close-cycle.force-z> {
            satisfied for 0.3 s { trigger: event <fsm.E_FT_CONTACT> }
        }
    }
    controllers {
        feed-forward ctrl-close-cycle-close-gripper { constraint: <close-cycle.close-gripper> }
    }
    solvers {
        arm-solver: serial-chain {
            agent:     <agents.arm1>,
            algorithm: fpk
        },
        gripper-solver: command-forwarding {
            agent: <agents.gripper1>
        }
    }
}

constraint-handler (ns=app) handler-open-cycle {
    handles: <open-cycle>
    runs-in: <fsm.S_OPEN>
    monitors {
        mon-open-cycle-done: monitor <open-cycle.until> {
            satisfied for 0.3 s { trigger: event <fsm.E_GRIPPER_OPENED> }
        },
        mon-open-cycle-pinch-moved: monitor <open-cycle.pinch-moved> {
            satisfied for 0.3 s { trigger: event <fsm.E_PINCH_MOVED> }
        },
        mon-open-cycle-force-z: monitor <open-cycle.force-z> {
            satisfied for 0.3 s { trigger: event <fsm.E_FT_CONTACT> }
        }
    }
    controllers {
        feed-forward ctrl-open-cycle-open-gripper { constraint: <open-cycle.open-gripper> }
    }
    solvers {
        <handler-close-cycle.arm-solver>,
        <handler-close-cycle.gripper-solver>
    }
}
