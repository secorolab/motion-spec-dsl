import "crf_unscrewing.scene"
import "../ur10e.ktree"

ns cu_mjc = "https://secorolab.github.io/models/scenes/crf-unscrewing-mjc/"

// The real cell is a UR20, which Menagerie does not have; the UR10e stands in for it.
ktree inst (ns=cu_mjc) ur10e of <ur10e_tree>

ktree (ns=cu_mjc) nutrunner_tree {
    root: <tool.tool_origin>
    body tool {
        frame tool_origin { }
        // The bit tip, flange orientation: z runs forward along the bit.
        frame tcp {
            pose tcp_in_tool {
                wrt: <tool.tool_origin>
                xyz: (-0.156, 0.0, 0.307) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        // screwdriver_tool.xml states no <inertial>: MuJoCo derives these from its six geoms.
        frame tool_com {
            pose tool_com_in_tool {
                wrt: <tool.tool_origin>
                xyz: (-0.114387, 0.0, 0.154105) m
                orientation: quat { xyzw: (-0.1852730291, -0.1852730291, 0.6824030368, 0.6824030368) }
            }
        }
        inertia {
            frame: <tool_com>
            mass: 3.72 kg
            inertia-matrix: (
                (0.05375416, 0.0, 0.0),
                (0.0, 0.05015159, 0.0),
                (0.0, 0.0, 0.0050659)
            ) kg*m^2
        }
    }
    joints { }
}

ktree (ns=cu_mjc) ur10e_nutrunner {
    root: <ur10e.base.base_origin>
    tree <ur10e>
    tree <nutrunner_tree>

    joints {
        fixed tool_on_flange {
            parent: <ur10e.wrist_3_link.attachment_site>
            child: <nutrunner_tree.tool.tool_origin>
        }
        serial {
            root: <ur10e.base.base_origin>
            tip: <nutrunner_tree.tool.tcp>
        }
    }
}

ktree (ns=cu_mjc) world_tree {
    root: <world_body.world>
    tree <ur10e_nutrunner>

    body world_body {
        frame world { }
    }

    // The logged TCP poses reach below the base, so the arm stands on a 1 m column.
    body column {
        frame column_top {
            pose column_top_in_world {
                wrt: <world_body.world>
                xyz: (0.0, 0.0, 1.0) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        // The screw, z along the bit: the program-start TCP pose of log_history 9.txt, in the UR
        // base frame, which this tree mounts on column_top unturned.
        frame screw_head {
            pose screw_head_in_column {
                wrt: <column.column_top>
                xyz: (-0.672774, 0.62929, -0.0854526) m
                orientation: quat { xyzw: (-0.5072572529, -0.4949342309, -0.5073807713, 0.4901988773) }
            }
        }
        // The simulate UI's copy-camera view from check_tcp.py.
        frame front_cam_mount {
            pose front_cam_mount_in_column {
                wrt: <column.column_top>
                xyz: (0.478, -2.539, 0.384) m
                orientation: quat { xyzw: (0.6167211769, -0.031528009, -0.0401580115, 0.7855242254) }
            }
        }
        // pedestal.xml states no <inertial>: a 0.18 x 0.18 x 1.0 m box at MuJoCo's default density.
        frame column_com {
            pose column_com_in_column {
                wrt: <column.column_top>
                xyz: (0.0, 0.0, -0.5) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        inertia {
            frame: <column_com>
            mass: 32.4 kg
            inertia-matrix: (
                (2.78748, 0.0, 0.0),
                (0.0, 2.78748, 0.0),
                (0.0, 0.0, 0.17496)
            ) kg*m^2
        }
    }

    joints {
        fixed column_on_world {
            parent: <world_body.world>
            child: <column.column_top>
        }
        fixed arm_on_column {
            parent: <column.column_top>
            child: <ur10e.base.base_origin>
        }
    }
}

scene inst (ns=cu_mjc) unscrew_scene_mjc {
    scene: <unscrew_scene>

    kgraph (ns=cu_mjc) cell_graph {
        anchor: <world_tree.world_body.world>
        tree <world_tree>
    }

    obj <cell_objects.pedestal> {
        model pedestal-mjc as mjcf { sys path = 'pedestal.xml'
            map body <world_tree.column> to "column"
        }
    }

    agn <cell_agents.arm1> {
        model ur10e-mjc as mjcf {
            sys path = '~/.cache/mj_kdl_wrapper/menagerie/universal_robots_ur10e/ur10e.xml'
            map tree <ur10e> to "base"
        }

        model nutrunner-mjc as mjcf {
            sys path = 'screwdriver_tool.xml'
            map tree <nutrunner_tree> to "tool"
        }

        force-torque bit_ft {
            frame: <nutrunner_tree.tool.tcp>
            observes: force torque
            update-rate: 1000.0 Hz
        }

        camera front {
            frame: <world_tree.column.front_cam_mount>
            type: rgb
            resolution: (1280, 720)
            fov: 45.0 deg
            update-rate: 30.0 Hz
        }
    }
}
