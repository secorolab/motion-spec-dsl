<mujoco model="table_asset">
  <!--
    drawer_dual's variant of mj_kdl_wrapper's assets/table.xml. Only the top surface differs:
    MuJoCo takes the max of the two contacting frictions, so the stock 1.0 would pin the
    cabinet here no matter how slippery the cabinet's own foot is.
  -->
  <worldbody>
    <!-- Root body origin is the table top surface center. Place this asset at z=surface_z. -->
    <body name="root">
      <geom name="top" type="box" pos="0 0 -0.02" size="0.8 0.6 0.02"
            rgba="0.45 0.28 0.12 1" contype="1" conaffinity="1" condim="3"
            friction="0.23 0.005 0.0001"/>
      <geom name="leg0" type="cylinder" pos="0.77 0.57 -0.37" size="0.03 0.33"
            rgba="0.35 0.35 0.35 1" contype="1" conaffinity="1" condim="3"/>
      <geom name="leg1" type="cylinder" pos="-0.77 0.57 -0.37" size="0.03 0.33"
            rgba="0.35 0.35 0.35 1" contype="1" conaffinity="1" condim="3"/>
      <geom name="leg2" type="cylinder" pos="0.77 -0.57 -0.37" size="0.03 0.33"
            rgba="0.35 0.35 0.35 1" contype="1" conaffinity="1" condim="3"/>
      <geom name="leg3" type="cylinder" pos="-0.77 -0.57 -0.37" size="0.03 0.33"
            rgba="0.35 0.35 0.35 1" contype="1" conaffinity="1" condim="3"/>
      <site name="table_top" pos="0 0 0" size="0.001 0.001 0.001" rgba="0 0 0 0"/>
    </body>
  </worldbody>
</mujoco>
