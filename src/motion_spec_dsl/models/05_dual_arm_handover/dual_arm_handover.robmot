// The grippers sit a quarter turn apart, so they take orthogonal face pairs of the cube.
import "dual_arm_handover.fsm"
import "dual_arm_handover.scenex"
ns app = "https://secorolab.github.io/models/dual-arm-handover/"
ns fsm = "https://secorolab.github.io/models/dual-arm-handover/fsm/"

exec-context (ns=app) dual-arm-handover-exec {
    runs-scene: <dual_arm_handover_scene_mjc>
    platform:   simulation { name: "MuJoCo" }
    config:     "robot.toml"
    timestep:   1.0 ms
}

context (ns=app) shared {
    world {
        pose pose-ee1-base {
            of:         <gripper1.g_base.g_pinch>,
            wrt:        <kinova1.base_link.base_link_origin>,
            as-seen-by: <kinova1.base_link.base_link_origin>
        },
        velocity-twist twist-ee1-base {
            of:         <gripper1.g_base.g_pinch>,
            wrt:        <kinova1.base_link.base_link_origin>,
            as-seen-by: <kinova1.base_link.base_link_origin>
        },
        pose pose-cube1-base {
            of:         <dual_arm_handover_graph.cube>,
            wrt:        <kinova1.base_link.base_link_origin>,
            as-seen-by: <kinova1.base_link.base_link_origin>
        },
        joint-position gripper1-pos {
            joint: <gripper1.g_left_driver_joint>
        },
        joint-position elbow1-angle {
            joint: <kinova1.joint_3>,
            normalization: (-pi, pi) rad
        },
        pose pose-ee2-base {
            of:         <gripper2.g_base.g_pinch>,
            wrt:        <kinova2.base_link.base_link_origin>,
            as-seen-by: <kinova2.base_link.base_link_origin>
        },
        velocity-twist twist-ee2-base {
            of:         <gripper2.g_base.g_pinch>,
            wrt:        <kinova2.base_link.base_link_origin>,
            as-seen-by: <kinova2.base_link.base_link_origin>
        },
        pose pose-cube2-base {
            of:         <dual_arm_handover_graph.cube>,
            wrt:        <kinova2.base_link.base_link_origin>,
            as-seen-by: <kinova2.base_link.base_link_origin>
        },
        joint-position gripper2-pos {
            joint: <gripper2.g_left_driver_joint>
        },
        joint-position elbow2-angle {
            joint: <kinova2.joint_3>,
            normalization: (-pi, pi) rad
        }
    },
    spec {
        length satisfied-band    = 0.01 m,
        angle satisfied-band-rot = 0.01 rad,
        // Wide on purpose: the next state drives the same rows, so the residual converges there.
        length gate-band         = 0.04 m,
        angle gate-band-rot      = 0.15 rad,
        angle gripper-closed     = 0.8 rad,
        angle gripper-open       = 0.0 rad,
        angle release-band       = 0.05 rad,
        // Pads stopped on the cube: past free swing, short of closing on air.
        angle grasp-threshold    = 0.15 rad,
        angle grip-on-cube-hi    = 0.70 rad,
        length grasp-reach       = 0.015 m,
        length meet-reach        = 0.025 m,
        angle half-turn          = pi rad,
        angle quarter-turn       = pi / 2 rad,

        angle elbow-angle-target  = pi rad,
        torque elbow-torque-limit = 10.0 Nm,
        // Gen3 large-actuator peak torque.
        torque arm-torque-limit   = 39.0 Nm,

        // Caps the integral so the quarter-turn swings cannot wind it up.
        angular-acceleration ori-integral-limit = 5.0 rad/s^2,
        // Uncapped, the quarter turns and long reaches are steps: ~100 Nm on joint 2.
        angular-acceleration turn-acc-limit = 10.0 rad/s^2,
        linear-acceleration move-acc-limit  = 1.0 m/s^2,

        length above-z       = 0.26 m,
        length grasp-z       = 0.015 m,
        length lift-z        = 0.32 m,
        length lifted-gate-z = 0.28 m,

        // World (0, 0, table + 0.30), which both bases see at x = 0.70.
        length present-x = 0.70 m,
        length present-y = 0.0 m,
        length present-z = 0.30 m,
        length premeet-x = 0.58 m,
        length meet-x    = 0.70 m,

        // With the elbow pinned, the horizontal tool cannot pass x = 0.55 without folding the wrist.
        length retreat1-x = 0.58 m,
        length clear1-x   = 0.60 m,

        // A tool-down wrist at the meet point is out of arm 2's reach.
        length turn2-x = 0.50 m,

        length place-x       = 0.40 m,
        length place-y       = 0.24 m,
        length place-above-z = 0.22 m,
        length place-z       = 0.03 m,

        // Tool kept horizontal: a fold-back at this radius transits the wrist-fold singularity.
        length rest1-x = 0.60 m,
        length rest1-z = 0.43 m
    }
}

tolerances {
    linear-velocity:  0.01 m/s,
    position:         0.01 m,
    orientation:      0.01 rad
}

guarded-motion (ns=app) home {
    description: "Hold both TCPs at their startup home poses"

    context {
        spec {
            pose home1-pose = snapshot of <shared.world.pose-ee1-base> on event <fsm.E_HOME_ENTERED>,
            pose home2-pose = snapshot of <shared.world.pose-ee2-base> on event <fsm.E_HOME_ENTERED>
        }
    }

    when {}

    while {
        hold1-position:    keeping <shared.world.pose-ee1-base>.position    equal to <spec.home1-pose>.position within <shared.spec.satisfied-band>,
        hold1-orientation: keeping <shared.world.pose-ee1-base>.orientation equal to <spec.home1-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold2-position:    keeping <shared.world.pose-ee2-base>.position    equal to <spec.home2-pose>.position within <shared.spec.satisfied-band>,
        hold2-orientation: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.home2-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold1-elbow:       keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        hold2-elbow:       keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>,
        open1-gripper:     keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>,
        open2-gripper:     keeping <shared.world.gripper2-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>
    }

    until all {
        settled1: <shared.world.pose-ee1-base>.position equal to <spec.home1-pose>.position within <shared.spec.satisfied-band>,
        settled2: <shared.world.pose-ee2-base>.position equal to <spec.home2-pose>.position within <shared.spec.satisfied-band>,
        opened1:  <shared.world.gripper1-pos> equal to <shared.spec.gripper-open> within <shared.spec.release-band>,
        opened2:  <shared.world.gripper2-pos> equal to <shared.spec.gripper-open> within <shared.spec.release-band>
    }
}

guarded-motion (ns=app) pick-above {
    description: "Arm1 moves along a path to the pre-grasp position above the cube; arm2 holds"

    context {
        spec {
            linear-velocity min-approach-speed = 0.005 m/s,
            velocity-profile approach-profile = profile {
                max-velocity: 0.08 m/s,
                max-acceleration: 0.05 m/s^2,
                shape: trapezoidal
            },
            pose start1-pose     = snapshot of <shared.world.pose-ee1-base> on event <fsm.E_PICK_ABOVE_ENTERED>,
            length start1-cube-x = snapshot of <shared.world.pose-cube1-base>.position.x on event <fsm.E_PICK_ABOVE_ENTERED>,
            length start1-cube-y = snapshot of <shared.world.pose-cube1-base>.position.y on event <fsm.E_PICK_ABOVE_ENTERED>,
            pose goal1-pose = {
                position: (<spec.start1-cube-x>, <spec.start1-cube-y>, <shared.spec.above-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.half-turn>, 0.0, <shared.spec.half-turn>) }
            },
            path approach1-path = lerp { start: <spec.start1-pose>, goal: <spec.goal1-pose> },
            pose hold2-pose = snapshot of <shared.world.pose-ee2-base> on event <fsm.E_PICK_ABOVE_ENTERED>
        }
    }

    when {}

    while {
        follow1-tan:       moving <shared.world.pose-ee1-base> along <spec.approach1-path> with <spec.approach-profile>,
        follow1-lat:       keeping <shared.world.pose-ee1-base>.position    on <spec.approach1-path> within <shared.spec.satisfied-band>,
        follow1-ori:       keeping <shared.world.pose-ee1-base>.orientation on <spec.approach1-path> within <shared.spec.satisfied-band-rot>,
        advance1:          progress of <shared.world.pose-ee1-base> along <spec.approach1-path> more than <spec.min-approach-speed>,
        hold2-position:    keeping <shared.world.pose-ee2-base>.position    equal to <spec.hold2-pose>.position within <shared.spec.satisfied-band>,
        hold2-orientation: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.hold2-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold1-elbow:       keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        hold2-elbow:       keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>
    }

    until all {
        above1: <shared.world.pose-ee1-base>.position equal to <spec.goal1-pose>.position within <shared.spec.satisfied-band>
    }
}

guarded-motion (ns=app) pick {
    description: "Arm1 lowers straight down to the grasp height at the cube; arm2 holds"

    context {
        spec {
            velocity-profile lower1-profile = profile {
                max-velocity: 0.10 m/s,
                max-acceleration: 0.30 m/s^2,
                measured-velocity: <shared.world.twist-ee1-base>.linvel.z,
                max-jerk: 2.0 m/s^3,
                shape: s-curve
            },
            length grasp1-x = snapshot of <shared.world.pose-cube1-base>.position.x on event <fsm.E_PICK_ENTERED>,
            length grasp1-y = snapshot of <shared.world.pose-cube1-base>.position.y on event <fsm.E_PICK_ENTERED>,
            pose grasp1-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.half-turn>, 0.0, <shared.spec.half-turn>) }
            },
            pose hold2-pose = snapshot of <shared.world.pose-ee2-base> on event <fsm.E_PICK_ENTERED>
        }
    }

    when {}

    while {
        hold1-x:           keeping <shared.world.pose-ee1-base>.position.x  equal to <spec.grasp1-x> within <shared.spec.satisfied-band>,
        hold1-y:           keeping <shared.world.pose-ee1-base>.position.y  equal to <spec.grasp1-y> within <shared.spec.satisfied-band>,
        lower1-z:          keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.grasp-z> within <shared.spec.satisfied-band>,
        follow1-ori:       keeping <shared.world.pose-ee1-base>.orientation equal to <spec.grasp1-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold2-position:    keeping <shared.world.pose-ee2-base>.position    equal to <spec.hold2-pose>.position within <shared.spec.satisfied-band>,
        hold2-orientation: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.hold2-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold1-elbow:       keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        hold2-elbow:       keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>
    }

    until all {
        near1-cube: distance between <shared.world.pose-ee1-base> and <shared.world.pose-cube1-base> less than <shared.spec.grasp-reach>
    }
}

guarded-motion (ns=app) grasp1 {
    description: "Arm1 holds its pose while its gripper closes on the cube; arm2 holds"

    context {
        spec {
            pose hold1-pose = snapshot of <shared.world.pose-ee1-base> on event <fsm.E_GRASP1_ENTERED>,
            pose hold2-pose = snapshot of <shared.world.pose-ee2-base> on event <fsm.E_GRASP1_ENTERED>
        }
    }

    when {}

    while {
        hold1-position:    keeping <shared.world.pose-ee1-base>.position    equal to <spec.hold1-pose>.position within <shared.spec.satisfied-band>,
        hold1-orientation: keeping <shared.world.pose-ee1-base>.orientation equal to <spec.hold1-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close1-gripper:    keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,
        hold2-position:    keeping <shared.world.pose-ee2-base>.position    equal to <spec.hold2-pose>.position within <shared.spec.satisfied-band>,
        hold2-orientation: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.hold2-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold1-elbow:       keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        hold2-elbow:       keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>
    }

    until all {
        grasped1: <shared.world.gripper1-pos> between <shared.spec.grasp-threshold> and <shared.spec.grip-on-cube-hi>
    }
}

guarded-motion (ns=app) lift {
    description: "Arm1 raises the cube straight up; arm2 holds"

    context {
        spec {
            length lift1-start-x = snapshot of <shared.world.pose-ee1-base>.position.x on event <fsm.E_LIFT_ENTERED>,
            length lift1-start-y = snapshot of <shared.world.pose-ee1-base>.position.y on event <fsm.E_LIFT_ENTERED>,
            pose grasp1-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.half-turn>, 0.0, <shared.spec.half-turn>) }
            },
            pose hold2-pose = snapshot of <shared.world.pose-ee2-base> on event <fsm.E_LIFT_ENTERED>
        }
    }

    when {}

    while {
        hold1-x:           keeping <shared.world.pose-ee1-base>.position.x  equal to <spec.lift1-start-x> within <shared.spec.satisfied-band>,
        hold1-y:           keeping <shared.world.pose-ee1-base>.position.y  equal to <spec.lift1-start-y> within <shared.spec.satisfied-band>,
        lift1-z:           keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.lift-z> within <shared.spec.satisfied-band>,
        follow1-ori:       keeping <shared.world.pose-ee1-base>.orientation equal to <spec.grasp1-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close1-gripper:    keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,
        hold2-position:    keeping <shared.world.pose-ee2-base>.position    equal to <spec.hold2-pose>.position within <shared.spec.satisfied-band>,
        hold2-orientation: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.hold2-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold1-elbow:       keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        hold2-elbow:       keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>
    }

    until all {
        lifted1: <shared.world.pose-ee1-base>.position.z greater than <shared.spec.lifted-gate-z>
    }
}

guarded-motion (ns=app) present {
    description: "Arm1 presents the cube horizontally at the meet point; arm2 comes to its standoff"

    context {
        spec {
            velocity-profile reach1-x-profile = profile {
                max-velocity: 0.25 m/s,
                max-acceleration: 0.60 m/s^2,
                measured-velocity: <shared.world.twist-ee1-base>.linvel.x,
                max-jerk: 4.0 m/s^3,
                shape: s-curve
            },
            velocity-profile reach2-x-profile = profile {
                max-velocity: 0.25 m/s,
                max-acceleration: 0.60 m/s^2,
                measured-velocity: <shared.world.twist-ee2-base>.linvel.x,
                max-jerk: 4.0 m/s^3,
                shape: s-curve
            },
            velocity-profile reach2-z-profile = profile {
                max-velocity: 0.25 m/s,
                max-acceleration: 0.60 m/s^2,
                measured-velocity: <shared.world.twist-ee2-base>.linvel.z,
                max-jerk: 4.0 m/s^3,
                shape: s-curve
            },
            pose present1-pose = {
                position: (<shared.spec.present-x>, <shared.spec.present-y>, <shared.spec.present-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (0.0, <shared.spec.quarter-turn>, 0.0) }
            },
            pose premeet2-pose = {
                position: (<shared.spec.premeet-x>, <shared.spec.present-y>, <shared.spec.present-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.quarter-turn>, 0.0, <shared.spec.quarter-turn>) }
            }
        }
    }

    when {}

    while {
        reach1-x:       keeping <shared.world.pose-ee1-base>.position.x  equal to <shared.spec.present-x> within <shared.spec.satisfied-band>,
        reach1-y:       keeping <shared.world.pose-ee1-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        reach1-z:       keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        present1-ori:   keeping <shared.world.pose-ee1-base>.orientation equal to <spec.present1-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close1-gripper: keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,
        reach2-x:       keeping <shared.world.pose-ee2-base>.position.x  equal to <shared.spec.premeet-x> within <shared.spec.satisfied-band>,
        reach2-y:       keeping <shared.world.pose-ee2-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        reach2-z:       keeping <shared.world.pose-ee2-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        premeet2-ori:   keeping <shared.world.pose-ee2-base>.orientation equal to <spec.premeet2-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold1-elbow:    keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        hold2-elbow:    keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>
    }

    until all {
        present1-pos-ok: <shared.world.pose-ee1-base>.position    equal to <spec.present1-pose>.position    within <shared.spec.gate-band>,
        present1-rot-ok: <shared.world.pose-ee1-base>.orientation equal to <spec.present1-pose>.orientation within <shared.spec.gate-band-rot>,
        premeet2-pos-ok: <shared.world.pose-ee2-base>.position    equal to <spec.premeet2-pose>.position    within <shared.spec.gate-band>,
        premeet2-rot-ok: <shared.world.pose-ee2-base>.orientation equal to <spec.premeet2-pose>.orientation within <shared.spec.gate-band-rot>
    }
}

guarded-motion (ns=app) meet {
    description: "Arm2 advances until the cube sits between its pads; arm1 keeps presenting"

    context {
        spec {
            pose present1-pose = {
                position: (<shared.spec.present-x>, <shared.spec.present-y>, <shared.spec.present-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (0.0, <shared.spec.quarter-turn>, 0.0) }
            },
            pose meet2-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.quarter-turn>, 0.0, <shared.spec.quarter-turn>) }
            }
        }
    }

    when {}

    while {
        hold1-x:        keeping <shared.world.pose-ee1-base>.position.x  equal to <shared.spec.present-x> within <shared.spec.satisfied-band>,
        hold1-y:        keeping <shared.world.pose-ee1-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        hold1-z:        keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        present1-ori:   keeping <shared.world.pose-ee1-base>.orientation equal to <spec.present1-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close1-gripper: keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,
        advance2-x:     keeping <shared.world.pose-ee2-base>.position.x  equal to <shared.spec.meet-x> within <shared.spec.satisfied-band>,
        hold2-y:        keeping <shared.world.pose-ee2-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        hold2-z:        keeping <shared.world.pose-ee2-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        meet2-ori:      keeping <shared.world.pose-ee2-base>.orientation equal to <spec.meet2-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold1-elbow:    keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        hold2-elbow:    keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>
    }

    until all {
        at2-cube: distance between <shared.world.pose-ee2-base> and <shared.world.pose-cube2-base> less than <shared.spec.meet-reach>
    }
}

guarded-motion (ns=app) grasp2 {
    description: "Arm2 closes on the cube while both arms hold their poses softly"

    context {
        spec {
            pose present1-pose = {
                position: (<shared.spec.present-x>, <shared.spec.present-y>, <shared.spec.present-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (0.0, <shared.spec.quarter-turn>, 0.0) }
            },
            pose meet2-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.quarter-turn>, 0.0, <shared.spec.quarter-turn>) }
            }
        }
    }

    when {}

    while {
        hold1-x:        keeping <shared.world.pose-ee1-base>.position.x  equal to <shared.spec.present-x> within <shared.spec.satisfied-band>,
        hold1-y:        keeping <shared.world.pose-ee1-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        hold1-z:        keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        present1-ori:   keeping <shared.world.pose-ee1-base>.orientation equal to <spec.present1-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close1-gripper: keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,
        hold2-x:        keeping <shared.world.pose-ee2-base>.position.x  equal to <shared.spec.meet-x> within <shared.spec.satisfied-band>,
        hold2-y:        keeping <shared.world.pose-ee2-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        hold2-z:        keeping <shared.world.pose-ee2-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        meet2-ori:      keeping <shared.world.pose-ee2-base>.orientation equal to <spec.meet2-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close2-gripper: keeping <shared.world.gripper2-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,
        hold1-elbow:    keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        hold2-elbow:    keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>
    }

    until all {
        grasped2: <shared.world.gripper2-pos> between <shared.spec.grasp-threshold> and <shared.spec.grip-on-cube-hi>
    }
}

guarded-motion (ns=app) release1 {
    description: "Arm1 opens its gripper while both arms hold; the cube passes to arm2"

    context {
        spec {
            pose present1-pose = {
                position: (<shared.spec.present-x>, <shared.spec.present-y>, <shared.spec.present-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (0.0, <shared.spec.quarter-turn>, 0.0) }
            },
            pose meet2-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.quarter-turn>, 0.0, <shared.spec.quarter-turn>) }
            }
        }
    }

    when {}

    while {
        hold1-x:        keeping <shared.world.pose-ee1-base>.position.x  equal to <shared.spec.present-x> within <shared.spec.satisfied-band>,
        hold1-y:        keeping <shared.world.pose-ee1-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        hold1-z:        keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        present1-ori:   keeping <shared.world.pose-ee1-base>.orientation equal to <spec.present1-pose>.orientation within <shared.spec.satisfied-band-rot>,
        open1-gripper:  keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>,
        hold2-x:        keeping <shared.world.pose-ee2-base>.position.x  equal to <shared.spec.meet-x> within <shared.spec.satisfied-band>,
        hold2-y:        keeping <shared.world.pose-ee2-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        hold2-z:        keeping <shared.world.pose-ee2-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        meet2-ori:      keeping <shared.world.pose-ee2-base>.orientation equal to <spec.meet2-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close2-gripper: keeping <shared.world.gripper2-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,
        hold1-elbow:    keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        hold2-elbow:    keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>
    }

    until all {
        released1: <shared.world.gripper1-pos> equal to <shared.spec.gripper-open> within <shared.spec.release-band>
    }
}

// In arm 2's xz plane the turn moves only joints 2, 4 and 6 through the wrist singularity.
guarded-motion (ns=app) turn2 {
    description: "Arm1 retreats clear of the meet; arm2 draws the cube in and turns its tool down"

    context {
        spec {
            velocity-profile retreat1-x-profile = profile {
                max-velocity: 0.25 m/s,
                max-acceleration: 0.60 m/s^2,
                measured-velocity: <shared.world.twist-ee1-base>.linvel.x,
                max-jerk: 4.0 m/s^3,
                shape: s-curve
            },
            pose retreat1-pose = {
                position: (<shared.spec.retreat1-x>, <shared.spec.present-y>, <shared.spec.present-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (0.0, <shared.spec.quarter-turn>, 0.0) }
            },
            velocity-profile draw2-x-profile = profile {
                max-velocity: 0.15 m/s,
                max-acceleration: 0.40 m/s^2,
                measured-velocity: <shared.world.twist-ee2-base>.linvel.x,
                max-jerk: 4.0 m/s^3,
                shape: s-curve
            },
            pose place2-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.half-turn>, 0.0, <shared.spec.quarter-turn>) }
            }
        }
    }

    when {}

    while {
        retreat1-x:     keeping <shared.world.pose-ee1-base>.position.x  equal to <shared.spec.retreat1-x> within <shared.spec.satisfied-band>,
        hold1-y:        keeping <shared.world.pose-ee1-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        hold1-z:        keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        present1-ori:   keeping <shared.world.pose-ee1-base>.orientation equal to <spec.retreat1-pose>.orientation within <shared.spec.satisfied-band-rot>,
        open1-gripper:  keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>,
        draw2-x:        keeping <shared.world.pose-ee2-base>.position.x  equal to <shared.spec.turn2-x> within <shared.spec.satisfied-band>,
        hold2-y:        keeping <shared.world.pose-ee2-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        hold2-z:        keeping <shared.world.pose-ee2-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        turn2-ori:      keeping <shared.world.pose-ee2-base>.orientation equal to <spec.place2-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close2-gripper: keeping <shared.world.gripper2-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,
        hold1-elbow:    keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        hold2-elbow:    keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>
    }

    until all {
        clear1:  <shared.world.pose-ee1-base>.position.x less than <shared.spec.clear1-x>,
        drawn2:  <shared.world.pose-ee2-base>.position.x equal to <shared.spec.turn2-x> within <shared.spec.gate-band>,
        turned2: <shared.world.pose-ee2-base>.orientation equal to <spec.place2-ori-pose>.orientation within <shared.spec.gate-band-rot>
    }
}

guarded-motion (ns=app) transport {
    description: "Arm1 holds clear of the meet; arm2 carries the cube above its place point"

    context {
        spec {
            velocity-profile retreat1-x-profile = profile {
                max-velocity: 0.25 m/s,
                max-acceleration: 0.60 m/s^2,
                measured-velocity: <shared.world.twist-ee1-base>.linvel.x,
                max-jerk: 4.0 m/s^3,
                shape: s-curve
            },
            velocity-profile reach2-x-profile = profile {
                max-velocity: 0.25 m/s,
                max-acceleration: 0.60 m/s^2,
                measured-velocity: <shared.world.twist-ee2-base>.linvel.x,
                max-jerk: 4.0 m/s^3,
                shape: s-curve
            },
            velocity-profile reach2-y-profile = profile {
                max-velocity: 0.25 m/s,
                max-acceleration: 0.60 m/s^2,
                measured-velocity: <shared.world.twist-ee2-base>.linvel.y,
                max-jerk: 4.0 m/s^3,
                shape: s-curve
            },
            pose retreat1-pose = {
                position: (<shared.spec.retreat1-x>, <shared.spec.present-y>, <shared.spec.present-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (0.0, <shared.spec.quarter-turn>, 0.0) }
            },
            pose place2-above-pose = {
                position: (<shared.spec.place-x>, <shared.spec.place-y>, <shared.spec.place-above-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.half-turn>, 0.0, <shared.spec.quarter-turn>) }
            }
        }
    }

    when {}

    while {
        retreat1-x:     keeping <shared.world.pose-ee1-base>.position.x  equal to <shared.spec.retreat1-x> within <shared.spec.satisfied-band>,
        hold1-y:        keeping <shared.world.pose-ee1-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        hold1-z:        keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        present1-ori:   keeping <shared.world.pose-ee1-base>.orientation equal to <spec.retreat1-pose>.orientation within <shared.spec.satisfied-band-rot>,
        open1-gripper:  keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>,
        reach2-x:       keeping <shared.world.pose-ee2-base>.position.x  equal to <shared.spec.place-x> within <shared.spec.satisfied-band>,
        reach2-y:       keeping <shared.world.pose-ee2-base>.position.y  equal to <shared.spec.place-y> within <shared.spec.satisfied-band>,
        reach2-z:       keeping <shared.world.pose-ee2-base>.position.z  equal to <shared.spec.place-above-z> within <shared.spec.satisfied-band>,
        place2-ori:     keeping <shared.world.pose-ee2-base>.orientation equal to <spec.place2-above-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close2-gripper: keeping <shared.world.gripper2-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,
        hold1-elbow:    keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        hold2-elbow:    keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>
    }

    until all {
        clear1:        <shared.world.pose-ee1-base>.position.x less than <shared.spec.clear1-x>,
        at2-above:     <shared.world.pose-ee2-base>.position    equal to <spec.place2-above-pose>.position    within <shared.spec.gate-band>,
        at2-above-rot: <shared.world.pose-ee2-base>.orientation equal to <spec.place2-above-pose>.orientation within <shared.spec.gate-band-rot>
    }
}

guarded-motion (ns=app) place {
    description: "Arm2 lowers the cube to the place height; arm1 folds back to its rest posture"

    context {
        spec {
            pose place2-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.half-turn>, 0.0, <shared.spec.quarter-turn>) }
            },
            pose rest1-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (0.0, <shared.spec.quarter-turn>, 0.0) }
            }
        }
    }

    when {}

    while {
        rest1-x:        keeping <shared.world.pose-ee1-base>.position.x  equal to <shared.spec.rest1-x> within <shared.spec.satisfied-band>,
        rest1-y:        keeping <shared.world.pose-ee1-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        rest1-z:        keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.rest1-z> within <shared.spec.satisfied-band>,
        rest1-ori:      keeping <shared.world.pose-ee1-base>.orientation equal to <spec.rest1-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold2-x:        keeping <shared.world.pose-ee2-base>.position.x  equal to <shared.spec.place-x> within <shared.spec.satisfied-band>,
        hold2-y:        keeping <shared.world.pose-ee2-base>.position.y  equal to <shared.spec.place-y> within <shared.spec.satisfied-band>,
        lower2-z:       keeping <shared.world.pose-ee2-base>.position.z  equal to <shared.spec.place-z> within <shared.spec.satisfied-band>,
        place2-ori:     keeping <shared.world.pose-ee2-base>.orientation equal to <spec.place2-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close2-gripper: keeping <shared.world.gripper2-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,
        hold1-elbow:    keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        hold2-elbow:    keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>
    }

    until all {
        at2-place: <shared.world.pose-ee2-base>.position.z equal to <shared.spec.place-z> within <shared.spec.satisfied-band>
    }
}

guarded-motion (ns=app) release2 {
    description: "Arm2 opens its gripper at the place point; both arms hold"

    context {
        spec {
            pose rest1-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (0.0, <shared.spec.quarter-turn>, 0.0) }
            },
            pose hold2-pose = snapshot of <shared.world.pose-ee2-base> on event <fsm.E_RELEASE2_ENTERED>
        }
    }

    when {}

    while {
        rest1-x:           keeping <shared.world.pose-ee1-base>.position.x  equal to <shared.spec.rest1-x> within <shared.spec.satisfied-band>,
        rest1-y:           keeping <shared.world.pose-ee1-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        rest1-z:           keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.rest1-z> within <shared.spec.satisfied-band>,
        rest1-ori:         keeping <shared.world.pose-ee1-base>.orientation equal to <spec.rest1-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold2-position:    keeping <shared.world.pose-ee2-base>.position    equal to <spec.hold2-pose>.position within <shared.spec.satisfied-band>,
        hold2-orientation: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.hold2-pose>.orientation within <shared.spec.satisfied-band-rot>,
        open2-gripper:     keeping <shared.world.gripper2-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>,
        hold1-elbow:       keeping <shared.world.elbow1-angle> equal to <shared.spec.elbow-angle-target>,
        hold2-elbow:       keeping <shared.world.elbow2-angle> equal to <shared.spec.elbow-angle-target>
    }

    until all {
        released2:  <shared.world.gripper2-pos> equal to <shared.spec.gripper-open> within <shared.spec.release-band>,
        rest1-x-ok: <shared.world.pose-ee1-base>.position.x equal to <shared.spec.rest1-x> within <shared.spec.satisfied-band>,
        rest1-z-ok: <shared.world.pose-ee1-base>.position.z equal to <shared.spec.rest1-z> within <shared.spec.satisfied-band>
    }
}

constraint-handler (ns=app) handler-home {
    handles: <home>
    runs-in: <fsm.S_HOME>
    monitors {
        mon-home-settled: monitor <home.until> {
            satisfied for 0.5 s { trigger: event <fsm.E_PICK_ABOVE_READY> }
        }
    }
    controllers {
        pid ctrl-home-hold1-position    { constraint: <home.hold1-position>,    Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <arm1-solver>,
        pid ctrl-home-hold1-orientation { constraint: <home.hold1-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <arm1-solver>,
        pid ctrl-home-hold2-position    { constraint: <home.hold2-position>,    Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <arm2-solver>,
        pid ctrl-home-hold2-orientation { constraint: <home.hold2-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <arm2-solver>,
        pid ctrl-home-hold1-elbow {
            constraint: <home.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm1-solver>,
        pid ctrl-home-hold2-elbow {
            constraint: <home.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <arm2-solver>,
        feed-forward ctrl-home-open1-gripper { constraint: <home.open1-gripper> } via <gripper1-solver>,
        feed-forward ctrl-home-open2-gripper { constraint: <home.open2-gripper> } via <gripper2-solver>
    }
    solvers {
        arm1-solver: serial-chain {
            agent:     <agents.arm1>,
            algorithm: achd,
            limits {   torque: saturation { max: <shared.spec.arm-torque-limit> } },
            gravity:   (0.0, 0.0, 9.81) m/s^2
        },
        arm2-solver: serial-chain {
            agent:     <agents.arm2>,
            algorithm: achd,
            limits {   torque: saturation { max: <shared.spec.arm-torque-limit> } },
            gravity:   (0.0, 0.0, 9.81) m/s^2
        },
        gripper1-solver: command-forwarding {
            agent: <agents.gripper1>
        },
        gripper2-solver: command-forwarding {
            agent: <agents.gripper2>
        }
    }
}

constraint-handler (ns=app) handler-pick-above {
    handles: <pick-above>
    runs-in: <fsm.S_PICK_ABOVE>
    monitors {
        mon-pick-above-done: monitor <pick-above.until> {
            satisfied for 0.3 s { trigger: event <fsm.E_PICK_READY> }
        }
    }
    controllers {
        pid ctrl-pick-above-follow1-tan       { constraint: <pick-above.follow1-tan>, Kp: 20,  Ki: 4,   Kd: 0,  decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pick-above-follow1-lat       { constraint: <pick-above.follow1-lat>, measured-derivative: <shared.world.twist-ee1-base>.linvel, Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pick-above-follow1-ori       { constraint: <pick-above.follow1-ori>, measured-derivative: <shared.world.twist-ee1-base>.angvel, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pick-above-hold2-position    { constraint: <pick-above.hold2-position>,    Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pick-above-hold2-orientation { constraint: <pick-above.hold2-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pick-above-hold1-elbow {
            constraint: <pick-above.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm1-solver>,
        pid ctrl-pick-above-hold2-elbow {
            constraint: <pick-above.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>
    }
}

constraint-handler (ns=app) handler-pick {
    handles: <pick>
    runs-in: <fsm.S_PICK>
    monitors {
        mon-pick-done: monitor <pick.until> {
            satisfied { trigger: event <fsm.E_GRASP1_READY> }
        }
    }
    controllers {
        pid ctrl-pick-hold1-x             { constraint: <pick.hold1-x>, Kp: 200, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pick-hold1-y             { constraint: <pick.hold1-y>, Kp: 200, Ki: 30, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pick-lower1-z            { constraint: <pick.lower1-z>, profile: <pick.spec.lower1-profile>, measured-derivative: <shared.world.twist-ee1-base>.linvel.z, Kp: 12, Ki: 5, Kd: 15, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pick-follow1-ori         { constraint: <pick.follow1-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pick-hold2-position      { constraint: <pick.hold2-position>,    Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pick-hold2-orientation   { constraint: <pick.hold2-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pick-hold1-elbow {
            constraint: <pick.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm1-solver>,
        pid ctrl-pick-hold2-elbow {
            constraint: <pick.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>
    }
}

constraint-handler (ns=app) handler-grasp1 {
    handles: <grasp1>
    runs-in: <fsm.S_GRASP1>
    monitors {
        mon-grasp1-done: monitor <grasp1.until> {
            satisfied for 0.2 s { trigger: event <fsm.E_LIFT_READY> }
        }
    }
    controllers {
        pid ctrl-grasp1-hold1-position    { constraint: <grasp1.hold1-position>,    Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-grasp1-hold1-orientation { constraint: <grasp1.hold1-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        feed-forward ctrl-grasp1-close1-gripper { constraint: <grasp1.close1-gripper> } via <handler-home.gripper1-solver>,
        pid ctrl-grasp1-hold2-position    { constraint: <grasp1.hold2-position>,    Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-grasp1-hold2-orientation { constraint: <grasp1.hold2-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-grasp1-hold1-elbow {
            constraint: <grasp1.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm1-solver>,
        pid ctrl-grasp1-hold2-elbow {
            constraint: <grasp1.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-home.gripper1-solver>
    }
}

constraint-handler (ns=app) handler-lift {
    handles: <lift>
    runs-in: <fsm.S_LIFT>
    monitors {
        mon-lift-done: monitor <lift.until> {
            satisfied { trigger: event <fsm.E_PRESENT_READY> }
        }
    }
    controllers {
        pid ctrl-lift-hold1-x           { constraint: <lift.hold1-x>,     Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-lift-hold1-y           { constraint: <lift.hold1-y>,     Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-lift-lift1-z           { constraint: <lift.lift1-z>,     Kp: 15,  Ki: 5,   Kd: 20, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-lift-follow1-ori       { constraint: <lift.follow1-ori>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        feed-forward ctrl-lift-close1-gripper { constraint: <lift.close1-gripper> } via <handler-home.gripper1-solver>,
        pid ctrl-lift-hold2-position    { constraint: <lift.hold2-position>,    Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-lift-hold2-orientation { constraint: <lift.hold2-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-lift-hold1-elbow {
            constraint: <lift.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm1-solver>,
        pid ctrl-lift-hold2-elbow {
            constraint: <lift.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-home.gripper1-solver>
    }
}

constraint-handler (ns=app) handler-present {
    handles: <present>
    runs-in: <fsm.S_PRESENT>
    monitors {
        mon-present-done: monitor <present.until> {
            satisfied for 0.3 s { trigger: event <fsm.E_MEET_READY> }
        }
    }
    controllers {
        pid ctrl-present-reach1-x     { constraint: <present.reach1-x>, profile: <present.spec.reach1-x-profile>, measured-derivative: <shared.world.twist-ee1-base>.linvel.x, Kp: 100, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-present-reach1-y     { constraint: <present.reach1-y>, output-saturation: saturation { max: <shared.spec.move-acc-limit> }, Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-present-reach1-z     { constraint: <present.reach1-z>, output-saturation: saturation { max: <shared.spec.move-acc-limit> }, Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-present-present1-ori { constraint: <present.present1-ori>, output-saturation: saturation { max: <shared.spec.turn-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 60, Ki: 10, Kd: 60, decay: 0 } via <handler-home.arm1-solver>,
        feed-forward ctrl-present-close1-gripper { constraint: <present.close1-gripper> } via <handler-home.gripper1-solver>,
        pid ctrl-present-reach2-x     { constraint: <present.reach2-x>, profile: <present.spec.reach2-x-profile>, measured-derivative: <shared.world.twist-ee2-base>.linvel.x, Kp: 100, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-present-reach2-y     { constraint: <present.reach2-y>, output-saturation: saturation { max: <shared.spec.move-acc-limit> }, Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-present-reach2-z     { constraint: <present.reach2-z>, profile: <present.spec.reach2-z-profile>, measured-derivative: <shared.world.twist-ee2-base>.linvel.z, Kp: 100, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-present-premeet2-ori { constraint: <present.premeet2-ori>, output-saturation: saturation { max: <shared.spec.turn-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 60, Ki: 10, Kd: 60, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-present-hold1-elbow {
            constraint: <present.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm1-solver>,
        pid ctrl-present-hold2-elbow {
            constraint: <present.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-home.gripper1-solver>
    }
}

constraint-handler (ns=app) handler-meet {
    handles: <meet>
    runs-in: <fsm.S_MEET>
    monitors {
        mon-meet-done: monitor <meet.until> {
            satisfied for 0.2 s { trigger: event <fsm.E_GRASP2_READY> }
        }
    }
    controllers {
        pid ctrl-meet-hold1-x      { constraint: <meet.hold1-x>,      Kp: 180, Ki: 40, Kd: 60, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-meet-hold1-y      { constraint: <meet.hold1-y>,      Kp: 180, Ki: 40, Kd: 60, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-meet-hold1-z      { constraint: <meet.hold1-z>,      Kp: 180, Ki: 40, Kd: 60, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-meet-present1-ori { constraint: <meet.present1-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        feed-forward ctrl-meet-close1-gripper { constraint: <meet.close1-gripper> } via <handler-home.gripper1-solver>,
        pid ctrl-meet-advance2-x   { constraint: <meet.advance2-x>,   Kp: 60,  Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-meet-hold2-y      { constraint: <meet.hold2-y>,      Kp: 180, Ki: 40, Kd: 60, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-meet-hold2-z      { constraint: <meet.hold2-z>,      Kp: 180, Ki: 40, Kd: 60, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-meet-meet2-ori    { constraint: <meet.meet2-ori>,    Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-meet-hold1-elbow {
            constraint: <meet.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm1-solver>,
        pid ctrl-meet-hold2-elbow {
            constraint: <meet.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-home.gripper1-solver>
    }
}

constraint-handler (ns=app) handler-grasp2 {
    handles: <grasp2>
    runs-in: <fsm.S_GRASP2>
    monitors {
        mon-grasp2-done: monitor <grasp2.until> {
            satisfied for 0.2 s { trigger: event <fsm.E_RELEASE1_READY> }
        }
    }
    controllers {
        pid ctrl-grasp2-hold1-x      { constraint: <grasp2.hold1-x>,      Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-grasp2-hold1-y      { constraint: <grasp2.hold1-y>,      Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-grasp2-hold1-z      { constraint: <grasp2.hold1-z>,      Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-grasp2-present1-ori { constraint: <grasp2.present1-ori>, Kp: 80, Ki: 0, Kd: 50, decay: 0 } via <handler-home.arm1-solver>,
        feed-forward ctrl-grasp2-close1-gripper { constraint: <grasp2.close1-gripper> } via <handler-home.gripper1-solver>,
        pid ctrl-grasp2-hold2-x      { constraint: <grasp2.hold2-x>,      Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-grasp2-hold2-y      { constraint: <grasp2.hold2-y>,      Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-grasp2-hold2-z      { constraint: <grasp2.hold2-z>,      Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-grasp2-meet2-ori    { constraint: <grasp2.meet2-ori>,    Kp: 80, Ki: 0, Kd: 50, decay: 0 } via <handler-home.arm2-solver>,
        feed-forward ctrl-grasp2-close2-gripper { constraint: <grasp2.close2-gripper> } via <handler-home.gripper2-solver>,
        pid ctrl-grasp2-hold1-elbow {
            constraint: <grasp2.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm1-solver>,
        pid ctrl-grasp2-hold2-elbow {
            constraint: <grasp2.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-home.gripper1-solver>,
        <handler-home.gripper2-solver>
    }
}

constraint-handler (ns=app) handler-release1 {
    handles: <release1>
    runs-in: <fsm.S_RELEASE1>
    monitors {
        mon-release1-done: monitor <release1.until> {
            satisfied for 0.2 s { trigger: event <fsm.E_TURN2_READY> }
        }
    }
    controllers {
        pid ctrl-release1-hold1-x      { constraint: <release1.hold1-x>,      Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-release1-hold1-y      { constraint: <release1.hold1-y>,      Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-release1-hold1-z      { constraint: <release1.hold1-z>,      Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-release1-present1-ori { constraint: <release1.present1-ori>, Kp: 80, Ki: 0, Kd: 50, decay: 0 } via <handler-home.arm1-solver>,
        feed-forward ctrl-release1-open1-gripper { constraint: <release1.open1-gripper> } via <handler-home.gripper1-solver>,
        pid ctrl-release1-hold2-x      { constraint: <release1.hold2-x>,      Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-release1-hold2-y      { constraint: <release1.hold2-y>,      Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-release1-hold2-z      { constraint: <release1.hold2-z>,      Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-release1-meet2-ori    { constraint: <release1.meet2-ori>,    Kp: 80, Ki: 0, Kd: 50, decay: 0 } via <handler-home.arm2-solver>,
        feed-forward ctrl-release1-close2-gripper { constraint: <release1.close2-gripper> } via <handler-home.gripper2-solver>,
        pid ctrl-release1-hold1-elbow {
            constraint: <release1.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm1-solver>,
        pid ctrl-release1-hold2-elbow {
            constraint: <release1.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-home.gripper1-solver>,
        <handler-home.gripper2-solver>
    }
}

constraint-handler (ns=app) handler-turn2 {
    handles: <turn2>
    runs-in: <fsm.S_TURN2>
    monitors {
        mon-turn2-done: monitor <turn2.until> {
            satisfied for 0.2 s { trigger: event <fsm.E_TRANSPORT_READY> }
        }
    }
    controllers {
        pid ctrl-turn2-retreat1-x   { constraint: <turn2.retreat1-x>, profile: <turn2.spec.retreat1-x-profile>, measured-derivative: <shared.world.twist-ee1-base>.linvel.x, Kp: 100, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-turn2-hold1-y      { constraint: <turn2.hold1-y>,      Kp: 120, Ki: 20, Kd: 45, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-turn2-hold1-z      { constraint: <turn2.hold1-z>,      Kp: 120, Ki: 20, Kd: 45, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-turn2-present1-ori { constraint: <turn2.present1-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        feed-forward ctrl-turn2-open1-gripper { constraint: <turn2.open1-gripper> } via <handler-home.gripper1-solver>,
        pid ctrl-turn2-draw2-x      { constraint: <turn2.draw2-x>, profile: <turn2.spec.draw2-x-profile>, measured-derivative: <shared.world.twist-ee2-base>.linvel.x, Kp: 100, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-turn2-hold2-y      { constraint: <turn2.hold2-y>, Kp: 140, Ki: 20, Kd: 55, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-turn2-hold2-z      { constraint: <turn2.hold2-z>, Kp: 140, Ki: 20, Kd: 55, decay: 0 } via <handler-home.arm2-solver>,
        // Critically damped at 0.8 rad/s, so the quarter turn keeps the wrist joints under their speed limit.
        pid ctrl-turn2-turn2-ori    { constraint: <turn2.turn2-ori>, measured-derivative: <shared.world.twist-ee2-base>.angvel, Kp: 0.64, Ki: 0, Kd: 1.6, decay: 0 } via <handler-home.arm2-solver>,
        feed-forward ctrl-turn2-close2-gripper { constraint: <turn2.close2-gripper> } via <handler-home.gripper2-solver>,
        pid ctrl-turn2-hold1-elbow {
            constraint: <turn2.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm1-solver>,
        pid ctrl-turn2-hold2-elbow {
            constraint: <turn2.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-home.gripper1-solver>,
        <handler-home.gripper2-solver>
    }
}

constraint-handler (ns=app) handler-transport {
    handles: <transport>
    runs-in: <fsm.S_TRANSPORT>
    monitors {
        mon-transport-done: monitor <transport.until> {
            satisfied for 0.2 s { trigger: event <fsm.E_PLACE_READY> }
        }
    }
    controllers {
        pid ctrl-transport-retreat1-x   { constraint: <transport.retreat1-x>, profile: <transport.spec.retreat1-x-profile>, measured-derivative: <shared.world.twist-ee1-base>.linvel.x, Kp: 100, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-transport-hold1-y      { constraint: <transport.hold1-y>,      Kp: 120, Ki: 20, Kd: 45, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-transport-hold1-z      { constraint: <transport.hold1-z>,      Kp: 120, Ki: 20, Kd: 45, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-transport-present1-ori { constraint: <transport.present1-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        feed-forward ctrl-transport-open1-gripper { constraint: <transport.open1-gripper> } via <handler-home.gripper1-solver>,
        pid ctrl-transport-reach2-x     { constraint: <transport.reach2-x>, profile: <transport.spec.reach2-x-profile>, measured-derivative: <shared.world.twist-ee2-base>.linvel.x, Kp: 100, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-transport-reach2-y     { constraint: <transport.reach2-y>, profile: <transport.spec.reach2-y-profile>, measured-derivative: <shared.world.twist-ee2-base>.linvel.y, Kp: 100, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-transport-reach2-z     { constraint: <transport.reach2-z>, output-saturation: saturation { max: <shared.spec.move-acc-limit> }, Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-transport-place2-ori   { constraint: <transport.place2-ori>, output-saturation: saturation { max: <shared.spec.turn-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 60, Ki: 10, Kd: 60, decay: 0 } via <handler-home.arm2-solver>,
        feed-forward ctrl-transport-close2-gripper { constraint: <transport.close2-gripper> } via <handler-home.gripper2-solver>,
        pid ctrl-transport-hold1-elbow {
            constraint: <transport.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm1-solver>,
        pid ctrl-transport-hold2-elbow {
            constraint: <transport.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-home.gripper1-solver>,
        <handler-home.gripper2-solver>
    }
}

constraint-handler (ns=app) handler-place {
    handles: <place>
    runs-in: <fsm.S_PLACE>
    monitors {
        mon-place-done: monitor <place.until> {
            satisfied for 0.2 s { trigger: event <fsm.E_RELEASE2_READY> }
        }
    }
    controllers {
        pid ctrl-place-rest1-x    { constraint: <place.rest1-x>, output-saturation: saturation { max: <shared.spec.move-acc-limit> }, Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-place-rest1-y    { constraint: <place.rest1-y>, output-saturation: saturation { max: <shared.spec.move-acc-limit> }, Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-place-rest1-z    { constraint: <place.rest1-z>, output-saturation: saturation { max: <shared.spec.move-acc-limit> }, Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-place-rest1-ori  { constraint: <place.rest1-ori>, output-saturation: saturation { max: <shared.spec.turn-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 60, Ki: 10, Kd: 60, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-place-hold2-x    { constraint: <place.hold2-x>,    Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-place-hold2-y    { constraint: <place.hold2-y>,    Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-place-lower2-z   { constraint: <place.lower2-z>,   Kp: 15,  Ki: 5,  Kd: 40,  decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-place-place2-ori { constraint: <place.place2-ori>, Kp: 180, Ki: 30, Kd: 120, decay: 0 } via <handler-home.arm2-solver>,
        feed-forward ctrl-place-close2-gripper { constraint: <place.close2-gripper> } via <handler-home.gripper2-solver>,
        pid ctrl-place-hold1-elbow {
            constraint: <place.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm1-solver>,
        pid ctrl-place-hold2-elbow {
            constraint: <place.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-home.gripper2-solver>
    }
}

constraint-handler (ns=app) handler-release2 {
    handles: <release2>
    runs-in: <fsm.S_RELEASE2>
    monitors {
        mon-release2-done: monitor <release2.until> {
            satisfied for 0.3 s { trigger: event <fsm.E_DONE_READY> }
        }
    }
    controllers {
        pid ctrl-release2-rest1-x           { constraint: <release2.rest1-x>, output-saturation: saturation { max: <shared.spec.move-acc-limit> }, Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-release2-rest1-y           { constraint: <release2.rest1-y>, output-saturation: saturation { max: <shared.spec.move-acc-limit> }, Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-release2-rest1-z           { constraint: <release2.rest1-z>, output-saturation: saturation { max: <shared.spec.move-acc-limit> }, Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-release2-rest1-ori         { constraint: <release2.rest1-ori>, output-saturation: saturation { max: <shared.spec.turn-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 60, Ki: 10, Kd: 60, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-release2-hold2-position    { constraint: <release2.hold2-position>,    Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-release2-hold2-orientation { constraint: <release2.hold2-orientation>, Kp: 180, Ki: 30, Kd: 120, decay: 0 } via <handler-home.arm2-solver>,
        feed-forward ctrl-release2-open2-gripper { constraint: <release2.open2-gripper> } via <handler-home.gripper2-solver>,
        pid ctrl-release2-hold1-elbow {
            constraint: <release2.hold1-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm1-solver>,
        pid ctrl-release2-hold2-elbow {
            constraint: <release2.hold2-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-home.gripper2-solver>
    }
}
