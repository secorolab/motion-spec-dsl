import "dual_arm_handover.scene"
import "../common/dual_arm_table.scenex"

ns hod_mjc = "https://secorolab.github.io/models/scenes/dual-arm-handover-mjc/"

scene inst (ns=hod_mjc) dual_arm_handover_scene_mjc {
    scene: <dual_arm_handover_scene>

    kgraph (ns=hod_mjc) dual_arm_handover_graph {
        anchor: <world_tree.world_body.world>
        tree <world_tree>

        body cube {
            frame cube_origin {
                pose cube_in_world {
                    wrt: <world_tree.world_body.world>
                    xyz: (-0.20, 0.0, 0.76) m
                    orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
                }
            }
        }
    }

    obj <ws_objects.table> {
        model table-mjc as mjcf { sys path = 'src/mjkdl/assets/table.xml'
            map body <world_tree.table> to "table"
        }
    }

    obj <objects.cube> {
        model cube-mjc as mjcf { sys path = 'src/mjkdl/assets/cube.xml'
            map body <dual_arm_handover_graph.cube> to "cube"
        }
    }

    agn <agents.arm1> {
        model arm1-mjc as mjcf {
            sys path = 'src/mjkdl/assets/kinova_gen3/gen3.xml'
            map tree <kinova1> to "base_link"
        }
    }

    agn <agents.gripper1> {
        model gripper1-mjc as mjcf {
            sys path = 'src/mjkdl/assets/robotiq_2f85/2f85.xml'
            map tree <gripper1> to "base_mount"
        }
    }

    agn <agents.arm2> {
        model arm2-mjc as mjcf {
            sys path = 'src/mjkdl/assets/kinova_gen3/gen3.xml'
            map tree <kinova2> to "base_link"
        }

        camera side {
            frame: <world_tree.table.side_cam_mount>
            type: rgb
            resolution: (1280, 720)
            fov: 55.0 deg
            update-rate: 30.0 Hz
        }
    }

    agn <agents.gripper2> {
        model gripper2-mjc as mjcf {
            sys path = 'src/mjkdl/assets/robotiq_2f85/2f85.xml'
            map tree <gripper2> to "base_mount"
        }
    }
}
