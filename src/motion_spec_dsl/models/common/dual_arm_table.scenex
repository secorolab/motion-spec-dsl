import "scene_dsl:robots/kinova_gen3_7dof.ktree"
import "scene_dsl:robots/robotiq_2f85.ktree"

ns dat = "https://secorolab.github.io/models/common/dual-arm-table/"

ktree inst (ns=dat) kinova1 of <kinova_tree>
ktree inst (ns=dat) gripper1 of <gripper_tree>
ktree inst (ns=dat) kinova2 of <kinova_tree>
ktree inst (ns=dat) gripper2 of <gripper_tree>

ktree (ns=dat) arm1_tree {
    root: <kinova1.base_link.base_link_origin>
    tree <kinova1>
    tree <gripper1>
    joints {
        fixed gripper1_on_arm1 {
            parent: <kinova1.bracelet_link.pinch_site>
            child: <gripper1.g_base_mount.g_mount_interface>
        }
        serial {
            root: <kinova1.base_link.base_link_origin>
            tip: <gripper1.g_base.g_pinch>
        }
    }
}

ktree (ns=dat) arm2_tree {
    root: <kinova2.base_link.base_link_origin>
    tree <kinova2>
    tree <gripper2>
    joints {
        fixed gripper2_on_arm2 {
            parent: <kinova2.bracelet_link.pinch_site>
            child: <gripper2.g_base_mount.g_mount_interface>
        }
        serial {
            root: <kinova2.base_link.base_link_origin>
            tip: <gripper2.g_base.g_pinch>
        }
    }
}

ktree (ns=dat) world_tree {
    root: <world_body.world>
    tree <arm1_tree>
    tree <arm2_tree>

    body world_body {
        frame world { }
    }

    body table {
        frame table_top {
            pose table_top_in_world {
                wrt: <world_body.world>
                xyz: (0.0, 0.0, 0.72) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        frame kinova1_mount {
            pose arm1_on_table {
                wrt: <table.table_top>
                xyz: (-0.7, 0.0, 0.0) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        frame kinova2_mount {
            pose arm2_on_table {
                wrt: <table.table_top>
                xyz: (0.7, 0.0, 0.0) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 180) unit: deg }
            }
        }
        frame side_cam_mount {
            pose side_cam_mount_in_table_top {
                wrt: <table.table_top>
                xyz: (0.0, -1.45, 0.45) m
                orientation: euler { axes: xyz extrinsic angles: (80.14, 0.0, 0.0) unit: deg }
            }
        }
        // table.xml states no <inertial>: MuJoCo derives these from the top and leg geoms.
        frame table_com {
            pose table_com_in_table_top {
                wrt: <table.table_top>
                xyz: (0.0, 0.0, -0.05100416904566816) m
                orientation: quat {
                    xyzw: (0.7071067811865489, 0.0, 0.7071067811865489, 0.0)
                }
            }
        }
        inertia {
            frame: <table_com>
            mass: 84.26442414492935 kg
            inertia-matrix: (
                (32.454207471081375, 0.0, 0.0),
                (0.0, 21.92592723136972, 0.0),
                (0.0, 0.0, 12.75746156052865)
            ) kg*m^2
        }
    }

    joints {
        fixed table_on_world {
            parent: <world_body.world>
            child: <table.table_top>
        }
        fixed arm1_on_table {
            parent: <table.kinova1_mount>
            child: <kinova1.base_link.base_link_origin>
        }
        fixed arm2_on_table {
            parent: <table.kinova2_mount>
            child: <kinova2.base_link.base_link_origin>
        }
    }
}
