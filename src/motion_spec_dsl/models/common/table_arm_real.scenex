import "table_arm_real.scene"
import "wrist_ft.scenex"
import "kinova_ft_2f85.scenex"
import "table_arm.scenex"

ns tar_mjc = "https://secorolab.github.io/models/scenes/table-arm-real-mjc/"

scene inst (ns=tar_mjc) table_arm_real_scene_mjc {
    scene: <table_arm_real_scene>

    kgraph (ns=tar_mjc) table_arm_graph {
        anchor: <world_tree.world_body.world>
        tree <world_tree>
    }

    agn <agents.arm1> {
        model kinova-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/assets/kinova_gen3/gen3.xml'
            map tree <kinova> to "base_link"
        }

        model ft-mjc as mjcf {
            sys path = '../common/ft_mount.xml'
            map tree <ft_tree> to "wrist_ft_body"
        }

        force-torque wrist_ft {
            frame: <ft_tree.wrist_ft_body.wrist_ft_site>
            observes: force torque
            update-rate: 1000.0 Hz
        }
    }

    agn <agents.gripper1> {
        model gripper-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/assets/robotiq_2f85/2f85.xml'
            map tree <gripper> to "base_mount"
        }
    }
}
