import "mobile_base_driving.fsm"
import "mobile_base_driving.scenex"
ns app = "https://secorolab.github.io/models/mobile-base-driving/"
ns edf = "https://secorolab.github.io/models/mobile-base-driving/fsm/"

// Velocity control of the platform: each motion holds a commanded platform twist, and the PID
// that closes on it produces the wrench the distribution spreads over the four castors. The
// force path takes a commanded wrench; here a loop decides what to ask of it.
exec-context (ns=app) mobile-base-driving-exec {
    runs-scene: <mobile_base_driving_scene_mjc>
    platform:   simulation { name: "MuJoCo" }
    config:     "robot.toml"
    timestep:   1.0 ms
}

// No world block: every world observation is answered by forward kinematics along a chain, and a
// platform has none. What the model observes of it, the composition solver computes.
context (ns=app) shared {
    spec {
        // The platform's twist and wrench: the velocity-composition solver writes the first from
        // the measured hub rates, the force-distribution solver reads the second and spreads it
        // over the drives. Neither is a world observation -- a platform has no chain to forward
        // its state through, so both live here as blackboard slots the solvers own.
        velocity-twist platform-velocity {
            of:         <eddie.base_link.base_link_origin>,
            wrt:        <eddie.base_footprint.base_footprint_origin>,
            ref-point:  <eddie.base_link.base_link_origin>,
            as-seen-by: <eddie.base_link.base_link_origin>
        },
        wrench platform-force {
            of:         <eddie.base_link.base_link_origin>,
            ref-point:  <eddie.base_link.base_link_origin>,
            as-seen-by: <eddie.base_link.base_link_origin>
        },

        linear-velocity drive-speed    = 0.30 m/s,
        linear-velocity reverse-speed  = -0.30 m/s,
        linear-velocity zero-linear    = 0.0 m/s,
        linear-velocity speed-band     = 0.02 m/s,
        // The platform's z is up, so a positive yaw rate turns it counter-clockwise.
        angular-velocity cw-rate       = -0.60 rad/s,
        angular-velocity ccw-rate      = 0.60 rad/s,
        angular-velocity zero-angular  = 0.0 rad/s,
        angular-velocity rate-band     = 0.05 rad/s,
        // The platform weighs 94.8 kg and rolling resistance costs it real force at cruise, so
        // the wrench is bounded well above what holding a speed needs and well below what the
        // eight 12 Nm hubs could deliver into a stall.
        force platform-force-limit     = 260.0 N,
        torque platform-moment-limit   = 45.0 Nm
    }
}

tolerances {
    linear-velocity: 0.02 m/s,
    position:        0.01 m,
    orientation:     0.01 rad
}

guarded-motion (ns=app) drive-forward {
    description: "Hold a forward speed in a straight line"
    context { }
    when {}
    while {
        speed-x:  keeping <shared.spec.platform-velocity>.linvel.x equal to <shared.spec.drive-speed> within <shared.spec.speed-band>,
        hold-y:   keeping <shared.spec.platform-velocity>.linvel.y equal to <shared.spec.zero-linear> within <shared.spec.speed-band>,
        hold-yaw: keeping <shared.spec.platform-velocity>.angvel.z equal to <shared.spec.zero-angular> within <shared.spec.rate-band>
    }
    until {
        travelled: elapsed greater than 4.0 s
    }
}

guarded-motion (ns=app) drive-backward {
    description: "Hold a reverse speed back along the same line"
    context { }
    when {}
    while {
        speed-x:  keeping <shared.spec.platform-velocity>.linvel.x equal to <shared.spec.reverse-speed> within <shared.spec.speed-band>,
        hold-y:   keeping <shared.spec.platform-velocity>.linvel.y equal to <shared.spec.zero-linear> within <shared.spec.speed-band>,
        hold-yaw: keeping <shared.spec.platform-velocity>.angvel.z equal to <shared.spec.zero-angular> within <shared.spec.rate-band>
    }
    until {
        returned: elapsed greater than 4.0 s
    }
}

guarded-motion (ns=app) turn-cw {
    description: "Hold a clockwise yaw rate about the platform's own centre"
    context { }
    when {}
    while {
        hold-x:   keeping <shared.spec.platform-velocity>.linvel.x equal to <shared.spec.zero-linear> within <shared.spec.speed-band>,
        hold-y:   keeping <shared.spec.platform-velocity>.linvel.y equal to <shared.spec.zero-linear> within <shared.spec.speed-band>,
        yaw-rate: keeping <shared.spec.platform-velocity>.angvel.z equal to <shared.spec.cw-rate> within <shared.spec.rate-band>
    }
    until {
        turned-cw: elapsed greater than 4.0 s
    }
}

guarded-motion (ns=app) turn-ccw {
    description: "Hold a counter-clockwise yaw rate about the platform's own centre"
    context { }
    when {}
    while {
        hold-x:   keeping <shared.spec.platform-velocity>.linvel.x equal to <shared.spec.zero-linear> within <shared.spec.speed-band>,
        hold-y:   keeping <shared.spec.platform-velocity>.linvel.y equal to <shared.spec.zero-linear> within <shared.spec.speed-band>,
        yaw-rate: keeping <shared.spec.platform-velocity>.angvel.z equal to <shared.spec.ccw-rate> within <shared.spec.rate-band>
    }
    until {
        turned-ccw: elapsed greater than 4.0 s
    }
}

// One pair of platform solvers for the whole model: composition to read the twist the constraints
// are judged on, distribution to spread the wrench the controllers produce. The castor alignment
// is the distribution's own secondary task, carried in the nullspace of the commanded wrench --
// a property of how a redundant platform is driven, not a motion the model asks for, so it is
// named in the solver's configuration rather than authored here.
constraint-handler (ns=app) handler-forward {
    handles: <drive-forward>
    runs-in: <edf.S_FORWARD>
    monitors {
        mon-forward: monitor <drive-forward.until> {
            satisfied { trigger: event <edf.E_FORWARD_DONE> }
        }
    }
    controllers {
        pid ctrl-forward-x {
            constraint: <drive-forward.speed-x>,
            output-saturation: saturation { max: <shared.spec.platform-force-limit> },
            Kp: 220, Ki: 400, Kd: 0, decay: 0
        } as force via <handler-forward.platform-force>,
        pid ctrl-forward-y {
            constraint: <drive-forward.hold-y>,
            output-saturation: saturation { max: <shared.spec.platform-force-limit> },
            Kp: 220, Ki: 400, Kd: 0, decay: 0
        } as force via <handler-forward.platform-force>,
        pid ctrl-forward-yaw {
            constraint: <drive-forward.hold-yaw>,
            output-saturation: saturation { max: <shared.spec.platform-moment-limit> },
            Kp: 25, Ki: 50, Kd: 0, decay: 0
        } as torque via <handler-forward.platform-force>
    }
    solvers {
        platform-twist: mobile-platform {
            agent: <agents.eddie>,
            algorithm: velocity-composition,
            configuration: "hddc2b_platform",
            quantity: <shared.spec.platform-velocity>
        },
        platform-force: mobile-platform {
            agent: <agents.eddie>,
            algorithm: force-distribution,
            configuration: "aligned",
            quantity: <shared.spec.platform-force>
        }
    }
}

constraint-handler (ns=app) handler-backward {
    handles: <drive-backward>
    runs-in: <edf.S_BACKWARD>
    monitors {
        mon-backward: monitor <drive-backward.until> {
            satisfied { trigger: event <edf.E_BACKWARD_DONE> }
        }
    }
    controllers {
        pid ctrl-backward-x {
            constraint: <drive-backward.speed-x>,
            output-saturation: saturation { max: <shared.spec.platform-force-limit> },
            Kp: 220, Ki: 400, Kd: 0, decay: 0
        } as force via <handler-forward.platform-force>,
        pid ctrl-backward-y {
            constraint: <drive-backward.hold-y>,
            output-saturation: saturation { max: <shared.spec.platform-force-limit> },
            Kp: 220, Ki: 400, Kd: 0, decay: 0
        } as force via <handler-forward.platform-force>,
        pid ctrl-backward-yaw {
            constraint: <drive-backward.hold-yaw>,
            output-saturation: saturation { max: <shared.spec.platform-moment-limit> },
            Kp: 25, Ki: 50, Kd: 0, decay: 0
        } as torque via <handler-forward.platform-force>
    }
    solvers {
        <handler-forward.platform-force>
    }
}

constraint-handler (ns=app) handler-cw {
    handles: <turn-cw>
    runs-in: <edf.S_CW>
    monitors {
        mon-cw: monitor <turn-cw.until> {
            satisfied { trigger: event <edf.E_CW_DONE> }
        }
    }
    controllers {
        pid ctrl-cw-x {
            constraint: <turn-cw.hold-x>,
            output-saturation: saturation { max: <shared.spec.platform-force-limit> },
            Kp: 220, Ki: 400, Kd: 0, decay: 0
        } as force via <handler-forward.platform-force>,
        pid ctrl-cw-y {
            constraint: <turn-cw.hold-y>,
            output-saturation: saturation { max: <shared.spec.platform-force-limit> },
            Kp: 220, Ki: 400, Kd: 0, decay: 0
        } as force via <handler-forward.platform-force>,
        pid ctrl-cw-yaw {
            constraint: <turn-cw.yaw-rate>,
            output-saturation: saturation { max: <shared.spec.platform-moment-limit> },
            Kp: 25, Ki: 50, Kd: 0, decay: 0
        } as torque via <handler-forward.platform-force>
    }
    solvers {
        <handler-forward.platform-force>
    }
}

constraint-handler (ns=app) handler-ccw {
    handles: <turn-ccw>
    runs-in: <edf.S_CCW>
    monitors {
        mon-ccw: monitor <turn-ccw.until> {
            satisfied { trigger: event <edf.E_CCW_DONE> }
        }
    }
    controllers {
        pid ctrl-ccw-x {
            constraint: <turn-ccw.hold-x>,
            output-saturation: saturation { max: <shared.spec.platform-force-limit> },
            Kp: 220, Ki: 400, Kd: 0, decay: 0
        } as force via <handler-forward.platform-force>,
        pid ctrl-ccw-y {
            constraint: <turn-ccw.hold-y>,
            output-saturation: saturation { max: <shared.spec.platform-force-limit> },
            Kp: 220, Ki: 400, Kd: 0, decay: 0
        } as force via <handler-forward.platform-force>,
        pid ctrl-ccw-yaw {
            constraint: <turn-ccw.yaw-rate>,
            output-saturation: saturation { max: <shared.spec.platform-moment-limit> },
            Kp: 25, Ki: 50, Kd: 0, decay: 0
        } as torque via <handler-forward.platform-force>
    }
    solvers {
        <handler-forward.platform-force>
    }
}
