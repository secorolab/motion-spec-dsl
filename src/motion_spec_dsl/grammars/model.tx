// Author: Vamsi Kalagaturu
// Top-level composition and execution target.

import base
import context
import path
import motion_spec
import constraint_handler

Model:
    imports*=Import
    namespaces*=NamespaceDeclare
    specs+=Specification
;

Specification:
    ContextSpec | ExecutionContext | ToleranceDefaults | Ros | GuardedMotion | ConstraintHandler
;

// Each group is a scope of its own, so an entry is referred to by what it is --
// `<ros.publishers.ext-wrench>` -- rather than by the namespace it happens to mint IRIs in,
// which every other kind of name shares.
Ros:
    "ros" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" "{"
        (publishers=RosPublishers ","?)?
        (subscribers=RosSubscribers ","?)?
        (action_clients=RosActionClients ","?)?
        (action_servers=RosActionServers ","?)?
        (standing=RosAlways ","?)?
    "}"
;

RosPublishers:    "publishers"     "{" topics+=RosTopicDecl[","] ","? "}" ;
RosSubscribers:   "subscribers"    "{" subscriptions+=RosSubscriptionDecl[","] ","? "}" ;
RosActionClients: "action-clients" "{" action_clients+=RosActionDecl[","] ","? "}" ;
RosActionServers: "action-servers" "{" action_servers+=RosActionServerDecl[","] ","? "}" ;
RosAlways:        "always"         "{" standing+=RosStandingPub[","] ","? "}" ;

// The topic is already declared above, so this states when it is published and what it carries,
// rather than naming a second thing. The message reports the quantity whole: its fields are the
// quantity's, and a model that wants a different mapping writes the ones it wants to change.
RosStandingPub:
    "publish" "at" rate=Measure "to" "<" topic=[RosTopicDecl|FQN] ">"
    "with" ("{" entries+=RosStandingEntry[","] ","? "}" | entries+=RosStandingEntry)
    ("{" fields+=RosMeasurementAssign[","] ","? "}")?
;

// One entry of the message: the quantity it reports, and -- when the message carries many and so
// must tell them apart -- the scene entity that entry is about.
RosStandingEntry:
    ("<" subject=[OBJECT|FQN] ">" ":")? "<" quantity=[WorldQuantity|FQN] ">"
;

// One overridden field of a standing message: the component of a world quantity it reports.
RosMeasurementAssign:
    path+=ID['.'] ":" "<" quantity=[WorldQuantity|FQN] ">" selector=SelectorTail
;

// A channel carries detections or it carries a camera's images. The `from` clause tells them
// apart: a detection says where in the message its pose sits, an image has no pose to place.
// Each alternative resolves its own class, which is what keeps a camera's `resolution` -- a
// child carrying the camera's own name -- from answering to the camera's name.
RosSubscriptionDecl:
    name=IRI_TRUNK ":" "topic" channel_name=STRING "message" type_name=STRING "{"
        ( "observes" "{" targets+=WorldQuantityRef[","] ","? "}"
          pose_field=ID "from" pose_container=ID ","?
        | "observes" "{" cameras+=CameraTargetRef[","] ","? "}" )
    "}"
;

WorldQuantityRef: "<" ref=[WorldQuantity|FQN] ">" ;
CameraTargetRef:  "<" ref=[scene.CameraSensorSpec|FQN] ">" ;

// Model-wide satisfaction bands, one per quantity kind. A constraint that authors no
// `within` takes the band declared for the kind its error carries, so the band a model is
// tuned against is stated once instead of on every gate.
ToleranceDefaults:
    "tolerances" "{" defaults+=ToleranceDefault[","] "}"
;

ToleranceDefault:
    kind=ToleranceQuantityType ":" band=ContextRef
;

// Execution target: binds the imported scene to a platform (real-world | simulation)
// and a control timestep. The controlled robot(s) come from the referenced scene's
// agents; the platform is dispatched off its name (required for simulation).
ExecutionContext:
    "exec-context" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        "runs-scene" ":" "<" scene=[scene.SceneInstance|FQN] ">"
        "platform"   ":" platform=Platform
        ("config"    ":" config=STRING)?
        "timestep"   ":" timestep=ConstExpr timestep_unit=TimeUnit
    "}"
;

Platform:
    RealWorldPlatform | SimulationPlatform
;

RealWorldPlatform:
    kind="real-world"
        ("{" devices+=DeviceBinding[","] "}")?
;

// Names the hardware that stands in for a modelled agent or sensor on this deployment.
// Nothing is mapped: the element is labelled with the device kind that realizes it.
DeviceBinding:
    "<" target=[OBJECT|FQN] ">" "realized" "by" device=DeviceKind
;

DeviceKind:
    "KinovaGen3-2F85" | "KinovaGen3" | "Robotiq2F85" | "RobotiqFT300s"
;

SimulationPlatform:
    kind="simulation"
        "{" "name" ":" name=STRING "}"
;
