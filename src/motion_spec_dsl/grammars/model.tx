// Top-level composition and execution target.

import base
import context
import path
import motion_spec
import constraint_handler

Model:
    imports*=Import
    namespaces*=NamespaceDeclare
    specs+=Specification
;

Specification:
    ContextSpec | ExecutionContext | ToleranceDefaults | RosTopicDecls | RosActionDecls | GuardedMotion | ConstraintHandler
;

// Model-wide satisfaction bands, one per quantity kind. A constraint that authors no
// `within` takes the band declared for the kind its error carries, so the band a model is
// tuned against is stated once instead of on every gate.
ToleranceDefaults:
    "tolerances" "{" defaults+=ToleranceDefault[","] "}"
;

ToleranceDefault:
    kind=ToleranceQuantityType ":" band=ContextRef
;

// Execution target: binds the imported scene to a platform (real-world | simulation)
// and a control timestep. The controlled robot(s) come from the referenced scene's
// agents; the platform is dispatched off its name (required for simulation).
ExecutionContext:
    "exec-context" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        "runs-scene" ":" "<" scene=[scene.SceneInstance|FQN] ">"
        "platform"   ":" platform=Platform
        ("config"    ":" config=STRING)?
        "timestep"   ":" timestep=FLOAT timestep_unit=TimeUnit
    "}"
;

Platform:
    RealWorldPlatform | SimulationPlatform
;

RealWorldPlatform:
    kind="real-world"
        ("{" devices+=DeviceBinding[","] "}")?
;

// Names the hardware that stands in for a modelled agent or sensor on this deployment.
// Nothing is mapped: the element is labelled with the device kind that realizes it.
DeviceBinding:
    "<" target=[OBJECT|FQN] ">" "realized" "by" device=DeviceKind
;

DeviceKind:
    "KinovaGen3-2F85" | "KinovaGen3" | "Robotiq2F85" | "RobotiqFT300s"
;

SimulationPlatform:
    kind="simulation"
        "{" "name" ":" name=STRING "}"
;
