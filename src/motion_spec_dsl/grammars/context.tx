// World quantities, geometric properties, views, and context quantities: values,
// snapshots, poses, references, and reference-generator specs (admittance, velocity profile).

import base

WorldQuantity:
    type=NonGravityWorldQuantityType name=IRI_TRUNK ("{" props=GeometricProps "}")?
;

NonGravityWorldQuantityType:
    "velocity-twist" | "wrench" | "pose" | "joint-position"
;

GeometricProps:
    pairs+=GeoPropPair[","]
;

// Geometric props reference scenex elements directly: frames for the
// pose/twist/wrench slots, a joint for joint-space quantities, an FT sensor
// for measured wrenches.
GeoPropPair:
      key="of"         ":" "<" frame=[scene.Frame|FQN] ">"
    | key="wrt"        ":" "<" frame=[scene.Frame|FQN] ">"
    | key="ref-point"  ":" "<" frame=[scene.Frame|FQN] ">"
    | key="as-seen-by" ":" "<" frame=[scene.Frame|FQN] ">"
    | key="joint"      ":" "<" joint=[scene.RevoluteJoint|FQN] ">"
    | key="ft-sensor"  ":" "<" sensor=[scene.ForceTorqueSensorSpec|FQN] ">"
;

QuantityValue:
    ScalarQuantity | VectorXYZ
;

ScalarQuantity:
    "=" Measure
;

Measure: value=FLOAT unit=Unit ;

VectorXYZ:
    "=" coords=Coordinates (unit=Unit)?
;

Coordinates: "(" values+=CoordinateElement[","] ")" ;
CoordinateElement: value=FLOAT | ref=ContextRef ;

QuantityType:
    ContextQuantityWithGeometryType | ScalarQuantityType
;

ContextQuantityWithGeometryType:
    "pose"                |
    "position"            |
    "orientation"         |
    "velocity-twist"      |
    "acceleration-twist"  |
    "wrench"              |
    "angular-velocity"    |
    "linear-velocity"     |
    "linear-acceleration" |
    "angular-acceleration"|
    "linear-jerk"         |
    "force"               |
    "torque"              |
    "direction"           |
    "free-vector"
;

ScalarQuantityType:
    "distance" | "angle" | "dimensionless" | "duration" | "path-parameter"
;

View:
    (
        "distance" "between"
        "<" distance_from=[WorldQuantity|FQN] ">"
        "and"
        "<" distance_to=[WorldQuantity|FQN] ">"
    )
    |
    elapsed=ElapsedTime
    |
    progress=ProgressAlong
    |
    moving=MovingAlong
    |
    on=OnPath
    |
    (
        "<" quantity=[WorldQuantity|FQN] ">"
        selector=SelectorTail?
    )
;

ElapsedTime:
    marker?="elapsed"
;

ProgressAlong:
    "progress" "of" "<" moved=[WorldQuantity|FQN] ">" "along" path=ContextRef
;

MovingAlong:
    "moving" "<" moved=[WorldQuantity|FQN] ">" "along" path=ContextRef "at" speed=ContextRef
;

OnPath:
    "<" moved=[WorldQuantity|FQN] ">" selector=SelectorTail? "on" path=ContextRef
;

SelectorTail:
    "." subspace=SubSpace ("." axis=Axis)?
;

SubSpace:
    "angacc"      |
    "angvel"      |
    "linacc"      |
    "linvel"      |
    "torque"      |
    "force"       |
    "orientation" |
    "position"
;

Axis:
    "x" | "y" | "z" | "roll" | "pitch" | "yaw"
;

LinearAxis: "x" | "y" | "z" ;
AngularAxis: "roll" | "pitch" | "yaw" ;

LengthUnit: 'mm' | 'cm' | 'm' ;
AngleUnit: 'rad' | 'deg' ;
AngularVelocityUnit: 'rad/s' | 'deg/s' ;
AngularAccelerationUnit: 'rad/s^2' | 'deg/s^2' ;
LinearVelocityUnit: "m/s" | "cm/s" ;
LinearAccelerationUnit: 'm/s^2' ;
LinearJerkUnit: 'm/s^3' ;
ForceUnit: 'N' ;
TorqueUnit: 'Nm' ;
TimeUnit: 's' | 'ms' ;
DimensionlessUnit: '1' ;

Unit:
    LinearAccelerationUnit | LinearJerkUnit | LinearVelocityUnit |
    AngularAccelerationUnit | AngularVelocityUnit |
    LengthUnit | AngleUnit | TorqueUnit | ForceUnit | TimeUnit | DimensionlessUnit
;

// Context quantities: values, poses, snapshots, and references.

PositionCoordinate:
    ref=ContextRef | coords=Coordinates unit=LengthUnit
;

OrientationCoordinate:
    ref=ContextRef | euler=EulerAngles | quat=Quaternion
    | direction_cosine=DirectionCosineXYZ
;

EulerAxes: 'xyz' | 'xzy' | 'yxz' | 'yzx' | 'zxy' | 'zyx' ;

EulerAngles:
    "euler" "{" "axes" ":" axes=EulerAxes extrinsic?="extrinsic"
        "," "angles" ":" angles=Coordinates (unit=AngleUnit)?
    "}"
;

Quaternion:
    "quat" "{" "xyzw" ":" xyzw=Coordinates "}"
;

DirectionCosineXYZ:
    "direction-cosine" "{"
        "x" ":" x_axis=Coordinates ","
        "y" ":" y_axis=Coordinates ","
        "z" ":" z_axis=Coordinates
    "}"
;

ContextQuantity:
      type="velocity-profile" name=IRI_TRUNK value=ProfileSpec
    | type="admittance" name=IRI_TRUNK value=AdmittanceSpec
    | type=ContextQuantityWithGeometryType name=IRI_TRUNK ("{" props=GeometricProps "}")? value=PlainContextQuantityValue?
    | type=ScalarContextQuantityType name=IRI_TRUNK value=PlainContextQuantityValue?
;

ScalarContextQuantityType:
    ScalarQuantityType | QuantityAliasType
;

QuantityAliasType:
    "linear-distance" | "angular-distance"
;

PlainContextQuantityValue:
    QuantityValue | SnapshotValue | PoseCoordinate | VelocityTwistCoordinate
    | AccelerationTwistCoordinate | WrenchCoordinate | ReferenceValue
;

VelocityTwistCoordinate:
    "=" "{" "angular-velocity" ":" angular=Coordinates angular_unit=AngularVelocityUnit ","
            "linear-velocity"  ":" linear=Coordinates  linear_unit=LinearVelocityUnit
    "}"
;

AccelerationTwistCoordinate:
    "=" "{" "angular-acceleration" ":" angular=Coordinates angular_unit=AngularAccelerationUnit ","
            "linear-acceleration"  ":" linear=Coordinates  linear_unit=LinearAccelerationUnit
    "}"
;

WrenchCoordinate:
    "=" "{" "torque" ":" torque=Coordinates torque_unit=TorqueUnit ","
            "force"  ":" force=Coordinates  force_unit=ForceUnit
    "}"
;

AdmittanceSpec:
    "=" "{"
        "force" ":" force=View ","
        "mass" ":" mass=FLOAT ","
        "damping" ":" damping=FLOAT
        ("," "stiffness" ":" stiffness=FLOAT)?
        "," "max-velocity" ":" max_velocity=FLOAT (max_velocity_unit=LinearVelocityUnit)?
    "}"
;

ProfileSpec:
    "=" "profile" "{"
        "max-velocity" ":" max_velocity=ContextRef ","
        "max-acceleration" ":" max_acceleration=ContextRef
        ("," "measured-velocity" ":" measured_velocity=View)?
        ("," "max-jerk" ":" max_jerk=ContextRef)?
        ("," "shape" ":" shape=VelocityProfileShape)?
    "}"
;

VelocityProfileShape: "trapezoidal" | "s-curve" ;

SnapshotValue:
    "=" "snapshot" "of" source=View ("+" offset=ContextRef)?
    ("on" "event" trigger=EventName)?
;

PoseCoordinate:
    "=" "{"
        "position" ":" position=PositionCoordinate ","
        "orientation" ":" orientation=OrientationCoordinate
    "}"
;

ContextRef:
    "[" quantity=[ContextQuantity|FQN] literal_value=QuantityValue? "]"
  | "<" quantity=[ContextQuantity|ScopedName] ">" selector=SelectorTail?
  | context_scope=ContextScope "[" inline_quantity=ContextQuantity "]"
  | bare=Measure
;

ContextScope:
    "pre" | "spec" | "post"
;

ReferenceValue:
    "=" source=ContextRef ("+" offset=ContextRef)?
;
