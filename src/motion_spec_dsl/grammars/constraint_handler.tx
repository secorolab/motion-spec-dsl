// Author: Vamsi Kalagaturu
// Constraint-handler assembly, monitors, controllers, and solvers.

import base
import context
import motion_spec

SaturationSpec:
    "saturation" "{"
        (
            "max" ":" maximum=ContextRef |
            "lower" ":" lower=ContextRef "," "upper" ":" upper=ContextRef
        )
    "}"
;

ConstraintHandler:
    "constraint-handler" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        ("context"    "{" context*=HandlerContextItem[","] "}")?
        "handles"      ":" "<" motion=[GuardedMotion|IRI_TRUNK] ">"
        ("runs-in"     ":" runs_in=StateName)?
        ("monitors"    "{" monitors*=MonitorEntry[","]? "}")?
        "controllers"  "{" controllers*=ControllerItem[","]? "}"
        "solvers"      "{" solvers+=SolverItem[","] "}"
    "}"
;

ControllerItem: ControllerAlias | ControllerEntry ;
ControllerAlias: (name=IRI_TRUNK ":")? "<" ref=ControllerRef ">" ;
SolverItem: SolverAlias | SolverEntry ;
SolverAlias: (name=IRI_TRUNK ":")? "<" ref=SolverRef ">" ;
HandlerContextDecl: WorldContextDecl | SpecContextDecl ;
HandlerContextItem: HandlerContextDecl | ContextDeclReference ;

MonitorEntry:
    name=IRI_TRUNK ":" "monitor" "<" constraint=MonitorTarget ">" "{"
        states*=MonitorStateBlock[","] ","?
    "}"
;

MonitorStateBlock:
    state=MonitorState ("for" sustain=Measure)? "{" actions+=MonitorAction[","] ","? "}"
;

MonitorState: "satisfied" | "violated" ;

MonitorAction:
      "trigger" ":" "event" event=EventName
    | "hold"    ":" "<" fallback=[GuardedMotion|IRI_TRUNK] ">"
    | "flag"    ":" flag=IRI_TRUNK
    | "publish" ":" occurrence="event" "to" "<" topic=[RosTopicDecl|FQN] ">"
    | "publish" ":" "to" "<" topic=[RosTopicDecl|FQN] ">" "{" fields+=RosFieldAssign[","] ","? "}"
    | "publish" ":" value=RosFieldValue "to" "<" topic=[RosTopicDecl|FQN] ">"
;

RosFieldAssign: path+=ID['.'] ":" value=RosFieldValue ;

RosFieldValue: literal=FLOAT | literal=STRING | constant=ID ;

RosTopicDecl: name=IRI_TRUNK ":" "topic" channel_name=STRING "message" type_name=STRING ;

ControllerEntry:
    (
        type="pid" name=IRI_TRUNK "{" params=PIDControllerParams "}" |
        type="impedance" name=IRI_TRUNK "{" params=ImpedanceControllerParams "}" |
        type="feed-forward" name=IRI_TRUNK "{" params=FeedForwardControllerParams "}"
    )
    ("as" command_type=QuantityType)?
    ("apply" "at" "<" apply_at=[scene.RigidBody|FQN] ">")?
    ("via" "<" solver=SolverRef ">")?
;

PIDControllerParams:
    ("constraint" ":")? "<" constraint=ConstraintRef ">"
    ("," "profile" ":" profile=ContextRef)?
    ("," "measured-derivative" ":" measured_derivative=View)?
    ("," "output-saturation" ":" output_saturation=SaturationSpec)?
    ("," "integral-saturation" ":" integral_saturation=SaturationSpec)?
    "," terms+=KpParam "," terms+=KiParam "," terms+=KdParam
    ("," terms+=DecayParam)?
;

ImpedanceControllerParams:
    ("constraint" ":")? "<" constraint=ConstraintRef ">"
    ("," "output-saturation" ":" output_saturation=SaturationSpec)?
    ("," terms+=KiParam)?
    "," (
        terms+=StiffnessParam ("," terms+=DampingParam)? |
        terms+=DampingParam ("," terms+=StiffnessParam)?
    )
;

FeedForwardControllerParams:
    ("constraint" ":")? "<" constraint=ConstraintRef ">"
    ("," "output-saturation" ":" output_saturation=SaturationSpec)?
;

KpParam: name="Kp" ":" value=FLOAT ;
KiParam: name="Ki" ":" value=FLOAT ;
KdParam: name="Kd" ":" value=FLOAT ;
DecayParam: name="decay" ":" value=FLOAT ;
StiffnessParam: name="stiffness" ":" value=FLOAT ;
DampingParam: name="damping" ":" value=FLOAT ;
MonitorTarget: UntilMonitorRef | WhenMonitorRef | ConstraintRef ;
UntilMonitorRef: motion=[GuardedMotion|IRI_TRUNK] "." "until" ;
WhenMonitorRef: motion=[GuardedMotion|IRI_TRUNK] "." "when" ;
ControllerRef: handler=[ConstraintHandler|IRI_TRUNK] "." controller=[ControllerEntry|IRI_TRUNK] ;
SolverRef: solver=[SolverEntry|FQN] ;

// A solver's mechanism family (serial-chain dynamics vs. mobile-platform kinematics/control
// allocation) is a closed authoring choice, not a generic algorithm string: each family accepts
// only its own algorithms and fields. Command forwarding is a third, distinct alternative -- it
// is neither a dynamics solver nor a platform kinematics/control-allocation solver.
SolverEntry: SerialChainSolver | MobilePlatformSolver | CommandForwardingSolver ;

SerialChainSolver:
    name=IRI_TRUNK ":" "serial-chain" "{"
        "agent"     ":" "<" agent=[scene.Agent|FQN] ">"
        ("," "algorithm" ":" algorithm=SerialChainAlgorithm)?
        ("," limits=SolverLimits)?
        ("," "gravity" ":" gravity_value=GravityValue)?
    "}"
;
SerialChainAlgorithm: "achd" | "rne" ;

// One class over two axes: quantity {velocity, force} x operation {composition, distribution}.
// velocity-composition and force-distribution are backed by vendored RDF classes
// (comp-rob2b solver-specification.ttl:25,35); velocity-distribution and force-composition
// are backed by slv-ext classes (solver-specification-extension.shacl.ttl). All four are
// implemented by the hddc2b runtime. The operation dimension lives in the algorithm token,
// not as a separate field, so no combination is representable as illegal state.
MobilePlatformSolver:
    name=IRI_TRUNK ":" "mobile-platform" "{"
        "agent"         ":" "<" agent=[scene.Agent|FQN] ">" ","
        "algorithm"     ":" algorithm=MobilePlatformAlgorithm ","
        "configuration" ":" configuration=STRING ","
        "quantity"      ":" quantity=ContextRef
    "}"
;
MobilePlatformAlgorithm:
    "velocity-composition" | "velocity-distribution" | "force-composition" | "force-distribution"
;

CommandForwardingSolver:
    name=IRI_TRUNK ":" "command-forwarding" "{"
        "agent" ":" "<" agent=[scene.Agent|FQN] ">"
    "}"
;

SolverLimits:
    "limits" "{" entries+=TorqueLimit "}"
;
TorqueLimit: target="torque" ":" saturation=SaturationSpec ;

GravityValue: ("=")? coords=Coordinates unit=LinearAccelerationUnit | ref=ContextRef ;
