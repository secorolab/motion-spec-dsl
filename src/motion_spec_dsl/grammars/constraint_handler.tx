// Constraint-handler assembly, monitors, controllers, and solvers.

import base
import context
import motion_spec

SaturationSpec:
    "saturation" "{"
        (
            "max" ":" maximum=ContextRef |
            "lower" ":" lower=ContextRef "," "upper" ":" upper=ContextRef
        )
    "}"
;

ConstraintHandler:
    "constraint-handler" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        ("context"    "{" context*=HandlerContextItem[","] "}")?
        "handles"      ":" "<" motion=[GuardedMotion|IRI_TRUNK] ">"
        ("progress"    "{" progress*=ProgressEntry[","]? "}")?
        ("monitors"    "{" monitors*=MonitorEntry[","]? "}")?
        "controllers"  "{" controllers*=ControllerItem[","]? "}"
        "solvers"      "{" solvers+=SolverItem[","] "}"
    "}"
;

ProgressEntry: ProgressConstraint | ProgressObjective ;

ProgressConstraint:
    name=IRI_TRUNK ":" "constraint" "{"
        "advance" parameter=ContextRef "along"
        (path=ContextRef | "{" paths+=ContextRef[","] "}")
        "at" advancement=FLOAT advancement_unit="Hz"
    "}"
;

ProgressObjective:
    name=IRI_TRUNK ":" "objective" "{"
        "maximize" parameter=ContextRef "along"
        (path=ContextRef | "{" paths+=ContextRef[","] "}")
    "}"
;

ControllerItem: ControllerAlias | ControllerEntry ;
ControllerAlias: (name=IRI_TRUNK ":")? "<" ref=ControllerRef ">" ;
SolverItem: SolverAlias | SolverEntry ;
SolverAlias: (name=IRI_TRUNK ":")? "<" ref=SolverRef ">" ;
HandlerContextDecl: WorldContextDecl | SpecContextDecl ;
HandlerContextItem: HandlerContextDecl | ContextDeclReference ;

MonitorEntry:
    name=IRI_TRUNK ":" "monitor" "<" constraint=MonitorTarget ">"
    (
        ("on" "activation" "trigger" "event" event=EventName
            ("after" "active" "for" debounce=Measure)?
            ("otherwise" "hold" "<" fallback=[GuardedMotion|IRI_TRUNK] ">")?
            ("also" "publish" "to" ros_topic=ROSTopic)?) |
        ("while" "active" "set" "flag" flag=IRI_TRUNK)
    )
;

ROSTopic: "topic" channel_name=STRING ("as" type_name=STRING)? ;

ControllerEntry:
    (
        type="pid" name=IRI_TRUNK "{" params=PIDControllerParams "}" |
        type="impedance" name=IRI_TRUNK "{" params=ImpedanceControllerParams "}" |
        type="feed-forward" name=IRI_TRUNK "{" params=FeedForwardControllerParams "}"
    )
    ("as" command_type=QuantityType)?
    ("apply" "at" "<" apply_at=[scene.RigidBody|FQN] ">")?
    ("via" "<" solver=SolverRef ">")?
;

PIDControllerParams:
    "constraint" ":" "<" constraint=ConstraintRef ">"
    ("," "profile" ":" profile=ContextRef)?
    ("," "measured-derivative" ":" measured_derivative=View)?
    ("," "output-saturation" ":" output_saturation=SaturationSpec)?
    ("," "integral-saturation" ":" integral_saturation=SaturationSpec)?
    "," terms+=KpParam "," terms+=KiParam "," terms+=KdParam
    ("," terms+=DecayParam)?
;

ImpedanceControllerParams:
    "constraint" ":" "<" constraint=ConstraintRef ">"
    ("," "output-saturation" ":" output_saturation=SaturationSpec)?
    ("," terms+=KiParam)?
    "," (
        terms+=StiffnessParam ("," terms+=DampingParam)? |
        terms+=DampingParam ("," terms+=StiffnessParam)?
    )
;

FeedForwardControllerParams:
    "constraint" ":" "<" constraint=ConstraintRef ">"
    ("," "output-saturation" ":" output_saturation=SaturationSpec)?
;

KpParam: name="Kp" ":" value=FLOAT ;
KiParam: name="Ki" ":" value=FLOAT ;
KdParam: name="Kd" ":" value=FLOAT ;
DecayParam: name="decay" ":" value=FLOAT ;
StiffnessParam: name="stiffness" ":" value=FLOAT ;
DampingParam: name="damping" ":" value=FLOAT ;
MonitorTarget: UntilMonitorRef | WhenMonitorRef | ConstraintRef ;
UntilMonitorRef: motion=[GuardedMotion|IRI_TRUNK] "." "until" ;
WhenMonitorRef: motion=[GuardedMotion|IRI_TRUNK] "." "when" ;
ControllerRef: handler=[ConstraintHandler|IRI_TRUNK] "." controller=[ControllerEntry|IRI_TRUNK] ;
SolverRef: (handler=[ConstraintHandler|IRI_TRUNK] ".")? solver=[SolverEntry|IRI_TRUNK] ;

SolverEntry:
    "solver" name=IRI_TRUNK "{"
        "agent"     ":" "<" agent=[scene.Agent|FQN] ">" ","
        "algorithm" ":" algorithm=SolverAlgorithm
        ("," limits=SolverLimits)?
        ("," "gravity" ":" gravity_value=GravityValue)?
    "}"
;

SolverLimits:
    "limits" "{" (
        entries+=TorqueLimit
        ("," entries+=LinearAccelerationLimit)?
        ("," entries+=AngularAccelerationLimit)? |
        entries+=LinearAccelerationLimit
        ("," entries+=AngularAccelerationLimit)? |
        entries+=AngularAccelerationLimit
    ) "}"
;
TorqueLimit: target="torque" ":" saturation=SaturationSpec ;
LinearAccelerationLimit: target="linear-acceleration" ":" saturation=SaturationSpec ;
AngularAccelerationLimit: target="angular-acceleration" ":" saturation=SaturationSpec ;
SolverAlgorithm: "ACHD" | "RNE" | "command-forwarding" | "velocity-distribution" | "force-distribution" ;

GravityVector:
    "{" "x" ":" x=FLOAT ","
        "y" ":" y=FLOAT ","
        "z" ":" z=FLOAT unit=Unit
    "}"
;

GravityValue: ("=")? literal=GravityVector | ref=ContextRef ;
