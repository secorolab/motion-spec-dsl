// https://textx.github.io/textX/stable/grammar/
// https://textx.github.io/textX/stable/scoping/

GuardedMotionSpecification:
    "ID" ":" name=ID
    "CONTEXT" ":" context+=ContextSpecification
    "WHEN" ":" when+=ConstraintSpecification
    "WHILE" ":" while_+=ConstraintSpecification
    "UNTIL" ":" until+=ConstraintSpecification
;

ContextSpecification:
    (world_name=ID ":" "World" world=WorldContextDeclarationList |
    pre_name=ID ":" "Pre" pre=ContextDeclarationList |
    spec_name=ID ":" "Spec" spec=ContextDeclarationList |
    post_name=ID ":" "Post" post=ContextDeclarationList)#
;

WorldContextDeclarationList:
    "{" declaration+=WorldContextVariable[","] "}"
;

WorldContextVariable:
    name=ID ":" type=QuantityType
;

ContextDeclarationList:
    "{" declaration+=ContextVariable[","] "}"
;

ContextVariable:
    name=ID ":" type=QuantityType "=" default=Quantity
;

QuantityType:
    "Angle" | "Distance" |
    "Pose" | "Orientation" | "Position" |
    "AngularSpeed" | "LinearSpeed" |
    "VelocityTwist" | "AngularVelocity" | "LinearVelocity" |
    "Wrench" | "Torque" | "Force" |
    "JointPosition" | "JointVelocity" | "JointForce" |
    "Point" | "Line" | "Direction" | "Frame" | "Plane"
;


ConstraintSpecification:
    name=ID ":" var=View expr=ConstraintExpression
;

View:
    entity=[WorldContextVariable:ID] ("." subspace=Subspace)? ("." axis=Axis)?
;

Subspace:
    "angular" | "linear"
;

Axis:
    "x" | "y" | "z"
;

ConstraintExpression:
    EqualityConstraint |
    GreaterThanConstraint |
    LessThanConstraint |
    BilateralConstraint
;

EqualityConstraint:
    "equal" "to" reference=ContextLookup
;

GreaterThanConstraint:
    "greater" "than" threshold=ContextLookup
;

LessThanConstraint:
    "less" "than" threshold=ContextLookup
;

BilateralConstraint:
    "between" lower=ContextLookup "and" upper=ContextLookup
;

ContextLookup:
    PreContextLookup | SpecContextLookup | PostContextLookup
;

PreContextLookup:
    "Pre" "[" variable=VariableWithDefaultValue "]"
;

SpecContextLookup:
    "Spec" "[" variable=VariableWithDefaultValue "]"
;

PostContextLookup:
    "Post" "[" variable=VariableWithDefaultValue "]"
;

VariableWithDefaultValue:
    variable=[ContextVariable:ID]
;

Quantity:
    value=FLOAT unit=Unit
;

Unit:
    "deg/s" | "rad/s" |
    "m/s" | "cm/s" |
    "deg" | "rad" |
    "m" | "cm" |
    "N" |
    "Nm"
;

Comment:
    (/\/\/.*$/ | /(?ms)\/\*(.*?)\*\//)
;
