{
    "@context": {
        "@version": 1.1,
        "mot": "https://comp-rob2b.github.io/metamodels/task/motion-specification#",

        "GuardedMotion": {
            "@id": "mot:GuardedMotion",
            "@context": {
                "when": {
                    "@id": "mot:when",
                    "@type": "@id",
                    "@container": "@set"
                },
                "while": {
                    "@id": "mot:while",
                    "@type": "@id",
                    "@container": "@set"
                },
                "until": {
                    "@id": "mot:until",
                    "@type": "@id",
                    "@container": "@set"
                }
            }
        },

        "Constraint": {
            "@id": "mot:Constraint",
            "@context": {
                "quantity": {
                    "@id": "mot:quantity",
                    "@type": "@id"
                }
            }
        },
        "GreaterThanConstraint": "mot:GreaterThanConstraint",
        "LessThanConstraint": "mot:LessThanConstraint",
        "UnilateralConstraint": {
            "@id": "mot:UnilateralConstraint",
            "@context": {
                "threshold": {
                    "@id": "mot:threshold",
                    "@type": "@id"
                }
            }
        },
        "BilateralConstraint": {
            "@id": "mot:BilateralConstraint",
            "@context": {
                "lower-threshold": {
                    "@id": "mot:lower-threshold",
                    "@type": "@id"
                },
                "upper-threshold": {
                    "@id": "mot:upper-threshold",
                    "@type": "@id"
                }
            }
        },
        "EqualityConstraint": {
            "@id": "mot:EqualityConstraint",
            "@context": {
                "reference-value": {
                    "@id": "mot:reference-value",
                    "@type": "@id"
                }
            }
        },

        "AngleConstraint": "mot:AngleConstraint",
        "DistanceConstraint": "mot:DistanceConstraint",
        "OrientationConstraint": "mot:OrientationConstraint",
        "PositionConstraint": "mot:PositionConstraint",
        "PoseConstraint": "mot:PoseConstraint",
        "AngularSpeedConstraint": "mot:AngularSpeedConstraint",
        "LinearSpeedConstraint": "mot:LinearSpeedConstraint",
        "AngularVelocityConstraint": "mot:AngularVelocityConstraint",
        "LinearVelocityConstraint": "mot:LinearVelocityConstraint",
        "VelocityTwistConstraint": "mot:VelocityTwistConstraint",
        "AngularAccelerationConstraint": "mot:AngularAccelerationConstraint",
        "LinearAccelerationConstraint": "mot:LinearAccelerationConstraint",
        "AccelerationTwistConstraint": "mot:AccelerationTwistConstraint",
        "TorqueConstraint": "mot:TorqueConstraint",
        "ForceConstraint": "mot:ForceConstraint",
        "WrenchConstraint": "mot:WrenchConstraint"
    }
}
