ID:
  my_motion
CONTEXT:
  c1: World {
        dist_da: Distance,      // Distance(between={d.origin, a.origin})
        pos_da: Pose,           // Pose(of=d, wrt=a, asb=[a])
        spd_da: LinearSpeed,    // LinearSpeed(between={d.origin, a.origin})
        frc: Wrench,            // ForceWrench()
        q: JointPosition,
        appr: Angle,            // Angle(between={d.x, a.y})
        a: Frame                // Frame(origin, x, y, z)
    }
  c2: Pre {
        dist_orig: Distance = 50 cm,
        height_max: Position = 75 cm
    }
  c3: Spec {
        vel_min: LinearSpeed = 0.1 m/s,
        vel_max: LinearSpeed = 0.2 m/s,
        angle_min: JointPosition = 0 rad,
        angle_max: JointPosition = 1.5 rad,
        frc_set: Force = 1.0 N,
        approach_angle: Angle = 0 rad
    }
  c4: Post {
        dist_max: Distance = 75 cm,
        max_force: Force = 2.0 N
    }
WHEN:
  we1: dist_da greater than Pre[dist_orig]
  we2: pos_da.linear.z greater than Pre[height_max]
WHILE:
  wi1: spd_da between Spec[vel_min] and Spec[vel_max]
  wi2: dist_da greater than Pre[height_max]
  wi3: q between Spec[angle_min] and Spec[angle_max]
  wi4: frc.linear.x equal to Spec[frc_set]
  wi5: appr equal to Spec[approach_angle]
UNTIL:
  u1: pos_da.linear.z less than Post[dist_max]
  u2: frc.linear.x greater than Post[max_force]











