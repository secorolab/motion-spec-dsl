ns app = "https://secorolab.github.io/models/reuse/"

ROBOT (ns=app) kinova {
    type: Manipulator,
    urdf: "../robots/kg3.urdf",
    chain: {
        root: link-base,
        end: link-ee
    }
}

MOTION_SPEC (ns=app) move_a {
    CONTEXT {
        c1: World {
            twist-ee-base: VelocityTwist { of: link-ee, wrt: link-base }
        },
        c2: Spec {
            vel-z-ref: LinearVelocity = 0.1 m/s
        }
    }

    WHEN {}

    WHILE {
        shared: <c1.twist-ee-base>.linvel.z equal to <c2.vel-z-ref>
    }

    UNTIL {}
}

MOTION_SPEC (ns=app) move_b {
    CONTEXT {
        c1: World {
            twist-ee-base: VelocityTwist { of: link-ee, wrt: link-base }
        },
        c2: Spec {
            vel-z-ref: LinearVelocity = 0.1 m/s
        }
    }

    WHEN {}

    WHILE {
        shared_local: <move_a.shared>
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler_a {
    CONTEXT {
        c1: World {
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <move_a>

    CONTROLLERS {
        ctrl-a: PID { constraint: <move_a.shared>, solver: <solver_a>, Kp = 1.0, Ki = 0.0, Kd = 0.1 }
    }

    SOLVERS {
        solver_a: Solver {
            robot: <kinova>,
            algorithm: Vereshchagin,
            root: <kinova.chain.root>,
            end: <kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}

CONSTRAINT_HANDLER (ns=app) handler_b {
    CONTEXT {
        c1: World {
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <move_b>

    CONTROLLERS {
        ctrl-b: PID { constraint: <move_a.shared>, solver: <solver_b>, Kp = 1.0, Ki = 0.0, Kd = 0.1 }
    }

    SOLVERS {
        solver_b: Solver {
            robot: <kinova>,
            algorithm: Vereshchagin,
            root: <kinova.chain.root>,
            end: <kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}
