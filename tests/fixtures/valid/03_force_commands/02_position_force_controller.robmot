// Valid: position constraint commanded as force; graph emission must prefer force output over acceleration energy.

ns app = "https://secorolab.github.io/models/tests/"

ROBOT (ns=app) kinova {
    type: Manipulator,
    model: KinovaGen3,
    urdf: "../robots/kg3.urdf",
    chain: { root: link-base, end: link-ee }
}

MOTION_SPEC (ns=app) m_push {
    CONTEXT {
        cw: World {
            pose-ee-base: Pose { of: frame-ee, wrt: frame-base, as-seen-by: frame-base }
        },
        cs: Spec {
            z-ref: LinearDistance = 0.1 m
        }
    }

    WHEN {}

    WHILE {
        c_z: keeping <cw.pose-ee-base>.position.z equal to <cs.z-ref>
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler_push {
    CONTEXT {
        c1: World {
            link-ee: Link,
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <m_push>

    CONTROLLERS {
        ctrl-z: PID { constraint: <m_push.c_z>, Kp = 1.0, Ki = 0.0, Kd = 0.0 }
        as Force
        apply at <c1.link-ee>
    }

    SOLVERS {
        arm_solver: Solver {
            robot: <kinova>,
            algorithm: ACHD,
            root: <kinova.chain.root>,
            end: <kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}
