// Valid: two velocity twists expressing the same body motion in different coordinate frames;
// the builder must emit a RotateVelocityTwistToProximalWithPose transform between them.

ns app = "https://secorolab.github.io/models/tests/"

ENVIRONMENT (ns=app) world {
    runtime: MuJoCo,
    ASSETS {
        kinova-mjcf: RobotAsset { model: KinovaGen3, xml: "../robots/kg3.xml" }
    },
    ASSEMBLY {
        Robot kinova using <kinova-mjcf> {
            chain: { root: link-base, end: link-ee }
        }
    }
}

MOTION_SPEC (ns=app) m_twist_transform {
    CONTEXT {
        cw: World {
            frame-base: Frame,
            frame-ee: Frame,
            pose-ee-base: Pose { of: frame-ee, wrt: frame-base },
            twist-ee-base-base: VelocityTwist { of: link-ee, wrt: link-base, as-seen-by: frame-base },
            twist-ee-base-ee: VelocityTwist { of: link-ee, wrt: link-base, as-seen-by: frame-ee }
        },
        cs: Spec {
            vel-x-ref: LinearVelocity = 0.0 m/s
        }
    }

    WHEN {}

    WHILE {
        c_lin_x: keeping <cw.twist-ee-base-ee>.linvel.x equal to <cs.vel-x-ref>
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler_twist_transform {
    CONTEXT {
        c1: World {
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: FreeVector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <m_twist_transform>
    CONTROL_MODE: JointTorque
    CONTROLLERS {
        ctrl-lin-x: PID { constraint: <m_twist_transform.c_lin_x>, Kp = 1.0, Ki = 0.0, Kd = 0.1 }
    }

    SOLVERS {
        arm_solver: Solver {
            robot: <world.kinova>,
            algorithm: ACHD,
            root: <world.kinova.chain.root>,
            end: <world.kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}
