// Valid: two-solver handler with acceleration and external force controllers; graph and codegen must keep solver paths separate.

ns motion = "https://secorolab.github.io/models/test/motion/"
ns handler = "https://secorolab.github.io/models/test/handler/"

ENVIRONMENT (ns=motion) world {
    runtime: MuJoCo,
    ASSETS {
        kinova-mjcf: RobotAsset { model: KinovaGen3, xml: "../robots/kg3.xml" }
    },
    ASSEMBLY {
        Robot kinova using <kinova-mjcf> {
            chain: { root: link-base, end: link-ee }
        }
    }
}

MOTION_SPEC (ns=motion) m_move {
    CONTEXT {
        c1: World {
            frame-base: Frame,
            frame-ee: Frame,
            twist-ee-base: VelocityTwist { of: link-ee, wrt: link-base, as-seen-by: frame-base },
            wrench-ee: Wrench { ref-point: point-ee-origin, as-seen-by: frame-ee }
        },
        c2: Spec {
            vel-z-ref: LinearVelocity = 0.1 m/s,
            force-z-ref: Force = 2.0 N
        }
    }

    WHEN {}

    WHILE {
        c1: <c1.twist-ee-base>.linvel.z equal to <c2.vel-z-ref>,
        c2: <c1.wrench-ee>.force.z equal to <c2.force-z-ref>
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=handler) handler_move {
    CONTEXT {
        c1: World {
            gravity: Gravity,
            link-ee: Link
        },
        c2: Spec {
            gravity-vec: FreeVector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <m_move>
    CONTROL_MODE: JointTorque
    CONTROLLERS {
        ctrl-c1: PID { constraint: <m_move.c1>, Kp = 1.0, Ki = 0.0, Kd = 0.1 } via <solver_a>,
        ctrl-c2: PID { constraint: <m_move.c2>, Kp = 1.0, Ki = 0.0, Kd = 0.1 } as Force apply at <c1.link-ee> via <solver_b>
    }

    SOLVERS {
        solver_a: Solver {
            robot: <world.kinova>,
            algorithm: ACHD,
            root: <world.kinova.chain.root>,
            end: <world.kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        },
        solver_b: Solver {
            robot: <world.kinova>,
            algorithm: ACHD,
            root: <world.kinova.chain.root>,
            end: <world.kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}
