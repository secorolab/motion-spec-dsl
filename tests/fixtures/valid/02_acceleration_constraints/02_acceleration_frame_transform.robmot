// Valid: acceleration constraint authored in a non-base frame; codegen must rotate the axis into the solver base.

ns app = "https://secorolab.github.io/models/tests/"

ENVIRONMENT (ns=app) world {
    runtime: MuJoCo,
    ASSETS {
        kinova-mjcf: RobotAsset { model: KinovaGen3, xml: "../robots/kg3.xml" }
    },
    ASSEMBLY {
        Robot kinova using <kinova-mjcf> {
            chain: { root: link-base, end: link-ee }
        }
    }
}

MOTION_SPEC (ns=app) m_frame {
    CONTEXT {
        cw: World {
            twist-ee-base-ee: VelocityTwist {
                of: link-ee,
                wrt: link-base,
                as-seen-by: frame-ee
            }
        },
        cs: Spec {
            vel-x-ref: LinearVelocity = 0.0 m/s
        }
    }

    WHEN {}

    WHILE {
        c_lin_x: keeping <cw.twist-ee-base-ee>.linvel.x equal to <cs.vel-x-ref>
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler_frame {
    CONTEXT {
        c1: World {
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: FreeVector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <m_frame>
    CONTROL_MODE: JointTorque

    CONTROL_PERIOD: 1.0 ms
    CONTROLLERS {
        ctrl-lin-x: PID { constraint: <m_frame.c_lin_x>, Kp = 1.0, Ki = 0.0, Kd = 0.1 }
    }

    SOLVERS {
        arm_solver: Solver {
            robot: <world.kinova>,
            algorithm: ACHD,
            root: <world.kinova.chain.root>,
            end: <world.kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}
