// Valid: PID family can be authored as P, PI, or PD while graph emission normalizes missing gains to zero.

ns app = "https://secorolab.github.io/models/test/"

ROBOT (ns=app) kinova {
    type: Manipulator,
    model: KinovaGen3,
    urdf: "../robots/kg3.urdf",
    chain: {
        root: link-base,
        end: link-ee
    }
}

MOTION_SPEC (ns=app) m_pid_variants {
    CONTEXT {
        c1: World {
            twist-ee-base: VelocityTwist { of: link-ee, wrt: link-base }
        },
        c2: Spec {
            vel-x-ref: LinearVelocity = 0.1 m/s,
            vel-y-ref: LinearVelocity = 0.2 m/s,
            vel-z-ref: LinearVelocity = 0.3 m/s
        }
    }

    WHEN {}

    WHILE {
        c_x: <c1.twist-ee-base>.linvel.x equal to <c2.vel-x-ref>,
        c_y: <c1.twist-ee-base>.linvel.y equal to <c2.vel-y-ref>,
        c_z: <c1.twist-ee-base>.linvel.z equal to <c2.vel-z-ref>
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler_pid_variants {
    CONTEXT {
        c1: World {
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <m_pid_variants>

    CONTROLLERS {
        ctrl-p: PID { constraint: <m_pid_variants.c_x>, Kp = 1.0 },
        ctrl-pi: PID { constraint: <m_pid_variants.c_y>, Kp = 1.0, Ki = 0.2 },
        ctrl-pd: PID { constraint: <m_pid_variants.c_z>, Kp = 1.0, Kd = 0.3 }
    }

    SOLVERS {
        kinova_solver: Solver {
            robot: <kinova>,
            algorithm: ACHD,
            root: <kinova.chain.root>,
            end: <kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}
