// Valid: minimal manipulator following an Arc trajectory between two endpoints
// (amplitude = half the chord reproduces a semicircle).

ns app = "https://secorolab.github.io/models/test/"

ENVIRONMENT (ns=app) world {
    runtime: MuJoCo,
    ASSETS {
        kinova-mjcf: RobotAsset { model: KinovaGen3, xml: "../robots/kg3.xml" }
    },
    ASSEMBLY {
        Robot kinova using <kinova-mjcf> {
            chain: { root: link-base, end: link-ee }
        }
    }
}

MOTION_SPEC (ns=app) m_arc {
    CONTEXT {
        c1: World {
            pose-ee-base: Pose { of: link-ee, wrt: link-base, as-seen-by: link-base }
        },
        c2: Spec {
            alpha:        TrajectoryProgress,
            plane-normal: Direction { as-seen-by: link-base } { x = 0.0, y = 0.0, z = 1.0 },
            chord-x:      LinearDistance = 0.20 m,
            amplitude:    LinearDistance = 0.10 m,
            start-pose:   Pose = Snapshot of <c1.pose-ee-base>,
            end-x:        LinearDistance = Snapshot of <c1.pose-ee-base>.position.x + <c2.chord-x>,
            end-y:        LinearDistance = Snapshot of <c1.pose-ee-base>.position.y,
            end-z:        LinearDistance = Snapshot of <c1.pose-ee-base>.position.z,
            end-pose:     Pose {
                position: { x: <c2.end-x>, y: <c2.end-y>, z: <c2.end-z> },
                orientation: { roll: 0.0 rad, pitch: 0.0 rad, yaw: 0.785398 rad }
            },
            traj: Trajectory = Arc {
                start:        <c2.start-pose>,
                end:          <c2.end-pose>,
                amplitude:    <c2.amplitude>,
                plane-normal: <c2.plane-normal>,
                alpha:        <c2.alpha>
            }
        }
    }

    WHEN {}

    WHILE {
        follow-pos: keeping <c1.pose-ee-base>.position equal to <c2.traj>.position
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler_arc {
    CONTEXT {
        c1: World {
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: FreeVector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <m_arc>
    CONTROL_MODE: JointTorque
    CONTROLLERS {
        ctrl-follow: PID { constraint: <m_arc.follow-pos>, Kp = 200, Ki = 100, Kd = 40 }
    }

    SOLVERS {
        kinova_solver: Solver {
            robot: <world.kinova>,
            algorithm: ACHD,
            root: <world.kinova.chain.root>,
            end: <world.kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}
