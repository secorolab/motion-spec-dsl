// Valid: minimal manipulator following a Helix trajectory.

ns app = "https://secorolab.github.io/models/test/"

ENVIRONMENT (ns=app) world {
    runtime: MuJoCo,
    ASSETS {
        kinova-mjcf: RobotAsset { model: KinovaGen3, xml: "../robots/kg3.xml" }
    },
    ASSEMBLY {
        Robot kinova using <kinova-mjcf> {
            chain: { root: link-base, end: link-ee }
        }
    }
}

MOTION_SPEC (ns=app) m_helix {
    CONTEXT {
        c1: World {
            pose-ee-base: Pose { of: link-ee, wrt: link-base, as-seen-by: link-base }
        },
        c2: Spec {
            alpha:       TrajectoryProgress,
            pitch:       LinearDistance = 0.04 m,
            revolutions: Distance       = 2.0 m,
            axis:        Direction { as-seen-by: link-base } { x = 0.0, y = 0.0, z = -1.0 },
            radius-vec:  FreeVector { as-seen-by: link-base } { x = 0.08, y = 0.0, z = 0.0 m },
            start-pose:  Pose = Snapshot of <c1.pose-ee-base>,
            center-pos:  Position = Snapshot of <c1.pose-ee-base>.position + <c2.radius-vec>,
            traj: Trajectory = Helix {
                start:       <c2.start-pose>,
                center:      <c2.center-pos>,
                axis:        <c2.axis>,
                pitch:       <c2.pitch>,
                revolutions: <c2.revolutions>,
                alpha:       <c2.alpha>
            }
        }
    }

    WHEN {}

    WHILE {
        follow-pos: keeping <c1.pose-ee-base>.position equal to <c2.traj>.position
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler_helix {
    CONTEXT {
        c1: World {
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: FreeVector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <m_helix>
    CONTROL_MODE: JointTorque

    CONTROL_PERIOD: 1.0 ms
    CONTROLLERS {
        ctrl-follow: PID { constraint: <m_helix.follow-pos>, Kp = 200, Ki = 100, Kd = 40 }
    }

    SOLVERS {
        kinova_solver: Solver {
            robot: <world.kinova>,
            algorithm: ACHD,
            root: <world.kinova.chain.root>,
            end: <world.kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}
