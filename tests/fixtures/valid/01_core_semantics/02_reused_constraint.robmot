// Valid: one constraint reused by multiple motions; graph emission must keep shared constraint URIs and unambiguous error signals.

ns app = "https://secorolab.github.io/models/reuse/"

ENVIRONMENT (ns=app) world {
    runtime: MuJoCo,
    ASSETS {
        kinova-mjcf: RobotAsset { model: KinovaGen3, xml: "../robots/kg3.xml" }
    },
    ASSEMBLY {
        Robot kinova using <kinova-mjcf> {
            chain: { root: link-base, end: link-ee }
        }
    }
}

MOTION_SPEC (ns=app) move_a {
    CONTEXT {
        c1: World {
            twist-ee-base: VelocityTwist { of: link-ee, wrt: link-base }
        },
        c2: Spec {
            vel-z-ref: LinearVelocity = 0.1 m/s
        }
    }

    WHEN {}

    WHILE {
        shared: <c1.twist-ee-base>.linvel.z equal to <c2.vel-z-ref>
    }

    UNTIL {}
}

MOTION_SPEC (ns=app) move_b {
    CONTEXT {
        c1: World {
            twist-ee-base: VelocityTwist { of: link-ee, wrt: link-base }
        },
        c2: Spec {
            vel-z-ref: LinearVelocity = 0.1 m/s
        }
    }

    WHEN {}

    WHILE {
        shared_local: <move_a.shared>
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler_a {
    CONTEXT {
        c1: World {
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: FreeVector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <move_a>
    CONTROL_MODE: JointTorque
    CONTROLLERS {
        ctrl-a: PID { constraint: <move_a.shared>, Kp = 1.0, Ki = 0.0, Kd = 0.1 }
    }

    SOLVERS {
        solver_a: Solver {
            robot: <world.kinova>,
            algorithm: ACHD,
            root: <world.kinova.chain.root>,
            end: <world.kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}

CONSTRAINT_HANDLER (ns=app) handler_b {
    CONTEXT {
        c1: World {
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: FreeVector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <move_b>
    CONTROL_MODE: JointTorque
    CONTROLLERS {
        ctrl-b: PID { constraint: <move_a.shared>, Kp = 1.0, Ki = 0.0, Kd = 0.1 }
    }

    SOLVERS {
        solver_b: Solver {
            robot: <world.kinova>,
            algorithm: ACHD,
            root: <world.kinova.chain.root>,
            end: <world.kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}
