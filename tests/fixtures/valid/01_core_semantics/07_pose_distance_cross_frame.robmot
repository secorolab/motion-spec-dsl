// Valid: distance endpoints use different wrt frames; graph emission must compose an available transform path before deriving distance.

ns app = "https://secorolab.github.io/models/tests/"

ENVIRONMENT (ns=app) world {
    runtime: RealRobot,
    ASSETS {
        kinova-urdf: RobotAsset { model: KinovaGen3, urdf: "../robots/kg3.urdf" }
    },
    ASSEMBLY {
        kinova: <kinova-urdf> {
            chain: { root: link-base, end: link-ee }
        }
    }
}

MOTION_SPEC (ns=app) m_cross_distance {
    CONTEXT {
        cw: World {
            pose-shoulder-base: Pose { of: frame-shoulder, wrt: frame-base },
            pose-table-base: Pose { of: frame-table, wrt: frame-base },
            pose-ee-table: Pose { of: frame-ee, wrt: frame-table }
        },
        cs: Spec {
            dist-lower: LinearDistance = 0.2 m,
            dist-upper: LinearDistance = 0.8 m
        }
    }

    WHEN {}

    WHILE {
        c_dist_cross: distance between <cw.pose-shoulder-base> and <cw.pose-ee-table> between <cs.dist-lower> and <cs.dist-upper>
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler_cross_distance {
    CONTEXT {
        c1: World {
            link-ee: Link,
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <m_cross_distance>
    CONTROL_MODE: JointTorque

    CONTROLLERS {
        ctrl-dist: PID { constraint: <m_cross_distance.c_dist_cross>, Kp = 1.0, Ki = 0.0, Kd = 0.1 } as Force apply at <c1.link-ee>
    }

    SOLVERS {
        arm_solver: Solver {
            robot: <world.kinova>,
            algorithm: ACHD,
            root: <world.kinova.chain.root>,
            end: <world.kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}
