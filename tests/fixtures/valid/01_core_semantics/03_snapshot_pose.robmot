// Valid: full pose hold against a motion-start snapshot; used for snapshot RDF and six-axis pose-hold codegen coverage.

ns app = "https://secorolab.github.io/models/test/"

ENVIRONMENT (ns=app) world {
    runtime: MuJoCo,
    ASSETS {
        kinova-mjcf: RobotAsset { model: KinovaGen3, xml: "../robots/kg3.xml" }
    },
    ASSEMBLY {
        Robot kinova using <kinova-mjcf> {
            chain: { root: link-base, end: link-ee }
        }
    }
}

MOTION_SPEC (ns=app) idle {
    CONTEXT {
        world: World {
            pose-ee-base: Pose { of: frame-ee, wrt: frame-base, as-seen-by: frame-base }
        },
        spec: Spec {
            pose-ee-start: Pose = Snapshot of <world.pose-ee-base>
        }
    }

    WHEN {}

    WHILE {
        hold-pose: <world.pose-ee-base> equal to <spec.pose-ee-start>
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler_idle {
    CONTEXT {
        world: World {
            gravity: Gravity
        },
        spec: Spec {
            gravity-vec: FreeVector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <idle>
    CONTROL_MODE: JointTorque

    CONTROLLERS {
        ctrl-hold-pose: PID { constraint: <idle.hold-pose>, Kp = 4.0, Ki = 0.0, Kd = 0.4 }
    }

    SOLVERS {
        arm_solver: Solver {
            robot: <world.kinova>,
            algorithm: ACHD,
            root: <world.kinova.chain.root>,
            end: <world.kinova.chain.end>,
            gravity: <world.gravity> equal to <spec.gravity-vec>
        }
    }
}
