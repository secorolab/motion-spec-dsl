// Valid: minimal manipulator ACHD motion with one velocity constraint; used for baseline graph, solver, and reference checks.

ns app = "https://secorolab.github.io/models/test/"

ENVIRONMENT (ns=app) world {
    runtime: MuJoCo,
    ASSETS {
        kinova-mjcf: RobotAsset { model: KinovaGen3, xml: "../robots/kg3.xml" }
    },
    ASSEMBLY {
        Robot kinova using <kinova-mjcf> {
            chain: { root: link-base, end: link-ee }
        }
    }
}

MOTION_SPEC (ns=app) m_move {
    CONTEXT {
        c1: World {
            twist-ee-base: VelocityTwist { of: link-ee, wrt: link-base }
        },
        c2: Spec {
            vel-z-ref: LinearVelocity = 0.1 m/s
        }
    }

    WHEN {}

    WHILE {
        c1: <c1.twist-ee-base>.linvel.z equal to <c2.vel-z-ref>
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler_move {
    CONTEXT {
        c1: World {
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: FreeVector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <m_move>
    CONTROL_MODE: JointTorque

    CONTROLLERS {
        ctrl-c1: PID { constraint: <m_move.c1>, Kp = 1.0, Ki = 0.0, Kd = 0.1 }
    }

    SOLVERS {
        kinova_solver: Solver {
            robot: <world.kinova>,
            algorithm: ACHD,
            root: <world.kinova.chain.root>,
            end: <world.kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}
