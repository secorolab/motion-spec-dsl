// Valid: guarded motion with event and flag monitors; graph emission must materialize monitor signals and evaluators.

ns app = "https://secorolab.github.io/models/test/"

ROBOT (ns=app) kinova {
    type: Manipulator,
    model: KinovaGen3,
    urdf: "../robots/kg3.urdf",
    chain: {
        root: link-base,
        end: link-ee
    }
}

MOTION_SPEC (ns=app) m_guarded {
    CONTEXT {
        c1: World {
            twist-ee-base: VelocityTwist { of: link-ee, wrt: link-base }
        },
        c2: Spec {
            start-threshold: LinearVelocity = 0.05 m/s,
            stop-threshold: LinearVelocity = 0.2 m/s,
            vel-z-ref: LinearVelocity = 0.1 m/s
        }
    }

    WHEN {
        c_start: <c1.twist-ee-base>.linvel.z greater than <c2.start-threshold>
    }

    WHILE {
        c_hold: <c1.twist-ee-base>.linvel.z equal to <c2.vel-z-ref>
    }

    UNTIL {
        c_stop: <c1.twist-ee-base>.linvel.z greater than <c2.stop-threshold>
    }
}

CONSTRAINT_HANDLER (ns=app) handler_guarded {
    CONTEXT {
        c1: World {
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <m_guarded>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-start: monitor <m_guarded.c_start> and trigger event evt-start when active,
        mon-stop: monitor <m_guarded.c_stop> and set flag flag-stop while active
    }

    CONTROLLERS {
        ctrl-hold: PID { constraint: <m_guarded.c_hold>, Kp = 1.0, Ki = 0.0, Kd = 0.1 }
    }

    SOLVERS {
        arm_solver: Solver {
            robot: <kinova>,
            algorithm: ACHD,
            root: <kinova.chain.root>,
            end: <kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}
