// Invalid: WHILE constraints have no controller or monitor; validation must require active handling for maintained constraints.

ns app = "https://secorolab.github.io/models/tests/"

ENVIRONMENT (ns=app) world {
    runtime: RealRobot,
    ASSETS {
        kelo-urdf: RobotAsset { model: Kelo, urdf: "../robots/eddie.urdf" },
        kinova-urdf: RobotAsset { model: KinovaGen3, urdf: "../robots/kg3.urdf" }
    },
    ASSEMBLY {
        base: <kelo-urdf> {},
        right-arm: <kinova-urdf> {
            chain: { root: link-base, end: link-ee }
        }
    }
}
    }
}

MOTION_SPEC (ns=app) m_move {
    MOVE: "Invalid handler without controllers"

    CONTEXT {
        cw: World {
            twist-ee-base: VelocityTwist { of: link-ee, wrt: link-base }
        },
        cs: Spec {
            vel-zero: LinearVelocity = 0.0 m/s
        }
    }

    WHEN {}

    WHILE {
        c1: keeping <cw.twist-ee-base>.linvel.x equal to <cs.vel-zero>
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler_move {
    CONTEXT {
        c1: World {
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <m_move>
    CONTROL_MODE: JointTorque

    CONTROLLERS {}

    SOLVERS {
        right_arm_solver: Solver {
            robot: <world.right-arm>,
            algorithm: ACHD,
            root: <world.right-arm.chain.root>,
            end: <world.right-arm.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}
