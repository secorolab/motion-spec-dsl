// Invalid: JointPosition controllers must explicitly produce joint torque.

ns app = "https://secorolab.github.io/models/tests/"

ENVIRONMENT (ns=app) world {
    runtime: MuJoCo,
    ASSETS {
        kinova-mjcf: RobotAsset { model: KinovaGen3, xml: "../robots/kg3.xml" }
    },
    ASSEMBLY {
        Robot kinova using <kinova-mjcf> {
            chain: { root: link-base, end: link-ee }
        }
    }
}

MOTION_SPEC (ns=app) m_posture {
    CONTEXT {
        cw: World {
            q-j2: JointPosition { of: joint-2 }
        },
        cs: Spec {
            q-j2-safe: Angle = 2.4 rad
        }
    }

    WHEN {}

    WHILE {
        keep-j2-safe: <cw.q-j2> equal to <cs.q-j2-safe>
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler_posture {
    CONTEXT {
        c1: World {
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: FreeVector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <m_posture>
    CONTROL_MODE: JointTorque
    CONTROLLERS {
        ctrl-j2: PID { constraint: <m_posture.keep-j2-safe>, Kp = 10.0, Ki = 0.0, Kd = 0.5 }
    }

    SOLVERS {
        arm_solver: Solver {
            robot: <world.kinova>,
            algorithm: ACHD,
            root: <world.kinova.chain.root>,
            end: <world.kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}
