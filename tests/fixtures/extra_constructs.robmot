import "../../models/admittance_arc_single/admittance_arc_single.fsm"
import "../../models/admittance_arc_single/admittance_arc_single.scenex"
ns app = "https://secorolab.github.io/models/base/"
ns aas = "https://secorolab.github.io/models/admittance-arc-single/fsm/"

exec-context (ns=app) base-exec {
    runs-scene: <admittance_arc_scene_mjc>
    platform:   simulation { name: "MuJoCo" }
    timestep:   1.0 ms
}

context (ns=app) shared {
    world {
        pose pose-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        velocity-twist twist-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        }
    },
    spec {
        linear-velocity zero-linvel = 0.0 m/s
    }
}

guarded-motion (ns=app) home {
    move: "Hold the current end-effector pose"

    context {
        spec {
            pose home-pose = snapshot of <shared.world.pose-ee-base>
        }
    }

    when {}

    while {
        hold-position: keeping <shared.world.pose-ee-base>.position equal to <spec.home-pose>.position
    }

    until all {
        settled-z: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel>
    }
}

constraint-handler (ns=app) handler-home {
    handles: <home>
    monitors {
        mon-home-settled: monitor <home.until> on activation trigger event aas.E_HOME_SETTLED after active for 0.3 s
    }
    controllers {
        pid ctrl-hold-position { constraint: <home.hold-position>, Kp: 200, Ki: 100, Kd: 40, decay: 0 }
    }
    solvers {
        solver arm-solver {
            agent: <agents.kinova_ft_2f85>,
            algorithm: ACHD,
            gravity: { x: 0.0, y: 0.0, z: -9.81 m/s2 }
        }
    }
}

context (ns=app) shared2 {
    world {
        wrench ext-force {
            ref-point:  <ft_tree.wrist_ft_body.wrist_ft_site>,
            as-seen-by: <kinova.base_link.base_link_origin>,
            ft-sensor:  <wrist_ft>
        },
        joint-position joint1-pos {
            joint: <kinova.joint_1>
        }
    },
    spec {
        force zero-force = 0.0 N,
        torque zero-torque = 0.0 Nm,
        angle joint1-target = 0.5 rad,
        force force-limit = 50.0 N,
        torque torque-limit = 5.0 Nm,
        linear-acceleration linacc-limit = 2.0 m/s2,
        angular-acceleration angacc-limit = 1.0 rad/s2,
        linear-distance target-x = 0.1 m
    }
}

guarded-motion (ns=app) posture {
    move: "Hold a joint posture"
    context {}
    when {}
    while {
        hold-joint1: keeping <shared2.world.joint1-pos> equal to <shared2.spec.joint1-target>
    }
    until {}
}

constraint-handler (ns=app) handler-posture {
    handles: <posture>
    controllers {
        pid ctrl-joint1 { constraint: <posture.hold-joint1>, Kp: 50, Ki: 0, Kd: 5, decay: 0 } as torque
    }
    solvers {
        solver posture-solver {
            agent: <agents.kinova_ft_2f85>,
            algorithm: ACHD,
            gravity: { x: 0.0, y: 0.0, z: -9.81 m/s2 }
        }
    }
}

guarded-motion (ns=app) force-hold {
    move: "Yield to zero external force via impedance"
    context {}
    when {}
    while {
        hold-x-imp: keeping <shared.world.pose-ee-base>.position.x equal to <shared2.spec.target-x>
    }
    until {}
}

constraint-handler (ns=app) handler-force-hold {
    handles: <force-hold>
    controllers {
        impedance ctrl-imp { constraint: <force-hold.hold-x-imp>, stiffness: 100, damping: 20 }
            apply at <kinova.bracelet_link>
    }
    solvers {
        solver force-hold-solver {
            agent: <agents.kinova_ft_2f85>,
            algorithm: ACHD,
            limits {
                torque: saturation { max: <shared2.spec.torque-limit> },
                linear-acceleration: saturation { max: <shared2.spec.linacc-limit> },
                angular-acceleration: saturation { max: <shared2.spec.angacc-limit> }
            },
            gravity: { x: 0.0, y: 0.0, z: -9.81 m/s2 }
        }
    }
}
