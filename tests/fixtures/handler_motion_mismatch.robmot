ns app = "https://secorolab.github.io/models/tests/"

ROBOT (ns=app) eddie {
    type: MobileManipulator,
    urdf: "../robots/eddie.urdf",
    base: { model: Kelo, chain: { root: link-base } },
    manipulators: {
        right_arm: { model: KinovaGen3, chain: { root: link-base, end: link-ee } }
    }
}

MOTION_SPEC (ns=app) m_a {
    MOVE: "First motion"

    CONTEXT {
        cw: World {
            twist-ee-base: VelocityTwist { of: link-ee, wrt: link-base }
        },
        cs: Spec {
            vel-zero: LinearVelocity = 0.0 m/s
        }
    }

    WHEN {}

    WHILE {
        c_a: keeping <cw.twist-ee-base>.linvel.x equal to <cs.vel-zero>
    }

    UNTIL {}
}

MOTION_SPEC (ns=app) m_b {
    MOVE: "Second motion"

    CONTEXT {
        cw: World {
            twist-ee-base: VelocityTwist { of: link-ee, wrt: link-base }
        },
        cs: Spec {
            vel-zero: LinearVelocity = 0.0 m/s
        }
    }

    WHEN {}

    WHILE {
        c_b: keeping <cw.twist-ee-base>.linvel.x equal to <cs.vel-zero>
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler_a {
    CONTEXT {
        c1: World {
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <m_a>

    CONTROLLERS {
        ctrl-wrong-motion: PID { constraint: <m_b.c_b>, Kp = 1.0, Ki = 0.0, Kd = 0.0 }
    }

    SOLVERS {
        right_arm_solver: Solver {
            robot: <eddie.right_arm>,
            algorithm: ACHD,
            root: <eddie.right_arm.root>,
            end: <eddie.right_arm.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}
