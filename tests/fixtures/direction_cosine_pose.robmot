import "../../models/admittance_arc_single/admittance_arc_single.fsm"
import "../../models/admittance_arc_single/admittance_arc_single.scenex"
ns app = "https://secorolab.github.io/models/base/"
ns aas = "https://secorolab.github.io/models/admittance-arc-single/fsm/"

exec-context (ns=app) base-exec {
    runs-scene: <admittance_arc_scene_mjc>
    platform:   simulation { name: "MuJoCo" }
    timestep:   1.0 ms
}

context (ns=app) shared {
    world {
        pose pose-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        velocity-twist twist-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        }
    },
    spec {
        linear-distance satisfied-band     = 0.01 m,
        linear-velocity satisfied-band-vel = 0.01 m/s,
        linear-velocity zero-linvel = 0.0 m/s
    }
}

guarded-motion (ns=app) home {
    description: "Hold the current end-effector pose"

    context {
        spec {
            pose home-pose = {
                position: (0.1, 0.2, 0.3) m,
                orientation: direction-cosine { x: (1.0, 0.0, 0.0), y: (0.0, 1.0, 0.0), z: (0.0, 0.0, 1.0) }
            }
        }
    }

    when {}

    while {
        hold-position: keeping <shared.world.pose-ee-base>.position equal to <spec.home-pose>.position within <shared.spec.satisfied-band>
    }

    until all {
        settled-z: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel> within <shared.spec.satisfied-band-vel>
    }
}

constraint-handler (ns=app) handler-home {
    handles: <home>
    monitors {
        mon-home-settled: monitor <home.until> on activation trigger event <aas.E_HOME_SETTLED> after active for 0.3 s
    }
    controllers {
        pid ctrl-hold-position { constraint: <home.hold-position>, Kp: 200, Ki: 100, Kd: 40, decay: 0 }
    }
    solvers {
        arm-solver: serial-chain {
            agent: <agents.kinova_ft_2f85>,
            algorithm: achd,
            gravity: (0.0, 0.0, 9.81) m/s^2
        }
    }
}
