ns app = "https://secorolab.github.io/models/mj-fall/"

ROBOT (ns=app) kinova {
    type: Manipulator,
    model: KinovaGen3,
    urdf: "../robots/kg3.urdf",
    chain: { root: base_link, end: bracelet_link }
}

MOTION_SPEC (ns=app) fall-down {
    MOVE: "Move the Kinova Gen3 end effector downward with constant linear z velocity"

    CONTEXT {
        world: World {
            pose-ee: Pose {
                of: bracelet_link,
                wrt: base_link,
                as-seen-by: base_link
            },
            twist-ee: VelocityTwist {
                of: bracelet_link,
                wrt: base_link,
                as-seen-by: base_link
            }
        },
        spec: Spec {
            vel-z-down: LinearVelocity = -0.10 m/s,
            pose-ee-start: Pose = Snapshot of <world.pose-ee>
        }
    }

    WHEN {}

    WHILE {
        cstr-linvel-z: keeping <world.twist-ee>.linvel.z equal to <spec.vel-z-down>,
        cstr-orientation: keeping <world.pose-ee>.orientation equal to <spec.pose-ee-start>
    }

    UNTIL {}
}

CONSTRAINT_HANDLER (ns=app) handler-fall-down {
    CONTEXT {
        world: World {
            gravity: Gravity
        },
        spec: Spec {
            gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <fall-down>
    CONTROL_MODE: JointTorque

    MONITORS {}

    CONTROLLERS {
        ctrl-linvel-z: PID { constraint: <fall-down.cstr-linvel-z>, Kp = 50, Ki = 0, Kd = 0},
        ctrl-orientation: PID { constraint: <fall-down.cstr-orientation>, Kp = 50, Ki = 0, Kd = 5}
    }

    SOLVERS {
        arm-solver: Solver {
            robot: <kinova>,
            algorithm: ACHD,
            root: <kinova.chain.root>,
            end: <kinova.chain.end>,
            gravity: <world.gravity> equal to <spec.gravity-vec>
        }
    }
}
