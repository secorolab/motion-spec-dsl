ns eal_env = "https://secorolab.github.io/models/environments/eddie-align/"
ns eal_agn = "https://secorolab.github.io/models/agents/eddie-align/"
ns eal_scene = "https://secorolab.github.io/models/scenes/eddie-align/"

obj set (ns=eal_env) ws_objects {
    object rig
}

ws set (ns=eal_env) workspaces {
    workspace rig_ws
}

agn set (ns=eal_agn) agents {
    agent left_arm,
    agent right_arm
}

comp (ns=eal_env) comp_rig of ws <workspaces.rig_ws> {
    obj <ws_objects.rig>
}

scene (ns=eal_scene) eddie_arms_only_scene {
    ws comp <comp_rig>
    agn set <agents>
}
