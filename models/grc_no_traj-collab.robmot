ns app = "https://secorolab.github.io/models/table-sequence/"

ROBOT (ns=app) kinova {
    type: Manipulator,
    model: KinovaGen3,
    urdf: "../robots/kg3.urdf",
    chain: {
        root: link-base,
        end: link-ee
    }
}

MOTION_SPEC (ns=app) idle {
    MOVE: "Maintain the current end-effector pose"

    CONTEXT {
        world: World {
            twist-ee-base: VelocityTwist { of: link-ee, wrt: link-base, ref-point: point-ee-origin, as-seen-by: frame-base },
            pose-ee-base: Pose { of: frame-ee, wrt: frame-base, as-seen-by: frame-base }
        },
        spec: Spec {
            pose-ee-start: Pose = Snapshot of <world.pose-ee-base>,
            zero-linvel: LinearVelocity = 0.0 m/s,
            zero-angvel: AngularVelocity = 0.0 rad/s
        }
    }

    WHEN {}

    WHILE {
        hold-pose: <world.pose-ee-base> equal to <spec.pose-ee-start>
    }

    UNTIL {}
}

MOTION_SPEC (ns=app) touch_down {
    MOVE: "Move down at constant linear z velocity until table contact stops z motion"

    CONTEXT {
        spec: Spec {
            down-vel: LinearVelocity = -0.03 m/s
        }
    }

    WHEN {}

    WHILE {
        move-down-z: <idle.world.twist-ee-base>.linvel.z equal to <spec.down-vel>,
        keep-lin-x-zero: <idle.world.twist-ee-base>.linvel.x equal to <idle.spec.zero-linvel>,
        keep-lin-y-zero: <idle.world.twist-ee-base>.linvel.y equal to <idle.spec.zero-linvel>,
        keep-ang-x-zero: <idle.world.twist-ee-base>.angvel.x equal to <idle.spec.zero-angvel>,
        keep-ang-y-zero: <idle.world.twist-ee-base>.angvel.y equal to <idle.spec.zero-angvel>,
        keep-ang-z-zero: <idle.world.twist-ee-base>.angvel.z equal to <idle.spec.zero-angvel>
    }

    UNTIL {
        contact-table: <idle.world.twist-ee-base>.linvel.z equal to <idle.spec.zero-linvel>
    }
}

MOTION_SPEC (ns=app) move_forward_15cm {
    MOVE: "Move forward 15 cm along linear x"

    CONTEXT {
        world: World {
            pose-start-ee: Pose { of: frame-ee, wrt: frame-ee-start }
        },
        spec: Spec {
            forward-vel: LinearVelocity = 0.05 m/s,
            forward-distance: LinearDistance = 0.15 m
        }
    }

    WHEN {}

    WHILE {
        move-forward-x: <idle.world.twist-ee-base>.linvel.x equal to <spec.forward-vel>,
        <touch_down.keep-lin-y-zero>,
        keep-lin-z-zero: <idle.world.twist-ee-base>.linvel.z equal to <idle.spec.zero-linvel>,
        <touch_down.keep-ang-x-zero>,
        <touch_down.keep-ang-y-zero>,
        <touch_down.keep-ang-z-zero>
    }

    UNTIL {
        reached-forward-distance: <world.pose-start-ee>.position.x greater than <spec.forward-distance>
    }
}

MOTION_SPEC (ns=app) move_up_30cm_from_table {
    MOVE: "Move up at constant linear z velocity until the end-effector is 30 cm from the table"

    CONTEXT {
        world: World {
            pose-world-table: Pose { of: frame-table, wrt: frame-world },
            pose-world-ee: Pose { of: frame-ee, wrt: frame-world },
            pose-table-ee: Pose { of: frame-ee, wrt: frame-table }
        },
        spec: Spec {
            up-vel: LinearVelocity = 0.03 m/s,
            table-clearance: LinearDistance = 0.30 m
        }
    }

    WHEN {}

    WHILE {
        move-up-z: <idle.world.twist-ee-base>.linvel.z equal to <spec.up-vel>,
        <touch_down.keep-lin-x-zero>,
        <touch_down.keep-lin-y-zero>,
        <touch_down.keep-ang-x-zero>,
        <touch_down.keep-ang-y-zero>,
        <touch_down.keep-ang-z-zero>
    }

    UNTIL {
        reached-table-clearance: distance between <world.pose-world-table> and <world.pose-world-ee> greater than <spec.table-clearance>
    }
}

CONSTRAINT_HANDLER (ns=app) handler_idle {
    CONTEXT {
        world: World {
            gravity: Gravity
        },
        spec: Spec {
            gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <idle>

    CONTROLLERS {
        ctrl-hold-pose: PID { constraint: <idle.hold-pose>, Kp = 4.0, Ki = 0.0, Kd = 0.4 }
    }

    SOLVERS {
        arm_solver: Solver {
            robot: <kinova>,
            algorithm: ACHD,
            root: <kinova.chain.root>,
            end: <kinova.chain.end>,
            gravity: <world.gravity> equal to <spec.gravity-vec>
        }
    }
}

CONSTRAINT_HANDLER (ns=app) handler_touch_down {
    CONTEXT {}

    MOTION: <touch_down>

    MONITORS {
        monitor-contact-table: monitor <touch_down.contact-table> and trigger event table-contact when active
    }

    CONTROLLERS {
        ctrl-move-down-z: PID { constraint: <touch_down.move-down-z>, Kp = 1.0, Ki = 0.0, Kd = 0.1 },
        ctrl-keep-lin-x-zero: PID { constraint: <touch_down.keep-lin-x-zero>, Kp = 1.0, Ki = 0.0, Kd = 0.1 },
        ctrl-keep-lin-y-zero: PID { constraint: <touch_down.keep-lin-y-zero>, Kp = 1.0, Ki = 0.0, Kd = 0.1 },
        ctrl-keep-ang-x-zero: PID { constraint: <touch_down.keep-ang-x-zero>, Kp = 1.0, Ki = 0.0, Kd = 0.1 },
        ctrl-keep-ang-y-zero: PID { constraint: <touch_down.keep-ang-y-zero>, Kp = 1.0, Ki = 0.0, Kd = 0.1 },
        ctrl-keep-ang-z-zero: PID { constraint: <touch_down.keep-ang-z-zero>, Kp = 1.0, Ki = 0.0, Kd = 0.1 }
    }

    SOLVERS {
        <handler_idle.arm_solver>
    }
}

CONSTRAINT_HANDLER (ns=app) handler_move_forward_15cm {
    CONTEXT {}

    MOTION: <move_forward_15cm>

    MONITORS {
        monitor-forward-distance: monitor <move_forward_15cm.reached-forward-distance> and trigger event forward-distance-reached when active
    }

    CONTROLLERS {
        ctrl-move-forward-x: PID { constraint: <move_forward_15cm.move-forward-x>, Kp = 1.0, Ki = 0.0, Kd = 0.1 },
        ctrl-keep-lin-z-zero: PID { constraint: <move_forward_15cm.keep-lin-z-zero>, Kp = 1.0, Ki = 0.0, Kd = 0.1 },
        <handler_touch_down.ctrl-keep-lin-y-zero>,
        <handler_touch_down.ctrl-keep-ang-x-zero>,
        <handler_touch_down.ctrl-keep-ang-y-zero>,
        <handler_touch_down.ctrl-keep-ang-z-zero>
    }

    SOLVERS {
        <handler_idle.arm_solver>
    }
}

CONSTRAINT_HANDLER (ns=app) handler_move_up_30cm_from_table {
    CONTEXT {}

    MOTION: <move_up_30cm_from_table>

    MONITORS {
        monitor-table-clearance: monitor <move_up_30cm_from_table.reached-table-clearance> and trigger event table-clearance-reached when active
    }

    CONTROLLERS {
        ctrl-move-up-z: PID { constraint: <move_up_30cm_from_table.move-up-z>, Kp = 1.0, Ki = 0.0, Kd = 0.1 },
        <handler_touch_down.ctrl-keep-lin-x-zero>,
        <handler_touch_down.ctrl-keep-lin-y-zero>,
        <handler_touch_down.ctrl-keep-ang-x-zero>,
        <handler_touch_down.ctrl-keep-ang-y-zero>,
        <handler_touch_down.ctrl-keep-ang-z-zero>
    }

    SOLVERS {
        <handler_idle.arm_solver>
    }
}
