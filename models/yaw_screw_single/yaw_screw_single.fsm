ns yss = "https://secorolab.github.io/models/yaw-screw-single/fsm/"

evt loop (ns=yss) yaw_screw_single_fsm_events {
    evt E_STEP,
    evt E_HOME_SETTLED,
    evt E_SWEEP_DONE
}

fsm (ns=yss) yaw_screw_single_fsm {
    description: "Settle in the home pose, then turn the tool about the base axis until it reaches the pose joint 1 at 90 degrees gives."

    states {
        S_START,
        S_HOME,
        S_SWEEP,
        S_DONE
    }

    evt loop: <yaw_screw_single_fsm_events>

    start: <S_START>
    end:   <S_DONE>

    transitions {
        T_START_HOME { from: <S_START>, to: <S_HOME> },
        T_HOME_SWEEP { from: <S_HOME>,  to: <S_SWEEP> },
        T_SWEEP_DONE { from: <S_SWEEP>, to: <S_DONE> }
    }

    reactions {
        R_STEP_START { when: <yaw_screw_single_fsm_events.E_STEP>, do: <T_START_HOME> },
        R_HOME_SETTLED { when: <yaw_screw_single_fsm_events.E_HOME_SETTLED>, do: <T_HOME_SWEEP> },
        R_SWEEP_DONE { when: <yaw_screw_single_fsm_events.E_SWEEP_DONE>, do: <T_SWEEP_DONE> }
    }
}
