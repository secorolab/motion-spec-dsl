import "yaw_screw_single.fsm"
import "yaw_screw_single.scenex"
ns app = "https://secorolab.github.io/models/yaw-screw-single/"
ns yss = "https://secorolab.github.io/models/yaw-screw-single/fsm/"

exec-context (ns=app) yaw-screw-exec {
    runs-scene: <yaw_screw_scene_mjc>
    platform:   simulation { name: "MuJoCo" }
    config:     "robot.toml"
    timestep:   1.0 ms
}

context (ns=app) shared {
    world {
        pose pose-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        velocity-twist twist-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        // The same twist in the tool's own axes. A turn about the base axis carries the tool
        // with it, so what is a rotating direction in the base frame is a fixed one here: the
        // whole sweep is six constants, and no path is needed to say where the tool goes next.
        velocity-twist twist-ee-tool {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <gripper.g_base.g_pinch>
        },
        // Six constraints on the tool leave the seventh joint free, and that self-motion
        // drifts the elbow until the wrist runs out of room partway through the sweep. A
        // yaw about the base keeps the elbow at one height, so holding it costs nothing.
        pose pose-elbow-base {
            of:         <kinova.forearm_link.forearm_link_origin>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        }
    },
    spec {
        length satisfied-band     = 0.01 m,
        angle satisfied-band-rot           = 0.01 rad,
        linear-velocity satisfied-band-vel = 0.01 m/s,
        linear-velocity zero-linvel        = 0.0 m/s,
        angular-velocity satisfied-band-ang-vel = 0.01 rad/s,
        angular-velocity zero-angvel       = 0.0 rad/s,
        // Half-width of the box the sweep has to end in. A band, not an equality: the last
        // millimetres bleed off slowly and a tight gate stalls there.
        length reach-band         = 0.03 m,
        length neg-reach-band     = -0.03 m,
        // Captured once, on the first tick: where the arm rests after the reset.
        pose start-pose         = snapshot of <shared.world.pose-ee-base>,
        length elbow-z = snapshot of <shared.world.pose-elbow-base>.position.z
    }
}

tolerances {
    linear-velocity:  0.01 m/s,
    angular-velocity: 0.01 rad/s,
    position:         0.01 m,
    orientation:      0.01 rad
}

guarded-motion (ns=app) home {
    description: "Hold the pose the arm resets to until it stops moving"

    context { }

    when {}

    while {
        hold-position:    keeping <shared.world.pose-ee-base>.position equal to <shared.spec.start-pose>.position within <shared.spec.satisfied-band>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <shared.spec.start-pose>.orientation within <shared.spec.satisfied-band-rot>
    }

    until all {
        settled-x: <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linvel> within <shared.spec.satisfied-band-vel>,
        settled-y: <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linvel> within <shared.spec.satisfied-band-vel>,
        settled-z: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel> within <shared.spec.satisfied-band-vel>
    }
}

guarded-motion (ns=app) yaw-screw {
    description: "Turn the tool about the base axis at a fixed twist until it reaches the joint-1 +90 deg pose"

    context {
        spec {
            // The twist of a rigid quarter turn about the base axis, written in the tool's
            // axes, where it is constant for the whole sweep. The chain puts the tool's x
            // along the base y, its y along the base z and its z outward along the radius, so
            // the turn is about tool y, the travel along tool x, and tool z holds the radius.
            // Rate = 0.05 m/s over the 0.677474 m radius; both negative because joint 1 at
            // +90 deg turns the arm clockwise seen from above.
            angular-velocity turn-rate  = -0.0738 rad/s,
            linear-velocity travel-rate = -0.05 m/s,
            // The tool at home with joint 1 at +90 deg -- the same pose the arc models end on,
            // stated here only to say when to stop.
            length target-x    = 0.001346 m,
            length target-y    = -0.677473 m,
            length target-x-lo = <spec.target-x> + <shared.spec.neg-reach-band>,
            length target-x-hi = <spec.target-x> + <shared.spec.reach-band>,
            length target-y-lo = <spec.target-y> + <shared.spec.neg-reach-band>,
            length target-y-hi = <spec.target-y> + <shared.spec.reach-band>
        }
    }

    when {}

    while {
        turn:          keeping <shared.world.twist-ee-tool>.angvel.y equal to <spec.turn-rate> within <shared.spec.satisfied-band-ang-vel>,
        no-tilt-x:     keeping <shared.world.twist-ee-tool>.angvel.x equal to <shared.spec.zero-angvel> within <shared.spec.satisfied-band-ang-vel>,
        no-tilt-z:     keeping <shared.world.twist-ee-tool>.angvel.z equal to <shared.spec.zero-angvel> within <shared.spec.satisfied-band-ang-vel>,
        // Along the tangent, and nothing along the other two: holding the radius and the
        // height is what makes the path a circle without any path being stated.
        travel:        keeping <shared.world.twist-ee-tool>.linvel.x equal to <spec.travel-rate> within <shared.spec.satisfied-band-vel>,
        hold-height:   keeping <shared.world.twist-ee-tool>.linvel.y equal to <shared.spec.zero-linvel> within <shared.spec.satisfied-band-vel>,
        hold-radius:   keeping <shared.world.twist-ee-tool>.linvel.z equal to <shared.spec.zero-linvel> within <shared.spec.satisfied-band-vel>,
        hold-elbow-z:  keeping <shared.world.pose-elbow-base>.position.z equal to <shared.spec.elbow-z> within <shared.spec.satisfied-band>
    }

    until all {
        at-target-x: <shared.world.pose-ee-base>.position.x between <spec.target-x-lo> and <spec.target-x-hi>,
        at-target-y: <shared.world.pose-ee-base>.position.y between <spec.target-y-lo> and <spec.target-y-hi>
    }
}

constraint-handler (ns=app) handler-home {
    handles: <home>
    monitors {
        mon-home-settled: monitor <home.until> {
            satisfied for 0.3 s { trigger: event <yss.E_HOME_SETTLED> },
        }
    }
    controllers {
        pid ctrl-hold-position { constraint: <home.hold-position>, Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-hold-orientation { constraint: <home.hold-orientation>, Kp: 120, Ki: 50, Kd: 80, decay: 0 }
    }
    solvers {
        arm-solver: serial-chain {
            agent: <agents.kinova_ft_2f85>,
            algorithm: rne,
            gravity: (0.0, 0.0, -9.81) m/s^2
        }
    }
}

constraint-handler (ns=app) handler-sweep {
    handles: <yaw-screw>
    monitors {
        mon-sweep-done: monitor <yaw-screw.until> {
            satisfied for 0.3 s { trigger: event <yss.E_SWEEP_DONE> },
        }
    }
    // Rate loops throughout: every error is already a velocity, so P and I are all it takes
    // and a D term would differentiate a measured rate twice.
    controllers {
        pid ctrl-turn { constraint: <yaw-screw.turn>, Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        pid ctrl-no-tilt-x { constraint: <yaw-screw.no-tilt-x>, Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        pid ctrl-no-tilt-z { constraint: <yaw-screw.no-tilt-z>, Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        pid ctrl-travel { constraint: <yaw-screw.travel>, Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        pid ctrl-hold-height { constraint: <yaw-screw.hold-height>, Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        pid ctrl-hold-radius { constraint: <yaw-screw.hold-radius>, Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        impedance ctrl-support-elbow {
            constraint: <yaw-screw.hold-elbow-z>,
            Ki: 200,
            stiffness: 2500,
            damping: 80
        } apply at <kinova.forearm_link>
    }
    solvers { <handler-home.arm-solver> }
}
