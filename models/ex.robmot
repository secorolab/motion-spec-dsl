ns app = "https://secorolab.github.io/models/generated/"

ROBOT (ns=app) kinova {
    type: Manipulator,
    urdf: "../robots/kg3.urdf",
    chain: {
        root: link-base,
        end: link-ee
    }
}

MOTION_SPEC (ns=app) m-approach {
    MOVE: "Move EE downward until contact, holding lateral velocities and joint posture"

    CONTEXT {
        cw: World {
            twist-ee: VelocityTwist {
                of: link-ee,
                wrt: link-base,
                ref-point: point-ee-origin,
                as-seen-by: frame-ee
            },
            wrench-ee: Wrench { ref-point: point-ee-origin, as-seen-by: frame-ee },
            q-j2: JointPosition { of: joint-2 },
            q-j4: JointPosition { of: joint-4 }
        },
        cs: Spec {
            vel-z-down:  LinearVelocity = -0.05 m/s,
            vel-zero:    LinearVelocity =  0.0  m/s,
            q-j2-ref:    Angle = 2.4 rad,
            q-j4-lower:  Angle = -0.8 rad,
            q-j4-upper:  Angle =  0.8 rad
        },
        cpo: Post {
            frc-threshold: Force = 5.0 N,
            frc-overload:  Force = 20.0 N
        }
    }

    WHEN {}

    WHILE {
        cstr-linvel-z: keeping <cw.twist-ee>.linvel.z equal to <cs.vel-z-down>,
        cstr-linvel-x: keeping <cw.twist-ee>.linvel.x equal to <cs.vel-zero>,
        cstr-linvel-y: keeping <cw.twist-ee>.linvel.y equal to Spec[vel-y-zero: LinearVelocity = 0.0 m/s],
        cstr-keep-j2:  keeping <cw.q-j2> away from <cs.q-j2-ref>,
        cstr-limit-j4: keeping <cw.q-j4> between <cs.q-j4-lower> and <cs.q-j4-upper>
    }

    UNTIL any {
        cstr-contact:  <cw.wrench-ee>.force.z is larger than <cpo.frc-threshold>,
        cstr-overload: <cw.wrench-ee>.force.z is larger than <cpo.frc-overload>
    }
}

MOTION_SPEC (ns=app) m-contact {
    MOVE: "Regulate contact force and EE orientation, maintaining joint posture"

    CONTEXT {
        cw: World {
            <m-approach.cw.twist-ee>,
            <m-approach.cw.wrench-ee>,
            <m-approach.cw.q-j2>,
            <m-approach.cw.q-j4>
        },
        cs: Spec {
            frc-z-ref:   Force = 10.0 N,
            angvel-zero: AngularVelocity = 0.0 rad/s
        },
        cpr: Pre {
            frc-start: Force = 1.0 N
        }
    }

    WHEN {
        cstr-in-contact: <m-approach.cw.wrench-ee>.force.z is larger than <cpr.frc-start>
    }

    WHILE {
        cstr-frc-z:    keeping <m-approach.cw.wrench-ee>.force.z equal to <cs.frc-z-ref>,
        cstr-angvel-x: keeping <m-approach.cw.twist-ee>.angvel.x equal to <cs.angvel-zero>,
        cstr-angvel-y: keeping <m-approach.cw.twist-ee>.angvel.y equal to <cs.angvel-zero>,
        cstr-angvel-z: keeping <m-approach.cw.twist-ee>.angvel.z equal to <cs.angvel-zero>,
        <m-approach.cstr-keep-j2>,
        <m-approach.cstr-limit-j4>
    }

    UNTIL {
        cstr-overload: <m-approach.cw.wrench-ee>.force.z is larger than Spec[frc-contact-overload: Force = 25.0 N]
    }
}

CONSTRAINT_HANDLER (ns=app) handler-approach {
    CONTEXT {
        c1: World {
            gravity: Gravity
        },
        c2: Spec {
            gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <m-approach>

    MONITORS {
        mon-contact:  monitor <m-approach.cstr-contact>  and trigger event evt-contact  when active,
        mon-overload: monitor <m-approach.cstr-overload> and trigger event evt-overload when active
    }

    CONTROLLERS {
        ctrl-linvel-z: PID { constraint: <m-approach.cstr-linvel-z>, Kp = 5.0, Ki = 1.0, Kd = 1.0 },
        ctrl-linvel-x: PID { constraint: <m-approach.cstr-linvel-x>, Kp = 5.0, Ki = 1.0, Kd = 1.0 },
        ctrl-linvel-y: PID { constraint: <m-approach.cstr-linvel-y>, Kp = 5.0, Ki = 1.0, Kd = 1.0 },
        ctrl-keep-j2:  PID { constraint: <m-approach.cstr-keep-j2>,  Kp = 10.0, Ki = 0.0, Kd = 0.5 } as Torque for Posture,
        ctrl-limit-j4: PID { constraint: <m-approach.cstr-limit-j4>, Kp = 10.0, Ki = 0.0, Kd = 0.5 } as Torque for Posture
    }

    SOLVERS {
        arm-solver: Solver {
            robot: <kinova>,
            algorithm: ACHD,
            root: <kinova.chain.root>,
            end: <kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}

CONSTRAINT_HANDLER (ns=app) handler-contact {
    CONTEXT {
        c1: World {
            link-ee: Link
        }
    }

    MOTION: <m-contact>

    MONITORS {
        mon-in-contact: monitor <m-contact.cstr-in-contact> and set flag flg-in-contact while active,
        mon-overload:   monitor <m-contact.cstr-overload>   and trigger event evt-overload when active
    }

    CONTROLLERS {
        ctrl-frc-z:    PID { constraint: <m-contact.cstr-frc-z>,    Kp = 1.0, Ki = 0.0, Kd = 0.0 } as Force apply at <c1.link-ee>,
        ctrl-angvel-x: PID { constraint: <m-contact.cstr-angvel-x>, Kp = 5.0, Ki = 0.5, Kd = 1.0 },
        ctrl-angvel-y: PID { constraint: <m-contact.cstr-angvel-y>, Kp = 5.0, Ki = 0.5, Kd = 1.0 },
        ctrl-angvel-z: PID { constraint: <m-contact.cstr-angvel-z>, Kp = 5.0, Ki = 0.5, Kd = 1.0 },
        <handler-approach.ctrl-keep-j2>,
        <handler-approach.ctrl-limit-j4>
    }

    SOLVERS {
        <handler-approach.arm-solver>
    }
}
