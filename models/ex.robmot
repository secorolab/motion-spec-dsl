// Simple example: move end-effector downward until contact force is detected

ns app = "https://secorolab.github.io/models/generated/"

MOTION_SPEC (ns=app) motion_move {
    MOVE: "Move end-effector downward at constant velocity until contact"

    CONTEXT {
        c1: World {
            twist-ee-base: VelocityTwist { of = link-ee, wrt = link-base },
            wrench-ee-ee:  Wrench { ref-point = link-ee, as-seen-by = link-ee }
        },
        c2: Spec {
            vel-z-down: LinearVelocity = -0.05 m/s,
            vel-zero:   LinearVelocity =  0.0  m/s
        },
        c3: Post {
            force-contact: Force = 5.0 N
        }
    }

    WHEN {}

    WHILE {
        wi1: keeping twist-ee-base.linear.z equal to Spec[vel-z-down],
        wi2: keeping twist-ee-base.linear.x equal to Spec[vel-zero],
        wi3: keeping twist-ee-base.linear.y equal to Spec[vel-zero]
    }

    UNTIL {
        u1: wrench-ee-ee.force.z is larger than Post[force-contact]
    }
}

CONSTRAINT_HANDLER (ns=app) handler_move {
    CONTEXT {
        c1: World {
            chain-arm:  KinematicChain,
            frame-base: Frame,
            gravity:    UniformGravitationalField
        },
        c2: Spec {
            gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: @motion_move

    MONITORS {
        monitor u1 and trigger event evt-contact when active
    }

    CONTROLLERS {
        ctrl-vel-z: PID { constraint: wi1, Kp: 5.0, Ki: 1.0, Kd: 1.0 },
        ctrl-vel-x: PID { constraint: wi2, Kp: 5.0, Ki: 1.0, Kd: 1.0 },
        ctrl-vel-y: PID { constraint: wi3, Kp: 5.0, Ki: 1.0, Kd: 1.0 }
    }

    SOLVER {
        algorithm: Vereshchagin,
        chain:     World[chain-arm],
        root:      World[frame-base],
        gravity:   World[gravity] equal to Spec[gravity-vec]
    }
}

