// Simple example: move end-effector downward until contact force is detected

ns app = "https://secorolab.github.io/models/generated/"

ROBOT (ns=app) kinova {
    type: Manipulator,
    urdf: "../robots/kg3.urdf",
    chain: {
        root: base-link,
        end: ee-link
    }
}

MOTION_SPEC (ns=app) m_move {
    MOVE: "Move end-effector downward at constant velocity until contact"

    CONTEXT {
        cw: World {
            twist-ee-base: VelocityTwist { of: link-ee, wrt: link-base },
            wrench-ee-ee:  Wrench { ref-point: link-ee, as-seen-by: link-ee }
        },
        cs: Spec {
            vel-z-down: LinearVelocity = -0.05 m/s,
            vel-zero:   LinearVelocity =  0.0  m/s
        },
        cpo: Post {
            force-contact: Force
        }
    }

    WHEN {}

    WHILE {
        wi1: keeping <cw.twist-ee-base>.linvel.z equal to <cs.vel-z-down>,
        wi2: keeping <cw.twist-ee-base>.linvel.x equal to <cs.vel-zero>,
        wi3: keeping <cw.twist-ee-base>.linvel.y equal to <cs.vel-zero>
    }

    UNTIL {
        u1: <cw.wrench-ee-ee>.force.z is larger than [cpo.force-contact = 5.0 N]
    }
}

CONSTRAINT_HANDLER (ns=app) handler_move {
    CONTEXT {
        c1: World {
            gravity:    Gravity
        },
        c2: Spec {
            gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <m_move>

    MONITORS {
        mon-contact: monitor <m_move.u1> and trigger event evt-contact when active
    }

    CONTROLLERS {
        ctrl-vel-z: PID {
            constraint: <m_move.wi1>,
            solver: <kinova_solver>,
            Kp = 5.0, Ki = 1.0, Kd = 1.0
        },
        ctrl-vel-x: PID {
            constraint: <m_move.wi2>,
            solver: <kinova_solver>,
            Kp = 5.0, Ki = 1.0, Kd = 1.0
        },
        ctrl-vel-y: PID { constraint: <m_move.wi3>, solver: <kinova_solver>, Kp = 5.0, Ki = 1.0, Kd = 1.0 }
    }

    SOLVERS {
        kinova_solver: Solver {
            robot: <kinova>,
            algorithm: Vereshchagin,
            root: <kinova.chain.root>,
            end: <kinova.chain.end>,
            gravity: <c1.gravity> equal to <c2.gravity-vec>
        }
    }
}
