// Contact-rich find-and-loosen example with two guarded motions.

ns app = "https://secorolab.github.io/models/crf/"

ENVIRONMENT (ns=app) world {
    runtime: RealRobot,
    ASSETS {
        kinova-urdf: RobotAsset { model: KinovaGen3, urdf: "../robots/kg3.urdf" }
    },
    ASSEMBLY {
        Robot kinova using <kinova-urdf> {
            chain: { root: base_link, end: Bracelet_Link }
        }
    }
}

MOTION_SPEC (ns=app) m-find {
    MOVE: "Rotate to find the screw engagement point"

    CONTEXT {
        c1: World {
            twist-ee-ee: VelocityTwist {
                of: link-ee,
                wrt: link-world,
                ref-point: point-ee-origin,
                as-seen-by: frame-ee
            },
            wrench-ee-ee: Wrench { ref-point: point-ee-origin, as-seen-by: frame-ee },
            pose-arm-ee-world: Pose { of: frame-ee, wrt: frame-world, as-seen-by: frame-world }
        },
        c2: Spec {
            angvel-ee-z-ref-find: AngularVelocity = 1.0 rad/s,
            angvel-zero-ref: AngularVelocity = 0.0 rad/s,
            linvel-zero-ref: LinearVelocity = 0.0 m/s
        },
        c3: Post {
            torque-find-shutoff: Torque = 4.0 Nm,
            rotation-find-limit: AngularDistance = 2.0944 rad,
            torque-find-upper-limit: Torque = 12.0 Nm
        }
    }

    WHEN {}

    WHILE {
        cstr-angvel-find: keeping <c1.twist-ee-ee>.angvel.z equal to <c2.angvel-ee-z-ref-find>,
        cstr-linvel-ee-x-zero: keeping <c1.twist-ee-ee>.linvel.x equal to <c2.linvel-zero-ref>,
        cstr-linvel-ee-y-zero:
            keeping <c1.twist-ee-ee>.linvel.y equal to Spec[linvel-zero-inline-ref: LinearVelocity = 0.0 m/s],
        cstr-linvel-ee-z-zero: keeping <c1.twist-ee-ee>.linvel.z equal to <c2.linvel-zero-ref>,
        cstr-angvel-ee-x-zero: keeping <c1.twist-ee-ee>.angvel.x equal to <c2.angvel-zero-ref>,
        cstr-angvel-ee-y-zero: keeping <c1.twist-ee-ee>.angvel.y equal to <c2.angvel-zero-ref>
    }

    UNTIL {
        cstr-torque-find-shutoff: <c1.wrench-ee-ee>.torque.z is larger than <c3.torque-find-shutoff>,
        cstr-rotation-find-limit:
            <c1.pose-arm-ee-world>.orientation.z
            is larger than <c3.rotation-find-limit>,
        cstr-torque-find-upper-limit:
            <c1.wrench-ee-ee>.torque.z
            is larger than <c3.torque-find-upper-limit>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-find {
    CONTEXT {
        c1: World {
            link-ee: Link,
            earth-uniform-gravitational-field: Gravity
        },
        c2: Spec {
            gravity-vec: FreeVector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: <m-find>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-find-until:
            monitor <m-find.until> and
            trigger event evt-find-until when active
    }

    CONTROLLERS {
        ctrl-angvel-find: PID {
            constraint: <m-find.cstr-angvel-find>,
            Kp = 8.0, Ki = 0.5, Kd = 3.0
        },
        ctrl-linvel-ee-x-zero: PID {
            constraint: <m-find.cstr-linvel-ee-x-zero>,
            Kp = 5.0, Ki = 1.0, Kd = 3.0
        },
        ctrl-linvel-ee-y-zero: PID {
            constraint: <m-find.cstr-linvel-ee-y-zero>,
            Kp = 5.0, Ki = 1.0, Kd = 3.0
        },
        ctrl-linvel-ee-z-zero: PID {
            constraint: <m-find.cstr-linvel-ee-z-zero>,
            Kp = 5.0, Ki = 1.0, Kd = 3.0
        },
        ctrl-angvel-ee-x-zero: PID {
            constraint: <m-find.cstr-angvel-ee-x-zero>,
            Kp = 5.0, Ki = 1.0, Kd = 3.0
        },
        ctrl-angvel-ee-y-zero: PID {
            constraint: <m-find.cstr-angvel-ee-y-zero>,
            Kp = 5.0, Ki = 1.0, Kd = 3.0
        }
    }

    SOLVERS {
        right_arm_solver: Solver {
            robot: <world.kinova>,
            algorithm: ACHD,
            root: <world.kinova.chain.root>,
            end: <world.kinova.chain.end>,
            gravity: <c1.earth-uniform-gravitational-field> equal to <c2.gravity-vec>
        }
    }
}

MOTION_SPEC (ns=app) m-loosen {
    MOVE: "Reverse-rotate to loosen after screw engagement"

    CONTEXT {
        c1: World {
            <m-find.c1.twist-ee-ee>,
            <m-find.c1.wrench-ee-ee>,
            <m-find.c1.pose-arm-ee-world>
        },
        c2: Pre {
            torque-loosen-min-contact: Torque = 0.5 Nm
        },
        c3: Spec {
            angvel-ee-z-ref-loosen: AngularVelocity = -1.0 rad/s,
            <m-find.c2.angvel-zero-ref>
        },
        c4: Post {
            rotation-loosen-lower: AngularDistance = 1.4835 rad,
            rotation-loosen-upper: AngularDistance = 1.6581 rad,
            torque-loosen-lower: Torque = 0.05 Nm,
            torque-loosen-upper: Torque = 8.4 Nm
        }
    }

    WHEN {
        cstr-torque-loosen-contact:
            <m-find.c1.wrench-ee-ee>.torque.z
            is larger than <c2.torque-loosen-min-contact>
    }

    WHILE {
        cstr-angvel-loosen:
            keeping <m-find.c1.twist-ee-ee>.angvel.z equal to <c3.angvel-ee-z-ref-loosen>,
        <m-find.cstr-linvel-ee-x-zero>,
        <m-find.cstr-linvel-ee-y-zero>,
        <m-find.cstr-linvel-ee-z-zero>,
        <m-find.cstr-angvel-ee-x-zero>,
        <m-find.cstr-angvel-ee-y-zero>
    }

    UNTIL {
        cstr-rotation-loosen-bilateral:
            <m-find.c1.pose-arm-ee-world>.orientation.z
            between <c4.rotation-loosen-lower>
            and <c4.rotation-loosen-upper>,
        cstr-torque-loosen-bilateral:
            <m-find.c1.wrench-ee-ee>.torque.z
            between <c4.torque-loosen-lower>
            and <c4.torque-loosen-upper>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-loosen {
    CONTEXT {}

    MOTION: <m-loosen>
    CONTROL_MODE: JointTorque

    MONITORS {
        mon-torque-loosen-contact:
            monitor <m-loosen.cstr-torque-loosen-contact> and
            set flag flg-torque-loosen-contact while active,
        mon-loosen-until:
            monitor <m-loosen.until> and
            trigger event evt-loosen-until when active
    }

    CONTROLLERS {
        ctrl-angvel-loosen: PID {
            constraint: <m-loosen.cstr-angvel-loosen>,
            Kp = 8.0, Ki = 0.5, Kd = 3.0
        },
        <handler-find.ctrl-linvel-ee-x-zero>,
        <handler-find.ctrl-linvel-ee-y-zero>,
        <handler-find.ctrl-linvel-ee-z-zero>,
        <handler-find.ctrl-angvel-ee-x-zero>,
        <handler-find.ctrl-angvel-ee-y-zero>
    }

    SOLVERS {
        <handler-find.right_arm_solver>
    }
}
