// Contact-rich find-and-loosen example with two guarded motions.

ns app = "https://secorolab.github.io/models/crf/"

MOTION_SPEC (ns=app) motion_find {
    MOVE: "Rotate to find the screw engagement point"

    CONTEXT {
        c1: World {
            twist-ee-ee: VelocityTwist { of = link-ee, wrt = link-world, ref-point = point-ee-origin, as-seen-by = frame-ee },
            wrench-ee-ee: Wrench { ref-point = point-ee-origin, as-seen-by = frame-ee },
            pose-arm-ee-world: Pose { of = frame-ee, wrt = frame-world, as-seen-by = frame-world }
        },
        c2: Spec {
            angvel-ee-z-ref-find: AngularVelocity = 1.0 rad/s,
            angvel-zero-ref: AngularVelocity = 0.0 rad/s,
            linvel-zero-ref: LinearVelocity = 0.0 m/s
        },
        c3: Post {
            torque-find-shutoff: Torque = 4.0 Nm,
            rotation-find-limit: Angle = 2.0944 rad,
            torque-find-upper-limit: Torque = 12.0 Nm
        }
    }

    WHEN {}

    WHILE {
        cstr-angvel-find: keeping c1.twist-ee-ee.angvel.z equal to c2.angvel-ee-z-ref-find,
        cstr-linvel-ee-x-zero: keeping c1.twist-ee-ee.linvel.x equal to c2.linvel-zero-ref,
        cstr-linvel-ee-y-zero: keeping c1.twist-ee-ee.linvel.y equal to c2.linvel-zero-ref,
        cstr-linvel-ee-z-zero: keeping c1.twist-ee-ee.linvel.z equal to c2.linvel-zero-ref,
        cstr-angvel-ee-x-zero: keeping c1.twist-ee-ee.angvel.x equal to c2.angvel-zero-ref,
        cstr-angvel-ee-y-zero: keeping c1.twist-ee-ee.angvel.y equal to c2.angvel-zero-ref
    }

    UNTIL {
        cstr-torque-find-shutoff: c1.wrench-ee-ee.torque.z is larger than c3.torque-find-shutoff,
        cstr-rotation-find-limit: c1.pose-arm-ee-world.orientation.z is larger than c3.rotation-find-limit,
        cstr-torque-find-upper-limit: c1.wrench-ee-ee.torque.z is larger than c3.torque-find-upper-limit
    }
}

CONSTRAINT_HANDLER (ns=app) handler_find {
    CONTEXT {
        c1: World {
            chain-arm: KinematicChain,
            frame-world: Frame,
            earth-uniform-gravitational-field: Gravity
        },
        c2: Spec {
            gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: motion_find

    MONITORS {
        monitor motion_find.cstr-torque-find-shutoff and trigger event evt-torque-find-shutoff when active,
        monitor motion_find.cstr-rotation-find-limit and trigger event evt-rotation-find-limit when active,
        monitor motion_find.cstr-torque-find-upper-limit and trigger event evt-torque-find-upper-limit when active
    }

    CONTROLLERS {
        ctrl-angvel-find: PID { constraint: motion_find.cstr-angvel-find, Kp: 8.0, Ki: 0.5, Kd: 3.0 },
        ctrl-linvel-ee-x-zero: PID { constraint: motion_find.cstr-linvel-ee-x-zero, Kp: 5.0, Ki: 1.0, Kd: 3.0 },
        ctrl-linvel-ee-y-zero: PID { constraint: motion_find.cstr-linvel-ee-y-zero, Kp: 5.0, Ki: 1.0, Kd: 3.0 },
        ctrl-linvel-ee-z-zero: PID { constraint: motion_find.cstr-linvel-ee-z-zero, Kp: 5.0, Ki: 1.0, Kd: 3.0 },
        ctrl-angvel-ee-x-zero: PID { constraint: motion_find.cstr-angvel-ee-x-zero, Kp: 5.0, Ki: 1.0, Kd: 3.0 },
        ctrl-angvel-ee-y-zero: PID { constraint: motion_find.cstr-angvel-ee-y-zero, Kp: 5.0, Ki: 1.0, Kd: 3.0 }
    }

    SOLVER {
        algorithm: Vereshchagin,
        chain: c1.chain-arm,
        root: c1.frame-world,
        gravity: c1.earth-uniform-gravitational-field equal to c2.gravity-vec
    }
}

MOTION_SPEC (ns=app) motion_loosen {
    MOVE: "Reverse-rotate to loosen after screw engagement"

    CONTEXT {
        c1: World {
            twist-ee-ee: VelocityTwist { of = link-ee, wrt = link-world, ref-point = point-ee-origin, as-seen-by = frame-ee },
            wrench-ee-ee: Wrench { ref-point = point-ee-origin, as-seen-by = frame-ee },
            pose-arm-ee-world: Pose { of = frame-ee, wrt = frame-world, as-seen-by = frame-world }
        },
        c2: Pre {
            torque-loosen-min-contact: Torque = 0.5 Nm
        },
        c3: Spec {
            angvel-ee-z-ref-loosen: AngularVelocity = -1.0 rad/s,
            angvel-zero-ref: AngularVelocity = 0.0 rad/s,
            linvel-zero-ref: LinearVelocity = 0.0 m/s
        },
        c4: Post {
            rotation-loosen-lower: Angle = 1.4835 rad,
            rotation-loosen-upper: Angle = 1.6581 rad,
            torque-loosen-lower: Torque = 0.05 Nm,
            torque-loosen-upper: Torque = 8.4 Nm
        }
    }

    WHEN {
        cstr-torque-loosen-contact: c1.wrench-ee-ee.torque.z is larger than c2.torque-loosen-min-contact
    }

    WHILE {
        cstr-angvel-loosen: keeping c1.twist-ee-ee.angvel.z equal to c3.angvel-ee-z-ref-loosen,
        cstr-linvel-ee-x-zero-loosen: keeping c1.twist-ee-ee.linvel.x equal to c3.linvel-zero-ref,
        cstr-linvel-ee-y-zero-loosen: keeping c1.twist-ee-ee.linvel.y equal to c3.linvel-zero-ref,
        cstr-linvel-ee-z-zero-loosen: keeping c1.twist-ee-ee.linvel.z equal to c3.linvel-zero-ref,
        cstr-angvel-ee-x-zero-loosen: keeping c1.twist-ee-ee.angvel.x equal to c3.angvel-zero-ref,
        cstr-angvel-ee-y-zero-loosen: keeping c1.twist-ee-ee.angvel.y equal to c3.angvel-zero-ref
    }

    UNTIL {
        cstr-rotation-loosen-bilateral: c1.pose-arm-ee-world.orientation.z between c4.rotation-loosen-lower and c4.rotation-loosen-upper,
        cstr-torque-loosen-bilateral: c1.wrench-ee-ee.torque.z between c4.torque-loosen-lower and c4.torque-loosen-upper
    }
}

CONSTRAINT_HANDLER (ns=app) handler_loosen {
    CONTEXT {
        c1: World {
            chain-arm: KinematicChain,
            frame-world: Frame,
            earth-uniform-gravitational-field: Gravity
        },
        c2: Spec {
            gravity-vec: Vector { x = 0.0, y = 0.0, z = -9.81 m/s2 }
        }
    }

    MOTION: motion_loosen

    MONITORS {
        monitor motion_loosen.cstr-torque-loosen-contact and set flag flg-torque-loosen-contact while active,
        monitor motion_loosen.cstr-rotation-loosen-bilateral and trigger event evt-rotation-loosen when active,
        monitor motion_loosen.cstr-torque-loosen-bilateral and trigger event evt-torque-loosen when active
    }

    CONTROLLERS {
        ctrl-angvel-loosen: PID { constraint: motion_loosen.cstr-angvel-loosen, Kp: 8.0, Ki: 0.5, Kd: 3.0 },
        ctrl-linvel-ee-x-zero-loosen: PID { constraint: motion_loosen.cstr-linvel-ee-x-zero-loosen, Kp: 5.0, Ki: 1.0, Kd: 3.0 },
        ctrl-linvel-ee-y-zero-loosen: PID { constraint: motion_loosen.cstr-linvel-ee-y-zero-loosen, Kp: 5.0, Ki: 1.0, Kd: 3.0 },
        ctrl-linvel-ee-z-zero-loosen: PID { constraint: motion_loosen.cstr-linvel-ee-z-zero-loosen, Kp: 5.0, Ki: 1.0, Kd: 3.0 },
        ctrl-angvel-ee-x-zero-loosen: PID { constraint: motion_loosen.cstr-angvel-ee-x-zero-loosen, Kp: 5.0, Ki: 1.0, Kd: 3.0 },
        ctrl-angvel-ee-y-zero-loosen: PID { constraint: motion_loosen.cstr-angvel-ee-y-zero-loosen, Kp: 5.0, Ki: 1.0, Kd: 3.0 }
    }

    SOLVER {
        algorithm: Vereshchagin,
        chain: c1.chain-arm,
        root: c1.frame-world,
        gravity: c1.earth-uniform-gravitational-field equal to c2.gravity-vec
    }
}
