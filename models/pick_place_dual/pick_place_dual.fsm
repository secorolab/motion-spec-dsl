ns pp = "https://secorolab.github.io/models/pick-place-dual/fsm/"

fsm (ns=pp) pick_place_dual_fsm {
    description: "Two arms facing each other, each pick&placing its own cube in lockstep; trajectory only home->pick_above, geometric setpoints elsewhere. Grasp-loss on either arm during transport (lift/place_above/place) routes to S_RECOVER, which captures and holds both current poses."

    states {
        S_START,
        S_HOME,
        S_PICK_ABOVE,
        S_PICK,
        S_GRASP,
        S_LIFT,
        S_PLACE_ABOVE,
        S_PLACE,
        S_OPEN,
        S_RETREAT,
        S_DONE,
        S_RECOVER
    }

    events {
        E_STEP,
        E_PICK_ABOVE_READY,
        E_PICK_READY,
        E_GRASP_READY,
        E_LIFT_READY,
        E_PLACE_ABOVE_READY,
        E_PLACE_READY,
        E_OPEN_READY,
        E_RETREAT_READY,
        E_RETREAT_SETTLED,
        E_GRASP_LOST_LIFT,
        E_GRASP_LOST_PLACE_ABOVE,
        E_GRASP_LOST_PLACE,
        E_RECOVER
    }

    start: <S_START>
    end:   <S_DONE>

    transitions {
        T_START_HOME          { from: <S_START>,       to: <S_HOME> },
        T_HOME_PICK_ABOVE     { from: <S_HOME>,        to: <S_PICK_ABOVE> },
        T_PICK_ABOVE_PICK     { from: <S_PICK_ABOVE>,  to: <S_PICK> },
        T_PICK_GRASP          { from: <S_PICK>,        to: <S_GRASP> },
        T_GRASP_LIFT          { from: <S_GRASP>,       to: <S_LIFT> },
        T_LIFT_PLACE_ABOVE    { from: <S_LIFT>,        to: <S_PLACE_ABOVE> },
        T_PLACE_ABOVE_PLACE   { from: <S_PLACE_ABOVE>, to: <S_PLACE> },
        T_PLACE_OPEN          { from: <S_PLACE>,       to: <S_OPEN> },
        T_OPEN_RETREAT        { from: <S_OPEN>,        to: <S_RETREAT> },
        T_RETREAT_DONE        { from: <S_RETREAT>,     to: <S_DONE> },
        T_LIFT_RECOVER        { from: <S_LIFT>,        to: <S_RECOVER> },
        T_PLACE_ABOVE_RECOVER { from: <S_PLACE_ABOVE>, to: <S_RECOVER> },
        T_PLACE_RECOVER       { from: <S_PLACE>,       to: <S_RECOVER> },
        T_RECOVER_HOLD        { from: <S_RECOVER>,     to: <S_RECOVER> }
    }

    reactions {
        R_STEP_START { when: <E_STEP>, do: <T_START_HOME> },
        R_PICK_ABOVE_READY { when: <E_PICK_ABOVE_READY>, do: <T_HOME_PICK_ABOVE> },
        R_PICK_READY { when: <E_PICK_READY>, do: <T_PICK_ABOVE_PICK> },
        R_GRASP_READY { when: <E_GRASP_READY>, do: <T_PICK_GRASP> },
        R_LIFT_READY { when: <E_LIFT_READY>, do: <T_GRASP_LIFT> },
        R_PLACE_ABOVE_READY { when: <E_PLACE_ABOVE_READY>, do: <T_LIFT_PLACE_ABOVE> },
        R_PLACE_READY { when: <E_PLACE_READY>, do: <T_PLACE_ABOVE_PLACE> },
        R_OPEN_READY { when: <E_OPEN_READY>, do: <T_PLACE_OPEN> },
        R_RETREAT_READY { when: <E_RETREAT_READY>, do: <T_OPEN_RETREAT> },
        R_RETREAT_SETTLED { when: <E_RETREAT_SETTLED>, do: <T_RETREAT_DONE> },
        R_LIFT_GRASP_LOST { when: <E_GRASP_LOST_LIFT>, do: <T_LIFT_RECOVER> },
        R_PLACE_ABOVE_GRASP_LOST { when: <E_GRASP_LOST_PLACE_ABOVE>, do: <T_PLACE_ABOVE_RECOVER> },
        R_PLACE_GRASP_LOST { when: <E_GRASP_LOST_PLACE>, do: <T_PLACE_RECOVER> },
        R_RECOVER_HOLD { when: <E_RECOVER>, do: <T_RECOVER_HOLD> }
    }
}
