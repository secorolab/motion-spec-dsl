import "pick_place_dual.fsm"
import "pick_place_dual.scenex"
ns app = "https://secorolab.github.io/models/pick-place-dual/"
ns pp = "https://secorolab.github.io/models/pick-place-dual/fsm/"

exec-context (ns=app) pick-place-dual-exec {
    runs-scene: <pick_place_scene_mjc>
    platform:   simulation { name: "MuJoCo" }
    config:     "robot.toml"
    timestep:   1.0 ms
}

context (ns=app) shared {
    world {
        pose pose-ee1-base {
            of:         <gripper1.g_base.g_pinch>,
            wrt:        <kinova1.base_link>,
            as-seen-by: <kinova1.base_link>
        },
        velocity-twist twist-ee1-base {
            of:         <gripper1.g_base.g_pinch>,
            wrt:        <kinova1.base_link>,
            as-seen-by: <kinova1.base_link>
        },
        pose pose-cube1-base {
            of:         <pick_place_graph.cube>,
            wrt:        <kinova1.base_link>,
            as-seen-by: <kinova1.base_link>
        },
        pose pose-elbow1-base {
            of:         <kinova1.half_arm_2_link>,
            wrt:        <kinova1.base_link>,
            as-seen-by: <kinova1.base_link>
        },
        joint-position gripper1-pos {
            joint: <gripper1.g_left_driver_joint>
        },
        pose pose-ee2-base {
            of:         <gripper2.g_base.g_pinch>,
            wrt:        <kinova2.base_link>,
            as-seen-by: <kinova2.base_link>
        },
        velocity-twist twist-ee2-base {
            of:         <gripper2.g_base.g_pinch>,
            wrt:        <kinova2.base_link>,
            as-seen-by: <kinova2.base_link>
        },
        pose pose-cube2-base {
            of:         <pick_place_graph.cube2>,
            wrt:        <kinova2.base_link>,
            as-seen-by: <kinova2.base_link>
        },
        pose pose-elbow2-base {
            of:         <kinova2.half_arm_2_link>,
            wrt:        <kinova2.base_link>,
            as-seen-by: <kinova2.base_link>
        },
        joint-position gripper2-pos {
            joint: <gripper2.g_left_driver_joint>
        }
    },
    spec {
        linear-distance satisfied-band     = 0.01 m,
        angle satisfied-band-rot           = 0.01 rad,
        linear-velocity zero-linvel = 0.0 m/s,
        linear-distance zero-dist   = 0.0 m,
        angle grasp-rot-x            = 3.14159 rad,
        angle grasp-rot-y           = 0.0 rad,
        angle grasp-rot-z             = 1.5708 rad,
        angle gripper-closed        = 0.8 rad,
        angle gripper-open          = 0.0 rad,
        linear-distance lost-dist   = 0.12 m
    }
}

tolerances {
    linear-distance:  0.01 m,
    angular-distance: 0.01 rad,
    linear-velocity:  0.01 m/s,
    position:         0.01 m,
    orientation:      0.01 rad
}

guarded-motion (ns=app) home {
    description: "Hold both TCPs at their startup home poses"

    context {
        spec {
            pose home1-pose = snapshot of <shared.world.pose-ee1-base>,
            pose home2-pose = snapshot of <shared.world.pose-ee2-base>
        }
    }

    when {}

    while {
        hold1-position:    keeping <shared.world.pose-ee1-base>.position    equal to <spec.home1-pose>.position within <shared.spec.satisfied-band>,
        hold1-orientation: keeping <shared.world.pose-ee1-base>.orientation equal to <spec.home1-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold2-position:    keeping <shared.world.pose-ee2-base>.position    equal to <spec.home2-pose>.position within <shared.spec.satisfied-band>,
        hold2-orientation: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.home2-pose>.orientation within <shared.spec.satisfied-band-rot>
    }

    until {}
}

guarded-motion (ns=app) pick-above {
    description: "Move both TCPs to the pre-grasp position above their cubes along paths"

    context {
        spec {
            linear-distance above-z = 0.26 m,
            linear-velocity approach-speed     = 0.08 m/s,
            linear-velocity min-approach-speed = 0.005 m/s,
            pose start1-pose = snapshot of <shared.world.pose-ee1-base>,
            linear-distance start1-cube-x = snapshot of <shared.world.pose-cube1-base>.position.x,
            linear-distance start1-cube-y = snapshot of <shared.world.pose-cube1-base>.position.y,
            pose goal1-pose = {
                position: (<spec.start1-cube-x>, <spec.start1-cube-y>, <spec.above-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            },
            path arm1-approach-path = lerp { start: <spec.start1-pose>, goal: <spec.goal1-pose> },

            pose start2-pose = snapshot of <shared.world.pose-ee2-base>,
            linear-distance start2-cube-x = snapshot of <shared.world.pose-cube2-base>.position.x,
            linear-distance start2-cube-y = snapshot of <shared.world.pose-cube2-base>.position.y,
            pose goal2-pose = {
                position: (<spec.start2-cube-x>, <spec.start2-cube-y>, <spec.above-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            },
            path arm2-approach-path = lerp { start: <spec.start2-pose>, goal: <spec.goal2-pose> }
        }
    }

    when all {
        gripper1-ready: <shared.world.gripper1-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>,
        gripper2-ready: <shared.world.gripper2-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>
    }

    while {
        follow1-tan: moving <shared.world.pose-ee1-base> along <spec.arm1-approach-path> at <spec.approach-speed>,
        follow1-lat: keeping <shared.world.pose-ee1-base>.position    on <spec.arm1-approach-path> within <shared.spec.satisfied-band>,
        follow1-ori: keeping <shared.world.pose-ee1-base>.orientation on <spec.arm1-approach-path> within <shared.spec.satisfied-band-rot>,
        advance1:    progress of <shared.world.pose-ee1-base> along <spec.arm1-approach-path> more than <spec.min-approach-speed>,
        follow2-tan: moving <shared.world.pose-ee2-base> along <spec.arm2-approach-path> at <spec.approach-speed>,
        follow2-lat: keeping <shared.world.pose-ee2-base>.position    on <spec.arm2-approach-path> within <shared.spec.satisfied-band>,
        follow2-ori: keeping <shared.world.pose-ee2-base>.orientation on <spec.arm2-approach-path> within <shared.spec.satisfied-band-rot>,
        advance2:    progress of <shared.world.pose-ee2-base> along <spec.arm2-approach-path> more than <spec.min-approach-speed>
    }

    until {}
}

guarded-motion (ns=app) pick {
    description: "Lower both TCPs straight down to the grasp height at their cubes"

    context {
        spec {
            linear-distance grasp-z = 0.015 m,
            linear-distance support-lift = 0.06 m,
            linear-velocity max-lower-velocity = 0.10 m/s,
            linear-acceleration max-lower-acceleration = 0.30 m/s^2,
            linear-jerk max-lower-jerk = 2.0 m/s^3,
            velocity-profile lower1-profile = profile {
                max-velocity: <spec.max-lower-velocity>,
                max-acceleration: <spec.max-lower-acceleration>,
                measured-velocity: <shared.world.twist-ee1-base>.linvel.z,
                max-jerk: <spec.max-lower-jerk>,
                shape: s-curve
            },
            velocity-profile lower2-profile = profile {
                max-velocity: <spec.max-lower-velocity>,
                max-acceleration: <spec.max-lower-acceleration>,
                measured-velocity: <shared.world.twist-ee2-base>.linvel.z,
                max-jerk: <spec.max-lower-jerk>,
                shape: s-curve
            },

            linear-distance grasp1-x = snapshot of <shared.world.pose-cube1-base>.position.x,
            linear-distance grasp1-y = snapshot of <shared.world.pose-cube1-base>.position.y,
            linear-distance support1-z = snapshot of <shared.world.pose-elbow1-base>.position.z + <spec.support-lift>,
            pose pick1-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            },

            linear-distance grasp2-x = snapshot of <shared.world.pose-cube2-base>.position.x,
            linear-distance grasp2-y = snapshot of <shared.world.pose-cube2-base>.position.y,
            linear-distance support2-z = snapshot of <shared.world.pose-elbow2-base>.position.z + <spec.support-lift>,
            pose pick2-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            }
        }
    }

    when all {
        aligned1-above: <shared.world.pose-ee1-base>.position equal to <pick-above.spec.goal1-pose>.position within <shared.spec.satisfied-band>,
        aligned2-above: <shared.world.pose-ee2-base>.position equal to <pick-above.spec.goal2-pose>.position within <shared.spec.satisfied-band>
    }

    while {
        hold1-x:          keeping <shared.world.pose-ee1-base>.position.x  equal to <spec.grasp1-x> within <shared.spec.satisfied-band>,
        hold1-y:          keeping <shared.world.pose-ee1-base>.position.y  equal to <spec.grasp1-y> within <shared.spec.satisfied-band>,
        lower1-z:         keeping <shared.world.pose-ee1-base>.position.z  equal to <spec.grasp-z> within <shared.spec.satisfied-band>,
        follow1-ori:      keeping <shared.world.pose-ee1-base>.orientation equal to <spec.pick1-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        support1-elbow-z: keeping <shared.world.pose-elbow1-base>.position.z equal to <spec.support1-z> within <shared.spec.satisfied-band>,

        hold2-x:          keeping <shared.world.pose-ee2-base>.position.x  equal to <spec.grasp2-x> within <shared.spec.satisfied-band>,
        hold2-y:          keeping <shared.world.pose-ee2-base>.position.y  equal to <spec.grasp2-y> within <shared.spec.satisfied-band>,
        lower2-z:         keeping <shared.world.pose-ee2-base>.position.z  equal to <spec.grasp-z> within <shared.spec.satisfied-band>,
        follow2-ori:      keeping <shared.world.pose-ee2-base>.orientation equal to <spec.pick2-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        support2-elbow-z: keeping <shared.world.pose-elbow2-base>.position.z equal to <spec.support2-z> within <shared.spec.satisfied-band>
    }

    until {}
}

guarded-motion (ns=app) grasp-hold {
    description: "Hold both TCPs at their current base-frame poses while the grippers close"

    context {
        spec {
            linear-distance support-lift = 0.06 m,
            linear-distance grasp-reach = 0.015 m,
            linear-distance support1-z = snapshot of <shared.world.pose-elbow1-base>.position.z + <spec.support-lift>,
            pose hold1-orientation-pose = snapshot of <shared.world.pose-ee1-base>,
            linear-distance support2-z = snapshot of <shared.world.pose-elbow2-base>.position.z + <spec.support-lift>,
            pose hold2-orientation-pose = snapshot of <shared.world.pose-ee2-base>
        }
    }

    when all {
        near1-cube: distance between <shared.world.pose-ee1-base> and <shared.world.pose-cube1-base> less than <grasp-hold.spec.grasp-reach>,
        near2-cube: distance between <shared.world.pose-ee2-base> and <shared.world.pose-cube2-base> less than <grasp-hold.spec.grasp-reach>
    }

    while {
        hold1-x:           keeping <shared.world.pose-ee1-base>.position.x equal to <spec.hold1-orientation-pose>.position.x within <shared.spec.satisfied-band>,
        hold1-y:           keeping <shared.world.pose-ee1-base>.position.y equal to <spec.hold1-orientation-pose>.position.y within <shared.spec.satisfied-band>,
        hold1-z:           keeping <shared.world.pose-ee1-base>.position.z equal to <spec.hold1-orientation-pose>.position.z within <shared.spec.satisfied-band>,
        hold1-orientation: keeping <shared.world.pose-ee1-base>.orientation equal to <spec.hold1-orientation-pose>.orientation within <shared.spec.satisfied-band-rot>,
        support1-elbow-z:  keeping <shared.world.pose-elbow1-base>.position.z equal to <spec.support1-z> within <shared.spec.satisfied-band>,
        close1-gripper:    keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,

        hold2-x:           keeping <shared.world.pose-ee2-base>.position.x equal to <spec.hold2-orientation-pose>.position.x within <shared.spec.satisfied-band>,
        hold2-y:           keeping <shared.world.pose-ee2-base>.position.y equal to <spec.hold2-orientation-pose>.position.y within <shared.spec.satisfied-band>,
        hold2-z:           keeping <shared.world.pose-ee2-base>.position.z equal to <spec.hold2-orientation-pose>.position.z within <shared.spec.satisfied-band>,
        hold2-orientation: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.hold2-orientation-pose>.orientation within <shared.spec.satisfied-band-rot>,
        support2-elbow-z:  keeping <shared.world.pose-elbow2-base>.position.z equal to <spec.support2-z> within <shared.spec.satisfied-band>,
        close2-gripper:    keeping <shared.world.gripper2-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>
    }

    until {}
}

guarded-motion (ns=app) lift {
    description: "Raise both TCPs straight up while holding the cubes"

    context {
        spec {
            linear-distance lift-z = 0.32 m,
            angle grasp-threshold = 0.15 rad,
            linear-distance support-lift = 0.06 m,

            linear-distance lift1-start-x = snapshot of <shared.world.pose-ee1-base>.position.x,
            linear-distance lift1-start-y = snapshot of <shared.world.pose-ee1-base>.position.y,
            linear-distance support1-z = snapshot of <shared.world.pose-elbow1-base>.position.z + <spec.support-lift>,
            pose lift1-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            },

            linear-distance lift2-start-x = snapshot of <shared.world.pose-ee2-base>.position.x,
            linear-distance lift2-start-y = snapshot of <shared.world.pose-ee2-base>.position.y,
            linear-distance support2-z = snapshot of <shared.world.pose-elbow2-base>.position.z + <spec.support-lift>,
            pose lift2-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            }
        }
    }

    when all {
        grasped1: <shared.world.gripper1-pos> greater than <lift.spec.grasp-threshold>,
        grasped2: <shared.world.gripper2-pos> greater than <lift.spec.grasp-threshold>
    }

    while {
        hold1-x:          keeping <shared.world.pose-ee1-base>.position.x  equal to <spec.lift1-start-x> within <shared.spec.satisfied-band>,
        hold1-y:          keeping <shared.world.pose-ee1-base>.position.y  equal to <spec.lift1-start-y> within <shared.spec.satisfied-band>,
        lift1-z:          keeping <shared.world.pose-ee1-base>.position.z  equal to <spec.lift-z> within <shared.spec.satisfied-band>,
        follow1-ori:      keeping <shared.world.pose-ee1-base>.orientation equal to <spec.lift1-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        support1-elbow-z: keeping <shared.world.pose-elbow1-base>.position.z equal to <spec.support1-z> within <shared.spec.satisfied-band>,
        close1-gripper:   keeping <shared.world.gripper1-pos>              equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,

        hold2-x:          keeping <shared.world.pose-ee2-base>.position.x  equal to <spec.lift2-start-x> within <shared.spec.satisfied-band>,
        hold2-y:          keeping <shared.world.pose-ee2-base>.position.y  equal to <spec.lift2-start-y> within <shared.spec.satisfied-band>,
        lift2-z:          keeping <shared.world.pose-ee2-base>.position.z  equal to <spec.lift-z> within <shared.spec.satisfied-band>,
        follow2-ori:      keeping <shared.world.pose-ee2-base>.orientation equal to <spec.lift2-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        support2-elbow-z: keeping <shared.world.pose-elbow2-base>.position.z equal to <spec.support2-z> within <shared.spec.satisfied-band>,
        close2-gripper:   keeping <shared.world.gripper2-pos>              equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>
    }

    until any {
        grasp-lost1: distance between <shared.world.pose-ee1-base> and <shared.world.pose-cube1-base> greater than <shared.spec.lost-dist>,
        grasp-lost2: distance between <shared.world.pose-ee2-base> and <shared.world.pose-cube2-base> greater than <shared.spec.lost-dist>
    }
}

guarded-motion (ns=app) place-above {
    description: "Move both TCPs laterally to the pre-place position above their place locations"

    context {
        spec {
            linear-distance place-x = 0.40 m,
            linear-distance place-y = 0.24 m,
            linear-distance place-above-z = 0.22 m,
            linear-distance lifted-z = 0.30 m,
            linear-distance support-lift = 0.06 m,

            linear-distance support1-z = snapshot of <shared.world.pose-elbow1-base>.position.z + <spec.support-lift>,
            pose goal1-pose-above = {
                position: (<spec.place-x>, <spec.place-y>, <spec.place-above-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            },

            linear-distance support2-z = snapshot of <shared.world.pose-elbow2-base>.position.z + <spec.support-lift>,
            pose goal2-pose-above = {
                position: (<spec.place-x>, <spec.place-y>, <spec.place-above-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            }
        }
    }

    when all {
        lifted1: <shared.world.pose-ee1-base>.position.z greater than <place-above.spec.lifted-z>,
        lifted2: <shared.world.pose-ee2-base>.position.z greater than <place-above.spec.lifted-z>
    }

    while {
        reach1-x:         keeping <shared.world.pose-ee1-base>.position.x  equal to <spec.place-x> within <shared.spec.satisfied-band>,
        reach1-y:         keeping <shared.world.pose-ee1-base>.position.y  equal to <spec.place-y> within <shared.spec.satisfied-band>,
        reach1-z:         keeping <shared.world.pose-ee1-base>.position.z  equal to <spec.place-above-z> within <shared.spec.satisfied-band>,
        align1-ori:       keeping <shared.world.pose-ee1-base>.orientation equal to <spec.goal1-pose-above>.orientation within <shared.spec.satisfied-band-rot>,
        support1-elbow-z: keeping <shared.world.pose-elbow1-base>.position.z equal to <spec.support1-z> within <shared.spec.satisfied-band>,
        close1-gripper:   keeping <shared.world.gripper1-pos>              equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,

        reach2-x:         keeping <shared.world.pose-ee2-base>.position.x  equal to <spec.place-x> within <shared.spec.satisfied-band>,
        reach2-y:         keeping <shared.world.pose-ee2-base>.position.y  equal to <spec.place-y> within <shared.spec.satisfied-band>,
        reach2-z:         keeping <shared.world.pose-ee2-base>.position.z  equal to <spec.place-above-z> within <shared.spec.satisfied-band>,
        align2-ori:       keeping <shared.world.pose-ee2-base>.orientation equal to <spec.goal2-pose-above>.orientation within <shared.spec.satisfied-band-rot>,
        support2-elbow-z: keeping <shared.world.pose-elbow2-base>.position.z equal to <spec.support2-z> within <shared.spec.satisfied-band>,
        close2-gripper:   keeping <shared.world.gripper2-pos>              equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>
    }

    until any {
        grasp-lost1: distance between <shared.world.pose-ee1-base> and <shared.world.pose-cube1-base> greater than <shared.spec.lost-dist>,
        grasp-lost2: distance between <shared.world.pose-ee2-base> and <shared.world.pose-cube2-base> greater than <shared.spec.lost-dist>
    }
}

guarded-motion (ns=app) place {
    description: "Lower both TCPs with cubes straight down to the place height"

    context {
        spec {
            linear-distance place-x = 0.40 m,
            linear-distance place-y = 0.24 m,
            linear-distance place-z = 0.03 m,
            linear-distance place-y-gate = 0.20 m,
            linear-distance support-lift = 0.06 m,

            linear-distance support1-z = snapshot of <shared.world.pose-elbow1-base>.position.z + <spec.support-lift>,
            pose goal1-pose-place = {
                position: (<spec.place-x>, <spec.place-y>, <spec.place-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            },

            linear-distance support2-z = snapshot of <shared.world.pose-elbow2-base>.position.z + <spec.support-lift>,
            pose goal2-pose-place = {
                position: (<spec.place-x>, <spec.place-y>, <spec.place-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            }
        }
    }

    when all {
        at1-pre-place: <shared.world.pose-ee1-base>.position.y greater than <place.spec.place-y-gate>,
        at2-pre-place: <shared.world.pose-ee2-base>.position.y greater than <place.spec.place-y-gate>
    }

    while {
        reach1-x:         keeping <shared.world.pose-ee1-base>.position.x  equal to <spec.place-x> within <shared.spec.satisfied-band>,
        reach1-y:         keeping <shared.world.pose-ee1-base>.position.y  equal to <spec.place-y> within <shared.spec.satisfied-band>,
        reach1-z:         keeping <shared.world.pose-ee1-base>.position.z  equal to <spec.place-z> within <shared.spec.satisfied-band>,
        align1-ori:       keeping <shared.world.pose-ee1-base>.orientation equal to <spec.goal1-pose-place>.orientation within <shared.spec.satisfied-band-rot>,
        support1-elbow-z: keeping <shared.world.pose-elbow1-base>.position.z equal to <spec.support1-z> within <shared.spec.satisfied-band>,
        close1-gripper:   keeping <shared.world.gripper1-pos>              equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,

        reach2-x:         keeping <shared.world.pose-ee2-base>.position.x  equal to <spec.place-x> within <shared.spec.satisfied-band>,
        reach2-y:         keeping <shared.world.pose-ee2-base>.position.y  equal to <spec.place-y> within <shared.spec.satisfied-band>,
        reach2-z:         keeping <shared.world.pose-ee2-base>.position.z  equal to <spec.place-z> within <shared.spec.satisfied-band>,
        align2-ori:       keeping <shared.world.pose-ee2-base>.orientation equal to <spec.goal2-pose-place>.orientation within <shared.spec.satisfied-band-rot>,
        support2-elbow-z: keeping <shared.world.pose-elbow2-base>.position.z equal to <spec.support2-z> within <shared.spec.satisfied-band>,
        close2-gripper:   keeping <shared.world.gripper2-pos>              equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>
    }

    until any {
        grasp-lost1: distance between <shared.world.pose-ee1-base> and <shared.world.pose-cube1-base> greater than <shared.spec.lost-dist>,
        grasp-lost2: distance between <shared.world.pose-ee2-base> and <shared.world.pose-cube2-base> greater than <shared.spec.lost-dist>
    }
}

guarded-motion (ns=app) open-grasp-hold {
    description: "Hold both TCPs at place pose while the grippers open"

    context {
        spec {
            linear-distance support-lift = 0.06 m,
            linear-distance release-z = 0.04 m,
            linear-distance support1-z = snapshot of <shared.world.pose-elbow1-base>.position.z + <spec.support-lift>,
            pose hold1-orientation-pose = snapshot of <shared.world.pose-ee1-base>,
            linear-distance support2-z = snapshot of <shared.world.pose-elbow2-base>.position.z + <spec.support-lift>,
            pose hold2-orientation-pose = snapshot of <shared.world.pose-ee2-base>
        }
    }

    when all {
        at1-place: <shared.world.pose-ee1-base>.position.z equal to <open-grasp-hold.spec.release-z> within <shared.spec.satisfied-band>,
        at2-place: <shared.world.pose-ee2-base>.position.z equal to <open-grasp-hold.spec.release-z> within <shared.spec.satisfied-band>
    }

    while {
        hold1-x:           keeping <shared.world.pose-ee1-base>.position.x equal to <spec.hold1-orientation-pose>.position.x within <shared.spec.satisfied-band>,
        hold1-y:           keeping <shared.world.pose-ee1-base>.position.y equal to <spec.hold1-orientation-pose>.position.y within <shared.spec.satisfied-band>,
        hold1-z:           keeping <shared.world.pose-ee1-base>.position.z equal to <spec.hold1-orientation-pose>.position.z within <shared.spec.satisfied-band>,
        hold1-orientation: keeping <shared.world.pose-ee1-base>.orientation equal to <spec.hold1-orientation-pose>.orientation within <shared.spec.satisfied-band-rot>,
        support1-elbow-z:  keeping <shared.world.pose-elbow1-base>.position.z equal to <spec.support1-z> within <shared.spec.satisfied-band>,
        open1-gripper:     keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>,

        hold2-x:           keeping <shared.world.pose-ee2-base>.position.x equal to <spec.hold2-orientation-pose>.position.x within <shared.spec.satisfied-band>,
        hold2-y:           keeping <shared.world.pose-ee2-base>.position.y equal to <spec.hold2-orientation-pose>.position.y within <shared.spec.satisfied-band>,
        hold2-z:           keeping <shared.world.pose-ee2-base>.position.z equal to <spec.hold2-orientation-pose>.position.z within <shared.spec.satisfied-band>,
        hold2-orientation: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.hold2-orientation-pose>.orientation within <shared.spec.satisfied-band-rot>,
        support2-elbow-z:  keeping <shared.world.pose-elbow2-base>.position.z equal to <spec.support2-z> within <shared.spec.satisfied-band>,
        open2-gripper:     keeping <shared.world.gripper2-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>
    }

    until {}
}

guarded-motion (ns=app) retreat {
    description: "Move both TCPs straight up to the pre-grasp height above the place locations"

    context {
        spec {
            linear-distance place-x = 0.40 m,
            linear-distance place-y = 0.24 m,
            linear-distance place-above-z = 0.22 m,
            linear-distance support-lift = 0.06 m,

            linear-distance support1-z = snapshot of <shared.world.pose-elbow1-base>.position.z + <spec.support-lift>,
            pose goal1-pose-retreat = {
                position: (<spec.place-x>, <spec.place-y>, <spec.place-above-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            },

            linear-distance support2-z = snapshot of <shared.world.pose-elbow2-base>.position.z + <spec.support-lift>,
            pose goal2-pose-retreat = {
                position: (<spec.place-x>, <spec.place-y>, <spec.place-above-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            }
        }
    }

    when all {
        released1: <shared.world.gripper1-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>,
        released2: <shared.world.gripper2-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>
    }

    while {
        reach1-x:         keeping <shared.world.pose-ee1-base>.position.x  equal to <spec.place-x> within <shared.spec.satisfied-band>,
        reach1-y:         keeping <shared.world.pose-ee1-base>.position.y  equal to <spec.place-y> within <shared.spec.satisfied-band>,
        reach1-z:         keeping <shared.world.pose-ee1-base>.position.z  equal to <spec.place-above-z> within <shared.spec.satisfied-band>,
        align1-ori:       keeping <shared.world.pose-ee1-base>.orientation equal to <spec.goal1-pose-retreat>.orientation within <shared.spec.satisfied-band-rot>,
        support1-elbow-z: keeping <shared.world.pose-elbow1-base>.position.z equal to <spec.support1-z> within <shared.spec.satisfied-band>,
        open1-gripper:    keeping <shared.world.gripper1-pos>              equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>,

        reach2-x:         keeping <shared.world.pose-ee2-base>.position.x  equal to <spec.place-x> within <shared.spec.satisfied-band>,
        reach2-y:         keeping <shared.world.pose-ee2-base>.position.y  equal to <spec.place-y> within <shared.spec.satisfied-band>,
        reach2-z:         keeping <shared.world.pose-ee2-base>.position.z  equal to <spec.place-above-z> within <shared.spec.satisfied-band>,
        align2-ori:       keeping <shared.world.pose-ee2-base>.orientation equal to <spec.goal2-pose-retreat>.orientation within <shared.spec.satisfied-band-rot>,
        support2-elbow-z: keeping <shared.world.pose-elbow2-base>.position.z equal to <spec.support2-z> within <shared.spec.satisfied-band>,
        open2-gripper:    keeping <shared.world.gripper2-pos>              equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>
    }

    until all {
        at-retreat1-settled: <shared.world.pose-ee1-base>.position equal to <spec.goal1-pose-retreat>.position within <shared.spec.satisfied-band>,
        at-retreat1-settled-rot: <shared.world.pose-ee1-base>.orientation equal to <spec.goal1-pose-retreat>.orientation within <shared.spec.satisfied-band-rot>,
        at-retreat2-settled: <shared.world.pose-ee2-base>.position equal to <spec.goal2-pose-retreat>.position within <shared.spec.satisfied-band>,
        at-retreat2-settled-rot: <shared.world.pose-ee2-base>.orientation equal to <spec.goal2-pose-retreat>.orientation within <shared.spec.satisfied-band-rot>
    }
}

guarded-motion (ns=app) recover {
    description: "Fallback recovery: capture both current poses on entry and hold them"

    context {
        spec {
            linear-distance support-lift = 0.06 m,
            linear-distance support1-z = snapshot of <shared.world.pose-elbow1-base>.position.z + <spec.support-lift>,
            pose hold1-orientation-pose = snapshot of <shared.world.pose-ee1-base>,
            linear-distance support2-z = snapshot of <shared.world.pose-elbow2-base>.position.z + <spec.support-lift>,
            pose hold2-orientation-pose = snapshot of <shared.world.pose-ee2-base>
        }
    }

    when {}

    while {
        hold1-x:           keeping <shared.world.pose-ee1-base>.position.x equal to <spec.hold1-orientation-pose>.position.x within <shared.spec.satisfied-band>,
        hold1-y:           keeping <shared.world.pose-ee1-base>.position.y equal to <spec.hold1-orientation-pose>.position.y within <shared.spec.satisfied-band>,
        hold1-z:           keeping <shared.world.pose-ee1-base>.position.z equal to <spec.hold1-orientation-pose>.position.z within <shared.spec.satisfied-band>,
        hold1-orientation: keeping <shared.world.pose-ee1-base>.orientation equal to <spec.hold1-orientation-pose>.orientation within <shared.spec.satisfied-band-rot>,
        support1-elbow-z:  keeping <shared.world.pose-elbow1-base>.position.z equal to <spec.support1-z> within <shared.spec.satisfied-band>,

        hold2-x:           keeping <shared.world.pose-ee2-base>.position.x equal to <spec.hold2-orientation-pose>.position.x within <shared.spec.satisfied-band>,
        hold2-y:           keeping <shared.world.pose-ee2-base>.position.y equal to <spec.hold2-orientation-pose>.position.y within <shared.spec.satisfied-band>,
        hold2-z:           keeping <shared.world.pose-ee2-base>.position.z equal to <spec.hold2-orientation-pose>.position.z within <shared.spec.satisfied-band>,
        hold2-orientation: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.hold2-orientation-pose>.orientation within <shared.spec.satisfied-band-rot>,
        support2-elbow-z:  keeping <shared.world.pose-elbow2-base>.position.z equal to <spec.support2-z> within <shared.spec.satisfied-band>
    }

    until {}
}

// ------------------ constraint handlers ------------------

constraint-handler (ns=app) handler-home {
    handles: <home>
    controllers {
        pid ctrl-h1-position { constraint: <home.hold1-position>,    Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <arm1-solver>,
        pid ctrl-h1-orientation { constraint: <home.hold1-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <arm1-solver>,
        pid ctrl-h2-position { constraint: <home.hold2-position>,    Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <arm2-solver>,
        pid ctrl-h2-orientation { constraint: <home.hold2-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <arm2-solver>
    }

    solvers {
        arm1-solver: serial-chain {
            agent:     <pickplace_agents.arm1>,
            algorithm: achd,
            gravity:   (0.0, 0.0, 9.81) m/s^2
        },
        arm2-solver: serial-chain {
            agent:     <pickplace_agents.arm2>,
            algorithm: achd,
            gravity:   (0.0, 0.0, 9.81) m/s^2
        }
    }
}

constraint-handler (ns=app) handler-pick-above {
    handles: <pick-above>
    monitors {
        mon-pick-above-ready: monitor <pick-above.when> on activation trigger event <pp.E_PICK_ABOVE_READY> otherwise hold <home>,
        mon-pa1-advancing:    monitor <pick-above.advance1> while active set flag pa1-advancing,
        mon-pa2-advancing:    monitor <pick-above.advance2> while active set flag pa2-advancing
    }

    controllers {
        pid ctrl-pa1-follow-tan { constraint: <pick-above.follow1-tan>, Kp: 20,  Ki: 4,   Kd: 0,  decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pa1-follow-lat { constraint: <pick-above.follow1-lat>, measured-derivative: <shared.world.twist-ee1-base>.linvel, Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pa1-follow-ori { constraint: <pick-above.follow1-ori>, measured-derivative: <shared.world.twist-ee1-base>.angvel, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pa2-follow-tan { constraint: <pick-above.follow2-tan>, Kp: 20,  Ki: 4,   Kd: 0,  decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pa2-follow-lat { constraint: <pick-above.follow2-lat>, measured-derivative: <shared.world.twist-ee2-base>.linvel, Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pa2-follow-ori { constraint: <pick-above.follow2-ori>, measured-derivative: <shared.world.twist-ee2-base>.angvel, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm2-solver>
    }

    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>
    }
}

constraint-handler (ns=app) handler-pick {
    handles: <pick>
    monitors {
        mon-pick-ready: monitor <pick.when> on activation trigger event <pp.E_PICK_READY> otherwise hold <pick-above>
    }

    controllers {
        pid ctrl-pk1-hold-x { constraint: <pick.hold1-x>,     Kp: 200, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pk1-hold-y { constraint: <pick.hold1-y>,     Kp: 200, Ki: 30, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pk1-lower-z { constraint: <pick.lower1-z>, profile: <pick.spec.lower1-profile>, measured-derivative: <shared.world.twist-ee1-base>.linvel.z, Kp: 12, Ki: 5, Kd: 15, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pk1-follow-ori { constraint: <pick.follow1-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        impedance ctrl-pk1-support-z { constraint: <pick.support1-elbow-z>, stiffness: 800, damping: 80 } apply at <kinova1.half_arm_2_link> via <handler-home.arm1-solver>,

        pid ctrl-pk2-hold-x { constraint: <pick.hold2-x>,     Kp: 200, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pk2-hold-y { constraint: <pick.hold2-y>,     Kp: 200, Ki: 30, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pk2-lower-z { constraint: <pick.lower2-z>, profile: <pick.spec.lower2-profile>, measured-derivative: <shared.world.twist-ee2-base>.linvel.z, Kp: 12, Ki: 5, Kd: 15, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pk2-follow-ori { constraint: <pick.follow2-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm2-solver>,
        impedance ctrl-pk2-support-z { constraint: <pick.support2-elbow-z>, stiffness: 800, damping: 80 } apply at <kinova2.half_arm_2_link> via <handler-home.arm2-solver>
    }

    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>
    }
}

constraint-handler (ns=app) handler-close-grip {
    handles: <grasp-hold>
    monitors {
        mon-grasp-ready: monitor <grasp-hold.when> on activation trigger event <pp.E_GRASP_READY> otherwise hold <pick>
    }

    controllers {
        pid ctrl-cg1-hold-x { constraint: <grasp-hold.hold1-x>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-cg1-hold-y { constraint: <grasp-hold.hold1-y>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-cg1-hold-z { constraint: <grasp-hold.hold1-z>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-cg1-hold-orientation { constraint: <grasp-hold.hold1-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        impedance ctrl-cg1-support-z { constraint: <grasp-hold.support1-elbow-z>, stiffness: 800, damping: 80 } apply at <kinova1.half_arm_2_link> via <handler-home.arm1-solver>,
        feed-forward ctrl-cg1-close-gripper { constraint: <grasp-hold.close1-gripper> } via <gripper1-solver>,

        pid ctrl-cg2-hold-x { constraint: <grasp-hold.hold2-x>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-cg2-hold-y { constraint: <grasp-hold.hold2-y>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-cg2-hold-z { constraint: <grasp-hold.hold2-z>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-cg2-hold-orientation { constraint: <grasp-hold.hold2-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm2-solver>,
        impedance ctrl-cg2-support-z { constraint: <grasp-hold.support2-elbow-z>, stiffness: 800, damping: 80 } apply at <kinova2.half_arm_2_link> via <handler-home.arm2-solver>,
        feed-forward ctrl-cg2-close-gripper { constraint: <grasp-hold.close2-gripper> } via <gripper2-solver>
    }

    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        gripper1-solver: command-forwarding {
            agent: <pickplace_agents.arm1>
        },
        gripper2-solver: command-forwarding {
            agent: <pickplace_agents.arm2>
        }
    }
}

constraint-handler (ns=app) handler-lift {
    handles: <lift>
    monitors {
        mon-lift-ready:      monitor <lift.when> on activation trigger event <pp.E_LIFT_READY> otherwise hold <grasp-hold>,
        mon-lift-grasp-lost: monitor <lift.until>    on activation trigger event <pp.E_GRASP_LOST_LIFT>
    }

    controllers {
        pid ctrl-lt1-hold-x { constraint: <lift.hold1-x>,     Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-lt1-hold-y { constraint: <lift.hold1-y>,     Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-lt1-lift-z { constraint: <lift.lift1-z>,     Kp: 15,  Ki: 5,   Kd: 20, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-lt1-follow-ori { constraint: <lift.follow1-ori>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        impedance ctrl-lt1-support-z { constraint: <lift.support1-elbow-z>, stiffness: 800, damping: 80 } apply at <kinova1.half_arm_2_link> via <handler-home.arm1-solver>,
        feed-forward ctrl-lt1-close-gripper { constraint: <lift.close1-gripper> } via <handler-close-grip.gripper1-solver>,

        pid ctrl-lt2-hold-x { constraint: <lift.hold2-x>,     Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-lt2-hold-y { constraint: <lift.hold2-y>,     Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-lt2-lift-z { constraint: <lift.lift2-z>,     Kp: 15,  Ki: 5,   Kd: 20, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-lt2-follow-ori { constraint: <lift.follow2-ori>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm2-solver>,
        impedance ctrl-lt2-support-z { constraint: <lift.support2-elbow-z>, stiffness: 800, damping: 80 } apply at <kinova2.half_arm_2_link> via <handler-home.arm2-solver>,
        feed-forward ctrl-lt2-close-gripper { constraint: <lift.close2-gripper> } via <handler-close-grip.gripper2-solver>
    }

    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-close-grip.gripper1-solver>,
        <handler-close-grip.gripper2-solver>
    }
}

constraint-handler (ns=app) handler-place-above {
    handles: <place-above>
    monitors {
        mon-place-above-ready:      monitor <place-above.when> on activation trigger event <pp.E_PLACE_ABOVE_READY> otherwise hold <lift>,
        mon-place-above-grasp-lost: monitor <place-above.until>   on activation trigger event <pp.E_GRASP_LOST_PLACE_ABOVE>
    }

    controllers {
        pid ctrl-pla1-reach-x { constraint: <place-above.reach1-x>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pla1-reach-y { constraint: <place-above.reach1-y>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pla1-reach-z { constraint: <place-above.reach1-z>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pla1-align-ori { constraint: <place-above.align1-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        impedance ctrl-pla1-support-z { constraint: <place-above.support1-elbow-z>, stiffness: 800, damping: 80 } apply at <kinova1.half_arm_2_link> via <handler-home.arm1-solver>,
        feed-forward ctrl-pla1-close-gripper { constraint: <place-above.close1-gripper> } via <handler-close-grip.gripper1-solver>,

        pid ctrl-pla2-reach-x { constraint: <place-above.reach2-x>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pla2-reach-y { constraint: <place-above.reach2-y>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pla2-reach-z { constraint: <place-above.reach2-z>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pla2-align-ori { constraint: <place-above.align2-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm2-solver>,
        impedance ctrl-pla2-support-z { constraint: <place-above.support2-elbow-z>, stiffness: 800, damping: 80 } apply at <kinova2.half_arm_2_link> via <handler-home.arm2-solver>,
        feed-forward ctrl-pla2-close-gripper { constraint: <place-above.close2-gripper> } via <handler-close-grip.gripper2-solver>
    }

    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-close-grip.gripper1-solver>,
        <handler-close-grip.gripper2-solver>
    }
}

constraint-handler (ns=app) handler-place {
    handles: <place>
    monitors {
        mon-place-ready:      monitor <place.when> on activation trigger event <pp.E_PLACE_READY> otherwise hold <place-above>,
        mon-place-grasp-lost: monitor <place.until>        on activation trigger event <pp.E_GRASP_LOST_PLACE>
    }

    controllers {
        pid ctrl-pl1-reach-x { constraint: <place.reach1-x>,   Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pl1-reach-y { constraint: <place.reach1-y>,   Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pl1-reach-z { constraint: <place.reach1-z>,   Kp: 15,  Ki: 5,  Kd: 40,  decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pl1-align-ori { constraint: <place.align1-ori>, Kp: 180, Ki: 30, Kd: 120, decay: 0 } via <handler-home.arm1-solver>,
        impedance ctrl-pl1-support-z { constraint: <place.support1-elbow-z>, stiffness: 800, damping: 160 } apply at <kinova1.half_arm_2_link> via <handler-home.arm1-solver>,
        feed-forward ctrl-pl1-close-gripper { constraint: <place.close1-gripper> } via <handler-close-grip.gripper1-solver>,

        pid ctrl-pl2-reach-x { constraint: <place.reach2-x>,   Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pl2-reach-y { constraint: <place.reach2-y>,   Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pl2-reach-z { constraint: <place.reach2-z>,   Kp: 15,  Ki: 5,  Kd: 40,  decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pl2-align-ori { constraint: <place.align2-ori>, Kp: 180, Ki: 30, Kd: 120, decay: 0 } via <handler-home.arm2-solver>,
        impedance ctrl-pl2-support-z { constraint: <place.support2-elbow-z>, stiffness: 800, damping: 160 } apply at <kinova2.half_arm_2_link> via <handler-home.arm2-solver>,
        feed-forward ctrl-pl2-close-gripper { constraint: <place.close2-gripper> } via <handler-close-grip.gripper2-solver>
    }

    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-close-grip.gripper1-solver>,
        <handler-close-grip.gripper2-solver>
    }
}

constraint-handler (ns=app) handler-open-grip {
    handles: <open-grasp-hold>
    monitors {
        mon-open-ready: monitor <open-grasp-hold.when> on activation trigger event <pp.E_OPEN_READY> otherwise hold <place>
    }

    controllers {
        pid ctrl-og1-hold-x { constraint: <open-grasp-hold.hold1-x>,           Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-og1-hold-y { constraint: <open-grasp-hold.hold1-y>,           Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-og1-hold-z { constraint: <open-grasp-hold.hold1-z>,           Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-og1-hold-orientation { constraint: <open-grasp-hold.hold1-orientation>, Kp: 180, Ki: 30, Kd: 120, decay: 0 } via <handler-home.arm1-solver>,
        impedance ctrl-og1-support-z { constraint: <open-grasp-hold.support1-elbow-z>, stiffness: 800, damping: 160 } apply at <kinova1.half_arm_2_link> via <handler-home.arm1-solver>,
        feed-forward ctrl-og1-open-gripper { constraint: <open-grasp-hold.open1-gripper> } via <handler-close-grip.gripper1-solver>,

        pid ctrl-og2-hold-x { constraint: <open-grasp-hold.hold2-x>,           Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-og2-hold-y { constraint: <open-grasp-hold.hold2-y>,           Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-og2-hold-z { constraint: <open-grasp-hold.hold2-z>,           Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-og2-hold-orientation { constraint: <open-grasp-hold.hold2-orientation>, Kp: 180, Ki: 30, Kd: 120, decay: 0 } via <handler-home.arm2-solver>,
        impedance ctrl-og2-support-z { constraint: <open-grasp-hold.support2-elbow-z>, stiffness: 800, damping: 160 } apply at <kinova2.half_arm_2_link> via <handler-home.arm2-solver>,
        feed-forward ctrl-og2-open-gripper { constraint: <open-grasp-hold.open2-gripper> } via <handler-close-grip.gripper2-solver>
    }

    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-close-grip.gripper1-solver>,
        <handler-close-grip.gripper2-solver>
    }
}

constraint-handler (ns=app) handler-retreat {
    handles: <retreat>
    monitors {
        mon-retreat-ready:   monitor <retreat.when> on activation trigger event <pp.E_RETREAT_READY> otherwise hold <open-grasp-hold>,
        mon-retreat-settled: monitor <retreat.until>     on activation trigger event <pp.E_RETREAT_SETTLED>
    }

    controllers {
        pid ctrl-ret1-reach-x { constraint: <retreat.reach1-x>,   Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-ret1-reach-y { constraint: <retreat.reach1-y>,   Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-ret1-reach-z { constraint: <retreat.reach1-z>,   Kp: 15,  Ki: 5,  Kd: 20,  decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-ret1-align-ori { constraint: <retreat.align1-ori>, Kp: 180, Ki: 30, Kd: 120, decay: 0 } via <handler-home.arm1-solver>,
        impedance ctrl-ret1-support-z { constraint: <retreat.support1-elbow-z>, stiffness: 800, damping: 160 } apply at <kinova1.half_arm_2_link> via <handler-home.arm1-solver>,
        feed-forward ctrl-ret1-open-gripper { constraint: <retreat.open1-gripper> } via <handler-close-grip.gripper1-solver>,

        pid ctrl-ret2-reach-x { constraint: <retreat.reach2-x>,   Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-ret2-reach-y { constraint: <retreat.reach2-y>,   Kp: 140, Ki: 20, Kd: 55,  decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-ret2-reach-z { constraint: <retreat.reach2-z>,   Kp: 15,  Ki: 5,  Kd: 20,  decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-ret2-align-ori { constraint: <retreat.align2-ori>, Kp: 180, Ki: 30, Kd: 120, decay: 0 } via <handler-home.arm2-solver>,
        impedance ctrl-ret2-support-z { constraint: <retreat.support2-elbow-z>, stiffness: 800, damping: 160 } apply at <kinova2.half_arm_2_link> via <handler-home.arm2-solver>,
        feed-forward ctrl-ret2-open-gripper { constraint: <retreat.open2-gripper> } via <handler-close-grip.gripper2-solver>
    }

    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-close-grip.gripper1-solver>,
        <handler-close-grip.gripper2-solver>
    }
}

constraint-handler (ns=app) handler-recover {
    handles: <recover>
    monitors {
        mon-recover-hold: monitor <recover.hold1-x> on activation trigger event <pp.E_RECOVER> after active for 0.1 s
    }

    controllers {
        pid ctrl-rc1-hold-x { constraint: <recover.hold1-x>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-rc1-hold-y { constraint: <recover.hold1-y>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-rc1-hold-z { constraint: <recover.hold1-z>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-rc1-hold-orientation { constraint: <recover.hold1-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        impedance ctrl-rc1-support-z { constraint: <recover.support1-elbow-z>, stiffness: 800, damping: 160 } apply at <kinova1.half_arm_2_link> via <handler-home.arm1-solver>,

        pid ctrl-rc2-hold-x { constraint: <recover.hold2-x>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-rc2-hold-y { constraint: <recover.hold2-y>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-rc2-hold-z { constraint: <recover.hold2-z>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-rc2-hold-orientation { constraint: <recover.hold2-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm2-solver>,
        impedance ctrl-rc2-support-z { constraint: <recover.support2-elbow-z>, stiffness: 800, damping: 160 } apply at <kinova2.half_arm_2_link> via <handler-home.arm2-solver>
    }

    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>
    }
}
