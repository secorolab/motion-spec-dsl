ns rdh = "https://secorolab.github.io/models/real-demo-hold/fsm/"

evt loop (ns=rdh) real_demo_hold_fsm_events {
    evt E_STEP,
    evt E_RUN_STARTED,
    evt E_GRIPPER_CLOSED,
    evt E_GRIPPER_OPENED
}

fsm (ns=rdh) real_demo_hold_fsm {
    description: "Hold the pose the arm started in while the gripper cycles."

    states {
        S_START,
        S_CLOSE,
        S_OPEN,
        S_DONE
    }

    evt loop: <real_demo_hold_fsm_events>

    start: <S_START>
    end:   <S_DONE>

    transitions {
        T_START_CLOSE { from: <S_START>, to: <S_CLOSE> },
        T_CLOSE_OPEN  { from: <S_CLOSE>, to: <S_OPEN> },
        T_OPEN_CLOSE  { from: <S_OPEN>,  to: <S_CLOSE> }
    }

    reactions {
        R_STEP_START     {
            when: <real_demo_hold_fsm_events.E_STEP>,
            do:   <T_START_CLOSE>,
            fires { <real_demo_hold_fsm_events.E_RUN_STARTED> }
        },
        R_GRIPPER_CLOSED { when: <real_demo_hold_fsm_events.E_GRIPPER_CLOSED>, do: <T_CLOSE_OPEN> },
        R_GRIPPER_OPENED { when: <real_demo_hold_fsm_events.E_GRIPPER_OPENED>, do: <T_OPEN_CLOSE> }
    }
}
