ns rdh = "https://secorolab.github.io/models/real-demo-hold/fsm/"

evt loop (ns=rdh) real_demo_hold_fsm_events {
    evt E_STEP,
    evt E_HOLD_ELAPSED
}

fsm (ns=rdh) real_demo_hold_fsm {
    description: "Hold the pose the arm started in, for a bounded time."

    states {
        S_START,
        S_HOLD,
        S_DONE
    }

    evt loop: <real_demo_hold_fsm_events>

    start: <S_START>
    end:   <S_DONE>

    transitions {
        T_START_HOLD { from: <S_START>, to: <S_HOLD> },
        T_HOLD_DONE  { from: <S_HOLD>,  to: <S_DONE> }
    }

    reactions {
        R_STEP_START { when: <real_demo_hold_fsm_events.E_STEP>,         do: <T_START_HOLD> },
        R_HOLD_DONE  { when: <real_demo_hold_fsm_events.E_HOLD_ELAPSED>, do: <T_HOLD_DONE> }
    }
}
