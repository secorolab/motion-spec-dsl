ns rdh = "https://secorolab.github.io/models/real-demo-hold/fsm/"

evt loop (ns=rdh) real_demo_hold_fsm_events {
    evt E_STEP
}

fsm (ns=rdh) real_demo_hold_fsm {
    description: "Hold the pose the arm started in, until the run is stopped."

    states {
        S_START,
        S_HOLD,
        S_DONE
    }

    evt loop: <real_demo_hold_fsm_events>

    start: <S_START>
    end:   <S_DONE>

    transitions {
        T_START_HOLD { from: <S_START>, to: <S_HOLD> }
    }

    reactions {
        R_STEP_START { when: <real_demo_hold_fsm_events.E_STEP>, do: <T_START_HOLD> }
    }
}
