import "real_demo_hold.fsm"
import "real_demo_hold.scenex"
ns app = "https://secorolab.github.io/models/real-demo-hold/"
ns rdh = "https://secorolab.github.io/models/real-demo-hold/fsm/"

// The gripper is on the arm and its mass is in the chain, but nothing commands it here: it is
// bound by no device, so this run opens the arm and the sensor and nothing else.
exec-context (ns=app) real-demo-hold-exec {
    runs-scene: <admittance_arc_scene_mjc>
    platform:   real-world {
                    <agents.arm1> realized by KinovaGen3,
                    <wrist_ft> realized by RobotiqFT300s
                }
    config:     "robot.toml"
    timestep:   1.0 ms
}

context (ns=app) shared {
    world {
        pose pose-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        // Not controlled: recorded, so the run says what the arm was pushed with while holding.
        wrench ext-force {
            ref-point:  <ft_tree.wrist_ft_body.wrist_ft_site>,
            as-seen-by: <kinova.base_link.base_link_origin>,
            ft-sensor:  <wrist_ft>
        }
    }
}

// The bands this model is tuned against, stated once by the kind of error they bound rather
// than on each constraint that takes them.
tolerances {
    position:    0.05 m,
    orientation: 0.10 rad
}

guarded-motion (ns=app) hold-pose {
    description: "Hold the end-effector pose the arm was in when the hold began"

    context {
        spec {
            pose start-pose = snapshot of <shared.world.pose-ee-base>
        }
    }

    when {}

    while {
        hold-position:    keeping <shared.world.pose-ee-base>.position    equal to <spec.start-pose>.position,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.start-pose>.orientation
    }

    // No exit: the hold runs until the run is stopped.
    until {}
}

constraint-handler (ns=app) handler-hold {
    handles: <hold-pose>
    runs-in: <rdh.S_HOLD>
    controllers {
        pid ctrl-hold-position    { <hold-pose.hold-position>,    Kp: 550, Ki: 50, Kd: 2, decay: 0.1 },
        pid ctrl-hold-orientation { <hold-pose.hold-orientation>, Kp: 250, Ki: 50, Kd: 2, decay: 0.1 }
    }
    solvers {
        arm-solver: serial-chain {
            agent:     <agents.arm1>,
            algorithm: achd,
            gravity:   (0.0, 0.0, 9.81) m/s^2
        }
    }
}
