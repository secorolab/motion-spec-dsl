ns app = "https://secorolab.github.io/models/demo/"

ROBOT (ns=app) eddie {
    type: MobileManipulator,
    urdf: "../robots/eddie.urdf",
    base: {
        root: link-platform
    },
    manipulators: {
        right_arm: { root: link-rightarm-shoulder, end: link-rightarm-ee },
        left_arm: { root: link-leftarm-shoulder, end: link-leftarm-ee }
    }
}

MOTION_SPEC (ns=app) motion_rightarm {
    MOVE: "Right arm pushing control for sc2"

    CONTEXT {
        c1: World {
            pose-rightarm-platform-shoulder: Pose {
                of: frame-rightarm-shoulder,
                wrt: frame-platform
            },
            pose-rightarm-platform-ee: Pose { of: frame-rightarm-ee, wrt: frame-platform },
            twist-rightarm-shoulder-ee-platform: VelocityTwist {
                of: link-rightarm-ee,
                wrt: link-rightarm-shoulder,
                as-seen-by: frame-platform
            },
            twist-rightarm-shoulder-ee-shoulder: VelocityTwist {
                of: link-rightarm-ee,
                wrt: link-rightarm-shoulder,
                as-seen-by: frame-rightarm-shoulder
            },
            twist-world-platform-rightarm-ee: VelocityTwist {
                of: link-platform,
                wrt: link-world,
                as-seen-by: frame-rightarm-ee
            },
            wrench-rightarm-ee-anteroposterior-ee: Wrench {
                as-seen-by: frame-rightarm-ee,
                ref-point: point-rightarm-ee-origin
            },
            wrench-rightarm-ee-anteroposterior-platform: Wrench {
                as-seen-by: frame-platform,
                ref-point: point-rightarm-ee-origin
            },
            pose-rightarm-platform-elbow: Pose { of: frame-rightarm-elbow, wrt: frame-platform },
            pose-rightarm-shoulder-elbow: Pose {
                of: frame-rightarm-elbow,
                wrt: frame-rightarm-shoulder
            },
            pose-rightarm-shoulder-ee: Pose {
                of: frame-rightarm-ee,
                wrt: frame-rightarm-shoulder
            }
        },
        c2: Spec {
            frc-rightarm-ee-anteroposterior-ref: Force = 20.0 N,
            linvel-rightarm-shoulder-ee-vertical-ref: LinearVelocity = 0.0 m/s,
            pos-rightarm-platform-elbow-height-ref: LinearDistance = 0.75 m,
            angvel-rightarm-shoulder-ee-anteroposterior-ref: AngularVelocity = 0.0 rad/s,
            angvel-rightarm-shoulder-ee-lateral-ref: AngularVelocity = 0.0 rad/s,
            linvel-rightarm-world-ee-lateral-ref: LinearVelocity = 0.0 m/s,
            ang-rightarm-shoulder-ee-vertical-ref: AngularDistance = 0.0 rad,
            dist-rightarm-shoulder-ee-lower: LinearDistance = 0.68 m,
            dist-rightarm-shoulder-ee-upper: LinearDistance = 0.72 m
        }

    }

    WHEN {

    }

    WHILE {
        cstr-frc-rightarm-ee-anteroposterior:
            <c1.wrench-rightarm-ee-anteroposterior-ee>.force.x
            equal to <c2.frc-rightarm-ee-anteroposterior-ref>,
        cstr-linvel-rightarm-shoulder-ee-vertical:
            <c1.twist-rightarm-shoulder-ee-shoulder>.linvel.z
            equal to <c2.linvel-rightarm-shoulder-ee-vertical-ref>,
        cstr-pos-rightarm-platform-elbow-height:
            <c1.pose-rightarm-platform-elbow>.position.z
            equal to <c2.pos-rightarm-platform-elbow-height-ref>,
        cstr-angvel-rightarm-shoulder-ee-anteroposterior:
            <c1.twist-rightarm-shoulder-ee-shoulder>.angvel.x
            equal to <c2.angvel-rightarm-shoulder-ee-anteroposterior-ref>,
        cstr-angvel-rightarm-shoulder-ee-lateral:
            <c1.twist-rightarm-shoulder-ee-shoulder>.angvel.y
            equal to <c2.angvel-rightarm-shoulder-ee-lateral-ref>,
        cstr-linvel-rightarm-world-ee-lateral:
            <c1.twist-world-platform-rightarm-ee>.linvel.y
            equal to <c2.linvel-rightarm-world-ee-lateral-ref>,
        cstr-ang-rightarm-shoulder-ee-vertical:
            <c1.pose-rightarm-shoulder-ee>.orientation.z
            equal to <c2.ang-rightarm-shoulder-ee-vertical-ref>,
        cstr-dist-rightarm-shoulder-ee:
            <c1.pose-rightarm-shoulder-ee>.position
            between <c2.dist-rightarm-shoulder-ee-lower>
            and <c2.dist-rightarm-shoulder-ee-upper>

    }

    UNTIL {
    }
}

MOTION_SPEC (ns=app) motion_leftarm {
    MOVE: "Left arm pushing control for sc2"

    CONTEXT {
        c1: World {
            pose-leftarm-platform-shoulder: Pose {
                of: frame-leftarm-shoulder,
                wrt: frame-platform
            },
            pose-leftarm-platform-ee: Pose { of: frame-leftarm-ee, wrt: frame-platform },
            twist-leftarm-shoulder-ee-platform: VelocityTwist {
                of: link-leftarm-ee,
                wrt: link-leftarm-shoulder,
                as-seen-by: frame-platform
            },
            twist-leftarm-shoulder-ee-shoulder: VelocityTwist {
                of: link-leftarm-ee,
                wrt: link-leftarm-shoulder,
                as-seen-by: frame-leftarm-shoulder
            },
            twist-world-platform-leftarm-ee: VelocityTwist {
                of: link-platform,
                wrt: link-world,
                as-seen-by: frame-leftarm-ee
            },
            wrench-leftarm-ee-anteroposterior-ee: Wrench {
                as-seen-by: frame-leftarm-ee,
                ref-point: point-leftarm-ee-origin
            },
            wrench-leftarm-ee-anteroposterior-platform: Wrench {
                as-seen-by: frame-platform,
                ref-point: point-leftarm-ee-origin
            },
            pose-leftarm-platform-elbow: Pose { of: frame-leftarm-elbow, wrt: frame-platform },
            pose-leftarm-shoulder-elbow: Pose {
                of: frame-leftarm-elbow,
                wrt: frame-leftarm-shoulder
            },
            pose-leftarm-shoulder-ee: Pose { of: frame-leftarm-ee, wrt: frame-leftarm-shoulder }
        },
        c2: Spec {
            frc-leftarm-ee-anteroposterior-ref: Force = 20.0 N,
            linvel-leftarm-shoulder-ee-vertical-ref: LinearVelocity = 0.0 m/s,
            pos-leftarm-platform-elbow-height-ref: LinearDistance = 0.75 m,
            angvel-leftarm-shoulder-ee-anteroposterior-ref: AngularVelocity = 0.0 rad/s,
            angvel-leftarm-shoulder-ee-lateral-ref: AngularVelocity = 0.0 rad/s,
            linvel-leftarm-world-ee-lateral-ref: LinearVelocity = 0.0 m/s,
            ang-leftarm-shoulder-ee-vertical-ref: AngularDistance = 0.0 rad,
            dist-leftarm-shoulder-ee-lower: LinearDistance = 0.68 m,
            dist-leftarm-shoulder-ee-upper: LinearDistance = 0.72 m
        }

    }

    WHEN {

    }

    WHILE {
        cstr-frc-leftarm-ee-anteroposterior:
            <c1.wrench-leftarm-ee-anteroposterior-ee>.force.x
            equal to <c2.frc-leftarm-ee-anteroposterior-ref>,
        cstr-linvel-leftarm-shoulder-ee-vertical:
            <c1.twist-leftarm-shoulder-ee-shoulder>.linvel.z
            equal to <c2.linvel-leftarm-shoulder-ee-vertical-ref>,
        cstr-pos-leftarm-platform-elbow-height:
            <c1.pose-leftarm-platform-elbow>.position.z
            equal to <c2.pos-leftarm-platform-elbow-height-ref>,
        cstr-angvel-leftarm-shoulder-ee-anteroposterior:
            <c1.twist-leftarm-shoulder-ee-shoulder>.angvel.x
            equal to <c2.angvel-leftarm-shoulder-ee-anteroposterior-ref>,
        cstr-angvel-leftarm-shoulder-ee-lateral:
            <c1.twist-leftarm-shoulder-ee-shoulder>.angvel.y
            equal to <c2.angvel-leftarm-shoulder-ee-lateral-ref>,
        cstr-linvel-leftarm-world-ee-lateral:
            <c1.twist-world-platform-leftarm-ee>.linvel.y
            equal to <c2.linvel-leftarm-world-ee-lateral-ref>,
        cstr-ang-leftarm-shoulder-ee-vertical:
            <c1.pose-leftarm-shoulder-ee>.orientation.z
            equal to <c2.ang-leftarm-shoulder-ee-vertical-ref>,
        cstr-dist-leftarm-shoulder-ee:
            <c1.pose-leftarm-shoulder-ee>.position
            between <c2.dist-leftarm-shoulder-ee-lower>
            and <c2.dist-leftarm-shoulder-ee-upper>

    }

    UNTIL {
    }
}

CONSTRAINT_HANDLER (ns=app) cstr-hdl-rightarm {
    CONTEXT {
        c1: World {
            link-rightarm-ee: Link,
            gravity-rightarm: Gravity,
            wrench-rightarm-ee-anteroposterior-platform: Wrench {
                as-seen-by: frame-platform,
                ref-point: point-rightarm-ee-origin
            },
            wrench-rightarm-elbow: Wrench {
                as-seen-by: frame-platform,
                ref-point: point-rightarm-elbow-origin
            },
            wrench-rightarm-dist-shoulder: Wrench {
                as-seen-by: frame-rightarm-shoulder,
                ref-point: point-rightarm-shoulder-origin
            }
        },
        c2: Spec {
            gravity-vec: Vector { x = 9.72607409, y = 0.90542332, z = -0.90542332 m/s2 }
        }
    }

    MOTION: <motion_rightarm>


    MONITORS {

    }

    CONTROLLERS {
        ctrl-linvel-rightarm-shoulder-ee-vertical: PID {
            constraint: <motion_rightarm.cstr-linvel-rightarm-shoulder-ee-vertical>,
            Kp = 5.0, Ki = 1.0, Kd = 3.0
        },
        ctrl-pos-rightarm-platform-elbow-height: PID {
            constraint: <motion_rightarm.cstr-pos-rightarm-platform-elbow-height>,
            Kp = 5.0, Ki = 1.0, Kd = 3.0
        } as LinearVelocity apply at <c1.link-rightarm-ee>,
        ctrl-angvel-rightarm-shoulder-ee-anteroposterior: PID {
            constraint: <motion_rightarm.cstr-angvel-rightarm-shoulder-ee-anteroposterior>,
            Kp = 5.0, Ki = 1.0, Kd = 3.0
        },
        ctrl-angvel-rightarm-shoulder-ee-lateral: PID {
            constraint: <motion_rightarm.cstr-angvel-rightarm-shoulder-ee-lateral>,
            Kp = 5.0, Ki = 1.0, Kd = 3.0
        },
        ctrl-linvel-rightarm-world-ee-lateral: PID {
            constraint: <motion_rightarm.cstr-linvel-rightarm-world-ee-lateral>,
            Kp = 5.0, Ki = 1.0, Kd = 3.0
        },
        ctrl-ang-rightarm-shoulder-ee-vertical: PID {
            constraint: <motion_rightarm.cstr-ang-rightarm-shoulder-ee-vertical>,
            Kp = 200.0, Ki = 2.9, Kd = 80.5
        } as AngularVelocity apply at <c1.link-rightarm-ee>,
        ctrl-dist-rightarm-shoulder-ee: PID {
            constraint: <motion_rightarm.cstr-dist-rightarm-shoulder-ee>,
            Kp = 450.0, Ki = 65.5, Kd = 80.0,
            decay: 0.99
        } as Force apply at <c1.link-rightarm-ee>


    }

    SOLVERS {
        right_arm_solver: Solver {
            robot: <eddie.right_arm>,
            algorithm: ACHD,
            root: <eddie.right_arm.root>,
            end: <eddie.right_arm.end>,
            gravity: <c1.gravity-rightarm> equal to <c2.gravity-vec>
        }
    }
}

CONSTRAINT_HANDLER (ns=app) cstr-hdl-leftarm {
    CONTEXT {
        c1: World {
            link-leftarm-ee: Link,
            gravity-leftarm: Gravity,
            wrench-leftarm-ee-anteroposterior-platform: Wrench {
                as-seen-by: frame-platform,
                ref-point: point-leftarm-ee-origin
            },
            wrench-leftarm-elbow: Wrench {
                as-seen-by: frame-platform,
                ref-point: point-leftarm-elbow-origin
            },
            wrench-leftarm-dist-shoulder: Wrench {
                as-seen-by: frame-leftarm-shoulder,
                ref-point: point-leftarm-shoulder-origin
            }
        },
        c2: Spec {
            gravity-vec: Vector { x = 9.72607409, y = -0.90542332, z = -0.90542332 m/s2 }
        }
    }

    MOTION: <motion_leftarm>


    MONITORS {

    }

    CONTROLLERS {
        ctrl-linvel-leftarm-shoulder-ee-vertical: PID {
            constraint: <motion_leftarm.cstr-linvel-leftarm-shoulder-ee-vertical>,
            Kp = 5.0, Ki = 1.0, Kd = 3.0
        },
        ctrl-pos-leftarm-platform-elbow-height: PID {
            constraint: <motion_leftarm.cstr-pos-leftarm-platform-elbow-height>,
            Kp = 5.0, Ki = 1.0, Kd = 3.0
        } as LinearVelocity apply at <c1.link-leftarm-ee>,
        ctrl-angvel-leftarm-shoulder-ee-anteroposterior: PID {
            constraint: <motion_leftarm.cstr-angvel-leftarm-shoulder-ee-anteroposterior>,
            Kp = 5.0, Ki = 1.0, Kd = 3.0
        },
        ctrl-angvel-leftarm-shoulder-ee-lateral: PID {
            constraint: <motion_leftarm.cstr-angvel-leftarm-shoulder-ee-lateral>,
            Kp = 5.0, Ki = 1.0, Kd = 3.0
        },
        ctrl-linvel-leftarm-world-ee-lateral: PID {
            constraint: <motion_leftarm.cstr-linvel-leftarm-world-ee-lateral>,
            Kp = 5.0, Ki = 1.0, Kd = 3.0
        },
        ctrl-ang-leftarm-shoulder-ee-vertical: PID {
            constraint: <motion_leftarm.cstr-ang-leftarm-shoulder-ee-vertical>,
            Kp = 200.0, Ki = 2.9, Kd = 80.5
        } as AngularVelocity apply at <c1.link-leftarm-ee>,
        ctrl-dist-leftarm-shoulder-ee: PID {
            constraint: <motion_leftarm.cstr-dist-leftarm-shoulder-ee>,
            Kp = 450.0, Ki = 65.5, Kd = 80.0,
            decay: 0.99
        } as Force apply at <c1.link-leftarm-ee>


    }

    SOLVERS {
        left_arm_solver: Solver {
            robot: <eddie.left_arm>,
            algorithm: ACHD,
            root: <eddie.left_arm.root>,
            end: <eddie.left_arm.end>,
            gravity: <c1.gravity-leftarm> equal to <c2.gravity-vec>
        }
    }
}
