ns edu_env = "https://secorolab.github.io/models/environments/eddie-dual/"
ns edu_agn = "https://secorolab.github.io/models/agents/eddie-dual/"
ns edu_scene = "https://secorolab.github.io/models/scenes/eddie-dual/"

obj set (ns=edu_env) ws_objects {
    object table
}

ws set (ns=edu_env) workspaces {
    workspace table_ws
}

// The platform and the two arms it carries are three agents: each drives its own solver, and the
// arms' chains are sliced from their own assets.
agn set (ns=edu_agn) agents {
    agent eddie,
    agent left_arm,
    agent right_arm
}

comp (ns=edu_env) comp_table of ws <workspaces.table_ws> {
    obj <ws_objects.table>
}

scene (ns=edu_scene) eddie_dual_scene {
    ws comp <comp_table>
    agn set <agents>
}
