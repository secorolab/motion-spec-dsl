ns eal_env = "https://secorolab.github.io/models/environments/eddie-align/"
ns eal_agn = "https://secorolab.github.io/models/agents/eddie-align/"
ns eal_scene = "https://secorolab.github.io/models/scenes/eddie-align/"

obj set (ns=eal_env) ws_objects {
    object table
}

ws set (ns=eal_env) workspaces {
    workspace table_ws
}

// The platform and the two arms it carries are three agents: each drives its own solver, and the
// arms' chains are sliced from their own assets.
agn set (ns=eal_agn) agents {
    agent eddie,
    agent left_arm,
    agent right_arm
}

comp (ns=eal_env) comp_table of ws <workspaces.table_ws> {
    obj <ws_objects.table>
}

scene (ns=eal_scene) eddie_align_scene {
    ws comp <comp_table>
    agn set <agents>
}
