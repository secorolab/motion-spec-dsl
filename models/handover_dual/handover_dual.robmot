// Dual-arm handover: arm1 top-grasps the cube and presents it horizontally at a mid-air
// meet point between the arms; arm2 approaches head-on with its pads a quarter turn off
// arm1's, so the two grippers take orthogonal face pairs of the cube and never touch.
// Arm1 releases and retreats while arm2 carries the cube to its side and places it.
import "handover_dual.fsm"
import "handover_dual.scenex"
ns app = "https://secorolab.github.io/models/handover-dual/"
ns ho = "https://secorolab.github.io/models/handover-dual/fsm/"

exec-context (ns=app) handover-dual-exec {
    runs-scene: <handover_scene_mjc>
    platform:   simulation { name: "MuJoCo" }
    config:     "robot.toml"
    timestep:   1.0 ms
}

tolerances {
    linear-velocity:  0.01 m/s,
    position:         0.01 m,
    orientation:      0.01 rad
}

context (ns=app) shared {
    world {
        pose pose-ee1-base {
            of:         <gripper1.g_base.g_pinch>,
            wrt:        <kinova1.base_link>,
            as-seen-by: <kinova1.base_link>
        },
        velocity-twist twist-ee1-base {
            of:         <gripper1.g_base.g_pinch>,
            wrt:        <kinova1.base_link>,
            as-seen-by: <kinova1.base_link>
        },
        pose pose-cube1-base {
            of:         <handover_graph.cube>,
            wrt:        <kinova1.base_link>,
            as-seen-by: <kinova1.base_link>
        },
        pose pose-forearm1-base {
            of:         <kinova1.forearm_link>,
            wrt:        <kinova1.base_link>,
            as-seen-by: <kinova1.base_link>
        },
        joint-position gripper1-pos {
            joint: <gripper1.g_left_driver_joint>
        },
        pose pose-ee2-base {
            of:         <gripper2.g_base.g_pinch>,
            wrt:        <kinova2.base_link>,
            as-seen-by: <kinova2.base_link>
        },
        velocity-twist twist-ee2-base {
            of:         <gripper2.g_base.g_pinch>,
            wrt:        <kinova2.base_link>,
            as-seen-by: <kinova2.base_link>
        },
        pose pose-cube2-base {
            of:         <handover_graph.cube>,
            wrt:        <kinova2.base_link>,
            as-seen-by: <kinova2.base_link>
        },
        pose pose-forearm2-base {
            of:         <kinova2.forearm_link>,
            wrt:        <kinova2.base_link>,
            as-seen-by: <kinova2.base_link>
        },
        joint-position gripper2-pos {
            joint: <gripper2.g_left_driver_joint>
        }
    },
    spec {
        length satisfied-band   = 0.01 m,
        angle satisfied-band-rot = 0.01 rad,
        // Waypoint gates, wide on purpose: the next state keeps driving the same rows, so
        // the residual converges there instead of stalling this state on the boundary.
        length gate-band        = 0.04 m,
        angle gate-band-rot     = 0.15 rad,
        angle gripper-closed    = 0.8 rad,
        angle gripper-open      = 0.0 rad,
        angle release-band      = 0.05 rad,
        // Driver band that means "pads stopped on the cube": past the free-swing threshold,
        // short of the air-close value, so a missed grasp can never gate the handover forward.
        angle grasp-threshold   = 0.15 rad,
        angle grip-on-cube-hi   = 0.70 rad,
        length grasp-reach      = 0.015 m,
        length meet-reach       = 0.025 m,

        // The forearm's own up axis: its z runs along the elbow hinge, so y is the one that
        // stands up when the arm is upright. Each arm states it against its own base.
        direction forearm1-up { as-seen-by: <kinova1.forearm_link> } = (0, 1, 0),
        direction base1-up { as-seen-by: <kinova1.base_link> } = (0, 0, 1),
        direction forearm2-up { as-seen-by: <kinova2.forearm_link> } = (0, 1, 0),
        direction base2-up { as-seen-by: <kinova2.base_link> } = (0, 0, 1),
        angle align-band = 0.05 rad,
        angle align-cone = 0.35 rad,
        angle align-cone-hold = 0.05 rad,

        // The quarter-turn states drive orientation with overdamped gains; this caps what
        // the integral may contribute so the swing cannot wind it up.
        angular-acceleration ori-integral-limit = 5.0 rad/s^2,

        // Heights of the pick sequence, all in each arm's base frame (origin on the table top).
        length above-z = 0.26 m,
        length grasp-z = 0.015 m,
        length lift-z = 0.32 m,
        length lifted-gate-z = 0.28 m,

        // The meet point: world (0, 0, table+0.30), which both bases see at x = 0.70. Arm1
        // presents the cube there with its tool axis horizontal, pads on the world-y faces;
        // arm2 waits at a standoff straight in front and closes on the world-z faces.
        length present-x = 0.70 m,
        length present-y = 0.0 m,
        length present-z = 0.30 m,
        length premeet-x = 0.58 m,
        length meet-x = 0.70 m,

        // Arm1's pull-back after release, and the gate that counts it as out of the way.
        // Shallow on purpose: retreating deeper folds the wrist toward the elbow
        // singularity while the tool is still horizontal.
        length retreat1-x = 0.42 m,
        length clear1-x = 0.50 m,

        // Where arm2 sets the cube down, on its own side.
        length place-x = 0.40 m,
        length place-y = 0.24 m,
        length place-above-z = 0.22 m,
        length place-z = 0.03 m,

        // Arm1's rest after the handover: back up and in to the compact home-like posture.
        // Same tool-horizontal orientation as present, so the move is pure translation --
        // any 90-degree fold-back at this radius transits the wrist-fold singular region.
        length rest1-x = 0.60 m,
        length rest1-z = 0.43 m
    }
}

// S.1 -- both arms settle at their startup poses.
guarded-motion (ns=app) home {
    description: "Hold both TCPs at their startup home poses"

    context {
        spec {
            pose home1-pose = snapshot of <shared.world.pose-ee1-base> on event <ho.E_HOME_ENTERED>,
            pose home2-pose = snapshot of <shared.world.pose-ee2-base> on event <ho.E_HOME_ENTERED>
        }
    }

    when {}

    while {
        hold1-position:    keeping <shared.world.pose-ee1-base>.position    equal to <spec.home1-pose>.position within <shared.spec.satisfied-band>,
        hold1-orientation: keeping <shared.world.pose-ee1-base>.orientation equal to <spec.home1-pose>.orientation within <shared.spec.satisfied-band-rot>,
        hold2-position:    keeping <shared.world.pose-ee2-base>.position    equal to <spec.home2-pose>.position within <shared.spec.satisfied-band>,
        hold2-orientation: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.home2-pose>.orientation within <shared.spec.satisfied-band-rot>,
        align1-forearm: keeping angle between <shared.spec.forearm1-up> and <shared.spec.base1-up> between 0 rad and <shared.spec.align-cone-hold> within <shared.spec.align-band>,
        align2-forearm: keeping angle between <shared.spec.forearm2-up> and <shared.spec.base2-up> between 0 rad and <shared.spec.align-cone-hold> within <shared.spec.align-band>
    }

    until all {
        settled1: <shared.world.pose-ee1-base>.position equal to <spec.home1-pose>.position within <shared.spec.satisfied-band>,
        settled2: <shared.world.pose-ee2-base>.position equal to <spec.home2-pose>.position within <shared.spec.satisfied-band>
    }
}

// S.2 -- arm1 rides a path to the pre-grasp point above the cube; arm2 stays home.
guarded-motion (ns=app) pick-above {
    description: "Arm1 moves along a path to the pre-grasp position above the cube; arm2 holds"

    context {
        spec {
            linear-velocity min-approach-speed = 0.005 m/s,
            velocity-profile approach-profile = profile {
                max-velocity: 0.08 m/s,
                max-acceleration: 0.05 m/s^2,
                shape: trapezoidal
            },
            pose start1-pose = snapshot of <shared.world.pose-ee1-base> on event <ho.E_PICK_ABOVE_ENTERED>,
            length start1-cube-x = snapshot of <shared.world.pose-cube1-base>.position.x on event <ho.E_PICK_ABOVE_ENTERED>,
            length start1-cube-y = snapshot of <shared.world.pose-cube1-base>.position.y on event <ho.E_PICK_ABOVE_ENTERED>,
            pose goal1-pose = {
                position: (<spec.start1-cube-x>, <spec.start1-cube-y>, <shared.spec.above-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (3.14159, 0.0, 1.5708) }
            },
            path arm1-approach-path = lerp { start: <spec.start1-pose>, goal: <spec.goal1-pose> },

            pose hold2-pose = snapshot of <shared.world.pose-ee2-base> on event <ho.E_PICK_ABOVE_ENTERED>
        }
    }

    when {}

    while {
        follow1-tan: moving <shared.world.pose-ee1-base> along <spec.arm1-approach-path> with <spec.approach-profile>,
        follow1-lat: keeping <shared.world.pose-ee1-base>.position    on <spec.arm1-approach-path> within <shared.spec.satisfied-band>,
        follow1-ori: keeping <shared.world.pose-ee1-base>.orientation on <spec.arm1-approach-path> within <shared.spec.satisfied-band-rot>,
        advance1:    progress of <shared.world.pose-ee1-base> along <spec.arm1-approach-path> more than <spec.min-approach-speed>,

        hold2-position:    keeping <shared.world.pose-ee2-base>.position    equal to <spec.hold2-pose>.position within <shared.spec.satisfied-band>,
        hold2-orientation: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.hold2-pose>.orientation within <shared.spec.satisfied-band-rot>,
        align1-forearm: keeping angle between <shared.spec.forearm1-up> and <shared.spec.base1-up> between 0 rad and <shared.spec.align-cone> within <shared.spec.align-band>,
        align2-forearm: keeping angle between <shared.spec.forearm2-up> and <shared.spec.base2-up> between 0 rad and <shared.spec.align-cone-hold> within <shared.spec.align-band>
    }

    until all {
        above1: <shared.world.pose-ee1-base>.position equal to <spec.goal1-pose>.position within <shared.spec.satisfied-band>
    }
}

// S.3 -- arm1 lowers straight down to the grasp height at the cube; arm2 stays home.
guarded-motion (ns=app) pick {
    description: "Arm1 lowers straight down to the grasp height at the cube; arm2 holds"

    context {
        spec {
            velocity-profile lower1-profile = profile {
                max-velocity: 0.10 m/s,
                max-acceleration: 0.30 m/s^2,
                measured-velocity: <shared.world.twist-ee1-base>.linvel.z,
                max-jerk: 2.0 m/s^3,
                shape: s-curve
            },
            length grasp1-x = snapshot of <shared.world.pose-cube1-base>.position.x on event <ho.E_PICK_ENTERED>,
            length grasp1-y = snapshot of <shared.world.pose-cube1-base>.position.y on event <ho.E_PICK_ENTERED>,
            pose pick1-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (3.14159, 0.0, 1.5708) }
            },
            pose hold2-pose = snapshot of <shared.world.pose-ee2-base> on event <ho.E_PICK_ENTERED>
        }
    }

    when {}

    while {
        hold1-x:     keeping <shared.world.pose-ee1-base>.position.x  equal to <spec.grasp1-x> within <shared.spec.satisfied-band>,
        hold1-y:     keeping <shared.world.pose-ee1-base>.position.y  equal to <spec.grasp1-y> within <shared.spec.satisfied-band>,
        lower1-z:    keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.grasp-z> within <shared.spec.satisfied-band>,
        follow1-ori: keeping <shared.world.pose-ee1-base>.orientation equal to <spec.pick1-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,

        hold2-position:    keeping <shared.world.pose-ee2-base>.position    equal to <spec.hold2-pose>.position within <shared.spec.satisfied-band>,
        hold2-orientation: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.hold2-pose>.orientation within <shared.spec.satisfied-band-rot>,
        align1-forearm: keeping angle between <shared.spec.forearm1-up> and <shared.spec.base1-up> between 0 rad and <shared.spec.align-cone-hold> within <shared.spec.align-band>,
        align2-forearm: keeping angle between <shared.spec.forearm2-up> and <shared.spec.base2-up> between 0 rad and <shared.spec.align-cone-hold> within <shared.spec.align-band>
    }

    until all {
        near1-cube: distance between <shared.world.pose-ee1-base> and <shared.world.pose-cube1-base> less than <shared.spec.grasp-reach>
    }
}

// S.4 -- arm1 closes on the cube while holding still; arm2 stays home.
guarded-motion (ns=app) grasp1 {
    description: "Arm1 holds its pose while its gripper closes on the cube; arm2 holds"

    context {
        spec {
            pose hold1-pose = snapshot of <shared.world.pose-ee1-base> on event <ho.E_GRASP1_ENTERED>,
            pose hold2-pose = snapshot of <shared.world.pose-ee2-base> on event <ho.E_GRASP1_ENTERED>
        }
    }

    when {}

    while {
        hold1-position:    keeping <shared.world.pose-ee1-base>.position    equal to <spec.hold1-pose>.position within <shared.spec.satisfied-band>,
        hold1-orientation: keeping <shared.world.pose-ee1-base>.orientation equal to <spec.hold1-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close1-gripper:    keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,

        hold2-position:    keeping <shared.world.pose-ee2-base>.position    equal to <spec.hold2-pose>.position within <shared.spec.satisfied-band>,
        hold2-orientation: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.hold2-pose>.orientation within <shared.spec.satisfied-band-rot>,
        align1-forearm: keeping angle between <shared.spec.forearm1-up> and <shared.spec.base1-up> between 0 rad and <shared.spec.align-cone-hold> within <shared.spec.align-band>,
        align2-forearm: keeping angle between <shared.spec.forearm2-up> and <shared.spec.base2-up> between 0 rad and <shared.spec.align-cone-hold> within <shared.spec.align-band>
    }

    until all {
        grasped1: <shared.world.gripper1-pos> between <shared.spec.grasp-threshold> and <shared.spec.grip-on-cube-hi>
    }
}

// S.5 -- arm1 lifts the cube straight up; arm2 stays home.
guarded-motion (ns=app) lift {
    description: "Arm1 raises the cube straight up; arm2 holds"

    context {
        spec {
            length lift1-start-x = snapshot of <shared.world.pose-ee1-base>.position.x on event <ho.E_LIFT_ENTERED>,
            length lift1-start-y = snapshot of <shared.world.pose-ee1-base>.position.y on event <ho.E_LIFT_ENTERED>,
            pose lift1-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (3.14159, 0.0, 1.5708) }
            },
            pose hold2-pose = snapshot of <shared.world.pose-ee2-base> on event <ho.E_LIFT_ENTERED>
        }
    }

    when {}

    while {
        hold1-x:        keeping <shared.world.pose-ee1-base>.position.x  equal to <spec.lift1-start-x> within <shared.spec.satisfied-band>,
        hold1-y:        keeping <shared.world.pose-ee1-base>.position.y  equal to <spec.lift1-start-y> within <shared.spec.satisfied-band>,
        lift1-z:        keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.lift-z> within <shared.spec.satisfied-band>,
        follow1-ori:    keeping <shared.world.pose-ee1-base>.orientation equal to <spec.lift1-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close1-gripper: keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,

        hold2-position:    keeping <shared.world.pose-ee2-base>.position    equal to <spec.hold2-pose>.position within <shared.spec.satisfied-band>,
        hold2-orientation: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.hold2-pose>.orientation within <shared.spec.satisfied-band-rot>,
        align1-forearm: keeping angle between <shared.spec.forearm1-up> and <shared.spec.base1-up> between 0 rad and <shared.spec.align-cone-hold> within <shared.spec.align-band>,
        align2-forearm: keeping angle between <shared.spec.forearm2-up> and <shared.spec.base2-up> between 0 rad and <shared.spec.align-cone-hold> within <shared.spec.align-band>
    }

    until all {
        lifted1: <shared.world.pose-ee1-base>.position.z greater than <shared.spec.lifted-gate-z>
    }
}

// S.6 -- arm1 swings the cube out to the meet point, tool axis going horizontal; arm2 moves
// to its standoff straight in front of the meet point, pads a quarter turn off arm1's.
guarded-motion (ns=app) present {
    description: "Arm1 presents the cube horizontally at the meet point; arm2 comes to its standoff"

    context {
        spec {
            velocity-profile reach1-x-profile = profile {
                max-velocity: 0.25 m/s,
                max-acceleration: 0.60 m/s^2,
                measured-velocity: <shared.world.twist-ee1-base>.linvel.x,
                max-jerk: 4.0 m/s^3,
                shape: s-curve
            },
            velocity-profile reach2-x-profile = profile {
                max-velocity: 0.25 m/s,
                max-acceleration: 0.60 m/s^2,
                measured-velocity: <shared.world.twist-ee2-base>.linvel.x,
                max-jerk: 4.0 m/s^3,
                shape: s-curve
            },
            velocity-profile reach2-z-profile = profile {
                max-velocity: 0.25 m/s,
                max-acceleration: 0.60 m/s^2,
                measured-velocity: <shared.world.twist-ee2-base>.linvel.z,
                max-jerk: 4.0 m/s^3,
                shape: s-curve
            },
            pose present1-pose = {
                position: (<shared.spec.present-x>, <shared.spec.present-y>, <shared.spec.present-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (1.5708, 0.0, 1.5708) }
            },
            pose premeet2-pose = {
                position: (<shared.spec.premeet-x>, <shared.spec.present-y>, <shared.spec.present-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (3.14159, -1.5708, 0.0) }
            }
        }
    }

    when {}

    while {
        reach1-x:       keeping <shared.world.pose-ee1-base>.position.x  equal to <shared.spec.present-x> within <shared.spec.satisfied-band>,
        reach1-y:       keeping <shared.world.pose-ee1-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        reach1-z:       keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        present1-ori:   keeping <shared.world.pose-ee1-base>.orientation equal to <spec.present1-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close1-gripper: keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,

        reach2-x:     keeping <shared.world.pose-ee2-base>.position.x  equal to <shared.spec.premeet-x> within <shared.spec.satisfied-band>,
        reach2-y:     keeping <shared.world.pose-ee2-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        reach2-z:     keeping <shared.world.pose-ee2-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        premeet2-ori: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.premeet2-pose>.orientation within <shared.spec.satisfied-band-rot>,

        align1-forearm: keeping angle between <shared.spec.forearm1-up> and <shared.spec.base1-up> between 0 rad and <shared.spec.align-cone> within <shared.spec.align-band>,
        align2-forearm: keeping angle between <shared.spec.forearm2-up> and <shared.spec.base2-up> between 0 rad and <shared.spec.align-cone> within <shared.spec.align-band>
    }

    until all {
        present1-pos-ok: <shared.world.pose-ee1-base>.position equal to <spec.present1-pose>.position within <shared.spec.gate-band>,
        present1-rot-ok: <shared.world.pose-ee1-base>.orientation equal to <spec.present1-pose>.orientation within <shared.spec.gate-band-rot>,
        premeet2-pos-ok: <shared.world.pose-ee2-base>.position equal to <spec.premeet2-pose>.position within <shared.spec.gate-band>,
        premeet2-rot-ok: <shared.world.pose-ee2-base>.orientation equal to <spec.premeet2-pose>.orientation within <shared.spec.gate-band-rot>
    }
}

// S.7 -- arm2 advances onto the cube; arm1 keeps presenting.
guarded-motion (ns=app) meet {
    description: "Arm2 advances until the cube sits between its pads; arm1 keeps presenting"

    context {
        spec {
            pose present1-pose = {
                position: (<shared.spec.present-x>, <shared.spec.present-y>, <shared.spec.present-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (1.5708, 0.0, 1.5708) }
            },
            pose meet2-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (3.14159, -1.5708, 0.0) }
            }
        }
    }

    when {}

    while {
        hold1-x:        keeping <shared.world.pose-ee1-base>.position.x  equal to <shared.spec.present-x> within <shared.spec.satisfied-band>,
        hold1-y:        keeping <shared.world.pose-ee1-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        hold1-z:        keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        present1-ori:   keeping <shared.world.pose-ee1-base>.orientation equal to <spec.present1-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close1-gripper: keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,

        advance2-x: keeping <shared.world.pose-ee2-base>.position.x  equal to <shared.spec.meet-x> within <shared.spec.satisfied-band>,
        hold2-y:    keeping <shared.world.pose-ee2-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        hold2-z:    keeping <shared.world.pose-ee2-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        meet2-ori:  keeping <shared.world.pose-ee2-base>.orientation equal to <spec.meet2-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,

        align1-forearm: keeping angle between <shared.spec.forearm1-up> and <shared.spec.base1-up> between 0 rad and <shared.spec.align-cone> within <shared.spec.align-band>,
        align2-forearm: keeping angle between <shared.spec.forearm2-up> and <shared.spec.base2-up> between 0 rad and <shared.spec.align-cone> within <shared.spec.align-band>
    }

    until all {
        at2-cube: distance between <shared.world.pose-ee2-base> and <shared.world.pose-cube2-base> less than <shared.spec.meet-reach>
    }
}

// S.8 -- arm2 closes on the cube's free faces while both arms hold softly.
guarded-motion (ns=app) grasp2 {
    description: "Arm2 closes on the cube while both arms hold their poses softly"

    context {
        spec {
            pose present1-pose = {
                position: (<shared.spec.present-x>, <shared.spec.present-y>, <shared.spec.present-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (1.5708, 0.0, 1.5708) }
            },
            pose meet2-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (3.14159, -1.5708, 0.0) }
            }
        }
    }

    when {}

    while {
        hold1-x:        keeping <shared.world.pose-ee1-base>.position.x  equal to <shared.spec.present-x> within <shared.spec.satisfied-band>,
        hold1-y:        keeping <shared.world.pose-ee1-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        hold1-z:        keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        present1-ori:   keeping <shared.world.pose-ee1-base>.orientation equal to <spec.present1-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close1-gripper: keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,

        hold2-x:        keeping <shared.world.pose-ee2-base>.position.x  equal to <shared.spec.meet-x> within <shared.spec.satisfied-band>,
        hold2-y:        keeping <shared.world.pose-ee2-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        hold2-z:        keeping <shared.world.pose-ee2-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        meet2-ori:      keeping <shared.world.pose-ee2-base>.orientation equal to <spec.meet2-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close2-gripper: keeping <shared.world.gripper2-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,

        align1-forearm: keeping angle between <shared.spec.forearm1-up> and <shared.spec.base1-up> between 0 rad and <shared.spec.align-cone> within <shared.spec.align-band>,
        align2-forearm: keeping angle between <shared.spec.forearm2-up> and <shared.spec.base2-up> between 0 rad and <shared.spec.align-cone> within <shared.spec.align-band>
    }

    until all {
        grasped2: <shared.world.gripper2-pos> between <shared.spec.grasp-threshold> and <shared.spec.grip-on-cube-hi>
    }
}

// S.9 -- arm1 lets go; arm2 owns the cube.
guarded-motion (ns=app) release1 {
    description: "Arm1 opens its gripper while both arms hold; the cube passes to arm2"

    context {
        spec {
            pose present1-pose = {
                position: (<shared.spec.present-x>, <shared.spec.present-y>, <shared.spec.present-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (1.5708, 0.0, 1.5708) }
            },
            pose meet2-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (3.14159, -1.5708, 0.0) }
            }
        }
    }

    when {}

    while {
        hold1-x:       keeping <shared.world.pose-ee1-base>.position.x  equal to <shared.spec.present-x> within <shared.spec.satisfied-band>,
        hold1-y:       keeping <shared.world.pose-ee1-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        hold1-z:       keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        present1-ori:  keeping <shared.world.pose-ee1-base>.orientation equal to <spec.present1-pose>.orientation within <shared.spec.satisfied-band-rot>,
        open1-gripper: keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>,

        hold2-x:        keeping <shared.world.pose-ee2-base>.position.x  equal to <shared.spec.meet-x> within <shared.spec.satisfied-band>,
        hold2-y:        keeping <shared.world.pose-ee2-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        hold2-z:        keeping <shared.world.pose-ee2-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        meet2-ori:      keeping <shared.world.pose-ee2-base>.orientation equal to <spec.meet2-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close2-gripper: keeping <shared.world.gripper2-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,

        align1-forearm: keeping angle between <shared.spec.forearm1-up> and <shared.spec.base1-up> between 0 rad and <shared.spec.align-cone> within <shared.spec.align-band>,
        align2-forearm: keeping angle between <shared.spec.forearm2-up> and <shared.spec.base2-up> between 0 rad and <shared.spec.align-cone> within <shared.spec.align-band>
    }

    until all {
        released1: <shared.world.gripper1-pos> equal to <shared.spec.gripper-open> within <shared.spec.release-band>
    }
}

// S.10 -- arm1 backs out of the meet; arm2 carries the cube over its place point.
guarded-motion (ns=app) transport {
    description: "Arm1 retreats clear of the meet; arm2 carries the cube above its place point"

    context {
        spec {
            velocity-profile retreat1-x-profile = profile {
                max-velocity: 0.25 m/s,
                max-acceleration: 0.60 m/s^2,
                measured-velocity: <shared.world.twist-ee1-base>.linvel.x,
                max-jerk: 4.0 m/s^3,
                shape: s-curve
            },
            velocity-profile reach2-x-profile = profile {
                max-velocity: 0.25 m/s,
                max-acceleration: 0.60 m/s^2,
                measured-velocity: <shared.world.twist-ee2-base>.linvel.x,
                max-jerk: 4.0 m/s^3,
                shape: s-curve
            },
            velocity-profile reach2-y-profile = profile {
                max-velocity: 0.25 m/s,
                max-acceleration: 0.60 m/s^2,
                measured-velocity: <shared.world.twist-ee2-base>.linvel.y,
                max-jerk: 4.0 m/s^3,
                shape: s-curve
            },
            pose present1-pose = {
                position: (<shared.spec.retreat1-x>, <shared.spec.present-y>, <shared.spec.present-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (1.5708, 0.0, 1.5708) }
            },
            pose place2-above-pose = {
                position: (<shared.spec.place-x>, <shared.spec.place-y>, <shared.spec.place-above-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (3.14159, 0.0, 0.0) }
            }
        }
    }

    when {}

    while {
        retreat1-x:    keeping <shared.world.pose-ee1-base>.position.x  equal to <shared.spec.retreat1-x> within <shared.spec.satisfied-band>,
        hold1-y:       keeping <shared.world.pose-ee1-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        hold1-z:       keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.present-z> within <shared.spec.satisfied-band>,
        present1-ori:  keeping <shared.world.pose-ee1-base>.orientation equal to <spec.present1-pose>.orientation within <shared.spec.satisfied-band-rot>,
        open1-gripper: keeping <shared.world.gripper1-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>,

        reach2-x:       keeping <shared.world.pose-ee2-base>.position.x  equal to <shared.spec.place-x> within <shared.spec.satisfied-band>,
        reach2-y:       keeping <shared.world.pose-ee2-base>.position.y  equal to <shared.spec.place-y> within <shared.spec.satisfied-band>,
        reach2-z:       keeping <shared.world.pose-ee2-base>.position.z  equal to <shared.spec.place-above-z> within <shared.spec.satisfied-band>,
        place2-ori:     keeping <shared.world.pose-ee2-base>.orientation equal to <spec.place2-above-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close2-gripper: keeping <shared.world.gripper2-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,

        align1-forearm: keeping angle between <shared.spec.forearm1-up> and <shared.spec.base1-up> between 0 rad and <shared.spec.align-cone> within <shared.spec.align-band>,
        align2-forearm: keeping angle between <shared.spec.forearm2-up> and <shared.spec.base2-up> between 0 rad and <shared.spec.align-cone> within <shared.spec.align-band>
    }

    until all {
        clear1: <shared.world.pose-ee1-base>.position.x less than <shared.spec.clear1-x>,
        at2-above: <shared.world.pose-ee2-base>.position equal to <spec.place2-above-pose>.position within <shared.spec.gate-band>
    }
}

// S.11 -- arm2 lowers the cube to the table; arm1 holds where it retreated to.
guarded-motion (ns=app) place {
    description: "Arm2 lowers the cube to the place height; arm1 folds back to its rest posture"

    context {
        spec {
            pose place2-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (3.14159, 0.0, 0.0) }
            },
            pose rest1-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (1.5708, 0.0, 1.5708) }
            }
        }
    }

    when {}

    while {
        rest1-x:   keeping <shared.world.pose-ee1-base>.position.x  equal to <shared.spec.rest1-x> within <shared.spec.satisfied-band>,
        rest1-y:   keeping <shared.world.pose-ee1-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        rest1-z:   keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.rest1-z> within <shared.spec.satisfied-band>,
        rest1-ori: keeping <shared.world.pose-ee1-base>.orientation equal to <spec.rest1-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,

        hold2-x:        keeping <shared.world.pose-ee2-base>.position.x  equal to <shared.spec.place-x> within <shared.spec.satisfied-band>,
        hold2-y:        keeping <shared.world.pose-ee2-base>.position.y  equal to <shared.spec.place-y> within <shared.spec.satisfied-band>,
        lower2-z:       keeping <shared.world.pose-ee2-base>.position.z  equal to <shared.spec.place-z> within <shared.spec.satisfied-band>,
        place2-ori:     keeping <shared.world.pose-ee2-base>.orientation equal to <spec.place2-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        close2-gripper: keeping <shared.world.gripper2-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>,

        align1-forearm: keeping angle between <shared.spec.forearm1-up> and <shared.spec.base1-up> between 0 rad and <shared.spec.align-cone> within <shared.spec.align-band>,
        align2-forearm: keeping angle between <shared.spec.forearm2-up> and <shared.spec.base2-up> between 0 rad and <shared.spec.align-cone-hold> within <shared.spec.align-band>
    }

    until all {
        at2-place: <shared.world.pose-ee2-base>.position.z equal to <shared.spec.place-z> within <shared.spec.satisfied-band>
    }
}

// S.12 -- arm2 lets go of the cube on the table.
guarded-motion (ns=app) release2 {
    description: "Arm2 opens its gripper at the place point; both arms hold"

    context {
        spec {
            pose rest1-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (1.5708, 0.0, 1.5708) }
            },
            pose hold2-pose = snapshot of <shared.world.pose-ee2-base> on event <ho.E_RELEASE2_ENTERED>
        }
    }

    when {}

    while {
        rest1-x:   keeping <shared.world.pose-ee1-base>.position.x  equal to <shared.spec.rest1-x> within <shared.spec.satisfied-band>,
        rest1-y:   keeping <shared.world.pose-ee1-base>.position.y  equal to <shared.spec.present-y> within <shared.spec.satisfied-band>,
        rest1-z:   keeping <shared.world.pose-ee1-base>.position.z  equal to <shared.spec.rest1-z> within <shared.spec.satisfied-band>,
        rest1-ori: keeping <shared.world.pose-ee1-base>.orientation equal to <spec.rest1-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,

        hold2-position:    keeping <shared.world.pose-ee2-base>.position    equal to <spec.hold2-pose>.position within <shared.spec.satisfied-band>,
        hold2-orientation: keeping <shared.world.pose-ee2-base>.orientation equal to <spec.hold2-pose>.orientation within <shared.spec.satisfied-band-rot>,
        open2-gripper:     keeping <shared.world.gripper2-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>,

        align1-forearm: keeping angle between <shared.spec.forearm1-up> and <shared.spec.base1-up> between 0 rad and <shared.spec.align-cone-hold> within <shared.spec.align-band>,
        align2-forearm: keeping angle between <shared.spec.forearm2-up> and <shared.spec.base2-up> between 0 rad and <shared.spec.align-cone-hold> within <shared.spec.align-band>
    }

    until all {
        released2: <shared.world.gripper2-pos> equal to <shared.spec.gripper-open> within <shared.spec.release-band>,
        rest1-x-ok: <shared.world.pose-ee1-base>.position.x equal to <shared.spec.rest1-x> within <shared.spec.satisfied-band>,
        rest1-z-ok: <shared.world.pose-ee1-base>.position.z equal to <shared.spec.rest1-z> within <shared.spec.satisfied-band>
    }
}

// ------------------ constraint handlers ------------------

constraint-handler (ns=app) handler-home {
    handles: <home>
    runs-in: <ho.S_HOME>
    monitors {
        mon-home-settled: monitor <home.until> {
            satisfied for 0.5 s { trigger: event <ho.E_PICK_ABOVE_READY> }
        }
    }
    controllers {
        pid ctrl-h1-position { constraint: <home.hold1-position>,    Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <arm1-solver>,
        pid ctrl-h1-orientation { constraint: <home.hold1-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <arm1-solver>,
        pid ctrl-h2-position { constraint: <home.hold2-position>,    Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <arm2-solver>,
        pid ctrl-h2-orientation { constraint: <home.hold2-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <arm2-solver>,
        impedance ctrl-home-align1 { constraint: <home.align1-forearm>, stiffness: 400, damping: 40 } apply at <kinova1.forearm_link> via <arm1-solver>,
        impedance ctrl-home-align2 { constraint: <home.align2-forearm>, stiffness: 400, damping: 40 } apply at <kinova2.forearm_link> via <arm2-solver>
    }
    solvers {
        arm1-solver: serial-chain {
            agent:     <handover_agents.arm1>,
            algorithm: achd,
            gravity:   (0.0, 0.0, 9.81) m/s^2
        },
        arm2-solver: serial-chain {
            agent:     <handover_agents.arm2>,
            algorithm: achd,
            gravity:   (0.0, 0.0, 9.81) m/s^2
        }
    }
}

constraint-handler (ns=app) handler-pick-above {
    handles: <pick-above>
    runs-in: <ho.S_PICK_ABOVE>
    monitors {
        mon-above: monitor <pick-above.until> {
            satisfied for 0.3 s { trigger: event <ho.E_PICK_READY> }
        }
    }
    controllers {
        pid ctrl-pa1-follow-tan { constraint: <pick-above.follow1-tan>, Kp: 20,  Ki: 4,   Kd: 0,  decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pa1-follow-lat { constraint: <pick-above.follow1-lat>, measured-derivative: <shared.world.twist-ee1-base>.linvel, Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pa1-follow-ori { constraint: <pick-above.follow1-ori>, measured-derivative: <shared.world.twist-ee1-base>.angvel, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pa2-hold-position { constraint: <pick-above.hold2-position>, Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pa2-hold-orientation { constraint: <pick-above.hold2-orientation>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm2-solver>,
        impedance ctrl-pa-align1 { constraint: <pick-above.align1-forearm>, stiffness: 40, damping: 8 } apply at <kinova1.forearm_link> via <handler-home.arm1-solver>,
        impedance ctrl-pa-align2 { constraint: <pick-above.align2-forearm>, stiffness: 400, damping: 40 } apply at <kinova2.forearm_link> via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>
    }
}

constraint-handler (ns=app) handler-pick {
    handles: <pick>
    runs-in: <ho.S_PICK>
    monitors {
        mon-near-cube: monitor <pick.until> {
            satisfied { trigger: event <ho.E_GRASP1_READY> }
        }
    }
    controllers {
        pid ctrl-pk1-hold-x { constraint: <pick.hold1-x>,     Kp: 200, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pk1-hold-y { constraint: <pick.hold1-y>,     Kp: 200, Ki: 30, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pk1-lower-z { constraint: <pick.lower1-z>, profile: <pick.spec.lower1-profile>, measured-derivative: <shared.world.twist-ee1-base>.linvel.z, Kp: 12, Ki: 5, Kd: 15, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pk1-follow-ori { constraint: <pick.follow1-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pk2-hold-position { constraint: <pick.hold2-position>, Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pk2-hold-orientation { constraint: <pick.hold2-orientation>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm2-solver>,
        impedance ctrl-pk-align1 { constraint: <pick.align1-forearm>, stiffness: 400, damping: 40 } apply at <kinova1.forearm_link> via <handler-home.arm1-solver>,
        impedance ctrl-pk-align2 { constraint: <pick.align2-forearm>, stiffness: 400, damping: 40 } apply at <kinova2.forearm_link> via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>
    }
}

constraint-handler (ns=app) handler-grasp1 {
    handles: <grasp1>
    runs-in: <ho.S_GRASP1>
    monitors {
        mon-grasped1: monitor <grasp1.until> {
            satisfied for 0.2 s { trigger: event <ho.E_LIFT_READY> }
        }
    }
    controllers {
        pid ctrl-g1-hold-position { constraint: <grasp1.hold1-position>, Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-g1-hold-orientation { constraint: <grasp1.hold1-orientation>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        feed-forward ctrl-g1-close { constraint: <grasp1.close1-gripper> } via <gripper1-solver>,
        pid ctrl-g1-hold2-position { constraint: <grasp1.hold2-position>, Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-g1-hold2-orientation { constraint: <grasp1.hold2-orientation>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm2-solver>,
        impedance ctrl-g1-align1 { constraint: <grasp1.align1-forearm>, stiffness: 400, damping: 40 } apply at <kinova1.forearm_link> via <handler-home.arm1-solver>,
        impedance ctrl-g1-align2 { constraint: <grasp1.align2-forearm>, stiffness: 400, damping: 40 } apply at <kinova2.forearm_link> via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        gripper1-solver: command-forwarding {
            agent: <handover_agents.arm1>
        },
        gripper2-solver: command-forwarding {
            agent: <handover_agents.arm2>
        }
    }
}

constraint-handler (ns=app) handler-lift {
    handles: <lift>
    runs-in: <ho.S_LIFT>
    monitors {
        mon-lifted: monitor <lift.until> {
            satisfied { trigger: event <ho.E_PRESENT_READY> }
        }
    }
    controllers {
        pid ctrl-lt1-hold-x { constraint: <lift.hold1-x>,     Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-lt1-hold-y { constraint: <lift.hold1-y>,     Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-lt1-lift-z { constraint: <lift.lift1-z>,     Kp: 15,  Ki: 5,   Kd: 20, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-lt1-follow-ori { constraint: <lift.follow1-ori>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        feed-forward ctrl-lt1-close { constraint: <lift.close1-gripper> } via <handler-grasp1.gripper1-solver>,
        pid ctrl-lt2-hold-position { constraint: <lift.hold2-position>, Kp: 200, Ki: 100, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-lt2-hold-orientation { constraint: <lift.hold2-orientation>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm2-solver>,
        impedance ctrl-lt-align1 { constraint: <lift.align1-forearm>, stiffness: 400, damping: 40 } apply at <kinova1.forearm_link> via <handler-home.arm1-solver>,
        impedance ctrl-lt-align2 { constraint: <lift.align2-forearm>, stiffness: 400, damping: 40 } apply at <kinova2.forearm_link> via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-grasp1.gripper1-solver>
    }
}

constraint-handler (ns=app) handler-present {
    handles: <present>
    runs-in: <ho.S_PRESENT>
    monitors {
        mon-presented: monitor <present.until> {
            satisfied for 0.3 s { trigger: event <ho.E_MEET_READY> }
        }
    }
    controllers {
        pid ctrl-pr1-reach-x { constraint: <present.reach1-x>, profile: <present.spec.reach1-x-profile>, measured-derivative: <shared.world.twist-ee1-base>.linvel.x, Kp: 100, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pr1-reach-y { constraint: <present.reach1-y>,   Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pr1-reach-z { constraint: <present.reach1-z>,   Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pr1-ori { constraint: <present.present1-ori>, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 60, Ki: 10, Kd: 60, decay: 0 } via <handler-home.arm1-solver>,
        feed-forward ctrl-pr1-close { constraint: <present.close1-gripper> } via <handler-grasp1.gripper1-solver>,
        pid ctrl-pr2-reach-x { constraint: <present.reach2-x>, profile: <present.spec.reach2-x-profile>, measured-derivative: <shared.world.twist-ee2-base>.linvel.x, Kp: 100, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pr2-reach-y { constraint: <present.reach2-y>,   Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pr2-reach-z { constraint: <present.reach2-z>, profile: <present.spec.reach2-z-profile>, measured-derivative: <shared.world.twist-ee2-base>.linvel.z, Kp: 100, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pr2-ori { constraint: <present.premeet2-ori>, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 60, Ki: 10, Kd: 60, decay: 0 } via <handler-home.arm2-solver>,
        impedance ctrl-pr-align1 { constraint: <present.align1-forearm>, stiffness: 40, damping: 8 } apply at <kinova1.forearm_link> via <handler-home.arm1-solver>,
        impedance ctrl-pr-align2 { constraint: <present.align2-forearm>, stiffness: 40, damping: 8 } apply at <kinova2.forearm_link> via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-grasp1.gripper1-solver>
    }
}

constraint-handler (ns=app) handler-meet {
    handles: <meet>
    runs-in: <ho.S_MEET>
    monitors {
        mon-met: monitor <meet.until> {
            satisfied for 0.2 s { trigger: event <ho.E_GRASP2_READY> }
        }
    }
    controllers {
        pid ctrl-mt1-hold-x { constraint: <meet.hold1-x>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-mt1-hold-y { constraint: <meet.hold1-y>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-mt1-hold-z { constraint: <meet.hold1-z>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-mt1-ori { constraint: <meet.present1-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        feed-forward ctrl-mt1-close { constraint: <meet.close1-gripper> } via <handler-grasp1.gripper1-solver>,
        pid ctrl-mt2-advance-x { constraint: <meet.advance2-x>, Kp: 60,  Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-mt2-hold-y { constraint: <meet.hold2-y>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-mt2-hold-z { constraint: <meet.hold2-z>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-mt2-ori { constraint: <meet.meet2-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm2-solver>,
        impedance ctrl-mt-align1 { constraint: <meet.align1-forearm>, stiffness: 40, damping: 8 } apply at <kinova1.forearm_link> via <handler-home.arm1-solver>,
        impedance ctrl-mt-align2 { constraint: <meet.align2-forearm>, stiffness: 40, damping: 8 } apply at <kinova2.forearm_link> via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-grasp1.gripper1-solver>
    }
}

constraint-handler (ns=app) handler-grasp2 {
    handles: <grasp2>
    runs-in: <ho.S_GRASP2>
    monitors {
        mon-grasped2: monitor <grasp2.until> {
            satisfied for 0.2 s { trigger: event <ho.E_RELEASE1_READY> }
        }
    }
    controllers {
        pid ctrl-g2-hold1-x { constraint: <grasp2.hold1-x>,   Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-g2-hold1-y { constraint: <grasp2.hold1-y>,   Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-g2-hold1-z { constraint: <grasp2.hold1-z>,   Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-g2-ori1 { constraint: <grasp2.present1-ori>, Kp: 80, Ki: 0, Kd: 50, decay: 0 } via <handler-home.arm1-solver>,
        feed-forward ctrl-g2-close1 { constraint: <grasp2.close1-gripper> } via <handler-grasp1.gripper1-solver>,
        pid ctrl-g2-hold2-x { constraint: <grasp2.hold2-x>,   Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-g2-hold2-y { constraint: <grasp2.hold2-y>,   Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-g2-hold2-z { constraint: <grasp2.hold2-z>,   Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-g2-ori2 { constraint: <grasp2.meet2-ori>, Kp: 80, Ki: 0, Kd: 50, decay: 0 } via <handler-home.arm2-solver>,
        feed-forward ctrl-g2-close2 { constraint: <grasp2.close2-gripper> } via <handler-grasp1.gripper2-solver>,
        impedance ctrl-g2-align1 { constraint: <grasp2.align1-forearm>, stiffness: 40, damping: 8 } apply at <kinova1.forearm_link> via <handler-home.arm1-solver>,
        impedance ctrl-g2-align2 { constraint: <grasp2.align2-forearm>, stiffness: 40, damping: 8 } apply at <kinova2.forearm_link> via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-grasp1.gripper1-solver>,
        <handler-grasp1.gripper2-solver>
    }
}

constraint-handler (ns=app) handler-release1 {
    handles: <release1>
    runs-in: <ho.S_RELEASE1>
    monitors {
        mon-released1: monitor <release1.until> {
            satisfied for 0.2 s { trigger: event <ho.E_TRANSPORT_READY> }
        }
    }
    controllers {
        pid ctrl-r1-hold1-x { constraint: <release1.hold1-x>,   Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-r1-hold1-y { constraint: <release1.hold1-y>,   Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-r1-hold1-z { constraint: <release1.hold1-z>,   Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-r1-ori1 { constraint: <release1.present1-ori>, Kp: 80, Ki: 0, Kd: 50, decay: 0 } via <handler-home.arm1-solver>,
        feed-forward ctrl-r1-open1 { constraint: <release1.open1-gripper> } via <handler-grasp1.gripper1-solver>,
        pid ctrl-r1-hold2-x { constraint: <release1.hold2-x>,   Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-r1-hold2-y { constraint: <release1.hold2-y>,   Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-r1-hold2-z { constraint: <release1.hold2-z>,   Kp: 60, Ki: 0, Kd: 25, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-r1-ori2 { constraint: <release1.meet2-ori>, Kp: 80, Ki: 0, Kd: 50, decay: 0 } via <handler-home.arm2-solver>,
        feed-forward ctrl-r1-close2 { constraint: <release1.close2-gripper> } via <handler-grasp1.gripper2-solver>,
        impedance ctrl-r1-align1 { constraint: <release1.align1-forearm>, stiffness: 40, damping: 8 } apply at <kinova1.forearm_link> via <handler-home.arm1-solver>,
        impedance ctrl-r1-align2 { constraint: <release1.align2-forearm>, stiffness: 40, damping: 8 } apply at <kinova2.forearm_link> via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-grasp1.gripper1-solver>,
        <handler-grasp1.gripper2-solver>
    }
}

constraint-handler (ns=app) handler-transport {
    handles: <transport>
    runs-in: <ho.S_TRANSPORT>
    monitors {
        mon-transported: monitor <transport.until> {
            satisfied for 0.2 s { trigger: event <ho.E_PLACE_READY> }
        }
    }
    controllers {
        pid ctrl-tr1-retreat-x { constraint: <transport.retreat1-x>, profile: <transport.spec.retreat1-x-profile>, measured-derivative: <shared.world.twist-ee1-base>.linvel.x, Kp: 100, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-tr1-hold-y { constraint: <transport.hold1-y>,   Kp: 120, Ki: 20, Kd: 45, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-tr1-hold-z { constraint: <transport.hold1-z>,   Kp: 120, Ki: 20, Kd: 45, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-tr1-ori { constraint: <transport.present1-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 } via <handler-home.arm1-solver>,
        feed-forward ctrl-tr1-open { constraint: <transport.open1-gripper> } via <handler-grasp1.gripper1-solver>,
        pid ctrl-tr2-reach-x { constraint: <transport.reach2-x>, profile: <transport.spec.reach2-x-profile>, measured-derivative: <shared.world.twist-ee2-base>.linvel.x, Kp: 100, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-tr2-reach-y { constraint: <transport.reach2-y>, profile: <transport.spec.reach2-y-profile>, measured-derivative: <shared.world.twist-ee2-base>.linvel.y, Kp: 100, Ki: 20, Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-tr2-reach-z { constraint: <transport.reach2-z>,   Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-tr2-ori { constraint: <transport.place2-ori>, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 60, Ki: 10, Kd: 60, decay: 0 } via <handler-home.arm2-solver>,
        feed-forward ctrl-tr2-close { constraint: <transport.close2-gripper> } via <handler-grasp1.gripper2-solver>,
        impedance ctrl-tr-align1 { constraint: <transport.align1-forearm>, stiffness: 40, damping: 8 } apply at <kinova1.forearm_link> via <handler-home.arm1-solver>,
        impedance ctrl-tr-align2 { constraint: <transport.align2-forearm>, stiffness: 40, damping: 8 } apply at <kinova2.forearm_link> via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-grasp1.gripper1-solver>,
        <handler-grasp1.gripper2-solver>
    }
}

constraint-handler (ns=app) handler-place {
    handles: <place>
    runs-in: <ho.S_PLACE>
    monitors {
        mon-placed: monitor <place.until> {
            satisfied for 0.2 s { trigger: event <ho.E_RELEASE2_READY> }
        }
    }
    controllers {
        pid ctrl-pl1-rest-x { constraint: <place.rest1-x>,   Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pl1-rest-y { constraint: <place.rest1-y>,   Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pl1-rest-z { constraint: <place.rest1-z>,   Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pl1-rest-ori { constraint: <place.rest1-ori>, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 60, Ki: 10, Kd: 60, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-pl2-hold-x { constraint: <place.hold2-x>,   Kp: 140, Ki: 20, Kd: 55, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pl2-hold-y { constraint: <place.hold2-y>,   Kp: 140, Ki: 20, Kd: 55, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pl2-lower-z { constraint: <place.lower2-z>, Kp: 15,  Ki: 5,  Kd: 40, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-pl2-ori { constraint: <place.place2-ori>, Kp: 180, Ki: 30, Kd: 120, decay: 0 } via <handler-home.arm2-solver>,
        feed-forward ctrl-pl2-close { constraint: <place.close2-gripper> } via <handler-grasp1.gripper2-solver>,
        impedance ctrl-pl-align1 { constraint: <place.align1-forearm>, stiffness: 400, damping: 40 } apply at <kinova1.forearm_link> via <handler-home.arm1-solver>,
        impedance ctrl-pl-align2 { constraint: <place.align2-forearm>, stiffness: 400, damping: 40 } apply at <kinova2.forearm_link> via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-grasp1.gripper2-solver>
    }
}

constraint-handler (ns=app) handler-release2 {
    handles: <release2>
    runs-in: <ho.S_RELEASE2>
    monitors {
        mon-released2: monitor <release2.until> {
            satisfied for 0.3 s { trigger: event <ho.E_DONE_READY> }
        }
    }
    controllers {
        pid ctrl-r2-rest-x { constraint: <release2.rest1-x>,   Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-r2-rest-y { constraint: <release2.rest1-y>,   Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-r2-rest-z { constraint: <release2.rest1-z>,   Kp: 60, Ki: 10, Kd: 30, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-r2-rest-ori { constraint: <release2.rest1-ori>, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 60, Ki: 10, Kd: 60, decay: 0 } via <handler-home.arm1-solver>,
        pid ctrl-r2-hold2-position { constraint: <release2.hold2-position>, Kp: 140, Ki: 20, Kd: 55, decay: 0 } via <handler-home.arm2-solver>,
        pid ctrl-r2-hold2-orientation { constraint: <release2.hold2-orientation>, Kp: 180, Ki: 30, Kd: 120, decay: 0 } via <handler-home.arm2-solver>,
        feed-forward ctrl-r2-open2 { constraint: <release2.open2-gripper> } via <handler-grasp1.gripper2-solver>,
        impedance ctrl-r2-align1 { constraint: <release2.align1-forearm>, stiffness: 400, damping: 40 } apply at <kinova1.forearm_link> via <handler-home.arm1-solver>,
        impedance ctrl-r2-align2 { constraint: <release2.align2-forearm>, stiffness: 400, damping: 40 } apply at <kinova2.forearm_link> via <handler-home.arm2-solver>
    }
    solvers {
        <handler-home.arm1-solver>,
        <handler-home.arm2-solver>,
        <handler-grasp1.gripper2-solver>
    }
}
