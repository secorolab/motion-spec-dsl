import "pick_place_single.scene"
import "../kinova_gen3_7dof.ktree"
import "../robotiq_2f85.ktree"

ns pps_mjc = "https://secorolab.github.io/models/scenes/pick-place-single-mjc/"

ktree inst (ns=pps_mjc) kinova of <kinova_tree>
ktree inst (ns=pps_mjc) gripper of <gripper_tree>

ktree (ns=pps_mjc) kinova_2f85 {
    tree <kinova>
    tree <gripper>

    joints {
        fixed g_mount_on_pinch_site {
            parent: <kinova.bracelet_link.pinch_site>
            child: <gripper.g_base_mount.g_mount_interface>
        }
        serial {
            root: <kinova.base_link.base_link_origin>
            tip: <gripper.g_base.g_pinch>
        }
    }
}

ktree (ns=pps_mjc) world_tree {
    tree <kinova_2f85>

    body world_body {
        frame world { }
    }

    body table {
        frame table_top {
            pose table_top_in_world {
                wrt: <world_body.world>
                xyz: (0.0, 0.0, 0.72) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
    }

    joints {
        fixed table_on_world {
            parent: <world_body.world>
            child: <table.table_top>
        }
        fixed arm_on_table {
            parent: <table.table_top>
            child: <kinova.base_link.base_link_origin>
        }
    }
}

scene inst (ns=pps_mjc) pick_place_scene_mjc {
    scene: <pick_place_scene>

    kgraph (ns=pps_mjc) pick_place_graph {
        tree <world_tree>

        body cube {
            frame cube_origin {
                pose cube_in_world {
                    wrt: <world_tree.world_body.world>
                    xyz: (0.50, 0.0, 0.76) m
                    orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
                }
            }
        }
    }

    obj <ws_objects.table> {
        model table-mjc as mjcf { sys path = 'src/mj_kdl_wrapper/assets/table.xml' }
        body: <world_tree.table>
    }

    obj <pickplace_objects.cube> {
        model cube-mjc as mjcf { sys path = 'src/mj_kdl_wrapper/assets/cube.xml' }
        body: <pick_place_graph.cube>
    }

    agn <pickplace_agents.kinova_2f85> {
        model kinova-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/third_party/menagerie/kinova_gen3/gen3.xml'
        } for <kinova>

        model gripper-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/assets/robotiq_2f85/2f85.xml'
        } for <gripper> at body "base_mount"

        camera wrist {
            frame: <kinova.bracelet_link.wrist_anchor>
            type: rgb
            resolution: (640, 480)
            fov: 41.83792730009236 deg
            update-rate: 30.0 Hz
        }
    }
}
