import "pick_place_single.fsm"
import "pick_place_single.scenex"
ns app = "https://secorolab.github.io/models/pick-place-single/"
ns pp = "https://secorolab.github.io/models/pick-place-single/fsm/"

exec-context (ns=app) pick-place-single-exec {
    runs-scene: <pick_place_scene_mjc>
    platform:   simulation { name: "MuJoCo" }
    config:     "robot.toml"
    timestep:   1.0 ms
}

context (ns=app) shared {
    world {
        pose pose-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link>,
            as-seen-by: <kinova.base_link>
        },
        velocity-twist twist-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link>,
            as-seen-by: <kinova.base_link>
        },
        pose pose-cube-base {
            of:         <pick_place_graph.cube>,
            wrt:        <kinova.base_link>,
            as-seen-by: <kinova.base_link>
        },
        pose pose-elbow-base {
            of:         <kinova.half_arm_2_link>,
            wrt:        <kinova.base_link>,
            as-seen-by: <kinova.base_link>
        },
        joint-position gripper-pos {
            joint: <gripper.g_left_driver_joint>
        }
    },
    spec {
        length satisfied-band     = 0.01 m,
        angle satisfied-band-rot           = 0.01 rad,
        linear-velocity zero-linvel = 0.0 m/s,
        length zero-dist   = 0.0 m,
        angle grasp-rot-x            = 3.14159 rad,
        angle grasp-rot-y           = 0.0 rad,
        angle grasp-rot-z             = 1.5708 rad,
        angle gripper-closed        = 0.8 rad,
        angle gripper-open          = 0.0 rad,
        length lost-dist   = 0.12 m,
        // Where this deployment parks the TCP: a property of the cell the arm stands in, not
        // of the pick-and-place task, so robot.toml states it and this names which section.
        pose home-pose = [config.poses.home] for <shared.world.pose-ee-base>
    }
    // nothing, the pose is the cube's start placement.
}

tolerances {
    linear-velocity:  0.01 m/s,
    position:         0.01 m,
    orientation:      0.01 rad
}

guarded-motion (ns=app) home {
    description: "Hold the TCP at the home pose the deployment states"

    context {
        <shared.spec>
    }

    when {}

    while {
        hold-position:    keeping <shared.world.pose-ee-base>.position    equal to <shared.spec.home-pose>.position within <shared.spec.satisfied-band>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <shared.spec.home-pose>.orientation within <shared.spec.satisfied-band-rot>
    }

    until {}
}

guarded-motion (ns=app) pick-above {
    description: "Move TCP to the pre-grasp position above the cube along a path"

    context {
        spec {
            length above-z      = 0.26 m,
            linear-velocity min-approach-speed = 0.005 m/s,
            velocity-profile approach-profile = profile {
                max-velocity: 0.08 m/s,
                max-acceleration: 0.05 m/s^2,
                shape: trapezoidal
            },
            pose start-pose              = snapshot of <shared.world.pose-ee-base>,
            length start-cube-x = snapshot of <shared.world.pose-cube-base>.position.x,
            length start-cube-y = snapshot of <shared.world.pose-cube-base>.position.y,
            pose goal-pose = {
                position: (<spec.start-cube-x>, <spec.start-cube-y>, <spec.above-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            },
            path approach-path = lerp {
                start: <spec.start-pose>,
                goal:  <spec.goal-pose>
            }
        }
    }

    when {
        gripper-ready: <shared.world.gripper-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>
    }

    while {
        follow-tan: moving <shared.world.pose-ee-base> along <spec.approach-path> with <spec.approach-profile>,
        follow-lat: keeping <shared.world.pose-ee-base>.position    on <spec.approach-path> within <shared.spec.satisfied-band>,
        follow-ori: keeping <shared.world.pose-ee-base>.orientation on <spec.approach-path> within <shared.spec.satisfied-band-rot>,
        advance:    progress of <shared.world.pose-ee-base> along <spec.approach-path> more than <spec.min-approach-speed>
    }

    until {}
}

guarded-motion (ns=app) pick {
    description: "Lower TCP straight down to the grasp height at the cube"

    context {
        spec {
            length grasp-x         = snapshot of <shared.world.pose-cube-base>.position.x,
            length grasp-y         = snapshot of <shared.world.pose-cube-base>.position.y,
            length grasp-z         = 0.015 m,
            length support-lift    = 0.06 m,
            length support-z       = snapshot of <shared.world.pose-elbow-base>.position.z + <spec.support-lift>,
            pose pick-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            }
        }
    }

    when {
        aligned-above: <shared.world.pose-ee-base>.position equal to <pick-above.spec.goal-pose>.position within <shared.spec.satisfied-band>
    }

    while {
        hold-x:     keeping <shared.world.pose-ee-base>.position.x  equal to <spec.grasp-x> within <shared.spec.satisfied-band>,
        hold-y:     keeping <shared.world.pose-ee-base>.position.y  equal to <spec.grasp-y> within <shared.spec.satisfied-band>,
        lower-z:    keeping <shared.world.pose-ee-base>.position.z  equal to <spec.grasp-z> within <shared.spec.satisfied-band>,
        follow-ori: keeping <shared.world.pose-ee-base>.orientation equal to <spec.pick-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z equal to <spec.support-z> within <shared.spec.satisfied-band>
    }

    until {}
}

guarded-motion (ns=app) grasp-hold {
    description: "Hold TCP at the current base-frame pose while the gripper closes"

    context {
        spec {
            length support-lift = 0.06 m,
            length support-z    = snapshot of <shared.world.pose-elbow-base>.position.z + <spec.support-lift>,
            pose hold-orientation-pose   = snapshot of <shared.world.pose-ee-base>,
            length grasp-reach  = 0.015 m
        }
    }

    when {
        near-cube: distance between <shared.world.pose-ee-base> and <shared.world.pose-cube-base> less than <grasp-hold.spec.grasp-reach>
    }

    while {
        hold-x:          keeping <shared.world.pose-ee-base>.position.x equal to <spec.hold-orientation-pose>.position.x within <shared.spec.satisfied-band>,
        hold-y:          keeping <shared.world.pose-ee-base>.position.y equal to <spec.hold-orientation-pose>.position.y within <shared.spec.satisfied-band>,
        hold-z:          keeping <shared.world.pose-ee-base>.position.z equal to <spec.hold-orientation-pose>.position.z within <shared.spec.satisfied-band>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.hold-orientation-pose>.orientation within <shared.spec.satisfied-band-rot>,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z equal to <spec.support-z> within <shared.spec.satisfied-band>,
        close-gripper:   keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>
    }

    until {}
}

guarded-motion (ns=app) lift {
    description: "Raise TCP straight up while holding the cube"

    context {
        spec {
            length lift-z       = 0.32 m,
            angle grasp-threshold        = 0.15 rad,
            length lift-start-x = snapshot of <shared.world.pose-ee-base>.position.x,
            length lift-start-y = snapshot of <shared.world.pose-ee-base>.position.y,
            length support-lift = 0.06 m,
            length support-z    = snapshot of <shared.world.pose-elbow-base>.position.z + <spec.support-lift>,
            pose lift-ori-pose = {
                position: (0.0, 0.0, 0.0) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            }
        }
    }

    when {
        grasped: <shared.world.gripper-pos> greater than <lift.spec.grasp-threshold>
    }

    while {
        hold-x:        keeping <shared.world.pose-ee-base>.position.x  equal to <spec.lift-start-x> within <shared.spec.satisfied-band>,
        hold-y:        keeping <shared.world.pose-ee-base>.position.y  equal to <spec.lift-start-y> within <shared.spec.satisfied-band>,
        lift-z:        keeping <shared.world.pose-ee-base>.position.z  equal to <spec.lift-z> within <shared.spec.satisfied-band>,
        follow-ori:    keeping <shared.world.pose-ee-base>.orientation equal to <spec.lift-ori-pose>.orientation within <shared.spec.satisfied-band-rot>,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z equal to <spec.support-z> within <shared.spec.satisfied-band>,
        close-gripper: keeping <shared.world.gripper-pos>              equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>
    }

    until {
        grasp-lost: distance between <shared.world.pose-ee-base> and <shared.world.pose-cube-base> greater than <shared.spec.lost-dist>
    }
}

guarded-motion (ns=app) place-above {
    description: "Move TCP laterally to the pre-place position above the place location"

    context {
        spec {
            length place-x       = 0.40 m,
            length place-y       = 0.24 m,
            length place-above-z = 0.22 m,
            length lifted-z      = 0.30 m,
            length support-lift  = 0.06 m,
            length support-z     = snapshot of <shared.world.pose-elbow-base>.position.z + <spec.support-lift>,
            pose goal-pose-above = {
                position: (<spec.place-x>, <spec.place-y>, <spec.place-above-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            }
        }
    }

    when {
        lifted: <shared.world.pose-ee-base>.position.z greater than <place-above.spec.lifted-z>
    }

    while {
        reach-x:       keeping <shared.world.pose-ee-base>.position.x         equal to <spec.place-x> within <shared.spec.satisfied-band>,
        reach-y:       keeping <shared.world.pose-ee-base>.position.y         equal to <spec.place-y> within <shared.spec.satisfied-band>,
        reach-z:       keeping <shared.world.pose-ee-base>.position.z         equal to <spec.place-above-z> within <shared.spec.satisfied-band>,
        align-ori:     keeping <shared.world.pose-ee-base>.orientation        equal to <spec.goal-pose-above>.orientation within <shared.spec.satisfied-band-rot>,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z   equal to <spec.support-z> within <shared.spec.satisfied-band>,
        close-gripper: keeping <shared.world.gripper-pos>                 equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>
    }

    until {
        grasp-lost: distance between <shared.world.pose-ee-base> and <shared.world.pose-cube-base> greater than <shared.spec.lost-dist>
    }
}

guarded-motion (ns=app) place {
    description: "Lower TCP with cube straight down to the place height"

    context {
        spec {
            length place-x      = 0.40 m,
            length place-y      = 0.24 m,
            length place-z      = 0.03 m,
            length place-y-gate = 0.20 m,
            length support-lift = 0.06 m,
            length support-z    = snapshot of <shared.world.pose-elbow-base>.position.z + <spec.support-lift>,
            pose goal-pose-place = {
                position: (<spec.place-x>, <spec.place-y>, <spec.place-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            }
        }
    }

    when {
        at-pre-place: <shared.world.pose-ee-base>.position.y greater than <place.spec.place-y-gate>
    }

    while {
        reach-x:       keeping <shared.world.pose-ee-base>.position.x         equal to <spec.place-x> within <shared.spec.satisfied-band>,
        reach-y:       keeping <shared.world.pose-ee-base>.position.y         equal to <spec.place-y> within <shared.spec.satisfied-band>,
        reach-z:       keeping <shared.world.pose-ee-base>.position.z         equal to <spec.place-z> within <shared.spec.satisfied-band>,
        align-ori:     keeping <shared.world.pose-ee-base>.orientation        equal to <spec.goal-pose-place>.orientation within <shared.spec.satisfied-band-rot>,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z   equal to <spec.support-z> within <shared.spec.satisfied-band>,
        close-gripper: keeping <shared.world.gripper-pos>                 equal to <shared.spec.gripper-closed> within <shared.spec.satisfied-band-rot>
    }

    until {
        grasp-lost: distance between <shared.world.pose-ee-base> and <shared.world.pose-cube-base> greater than <shared.spec.lost-dist>
    }
}

guarded-motion (ns=app) open-grasp-hold {
    description: "Hold TCP at place pose while the gripper opens"

    context {
        spec {
            length support-lift = 0.06 m,
            length support-z    = snapshot of <shared.world.pose-elbow-base>.position.z + <spec.support-lift>,
            pose hold-orientation-pose   = snapshot of <shared.world.pose-ee-base>,
            length release-z    = 0.04 m
        }
    }

    when {
        at-place: <shared.world.pose-ee-base>.position.z equal to <open-grasp-hold.spec.release-z> within <shared.spec.satisfied-band>
    }

    while {
        hold-x:          keeping <shared.world.pose-ee-base>.position.x equal to <spec.hold-orientation-pose>.position.x within <shared.spec.satisfied-band>,
        hold-y:          keeping <shared.world.pose-ee-base>.position.y equal to <spec.hold-orientation-pose>.position.y within <shared.spec.satisfied-band>,
        hold-z:          keeping <shared.world.pose-ee-base>.position.z equal to <spec.hold-orientation-pose>.position.z within <shared.spec.satisfied-band>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.hold-orientation-pose>.orientation within <shared.spec.satisfied-band-rot>,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z equal to <spec.support-z> within <shared.spec.satisfied-band>,
        open-gripper:    keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>
    }

    until {}
}

guarded-motion (ns=app) retreat {
    description: "Move TCP straight up to the pre-grasp height above the place location"

    context {
        spec {
            length place-x       = 0.40 m,
            length place-y       = 0.24 m,
            length place-above-z = 0.22 m,
            length retreat-z-lo  = 0.20 m,
            length retreat-z-hi  = 0.24 m,
            length support-lift  = 0.06 m,
            length support-z     = snapshot of <shared.world.pose-elbow-base>.position.z + <spec.support-lift>,
            pose goal-pose-retreat = {
                position: (<spec.place-x>, <spec.place-y>, <spec.place-above-z>) m,
                orientation: euler { axes: xyz extrinsic, angles: (<shared.spec.grasp-rot-x>, <shared.spec.grasp-rot-y>, <shared.spec.grasp-rot-z>) }
            }
        }
    }

    when {
        released: <shared.world.gripper-pos> equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>
    }

    while {
        reach-x:       keeping <shared.world.pose-ee-base>.position.x         equal to <spec.place-x> within <shared.spec.satisfied-band>,
        reach-y:       keeping <shared.world.pose-ee-base>.position.y         equal to <spec.place-y> within <shared.spec.satisfied-band>,
        reach-z:       keeping <shared.world.pose-ee-base>.position.z         equal to <spec.place-above-z> within <shared.spec.satisfied-band>,
        align-ori:     keeping <shared.world.pose-ee-base>.orientation        equal to <spec.goal-pose-retreat>.orientation within <shared.spec.satisfied-band-rot>,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z   equal to <spec.support-z> within <shared.spec.satisfied-band>,
        open-gripper:  keeping <shared.world.gripper-pos>                 equal to <shared.spec.gripper-open> within <shared.spec.satisfied-band-rot>
    }

    until all {
        at-retreat-settled: <shared.world.pose-ee-base>.position.z between <spec.retreat-z-lo> and <spec.retreat-z-hi>
    }
}

guarded-motion (ns=app) recover {
    description: "Fallback recovery: capture the current pose on entry and hold it"

    context {
        spec {
            length support-lift = 0.06 m,
            length support-z    = snapshot of <shared.world.pose-elbow-base>.position.z + <spec.support-lift>,
            pose hold-orientation-pose   = snapshot of <shared.world.pose-ee-base>
        }
    }

    when {}

    while {
        hold-x:           keeping <shared.world.pose-ee-base>.position.x equal to <spec.hold-orientation-pose>.position.x within <shared.spec.satisfied-band>,
        hold-y:           keeping <shared.world.pose-ee-base>.position.y equal to <spec.hold-orientation-pose>.position.y within <shared.spec.satisfied-band>,
        hold-z:           keeping <shared.world.pose-ee-base>.position.z equal to <spec.hold-orientation-pose>.position.z within <shared.spec.satisfied-band>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.hold-orientation-pose>.orientation within <shared.spec.satisfied-band-rot>,
        support-elbow-z:  keeping <shared.world.pose-elbow-base>.position.z equal to <spec.support-z> within <shared.spec.satisfied-band>
    }

    until {}
}

// ------------------ constraint handlers ------------------

constraint-handler (ns=app) handler-home {
    handles: <home>
    controllers {
        pid ctrl-hold-position    { constraint: <home.hold-position>,    Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-hold-orientation { constraint: <home.hold-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 }
    }

    solvers {
        arm-solver: serial-chain {
            agent:     <pickplace_agents.arm1>,
            algorithm: achd,
            gravity:   (0.0, 0.0, 9.81) m/s^2
        }
    }
}

constraint-handler (ns=app) handler-pick-above {
    handles: <pick-above>
    monitors {
        mon-pick-above-ready: monitor <pick-above.gripper-ready> {
            satisfied { trigger: event <pp.E_PICK_ABOVE_READY> },
            violated { hold: <home> },
        },
        mon-pa-advancing: monitor <pick-above.advance> {
            satisfied { flag: pa-advancing },
        }
    }

    controllers {
        pid ctrl-pa-follow-tan { constraint: <pick-above.follow-tan>, Kp: 20,  Ki: 4,   Kd: 0,  decay: 0 },
        pid ctrl-pa-follow-lat { constraint: <pick-above.follow-lat>, measured-derivative: <shared.world.twist-ee-base>.linvel, Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-pa-follow-ori { constraint: <pick-above.follow-ori>, measured-derivative: <shared.world.twist-ee-base>.angvel, Kp: 120, Ki: 50,  Kd: 80, decay: 0 }
    }

    solvers {
        <handler-home.arm-solver>
    }
}

constraint-handler (ns=app) handler-pick {
    handles: <pick>
    monitors {
        mon-pick-ready: monitor <pick.aligned-above> {
            satisfied { trigger: event <pp.E_PICK_READY> },
            violated { hold: <pick-above> },
        }
    }

    controllers {
        pid ctrl-pk-hold-x     { constraint: <pick.hold-x>,     Kp: 200, Ki: 20, Kd: 40, decay: 0 },
        pid ctrl-pk-hold-y     { constraint: <pick.hold-y>,     Kp: 200, Ki: 30, Kd: 40, decay: 0 },
        pid ctrl-pk-lower-z    { constraint: <pick.lower-z>,    Kp: 12, Ki: 5,  Kd: 15, decay: 0 },
        pid ctrl-pk-follow-ori { constraint: <pick.follow-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 },
        impedance ctrl-pk-support-z { constraint: <pick.support-elbow-z>, stiffness: 800, damping: 80 }
            apply at <kinova.half_arm_2_link>
    }

    solvers {
        <handler-home.arm-solver>
    }
}

constraint-handler (ns=app) handler-close-grip {
    handles: <grasp-hold>
    monitors {
        mon-grasp-ready: monitor <grasp-hold.near-cube> {
            satisfied { trigger: event <pp.E_GRASP_READY> },
            violated { hold: <pick> },
        }
    }

    controllers {
        pid ctrl-cg-hold-x      { constraint: <grasp-hold.hold-x>,      Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-cg-hold-y      { constraint: <grasp-hold.hold-y>,      Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-cg-hold-z      { constraint: <grasp-hold.hold-z>,      Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-cg-hold-orientation { constraint: <grasp-hold.hold-orientation>, Kp: 120, Ki: 50, Kd: 80, decay: 0 },
        impedance ctrl-cg-support-z  { constraint: <grasp-hold.support-elbow-z>, stiffness: 800, damping: 80 }
            apply at <kinova.half_arm_2_link>,
        feed-forward ctrl-cg-close-gripper { constraint: <grasp-hold.close-gripper> }
    }

    solvers {
        <handler-home.arm-solver>,
        gripper-command-solver: command-forwarding {
            agent: <pickplace_agents.gripper1>
        }
    }
}

constraint-handler (ns=app) handler-lift {
    handles: <lift>
    monitors {
        mon-lift-ready: monitor <lift.grasped> {
            satisfied { trigger: event <pp.E_LIFT_READY> },
            violated { hold: <grasp-hold> },
        },
        mon-lift-grasp-lost: monitor <lift.until> {
            satisfied { trigger: event <pp.E_GRASP_LOST_LIFT> },
        }
    }

    controllers {
        pid ctrl-lt-hold-x     { constraint: <lift.hold-x>,     Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-lt-hold-y     { constraint: <lift.hold-y>,     Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-lt-lift-z     { constraint: <lift.lift-z>,     Kp: 15, Ki: 5,  Kd: 20, decay: 0 },
        pid ctrl-lt-follow-ori { constraint: <lift.follow-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 },
        impedance ctrl-lt-support-z { constraint: <lift.support-elbow-z>, stiffness: 800, damping: 80 }
            apply at <kinova.half_arm_2_link>,
        feed-forward ctrl-lt-close-gripper { constraint: <lift.close-gripper> }
    }

    solvers {
        <handler-home.arm-solver>,
        <handler-close-grip.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-place-above {
    handles: <place-above>
    monitors {
        mon-place-above-ready: monitor <place-above.lifted> {
            satisfied { trigger: event <pp.E_PLACE_ABOVE_READY> },
            violated { hold: <lift> },
        },
        mon-place-above-grasp-lost: monitor <place-above.until> {
            satisfied { trigger: event <pp.E_GRASP_LOST_PLACE_ABOVE> },
        }
    }

    controllers {
        pid ctrl-pla-reach-x   { constraint: <place-above.reach-x>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 },
        pid ctrl-pla-reach-y   { constraint: <place-above.reach-y>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 },
        pid ctrl-pla-reach-z   { constraint: <place-above.reach-z>,   Kp: 180, Ki: 40, Kd: 60, decay: 0 },
        pid ctrl-pla-align-ori { constraint: <place-above.align-ori>, Kp: 120, Ki: 50, Kd: 80, decay: 0 },
        impedance ctrl-pla-support-z { constraint: <place-above.support-elbow-z>, stiffness: 800, damping: 80 }
            apply at <kinova.half_arm_2_link>,
        feed-forward ctrl-pla-close-gripper { constraint: <place-above.close-gripper> }
    }

    solvers {
        <handler-home.arm-solver>,
        <handler-close-grip.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-place {
    handles: <place>
    monitors {
        mon-place-ready: monitor <place.at-pre-place> {
            satisfied { trigger: event <pp.E_PLACE_READY> },
            violated { hold: <place-above> },
        },
        mon-place-grasp-lost: monitor <place.until> {
            satisfied { trigger: event <pp.E_GRASP_LOST_PLACE> },
        }
    }

    controllers {
        pid ctrl-pl-reach-x   { constraint: <place.reach-x>,   Kp: 140, Ki: 20, Kd: 55, decay: 0 },
        pid ctrl-pl-reach-y   { constraint: <place.reach-y>,   Kp: 140, Ki: 20, Kd: 55, decay: 0 },
        pid ctrl-pl-reach-z   { constraint: <place.reach-z>,   Kp: 60,  Ki: 15, Kd: 55, decay: 0 },
        pid ctrl-pl-align-ori { constraint: <place.align-ori>, Kp: 180, Ki: 30, Kd: 120, decay: 0 },
        impedance ctrl-pl-support-z { constraint: <place.support-elbow-z>, stiffness: 800, damping: 160 }
            apply at <kinova.half_arm_2_link>,
        feed-forward ctrl-pl-close-gripper { constraint: <place.close-gripper> }
    }

    solvers {
        <handler-home.arm-solver>,
        <handler-close-grip.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-open-grip {
    handles: <open-grasp-hold>
    monitors {
        mon-open-ready: monitor <open-grasp-hold.at-place> {
            satisfied { trigger: event <pp.E_OPEN_READY> },
            violated { hold: <place> },
        }
    }

    controllers {
        pid ctrl-og-hold-x      { constraint: <open-grasp-hold.hold-x>, Kp: 140, Ki: 20, Kd: 55, decay: 0 },
        pid ctrl-og-hold-y      { constraint: <open-grasp-hold.hold-y>, Kp: 140, Ki: 20, Kd: 55, decay: 0 },
        pid ctrl-og-hold-z      { constraint: <open-grasp-hold.hold-z>, Kp: 140, Ki: 20, Kd: 55, decay: 0 },
        pid ctrl-og-hold-orientation { constraint: <open-grasp-hold.hold-orientation>, Kp: 180, Ki: 30, Kd: 120, decay: 0 },
        impedance ctrl-og-support-z  { constraint: <open-grasp-hold.support-elbow-z>, stiffness: 800, damping: 160 }
            apply at <kinova.half_arm_2_link>,
        feed-forward ctrl-og-open-gripper { constraint: <open-grasp-hold.open-gripper> }
    }

    solvers {
        <handler-home.arm-solver>,
        <handler-close-grip.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-retreat {
    handles: <retreat>
    monitors {
        mon-retreat-ready: monitor <retreat.released> {
            satisfied { trigger: event <pp.E_RETREAT_READY> },
            violated { hold: <open-grasp-hold> },
        },
        mon-retreat-settled: monitor <retreat.until> {
            satisfied { trigger: event <pp.E_RETREAT_SETTLED> },
        }
    }

    controllers {
        pid ctrl-ret-reach-x   { constraint: <retreat.reach-x>,   Kp: 140, Ki: 20, Kd: 55, decay: 0 },
        pid ctrl-ret-reach-y   { constraint: <retreat.reach-y>,   Kp: 140, Ki: 20, Kd: 55, decay: 0 },
        pid ctrl-ret-reach-z   { constraint: <retreat.reach-z>,   Kp: 60,  Ki: 15, Kd: 55, decay: 0 },
        pid ctrl-ret-align-ori { constraint: <retreat.align-ori>, Kp: 180, Ki: 30, Kd: 120, decay: 0 },
        impedance ctrl-ret-support-z { constraint: <retreat.support-elbow-z>, stiffness: 800, damping: 160 }
            apply at <kinova.half_arm_2_link>,
        feed-forward ctrl-ret-open-gripper { constraint: <retreat.open-gripper> }
    }

    solvers {
        <handler-home.arm-solver>,
        <handler-close-grip.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-recover {
    handles: <recover>
    monitors {
        mon-recover-hold: monitor <recover.hold-x> {
            satisfied for 0.1 s { trigger: event <pp.E_RECOVER> },
        }
    }

    controllers {
        pid ctrl-rc-hold-x           { constraint: <recover.hold-x>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-rc-hold-y           { constraint: <recover.hold-y>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-rc-hold-z           { constraint: <recover.hold-z>,           Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-rc-hold-orientation { constraint: <recover.hold-orientation>, Kp: 120, Ki: 50,  Kd: 80, decay: 0 },
        impedance ctrl-rc-support-z  { constraint: <recover.support-elbow-z>, stiffness: 800, damping: 160 }
            apply at <kinova.half_arm_2_link>
    }

    solvers {
        <handler-home.arm-solver>
    }
}
