import "look_cartesian_test.fsm"
import "../admittance_arc_single/admittance_arc_single.scenex"
ns app = "https://secorolab.github.io/models/look-cartesian-test/"
ns lct = "https://secorolab.github.io/models/look-cartesian-test/fsm/"

exec-context (ns=app) look-cartesian-test-exec {
    runs-scene: <admittance_arc_scene_mjc>
    platform: simulation { name: "MuJoCo" }
    config: "robot.toml"
    timestep: 1.0 ms
}

context (ns=app) shared {
    world {
        pose tcp {
            of: <gripper.g_base.g_pinch>,
            wrt: <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        velocity-twist tcp-twist {
            of: <gripper.g_base.g_pinch>,
            wrt: <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        pose elbow-base {
            of: <kinova.forearm_link.forearm_link_origin>,
            wrt: <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        joint-position elbow-angle {
            joint: <kinova.joint_3>,
            normalization: (-pi, pi) rad
        }
    },
    spec {
        pose home-pose = snapshot of <shared.world.tcp> on event <lct.E_HOME_ENTERED>,
        pose look-pose = [config.poses.look] for <shared.world.tcp>,
        angle orientation-band = 0.15 rad,
        linear-velocity zero-linear = 0.0 m/s,
        linear-velocity velocity-band = 0.005 m/s,
        angular-velocity zero-angular = 0.0 rad/s,
        angular-velocity angular-velocity-band = 0.01 rad/s,
        torque arm-torque-limit = 35.0 Nm,
        // The seventh degree of freedom, pinned in joint space so the elbow stays in its plane.
        angle elbow-angle-target = pi rad,
        torque elbow-torque-limit = 10.0 Nm
    }
}

tolerances {
    position: 0.05 m,
    orientation: 0.05 rad,
    linear-velocity: 0.005 m/s
}

guarded-motion (ns=app) home {
    description: "Hold the reset pose until the arm settles"
    context {}
    when {}
    while {
        hold-position: keeping <shared.world.tcp>.position equal to <shared.spec.home-pose>.position,
        hold-orientation: keeping <shared.world.tcp>.orientation equal to <shared.spec.home-pose>.orientation,
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>
    }
    until all {
        settled-x: <shared.world.tcp-twist>.linvel.x equal to <shared.spec.zero-linear> within <shared.spec.velocity-band>,
        settled-y: <shared.world.tcp-twist>.linvel.y equal to <shared.spec.zero-linear> within <shared.spec.velocity-band>,
        settled-z: <shared.world.tcp-twist>.linvel.z equal to <shared.spec.zero-linear> within <shared.spec.velocity-band>,
        settled-rx: <shared.world.tcp-twist>.angvel.x equal to <shared.spec.zero-angular> within <shared.spec.angular-velocity-band>,
        settled-ry: <shared.world.tcp-twist>.angvel.y equal to <shared.spec.zero-angular> within <shared.spec.angular-velocity-band>,
        settled-rz: <shared.world.tcp-twist>.angvel.z equal to <shared.spec.zero-angular> within <shared.spec.angular-velocity-band>
    }
}

guarded-motion (ns=app) look {
    description: "Follow the TCP arc corresponding to a 120 degree joint-1 rotation"
    context {
        <shared.spec>,
        spec {
            pose start = snapshot of <shared.world.tcp> on event <lct.E_LOOK_ENTERED>,
            velocity-profile speed-profile = profile {
                max-velocity: 0.05 m/s,
                max-acceleration: 0.01 m/s^2,
                shape: trapezoidal
            },
            length position-band = 0.005 m,
            direction plane-normal { as-seen-by: <kinova.base_link.base_link_origin> } = (0.0, 0.0, 1.0),
            distance arc-height = 0.336836 m,
            path trajectory = arc {
                start: <spec.start>,
                end: <shared.spec.look-pose>,
                amplitude: <spec.arc-height>,
                plane-normal: <spec.plane-normal>
            }
        }
    }
    when {}
    while {
        tangent: moving <shared.world.tcp> along <spec.trajectory> with <spec.speed-profile>,
        position: keeping <shared.world.tcp>.position on <spec.trajectory>,
        orientation: keeping <shared.world.tcp>.orientation on <spec.trajectory>,
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>
    }
    until all {
        tcp-position: <shared.world.tcp>.position equal to <shared.spec.look-pose>.position within <spec.position-band>,
        tcp-orientation: <shared.world.tcp>.orientation equal to <shared.spec.look-pose>.orientation within <shared.spec.orientation-band>,
        stopped-x: <shared.world.tcp-twist>.linvel.x equal to <shared.spec.zero-linear> within <shared.spec.velocity-band>,
        stopped-y: <shared.world.tcp-twist>.linvel.y equal to <shared.spec.zero-linear> within <shared.spec.velocity-band>,
        stopped-z: <shared.world.tcp-twist>.linvel.z equal to <shared.spec.zero-linear> within <shared.spec.velocity-band>,
        stopped-rx: <shared.world.tcp-twist>.angvel.x equal to <shared.spec.zero-angular> within <shared.spec.angular-velocity-band>,
        stopped-ry: <shared.world.tcp-twist>.angvel.y equal to <shared.spec.zero-angular> within <shared.spec.angular-velocity-band>,
        stopped-rz: <shared.world.tcp-twist>.angvel.z equal to <shared.spec.zero-angular> within <shared.spec.angular-velocity-band>
    }
}

guarded-motion (ns=app) hold {
    description: "Hold the configured look pose for five seconds"
    context {}
    when {}
    while {
        position: keeping <shared.world.tcp>.position equal to <shared.spec.look-pose>.position,
        orientation: keeping <shared.world.tcp>.orientation equal to <shared.spec.look-pose>.orientation,
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>
    }
    until {
        timeout: elapsed greater than 5.0 s
    }
}

constraint-handler (ns=app) handler-home {
    handles: <home>
    runs-in: <lct.S_HOME>
    monitors {
        mon-settled: monitor <home.until> {
            satisfied for 0.3 s { trigger: event <lct.E_HOME_SETTLED> }
        }
    }
    controllers {
        pid home-position { constraint: <home.hold-position>, Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid home-orientation { constraint: <home.hold-orientation>, Kp: 120, Ki: 50, Kd: 80, decay: 0 },
        pid home-elbow {
            constraint: <home.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque
    }
    solvers {
        arm: serial-chain {
            agent: <agents.kinova_ft_2f85>,
            algorithm: achd,
            limits { torque: saturation { max: <shared.spec.arm-torque-limit> } },
            gravity: (0.0, 0.0, 9.81) m/s^2
        }
    }
}

constraint-handler (ns=app) handler-look {
    handles: <look>
    runs-in: <lct.S_LOOK>
    monitors {
        mon-done: monitor <look.until> {
            satisfied for 0.3 s { trigger: event <lct.E_LOOK_DONE> }
        }
    }
    controllers {
        pid look-tangent { constraint: <look.tangent>, Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        pid look-position { constraint: <look.position>, measured-derivative: <shared.world.tcp-twist>.linvel, Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid look-orientation { constraint: <look.orientation>, measured-derivative: <shared.world.tcp-twist>.angvel, Kp: 120, Ki: 50, Kd: 80, decay: 0 },
        pid look-elbow {
            constraint: <look.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque
    }
    solvers {
        arm: serial-chain {
            agent: <agents.kinova_ft_2f85>,
            algorithm: achd,
            limits { torque: saturation { max: <shared.spec.arm-torque-limit> } },
            gravity: (0.0, 0.0, 9.81) m/s^2
        }
    }
}

constraint-handler (ns=app) handler-hold {
    handles: <hold>
    runs-in: <lct.S_HOLD>
    monitors {
        mon-timeout: monitor <hold.until> {
            satisfied { trigger: event <lct.E_HOLD_DONE> }
        }
    }
    controllers {
        pid hold-position { constraint: <hold.position>, measured-derivative: <shared.world.tcp-twist>.linvel, Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid hold-orientation { constraint: <hold.orientation>, measured-derivative: <shared.world.tcp-twist>.angvel, Kp: 120, Ki: 50, Kd: 80, decay: 0 },
        pid hold-elbow {
            constraint: <hold.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque
    }
    solvers { <handler-look.arm> }
}
