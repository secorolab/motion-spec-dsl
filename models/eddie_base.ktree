// Eddie's KELO-drive mobile base.
//
// Transcribed from eddie_description: urdf/eddie_base.macro.xacro, urdf/kelo_drive_unit.macro.xacro
// and urdf/kelo_hub_wheel.macro.xacro. Link names, transforms and inertias are those files' values,
// in their own units (URDF rpy is extrinsic xyz in radians).
//
// Conventions, as in kinova_gen3_7dof.ktree:
//   <body>_origin   the body frame; carries no pose when a joint places it
//   <body>_com      the inertial frame, so the inertia matrix stays diagonal
//   <joint>_anchor  anchors a joint on its *parent* body -- a revolute joint is the
//                   collinearity of two z axes, coincident at q=0
//
// Each of the four drive units is a castor: the pivot is unactuated and steers by differential
// wheel torque, so no joint here carries an actuation block (the xacro states no gear ratio).
// The base is a branching tree, not a serial chain, so it declares no joint composition.
ktree eddie_base_tree {
    body base_footprint {
        frame base_footprint_origin { }
        frame base_link_joint_anchor {
            pose base_link_joint_anchor_in_base_footprint {
                wrt: <base_footprint.base_footprint_origin>
                xyz: (0.0, 0.0, 0.2164) m
                orientation: euler { axes: xyz extrinsic angles: (0.0, 0.0, 0.0) unit: rad }
            }
        }
    }
    body base_link {
        frame base_link_origin { }
        frame base_link_com {
            pose base_link_com_in_base_link {
                wrt: <base_link.base_link_origin>
                xyz: (0.0, 0.0, 0.0833) m
                orientation: euler { axes: xyz extrinsic angles: (0.0, 0.0, 0.0) unit: rad }
            }
        }
        frame front_left_drive_attachment_joint_anchor {
            pose front_left_drive_attachment_joint_anchor_in_base_link {
                wrt: <base_link.base_link_origin>
                xyz: (0.2078, 0.188, -0.0632) m
                orientation: euler { axes: xyz extrinsic angles: (0.0, 0.0, 1.5708) unit: rad }
            }
        }
        frame rear_left_drive_attachment_joint_anchor {
            pose rear_left_drive_attachment_joint_anchor_in_base_link {
                wrt: <base_link.base_link_origin>
                xyz: (-0.2078, 0.188, -0.0632) m
                orientation: euler { axes: xyz extrinsic angles: (0.0, 0.0, 1.5708) unit: rad }
            }
        }
        frame rear_right_drive_attachment_joint_anchor {
            pose rear_right_drive_attachment_joint_anchor_in_base_link {
                wrt: <base_link.base_link_origin>
                xyz: (-0.2078, -0.188, -0.0632) m
                orientation: euler { axes: xyz extrinsic angles: (0.0, 0.0, -1.5708) unit: rad }
            }
        }
        frame front_right_drive_attachment_joint_anchor {
            pose front_right_drive_attachment_joint_anchor_in_base_link {
                wrt: <base_link.base_link_origin>
                xyz: (0.2078, -0.188, -0.0632) m
                orientation: euler { axes: xyz extrinsic angles: (0.0, 0.0, -1.5708) unit: rad }
            }
        }
        inertia {
            frame: <base_link_com>
            mass: 76.4377 kg
            inertia-matrix: (
                (4.128795216, 0.0, 0.0),
                (0.0, 4.117596854, 0.0),
                (0.0, 0.0, 3.364397364)
            ) kg*m^2
        }
    }
    body front_left_drive_attachment_link {
        frame front_left_drive_attachment_link_origin { }
        frame front_left_drive_pivot_joint_anchor {
            pose front_left_drive_pivot_joint_anchor_in_front_left_drive_attachment_link {
                wrt: <front_left_drive_attachment_link.front_left_drive_attachment_link_origin>
                xyz: (-0.01, -0.0006, -0.0641) m
                orientation: euler { axes: xyz extrinsic angles: (0.0, 0.0, 1.5708) unit: rad }
            }
        }
        inertia {
