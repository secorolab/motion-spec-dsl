        }
        revolute front_right_drive_pivot_joint {
            parent: <front_right_drive_attachment_link.front_right_drive_pivot_joint_anchor>.z
            child: <front_right_drive_struct_link.front_right_drive_struct_link_origin>.z
            polarity: PositivePolarity
        }
        revolute front_right_drive_r_wheel_joint {
            parent: <front_right_drive_struct_link.front_right_drive_r_wheel_joint_anchor>.z
            child: <front_right_drive_r_wheel_link.front_right_drive_r_wheel_link_origin>.z
            polarity: PositivePolarity
        }
        revolute front_right_drive_l_wheel_joint {
            parent: <front_right_drive_struct_link.front_right_drive_l_wheel_joint_anchor>.z
            child: <front_right_drive_l_wheel_link.front_right_drive_l_wheel_link_origin>.z
            polarity: PositivePolarity
        }
    }
}
