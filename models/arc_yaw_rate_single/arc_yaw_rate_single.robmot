import "arc_yaw_rate_single.fsm"
import "arc_yaw_rate_single.scenex"
ns app = "https://secorolab.github.io/models/arc-yaw-rate-single/"
ns ayr = "https://secorolab.github.io/models/arc-yaw-rate-single/fsm/"

exec-context (ns=app) arc-yaw-exec {
    runs-scene: <arc_yaw_rate_scene_mjc>
    platform:   simulation { name: "MuJoCo" }
    config:     "robot.toml"
    timestep:   1.0 ms
}

context (ns=app) shared {
    world {
        pose pose-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        velocity-twist twist-ee-base {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        // Six constraints on the tool leave the seventh joint free, and that self-motion
        // drifts the elbow until the wrist runs out of room halfway through the sweep. A
        // yaw about the base keeps the elbow at one height, so holding it costs the task
        // nothing and pins the arm's posture.
        pose pose-elbow-base {
            of:         <kinova.forearm_link.forearm_link_origin>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        }
    },
    spec {
        linear-distance satisfied-band     = 0.01 m,
        angle satisfied-band-rot           = 0.01 rad,
        linear-velocity satisfied-band-vel = 0.01 m/s,
        linear-velocity zero-linvel        = 0.0 m/s,
        // Half-width of the box the sweep has to end in. A band, not an equality: the last
        // millimetres of a metre-long arc bleed off slowly and a tight gate stalls there.
        linear-distance reach-band         = 0.03 m,
        linear-distance neg-reach-band     = -0.03 m,
        // The sweep is one rigid turn about the base axis, so the tool's yaw rate is the
        // arc speed over the radius it turns at: 0.05 / 0.677474. Negative because joint 1
        // at +90 deg yaws the tool a quarter turn clockwise seen from above.
        angular-velocity yaw-rate           = -0.0738 rad/s,
        angular-velocity zero-angvel        = 0.0 rad/s,
        angular-velocity satisfied-band-ang-vel = 0.01 rad/s,
        // Captured once, on the first tick: where the arm rests after the reset. The hold
        // targets it and the sweep starts from it, so the millimetre the tool sags while
        // holding cannot walk the arc's start away from the pose the hold was aiming at.
        pose start-pose         = snapshot of <shared.world.pose-ee-base>,
        linear-distance elbow-z = snapshot of <shared.world.pose-elbow-base>.position.z
    }
}

tolerances {
    linear-distance:  0.01 m,
    angular-distance: 0.01 rad,
    linear-velocity:  0.01 m/s,
    position:         0.01 m,
    orientation:      0.01 rad
}

guarded-motion (ns=app) home {
    description: "Hold the pose the arm resets to until it stops moving"

    context { }

    when {}

    while {
        hold-position:    keeping <shared.world.pose-ee-base>.position equal to <shared.spec.start-pose>.position within <shared.spec.satisfied-band>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <shared.spec.start-pose>.orientation within <shared.spec.satisfied-band-rot>
    }

    until all {
        settled-x: <shared.world.twist-ee-base>.linvel.x equal to <shared.spec.zero-linvel> within <shared.spec.satisfied-band-vel>,
        settled-y: <shared.world.twist-ee-base>.linvel.y equal to <shared.spec.zero-linvel> within <shared.spec.satisfied-band-vel>,
        settled-z: <shared.world.twist-ee-base>.linvel.z equal to <shared.spec.zero-linvel> within <shared.spec.satisfied-band-vel>
    }
}

guarded-motion (ns=app) arc-yaw {
    description: "Sweep the tool along an arc to the pose joint 1 reaches 90 degrees on"

    context {
        spec {
            linear-velocity arc-speed = 0.05 m/s,
            // Turning joint 1 sweeps the tool through a horizontal circle about the base
            // axis, so the arc plane is horizontal and the tool keeps its height.
            direction sweep-normal { as-seen-by: <kinova.base_link.base_link_origin> }
                = (0.0, 0.0, 1.0),
            // Sagitta of that quarter circle: r * (1 - cos 45deg) with r = 0.677474 m, the
            // radius the home configuration puts the tool at.
            linear-distance sweep-sagitta = 0.198428 m,
            // The tool at home with joint 1 at +90 deg. Joint 1 turns about the shoulder's
            // z, which the 180 deg mounting flips against the base z, so the arm yaws -90 deg
            // and the tool lands a quarter turn clockwise from where it starts.
            linear-distance target-x = 0.001346 m,
            linear-distance target-y = -0.677473 m,
            linear-distance target-z = 0.433728 m,
            pose target-pose = {
                position: (<spec.target-x>, <spec.target-y>, <spec.target-z>) m,
                orientation: <shared.spec.start-pose>.orientation rotated by euler { axes: xyz extrinsic, angles: (0.0, 0.0, -90.0) deg }
            },
            linear-distance target-x-lo = <spec.target-x> + <shared.spec.neg-reach-band>,
            linear-distance target-x-hi = <spec.target-x> + <shared.spec.reach-band>,
            linear-distance target-y-lo = <spec.target-y> + <shared.spec.neg-reach-band>,
            linear-distance target-y-hi = <spec.target-y> + <shared.spec.reach-band>,
            path sweep-path = arc {
                start:        <shared.spec.start-pose>,
                end:          <spec.target-pose>,
                amplitude:    <spec.sweep-sagitta>,
                plane-normal: <spec.sweep-normal>
            }
        }
    }

    when {}

    while {
        follow-tangent:     moving <shared.world.pose-ee-base> along <spec.sweep-path> at <spec.arc-speed>,
        follow-position:    keeping <shared.world.pose-ee-base>.position on <spec.sweep-path>,
        // Yaw commanded as a rate rather than tracked off the path's orientation. Roll and
        // pitch are held at zero rate, so the tool turns about the base axis and nothing else.
        yaw-rate:           keeping <shared.world.twist-ee-base>.angvel.z equal to <shared.spec.yaw-rate> within <shared.spec.satisfied-band-ang-vel>,
        hold-roll-rate:     keeping <shared.world.twist-ee-base>.angvel.x equal to <shared.spec.zero-angvel> within <shared.spec.satisfied-band-ang-vel>,
        hold-pitch-rate:    keeping <shared.world.twist-ee-base>.angvel.y equal to <shared.spec.zero-angvel> within <shared.spec.satisfied-band-ang-vel>,
        hold-elbow-z:       keeping <shared.world.pose-elbow-base>.position.z equal to <shared.spec.elbow-z> within <shared.spec.satisfied-band>
    }

    until all {
        at-target-x: <shared.world.pose-ee-base>.position.x between <spec.target-x-lo> and <spec.target-x-hi>,
        at-target-y: <shared.world.pose-ee-base>.position.y between <spec.target-y-lo> and <spec.target-y-hi>
    }
}

constraint-handler (ns=app) handler-home {
    handles: <home>
    monitors {
        mon-home-settled: monitor <home.until> {
            satisfied for 0.3 s { trigger: event <ayr.E_HOME_SETTLED> },
        }
    }
    controllers {
        pid ctrl-hold-position { constraint: <home.hold-position>, Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        pid ctrl-hold-orientation { constraint: <home.hold-orientation>, Kp: 120, Ki: 50, Kd: 80, decay: 0 }
    }
    solvers {
        arm-solver: serial-chain {
            agent: <agents.kinova_ft_2f85>,
            algorithm: rne,
            gravity: (0.0, 0.0, 9.81) m/s^2
        }
    }
}

constraint-handler (ns=app) handler-arc {
    handles: <arc-yaw>
    monitors {
        mon-arc-done: monitor <arc-yaw.until> {
            satisfied for 0.3 s { trigger: event <ayr.E_ARC_DONE> },
        }
    }
    controllers {
        pid ctrl-follow-tangent {
            constraint: <arc-yaw.follow-tangent>,
            Kp: 20,
            Ki: 4,
            Kd: 0,
            decay: 0
        },
        pid ctrl-follow-position {
            constraint: <arc-yaw.follow-position>,
            measured-derivative: <shared.world.twist-ee-base>.linvel,
            Kp: 200,
            Ki: 0,
            Kd: 40,
            decay: 0
        },
        // A rate loop, like the tangent one: the error is already a velocity, so P and I
        // are all it takes and a D term would differentiate a measured rate twice.
        pid ctrl-yaw-rate { constraint: <arc-yaw.yaw-rate>, Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        pid ctrl-roll-rate { constraint: <arc-yaw.hold-roll-rate>, Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        pid ctrl-pitch-rate { constraint: <arc-yaw.hold-pitch-rate>, Kp: 20, Ki: 4, Kd: 0, decay: 0 },
        impedance ctrl-support-elbow {
            constraint: <arc-yaw.hold-elbow-z>,
            Ki: 200,
            stiffness: 2500,
            damping: 80
        } apply at <kinova.forearm_link>
    }
    solvers { <handler-home.arm-solver> }
}
