ns dps_env = "https://secorolab.github.io/models/environments/detect-pick-single/"
ns dps_agn = "https://secorolab.github.io/models/agents/detect-pick-single/"
ns dps_scene = "https://secorolab.github.io/models/scenes/detect-pick-single/"
ns dps_mjc = "https://secorolab.github.io/models/scenes/detect-pick-single-mjc/"

obj set (ns=dps_env) pickplace_objects {
    object cube
}

obj set (ns=dps_env) ws_objects {
    object table
}

ws set (ns=dps_env) pickplace_workspaces {
    workspace table_ws
}

agn set (ns=dps_agn) pickplace_agents {
    agent arm1,
    agent gripper1
}

comp (ns=dps_env) comp_table_pickplace of ws <pickplace_workspaces.table_ws> {
    obj <ws_objects.table>
}

scene (ns=dps_scene) pick_place_scene {
    obj set <pickplace_objects>
    ws comp <comp_table_pickplace>
    agn set <pickplace_agents>
}
