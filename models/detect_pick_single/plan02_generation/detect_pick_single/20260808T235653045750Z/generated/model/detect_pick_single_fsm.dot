  "https://secorolab.github.io/models/detect-pick-single/fsm/S_LIFT" -> "https://secorolab.github.io/models/detect-pick-single/fsm/S_RECOVER" [label="E_GRASP_LOST_LIFT"];
  "https://secorolab.github.io/models/detect-pick-single/fsm/S_GRASP" -> "https://secorolab.github.io/models/detect-pick-single/fsm/S_LIFT" [label="E_LIFT_READY"];
  "https://secorolab.github.io/models/detect-pick-single/fsm/S_PLACE" -> "https://secorolab.github.io/models/detect-pick-single/fsm/S_OPEN" [label="E_OPEN_READY"];
