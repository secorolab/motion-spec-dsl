  "https://secorolab.github.io/models/detect-pick-single/fsm/S_OPEN" [label="S_OPEN"];
  "https://secorolab.github.io/models/detect-pick-single/fsm/S_PICK" [label="S_PICK"];
  "https://secorolab.github.io/models/detect-pick-single/fsm/S_PICK_ABOVE" [label="S_PICK_ABOVE"];
  "https://secorolab.github.io/models/detect-pick-single/fsm/S_PLACE" [label="S_PLACE"];
  "https://secorolab.github.io/models/detect-pick-single/fsm/S_PLACE_ABOVE" [label="S_PLACE_ABOVE"];
  "https://secorolab.github.io/models/detect-pick-single/fsm/S_RECOVER" [label="S_RECOVER"];
  "https://secorolab.github.io/models/detect-pick-single/fsm/S_RETREAT" [label="S_RETREAT"];
  "https://secorolab.github.io/models/detect-pick-single/fsm/S_START" [label="S_START", fillcolor="#e8f0fe"];
  "https://secorolab.github.io/models/detect-pick-single/fsm/S_DETECT" -> "https://secorolab.github.io/models/detect-pick-single/fsm/S_PICK_ABOVE" [label="E_CUBE_DETECTED"];
  "https://secorolab.github.io/models/detect-pick-single/fsm/S_DETECT" -> "https://secorolab.github.io/models/detect-pick-single/fsm/S_DETECT" [label="E_DETECT_FAILED"];
  "https://secorolab.github.io/models/detect-pick-single/fsm/S_HOME" -> "https://secorolab.github.io/models/detect-pick-single/fsm/S_DETECT" [label="E_GOAL"];
