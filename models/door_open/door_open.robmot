// Opening a latched cupboard door: the same Borghesan-style vocabulary as drawer_open up to
// the grasp, then two increments a drawer does not have -- rotating the lever until the bolt
// clears the strike, and cracking the door on its hinge. Increment 1 of the pre-registered
// E-INC sequence: crack only (small swing, fixed tool orientation); orientation-following
// swing, re-latch handling and recovery are later increments.
import "door_open.fsm"
import "door_open.scenex"
ns app = "https://secorolab.github.io/models/door-open/"
ns dor = "https://secorolab.github.io/models/door-open/fsm/"

exec-context (ns=app) door-open-exec {
    runs-scene: <door_scene_mjc>
    platform:   simulation { name: "MuJoCo" }
    config:     "robot.toml"
    timestep:   1.0 ms
}

tolerances {
    position:    0.01 m,
    orientation: 0.05 rad
}

context (ns=app) shared {
    world {
        pose pose-grasp {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        // The lever's grip point while the door is closed: the projections are measured
        // against lines through it, so the pose has to be one the run already computes.
        pose pose-handle {
            of:         <door_graph.cupboard.lever_grip>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        joint-position gripper-pos {
            joint: <gripper.g_left_driver_joint>
        },
        // The spare 7th turn is pinned in joint space; see drawer_open for the rationale.
        joint-position elbow-angle {
            joint: <kinova.joint_3>,
            normalization: (-pi, pi) rad
        }
    },
    spec {
        // gn: the grasp normal, the tool's x -- the axis the pads close along.
        direction grasp-normal { as-seen-by: <gripper.g_base.g_pinch> } = (1, 0, 0),
        // ga: the grasping axis, the tool's z -- the direction it approaches along.
        direction approach-axis { as-seen-by: <gripper.g_base.g_pinch> } = (0, 0, 1),
        direction base-up { as-seen-by: <kinova.base_link.base_link_origin> } = (0, 0, 1),
        // Where the approach axis is driven TO: into the door face.
        direction drawer-inward { as-seen-by: <kinova.base_link.base_link_origin> } = (1, 0, 0),

        // The lever frame's axes in the base frame, constants while the door is closed:
        // x is the swing-out direction, z runs along the bar.
        direction handle-x-base { as-seen-by: <kinova.base_link.base_link_origin> } = (-1, 0, 0),
        direction handle-y-base { as-seen-by: <kinova.base_link.base_link_origin> } = (0, 0, -1),
        direction handle-z-base { as-seen-by: <kinova.base_link.base_link_origin> } = (0, -1, 0),

        line handle-hx { of: <door_graph.cupboard.lever_grip>, along: <shared.spec.handle-x-base> },
        line handle-hy { of: <door_graph.cupboard.lever_grip>, along: <shared.spec.handle-y-base> },
        line handle-hz { of: <door_graph.cupboard.lever_grip>, along: <shared.spec.handle-z-base> },

        length at-handle    = 0.0 m,
        // Fingertips reach 27 mm past the pinch frame; the bar stands 42 mm proud of the
        // door panel, so a 10 mm standoff leaves 5 mm of tip clearance with the bar mid-pad.
        length grasp-standoff = 0.01 m,
        length reach-band   = 0.01 m,
        length grasp-reach  = 0.02 m,
        // The staging point straight out from the bar.
        length pre-dist     = 0.08 m,
        length pre-band     = 0.01 m,
        // Grasp starts only centered; off-center pads cam the bar out (measured on drawer).
        length center-band  = 0.002 m,
        // Increment 1 cracks the door: ~13 deg of swing at the grip radius, small enough
        // that the bar's yaw stays within what capsule-on-pad tolerates.
        length crack-out    = 0.06 m,
        length crack-band   = 0.015 m,
        // The swing's lateral drift at 13 deg is ~9 mm: held softly, not fought.
        length swing-lateral-band = 0.04 m,

        angle aligned    = 1.5708 rad,
        angle align-band = 0.05 rad,
        angular-acceleration ori-acc-limit      = 50.0 rad/s^2,
        angular-acceleration ori-integral-limit = 10.0 rad/s^2,
        linear-acceleration pos-integral-limit = 0.5 m/s^2,
        // The press row holds a sustained force against the lever spring, so its integral
        // carries the working load and needs the headroom the free-air rows must not have.
        linear-acceleration press-integral-limit = 8.0 m/s^2,

        angle gripper-closed  = 0.8 rad,
        angle gripper-band    = 0.05 rad,
        angle gripper-preclose = 0.45 rad,
        // The driver settles here with the 18 mm bar between the fingers; air-close runs past.
        angle grip-on-bar-lo  = 0.2 rad,
        angle grip-on-bar-hi  = 0.72 rad,

        // Unlatch by pressing the bar down: at the 30 mm grip radius, 16 mm of descent is
        // ~30 deg of lever, and the bolt clears the strike at ~6 mm. A pure position drive --
        // flat pads torsion-slip around a capsule bar, so rolling the wrist does not turn
        // the lever, pressing does (tried and measured: the roll variant froze at 5 deg).
        length unlatch-press      = 0.016 m,
        length unlatch-press-band = 0.005 m,

        angle elbow-angle-target  = pi rad,
        torque elbow-torque-limit = 10.0 Nm
    }
}

// S.0 -- stage in front of the lever, jaws pre-closed.
guarded-motion (ns=app) pre-approach {
    description: "Bring the grasp frame to a staging point straight in front of the lever"

    context { }

    when {}

    while {
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-pre-x: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hx> equal to <shared.spec.pre-dist> within <shared.spec.reach-band>,
        at-handle-y: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hy> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hz> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        preclose-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-preclose> within <shared.spec.gripper-band>,

        at-pre: keeping distance between <shared.world.pose-grasp> and <shared.world.pose-handle> equal to <shared.spec.pre-dist> within <shared.spec.pre-band>
    }

    until {}
}

// S.1 -- slide onto the bar.
guarded-motion (ns=app) approach-handle {
    description: "Slide the grasp frame level onto the lever bar"

    context { }

    when {}

    while {
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-handle-x: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hx> equal to <shared.spec.grasp-standoff> within <shared.spec.reach-band>,
        at-handle-y: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hy> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hz> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        preclose-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-preclose> within <shared.spec.gripper-band>,

        reached: keeping distance between <shared.world.pose-grasp> and <shared.world.pose-handle> equal to <shared.spec.at-handle> within <shared.spec.grasp-reach>
    }

    // The grasp may only start centered, or the closing pads push the bar out.
    until all {
        centered-x: projection of <shared.world.pose-grasp> on <shared.spec.handle-hx> equal to <shared.spec.grasp-standoff> within <shared.spec.center-band>,
        centered-y: projection of <shared.world.pose-grasp> on <shared.spec.handle-hy> equal to <shared.spec.at-handle> within <shared.spec.center-band>,
        centered-z: projection of <shared.world.pose-grasp> on <shared.spec.handle-hz> equal to <shared.spec.at-handle> within <shared.spec.center-band>
    }
}

// S.2 -- close on the bar.
guarded-motion (ns=app) grasp-handle {
    description: "Hold the grasp frame on the lever while the fingers close on the bar"

    context { }

    when {}

    while {
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-handle-x: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hx> equal to <shared.spec.grasp-standoff> within <shared.spec.reach-band>,
        at-handle-y: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hy> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hz> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        close-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.gripper-band>
    }

    // The driver settles inside the band only with the bar between the fingers.
    until {
        grasped-on-bar: <shared.world.gripper-pos> between <shared.spec.grip-on-bar-lo> and <shared.spec.grip-on-bar-hi>
    }
}

// S.3 -- press the grasped bar down until the bolt clears the strike. Same six rows as the
// approach with one changed target: the vertical projection is driven to the pressed depth,
// and the grip point's small arc toward the pivot rides in the along-bar band.
guarded-motion (ns=app) unlatch {
    description: "Press the grasped lever down until the latch bolt clears the strike"

    context { }

    when {}

    while {
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-handle-x: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hx> equal to <shared.spec.grasp-standoff> within <shared.spec.grasp-reach>,
        press-down: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hy> equal to <shared.spec.unlatch-press> within <shared.spec.unlatch-press-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hz> equal to <shared.spec.at-handle> within <shared.spec.grasp-reach>,
        close-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.gripper-band>
    }

    until {}
}

// S.4 -- crack the door: draw the grip out along the swing direction, lever held down.
guarded-motion (ns=app) swing-open {
    description: "Crack the door open along its swing, lever held rotated"

    context { }

    when {}

    while {
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        swing-pull: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hx> equal to <shared.spec.crack-out> within <shared.spec.crack-band>,
        press-down: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hy> equal to <shared.spec.unlatch-press> within <shared.spec.swing-lateral-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hz> equal to <shared.spec.at-handle> within <shared.spec.swing-lateral-band>,
        close-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.gripper-band>
    }

    until {}
}

// ------------------ constraint handlers ------------------

constraint-handler (ns=app) handler-approach {
    handles: <approach-handle>
    runs-in: <dor.S_APPROACH>
    monitors {
        mon-reached: monitor <approach-handle.until> {
            satisfied for 0.3 s {
                trigger: event <dor.E_AT_HANDLE>
            },
        }
    }
    controllers {
        pid ctrl-a-elbow {
            constraint: <approach-handle.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        pid ctrl-normal-to-handle { constraint: <approach-handle.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-a-align { constraint: <approach-handle.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-at-handle-x { constraint: <approach-handle.at-handle-x>, Kp: 80, Ki: 0, Kd: 24, decay: 0 },
        pid ctrl-at-handle-y { constraint: <approach-handle.at-handle-y>, integral-saturation: saturation { max: <shared.spec.pos-integral-limit> }, Kp: 80, Ki: 80, Kd: 24, decay: 0 },
        pid ctrl-at-handle-z { constraint: <approach-handle.at-handle-z>, Kp: 80, Ki: 0, Kd: 24, decay: 0 },
        feed-forward ctrl-a-preclose { constraint: <approach-handle.preclose-gripper> }
    }
    solvers {
        arm-solver: serial-chain {
            agent:     <door_agents.arm1>,
            algorithm: achd,
            gravity:   (0.0, 0.0, 9.81) m/s^2
        },
        gripper-command-solver: command-forwarding {
            agent: <door_agents.gripper1>
        }
    }
}

constraint-handler (ns=app) handler-pre {
    handles: <pre-approach>
    runs-in: <dor.S_PREGRASP>
    monitors {
        mon-at-pre: monitor <pre-approach.at-pre> {
            satisfied for 0.5 s {
                trigger: event <dor.E_AT_PRE>
            },
        }
    }
    controllers {
        pid ctrl-pre-elbow {
            constraint: <pre-approach.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        pid ctrl-pre-normal { constraint: <pre-approach.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-pre-align { constraint: <pre-approach.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-pre-x { constraint: <pre-approach.at-pre-x>, Kp: 80, Ki: 10, Kd: 24, decay: 0 },
        pid ctrl-pre-y { constraint: <pre-approach.at-handle-y>, Kp: 80, Ki: 10, Kd: 24, decay: 0 },
        pid ctrl-pre-z { constraint: <pre-approach.at-handle-z>, Kp: 80, Ki: 10, Kd: 24, decay: 0 },
        feed-forward ctrl-pre-preclose { constraint: <pre-approach.preclose-gripper> }
    }
    solvers {
        <handler-approach.arm-solver>,
        <handler-approach.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-grasp {
    handles: <grasp-handle>
    runs-in: <dor.S_GRASP>
    monitors {
        mon-grasped: monitor <grasp-handle.until> {
            satisfied for 0.5 s {
                trigger: event <dor.E_GRASPED>
            },
        }
    }
    controllers {
        pid ctrl-g-elbow {
            constraint: <grasp-handle.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        pid ctrl-g-normal { constraint: <grasp-handle.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-g-align { constraint: <grasp-handle.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-g-x { constraint: <grasp-handle.at-handle-x>, Kp: 80, Ki: 10, Kd: 24, decay: 0 },
        pid ctrl-g-y { constraint: <grasp-handle.at-handle-y>, Kp: 80, Ki: 10, Kd: 24, decay: 0 },
        pid ctrl-g-z { constraint: <grasp-handle.at-handle-z>, Kp: 80, Ki: 10, Kd: 24, decay: 0 },
        feed-forward ctrl-g-close { constraint: <grasp-handle.close-gripper> }
    }
    solvers {
        <handler-approach.arm-solver>,
        <handler-approach.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-unlatch {
    handles: <unlatch>
    runs-in: <dor.S_UNLATCH>
    monitors {
        mon-unlatched: monitor <unlatch.press-down> {
            satisfied for 0.3 s {
                trigger: event <dor.E_UNLATCHED>
            },
        }
    }
    controllers {
        pid ctrl-u-elbow {
            constraint: <unlatch.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        pid ctrl-u-normal { constraint: <unlatch.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-u-align { constraint: <unlatch.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-u-x { constraint: <unlatch.at-handle-x>, Kp: 40, Ki: 0, Kd: 15, decay: 0 },
        pid ctrl-u-press { constraint: <unlatch.press-down>, integral-saturation: saturation { max: <shared.spec.press-integral-limit> }, Kp: 120, Ki: 60, Kd: 30, decay: 0 },
        pid ctrl-u-z { constraint: <unlatch.at-handle-z>, Kp: 40, Ki: 0, Kd: 15, decay: 0 },
        feed-forward ctrl-u-close { constraint: <unlatch.close-gripper> }
    }
    solvers {
        <handler-approach.arm-solver>,
        <handler-approach.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-swing {
    handles: <swing-open>
    runs-in: <dor.S_SWING>
    monitors {
        mon-swung: monitor <swing-open.swing-pull> {
            satisfied for 0.5 s {
                trigger: event <dor.E_OPENED>
            },
        }
    }
    controllers {
        pid ctrl-s-elbow {
            constraint: <swing-open.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        pid ctrl-s-normal { constraint: <swing-open.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-s-align { constraint: <swing-open.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-s-pull { constraint: <swing-open.swing-pull>, Kp: 100, Ki: 15, Kd: 30, decay: 0 },
        pid ctrl-s-press { constraint: <swing-open.press-down>, integral-saturation: saturation { max: <shared.spec.press-integral-limit> }, Kp: 80, Ki: 40, Kd: 24, decay: 0 },
        pid ctrl-s-z { constraint: <swing-open.at-handle-z>, Kp: 40, Ki: 0, Kd: 15, decay: 0 },
        feed-forward ctrl-s-close { constraint: <swing-open.close-gripper> }
    }
    solvers {
        <handler-approach.arm-solver>,
        <handler-approach.gripper-command-solver>
    }
}
