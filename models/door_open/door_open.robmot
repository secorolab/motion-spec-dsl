// Opening a latched cupboard door: the same Borghesan-style vocabulary as drawer_open up to
// the grasp, then two increments a drawer does not have -- rotating the lever until the bolt
// clears the strike, and cracking the door on its hinge. Increment 1 of the pre-registered
// E-INC sequence: crack only (small swing, fixed tool orientation); orientation-following
// swing, re-latch handling and recovery are later increments.
import "door_open.fsm"
import "door_open.scenex"
ns app = "https://secorolab.github.io/models/door-open/"
ns dor = "https://secorolab.github.io/models/door-open/fsm/"

exec-context (ns=app) door-open-exec {
    runs-scene: <door_scene_mjc>
    platform:   simulation { name: "MuJoCo" }
    config:     "robot.toml"
    timestep:   1.0 ms
}

tolerances {
    position:    0.01 m,
    orientation: 0.05 rad
}

context (ns=app) shared {
    world {
        pose pose-grasp {
            of:         <gripper.g_base.g_pinch>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        // The lever's grip point while the door is closed: the projections are measured
        // against lines through it, so the pose has to be one the run already computes.
        pose pose-handle {
            of:         <door_graph.cupboard.lever_grip>,
            wrt:        <kinova.base_link.base_link_origin>,
            as-seen-by: <kinova.base_link.base_link_origin>
        },
        joint-position gripper-pos {
            joint: <gripper.g_left_driver_joint>
        },
        // The spare 7th turn is pinned in joint space; see drawer_open for the rationale.
        joint-position elbow-angle {
            joint: <kinova.joint_3>,
            normalization: (-pi, pi) rad
        }
    },
    spec {
        // gn: the grasp normal, the tool's x -- the axis the pads close along.
        direction grasp-normal { as-seen-by: <gripper.g_base.g_pinch> } = (1, 0, 0),
        // ga: the grasping axis, the tool's z -- the direction it approaches along.
        direction approach-axis { as-seen-by: <gripper.g_base.g_pinch> } = (0, 0, 1),
        direction base-up { as-seen-by: <kinova.base_link.base_link_origin> } = (0, 0, 1),
        // Where the approach axis is driven TO: into the door face.
        direction drawer-inward { as-seen-by: <kinova.base_link.base_link_origin> } = (1, 0, 0),

        // The lever frame's axes in the base frame, constants while the door is closed:
        // x is the swing-out direction, z runs along the bar.
        direction handle-x-base { as-seen-by: <kinova.base_link.base_link_origin> } = (-1, 0, 0),
        direction handle-y-base { as-seen-by: <kinova.base_link.base_link_origin> } = (0, 0, -1),
        direction handle-z-base { as-seen-by: <kinova.base_link.base_link_origin> } = (0, -1, 0),

        line handle-hx { of: <door_graph.cupboard.lever_grip>, along: <shared.spec.handle-x-base> },
        line handle-hy { of: <door_graph.cupboard.lever_grip>, along: <shared.spec.handle-y-base> },
        line handle-hz { of: <door_graph.cupboard.lever_grip>, along: <shared.spec.handle-z-base> },

        // Where the grip stands after an early-swing slip: the damped hinge holds the door
        // near the crack angle (13 deg), whose grip point these constants place on the
        // static lever lines. Driving against the live door frame is rejected by the
        // toolchain (off-chain reference), so recovery is authored at this known pose.
        length regrip-out = 0.065 m,
        length regrip-lat = 0.018 m,

        length at-handle    = 0.0 m,
        // Fingertips reach 27 mm past the pinch frame; the bar stands 42 mm proud of the
        // door panel, so a 10 mm standoff leaves 5 mm of tip clearance with the bar mid-pad.
        length grasp-standoff = 0.01 m,
        length reach-band   = 0.01 m,
        length grasp-reach  = 0.02 m,
        // The staging point straight out from the bar.
        length pre-dist     = 0.08 m,
        length pre-band     = 0.01 m,
        // Grasp starts only centered; off-center pads cam the bar out (measured on drawer).
        length center-band  = 0.002 m,
        // Increment 1 cracks the door: ~13 deg of swing at the grip radius, small enough
        // that the bar's yaw stays within what capsule-on-pad tolerates.
        length crack-out    = 0.06 m,
        length crack-band   = 0.015 m,
        // The swing's lateral drift at 13 deg is ~9 mm: held softly, not fought.
        length swing-lateral-band = 0.04 m,

        // Increment 2 swings to full open. Hinge at cupboard-local (0.012, 0.170), grip at
        // (0.062, -0.08): radius 0.255 m. Targets are the grip's circle at 70 deg; the
        // door-open gate reads the lateral projection, which distinguishes angles where the
        // out projection has already flattened (60 deg = 0.168 m).
        length swing2-out = 0.202 m,
        length swing2-lat = 0.2115 m,
        length swing2-band = 0.03 m,
        length open-gate-lat = 0.168 m,
        // The tool yaws with the door so the pads stay square on the bar; commanded to the
        // 70 deg end target with the same loose follow band the unlatch roll uses.
        angle swing2-yaw = 1.2217 rad,

        angle aligned    = 1.5708 rad,
        angle align-band = 0.05 rad,
        angular-acceleration ori-acc-limit      = 50.0 rad/s^2,
        angular-acceleration ori-integral-limit = 10.0 rad/s^2,
        // In-contact states fight reaction torques at the pads: the free-space anti-slam cap
        // starves them (measured: 0.40 rad orientation sag under press), so they carry their
        // own authority.
        angular-acceleration contact-ori-acc-limit      = 200.0 rad/s^2,
        angular-acceleration contact-ori-integral-limit = 60.0 rad/s^2,
        linear-acceleration pos-integral-limit = 0.5 m/s^2,
        // The press row holds a sustained force against the lever spring, so its integral
        // carries the working load and needs the headroom the free-air rows must not have.
        linear-acceleration press-integral-limit = 8.0 m/s^2,

        angle gripper-closed  = 0.8 rad,
        angle gripper-open    = 0.0 rad,
        angle gripper-band    = 0.05 rad,
        // Increment 3: let go of the bar at full open and back just clear of it. The rest
        // keeps the swing's yaw: yawing square again at a compact radius transits the
        // wrist-fold region (diverged when tried), and a 4 cm back-off is already clear.
        length door-retreat-x = 0.50 m,
        // The rest is deliberately over-constrained (yawed wrist + elbow pin): its
        // equilibrium sits a few cm off the point targets, which is what a rest tolerates.
        length rest-band = 0.06 m,
        angle gripper-preclose = 0.45 rad,
        // The driver settles here with the 18 mm bar between the fingers; air-close runs past.
        angle grip-on-bar-lo  = 0.2 rad,
        angle grip-on-bar-hi  = 0.72 rad,

        // Unlatch by pressing the bar down: at the 30 mm grip radius, 16 mm of descent is
        // ~30 deg of lever, and the bolt clears the strike at ~6 mm. A pure position drive --
        // flat pads torsion-slip around a capsule bar, so rolling the wrist does not turn
        // the lever, pressing does (tried and measured: the roll variant froze at 5 deg).
        length unlatch-press      = 0.016 m,
        length unlatch-press-band = 0.005 m,
        // The gripped bar rotates with the lever, so the tool's normal must follow: at full
        // press the bar direction has turned 30 deg, and fighting that (fixed 90 deg target)
        // stalls the press against the pads' slip. Commanded consistently instead: 60 deg
        // during the press, back toward square as the lever springs up, both loosely banded.
        angle unlatch-roll-follow = 1.0472 rad,
        angle follow-band         = 0.6 rad,

        angle elbow-angle-target  = pi rad,
        torque elbow-torque-limit = 10.0 Nm,
        // The bar's release springs the arm back and can drop the elbow further than the
        // gentle in-task pin can lift against gravity; the post-release states get the
        // authority to restore the posture.
        torque rest-elbow-torque-limit = 25.0 Nm
    }
}

// S.0 -- stage in front of the lever, jaws pre-closed.
guarded-motion (ns=app) pre-approach {
    description: "Bring the grasp frame to a staging point straight in front of the lever"

    context { }

    when {}

    while {
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-pre-x: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hx> equal to <shared.spec.pre-dist> within <shared.spec.reach-band>,
        at-handle-y: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hy> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hz> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        preclose-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-preclose> within <shared.spec.gripper-band>,

        at-pre: keeping distance between <shared.world.pose-grasp> and <shared.world.pose-handle> equal to <shared.spec.pre-dist> within <shared.spec.pre-band>
    }

    until {}
}

// S.1 -- slide onto the bar.
guarded-motion (ns=app) approach-handle {
    description: "Slide the grasp frame level onto the lever bar"

    context { }

    when {}

    while {
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-handle-x: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hx> equal to <shared.spec.grasp-standoff> within <shared.spec.reach-band>,
        at-handle-y: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hy> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hz> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        preclose-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-preclose> within <shared.spec.gripper-band>,

        reached: keeping distance between <shared.world.pose-grasp> and <shared.world.pose-handle> equal to <shared.spec.at-handle> within <shared.spec.grasp-reach>
    }

    // The grasp may only start centered, or the closing pads push the bar out.
    until all {
        centered-x: projection of <shared.world.pose-grasp> on <shared.spec.handle-hx> equal to <shared.spec.grasp-standoff> within <shared.spec.center-band>,
        centered-y: projection of <shared.world.pose-grasp> on <shared.spec.handle-hy> equal to <shared.spec.at-handle> within <shared.spec.center-band>,
        centered-z: projection of <shared.world.pose-grasp> on <shared.spec.handle-hz> equal to <shared.spec.at-handle> within <shared.spec.center-band>
    }
}

// S.2 -- close on the bar.
guarded-motion (ns=app) grasp-handle {
    description: "Hold the grasp frame on the lever while the fingers close on the bar"

    context { }

    when {}

    while {
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-handle-x: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hx> equal to <shared.spec.grasp-standoff> within <shared.spec.reach-band>,
        at-handle-y: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hy> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hz> equal to <shared.spec.at-handle> within <shared.spec.reach-band>,
        close-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.gripper-band>
    }

    // The driver settles inside the band only with the bar between the fingers.
    until {
        grasped-on-bar: <shared.world.gripper-pos> between <shared.spec.grip-on-bar-lo> and <shared.spec.grip-on-bar-hi>
    }
}

// S.3 -- press the grasped bar down until the bolt clears the strike. Same six rows as the
// approach with one changed target: the vertical projection is driven to the pressed depth,
// and the grip point's small arc toward the pivot rides in the along-bar band.
guarded-motion (ns=app) unlatch {
    description: "Press the grasped lever down until the latch bolt clears the strike"

    context { }

    when {}

    while {
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.unlatch-roll-follow> within <shared.spec.follow-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-handle-x: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hx> equal to <shared.spec.grasp-standoff> within <shared.spec.grasp-reach>,
        press-down: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hy> equal to <shared.spec.unlatch-press> within <shared.spec.unlatch-press-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hz> equal to <shared.spec.at-handle> within <shared.spec.grasp-reach>,
        close-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.gripper-band>
    }

    until {}
}

// S.4 -- crack the door: draw the grip out along the swing direction, lever held down.
guarded-motion (ns=app) swing-open {
    description: "Crack the door open along its swing, lever held rotated"

    context { }

    when {}

    while {
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.follow-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        swing-pull: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hx> equal to <shared.spec.crack-out> within <shared.spec.crack-band>,
        press-down: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hy> equal to <shared.spec.unlatch-press> within <shared.spec.swing-lateral-band>,
        at-handle-z: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hz> equal to <shared.spec.at-handle> within <shared.spec.swing-lateral-band>,
        close-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.gripper-band>
    }

    until {}
}

// S.5 -- swing to full open: the grip rides its hinge circle to 70 deg, the tool yaws with
// the door, and the lever is released to spring back up on the way (the follow-band release).
guarded-motion (ns=app) swing-full {
    description: "Swing the door to full open, tool yawing with it, lever released"

    context { }

    when {}

    while {
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.follow-band>,
        follow-yaw: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to <shared.spec.swing2-yaw> within <shared.spec.follow-band>,
        swing2-pull: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hx> equal to <shared.spec.swing2-out> within <shared.spec.swing2-band>,
        swing2-track: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hz> equal to <shared.spec.swing2-lat> within <shared.spec.swing2-band>,
        // The lever's press is released: the vertical projection is asked back to the bar
        // height, wide-banded, so the spring brings the lever up without a fight.
        release-lever: keeping projection of <shared.world.pose-grasp> on <shared.spec.handle-hy> equal to <shared.spec.at-handle> within <shared.spec.swing-lateral-band>,
        close-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.gripper-band>,
        // Watched, not driven: satisfied only when the driver has run past the bar band --
        // i.e. the pads closed on air because the bar slipped out.
        bar-lost: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.gripper-band>
    }

    // The lateral gate alone can be crossed by an arm that has LOST the bar; the door only
    // counts as open while the driver still holds it.
    until all {
        full-open: projection of <shared.world.pose-grasp> on <shared.spec.handle-hz> greater than <shared.spec.open-gate-lat>,
        still-on-bar: <shared.world.gripper-pos> between <shared.spec.grip-on-bar-lo> and <shared.spec.grip-on-bar-hi>
    }
}

// R.1 -- the bar slipped out mid-swing: reopen and re-approach the grip where the door IS,
// with the approach vocabulary re-aimed at the live door frame.
// R.0 -- the slip launches the arm on the swing's stored spring energy; catch it where it
// is before aiming anywhere (going straight to the re-approach diverged, measured).
guarded-motion (ns=app) steady {
    description: "Arrest the arm where the slip left it before re-approaching"

    context {
        spec {
            length steady-band = 0.05 m,
            pose steady-pose = snapshot of <shared.world.pose-grasp> on event <dor.E_STEADY_ENTERED>
        }
    }

    when {}

    while {
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        hold-position: keeping <shared.world.pose-grasp>.position equal to <spec.steady-pose>.position within <spec.steady-band>,
        hold-orientation: keeping <shared.world.pose-grasp>.orientation equal to <spec.steady-pose>.orientation within <shared.spec.follow-band>,
        preclose-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-preclose> within <shared.spec.gripper-band>
    }

    until {
        steadied: <shared.world.pose-grasp>.position equal to <spec.steady-pose>.position within <spec.steady-band>
    }
}

guarded-motion (ns=app) regrasp {
    description: "Re-approach the bar where the pads last held it"

    context {
        spec {
            // The pads were ON the bar until it escaped: the pinch position at the moment
            // the loss was detected is the best observable estimate of where the bar is
            // (the damped hinge holds the door there, and the live door frame cannot be
            // driven against).
            length bar-x = snapshot of <shared.world.pose-grasp>.position.x on event <dor.E_STEADY_ENTERED>,
            length bar-y = snapshot of <shared.world.pose-grasp>.position.y on event <dor.E_STEADY_ENTERED>,
            length bar-z = snapshot of <shared.world.pose-grasp>.position.z on event <dor.E_STEADY_ENTERED>
        }
    }

    when {}

    while {
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.follow-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-grip-x: keeping <shared.world.pose-grasp>.position.x equal to <spec.bar-x> within <shared.spec.reach-band>,
        at-grip-y: keeping <shared.world.pose-grasp>.position.y equal to <spec.bar-y> within <shared.spec.reach-band>,
        at-grip-z: keeping <shared.world.pose-grasp>.position.z equal to <spec.bar-z> within <shared.spec.reach-band>,
        preclose-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-preclose> within <shared.spec.gripper-band>
    }

    until all {
        recentered-x: <shared.world.pose-grasp>.position.x equal to <spec.bar-x> within <shared.spec.crack-band>,
        recentered-y: <shared.world.pose-grasp>.position.y equal to <spec.bar-y> within <shared.spec.crack-band>,
        recentered-z: <shared.world.pose-grasp>.position.z equal to <spec.bar-z> within <shared.spec.crack-band>
    }
}

// R.2 -- close on the bar again, holding the live-grip projections.
guarded-motion (ns=app) regrip {
    description: "Hold on the live grip while the fingers close on the bar again"

    context { }

    when {}

    while {
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        normal-to-handle: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.follow-band>,
        align-approach: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to 0 rad,
        at-grip-x: keeping <shared.world.pose-grasp>.position.x equal to <regrasp.spec.bar-x> within <shared.spec.reach-band>,
        at-grip-y: keeping <shared.world.pose-grasp>.position.y equal to <regrasp.spec.bar-y> within <shared.spec.reach-band>,
        at-grip-z: keeping <shared.world.pose-grasp>.position.z equal to <regrasp.spec.bar-z> within <shared.spec.reach-band>,
        close-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.gripper-band>,
        // Watched: satisfied only when the driver has run past every bar width -- the
        // close caught air and the approach must be retried.
        closed-on-air: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed> within <shared.spec.gripper-band>
    }

    until {
        regrasped-on-bar: <shared.world.gripper-pos> between <shared.spec.grip-on-bar-lo> and <shared.spec.grip-on-bar-hi>
    }
}

// S.6 -- let go of the bar: hold still where the swing ended while the pads open.
guarded-motion (ns=app) release-door {
    description: "Hold the pose at full open while the gripper releases the bar"

    context {
        spec {
            pose hold-pose = snapshot of <shared.world.pose-grasp> on event <dor.E_RELEASE_ENTERED>
        }
    }

    when {}

    while {
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        hold-position: keeping <shared.world.pose-grasp>.position equal to <spec.hold-pose>.position within <shared.spec.reach-band>,
        hold-orientation: keeping <shared.world.pose-grasp>.orientation equal to <spec.hold-pose>.orientation within <shared.spec.align-band>,
        open-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-open> within <shared.spec.gripper-band>
    }

    until {
        released: <shared.world.gripper-pos> equal to <shared.spec.gripper-open> within <shared.spec.gripper-band>
    }
}

// S.7 -- pull straight back out of the door arc to a stable rest, orientation held.
guarded-motion (ns=app) retreat-clear {
    description: "Retreat the tool clear of the open door to a stable rest posture"

    context {
        spec {
            length rest-y = snapshot of <shared.world.pose-grasp>.position.y on event <dor.E_RETREAT_ENTERED>,
            length rest-z = snapshot of <shared.world.pose-grasp>.position.z on event <dor.E_RETREAT_ENTERED>
        }
    }

    when {}

    while {
        hold-elbow: keeping <shared.world.elbow-angle> equal to <shared.spec.elbow-angle-target>,
        retreat-x: keeping <shared.world.pose-grasp>.position.x equal to <shared.spec.door-retreat-x> within <shared.spec.reach-band>,
        hold-y: keeping <shared.world.pose-grasp>.position.y equal to <spec.rest-y> within <shared.spec.reach-band>,
        hold-z: keeping <shared.world.pose-grasp>.position.z equal to <spec.rest-z> within <shared.spec.reach-band>,
        rest-normal: keeping angle between <shared.spec.grasp-normal> and <shared.spec.handle-z-base> equal to <shared.spec.aligned> within <shared.spec.align-band>,
        rest-yaw: keeping angle between <shared.spec.approach-axis> and <shared.spec.drawer-inward> equal to <shared.spec.swing2-yaw> within <shared.spec.follow-band>,
        open-gripper: keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-open> within <shared.spec.gripper-band>
    }

    // Crossing the clear line mid-flight is not a rest: the gate names arrival at the rest
    // point, held, so S_DONE freezes a settled posture.
    until all {
        arrived-x: <shared.world.pose-grasp>.position.x equal to <shared.spec.door-retreat-x> within <shared.spec.rest-band>,
        settled-y: <shared.world.pose-grasp>.position.y equal to <spec.rest-y> within <shared.spec.rest-band>,
        settled-z: <shared.world.pose-grasp>.position.z equal to <spec.rest-z> within <shared.spec.rest-band>
    }
}

// ------------------ constraint handlers ------------------

constraint-handler (ns=app) handler-approach {
    handles: <approach-handle>
    runs-in: <dor.S_APPROACH>
    monitors {
        mon-reached: monitor <approach-handle.until> {
            satisfied for 0.3 s {
                trigger: event <dor.E_AT_HANDLE>
            },
        }
    }
    controllers {
        pid ctrl-a-elbow {
            constraint: <approach-handle.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        pid ctrl-normal-to-handle { constraint: <approach-handle.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-a-align { constraint: <approach-handle.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-at-handle-x { constraint: <approach-handle.at-handle-x>, Kp: 80, Ki: 0, Kd: 24, decay: 0 },
        pid ctrl-at-handle-y { constraint: <approach-handle.at-handle-y>, integral-saturation: saturation { max: <shared.spec.pos-integral-limit> }, Kp: 80, Ki: 80, Kd: 24, decay: 0 },
        pid ctrl-at-handle-z { constraint: <approach-handle.at-handle-z>, Kp: 80, Ki: 0, Kd: 24, decay: 0 },
        feed-forward ctrl-a-preclose { constraint: <approach-handle.preclose-gripper> }
    }
    solvers {
        arm-solver: serial-chain {
            agent:     <door_agents.arm1>,
            algorithm: achd,
            gravity:   (0.0, 0.0, 9.81) m/s^2
        },
        gripper-command-solver: command-forwarding {
            agent: <door_agents.gripper1>
        }
    }
}

constraint-handler (ns=app) handler-pre {
    handles: <pre-approach>
    runs-in: <dor.S_PREGRASP>
    monitors {
        mon-at-pre: monitor <pre-approach.at-pre> {
            satisfied for 0.5 s {
                trigger: event <dor.E_AT_PRE>
            },
        }
    }
    controllers {
        pid ctrl-pre-elbow {
            constraint: <pre-approach.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        pid ctrl-pre-normal { constraint: <pre-approach.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-pre-align { constraint: <pre-approach.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-pre-x { constraint: <pre-approach.at-pre-x>, Kp: 80, Ki: 10, Kd: 24, decay: 0 },
        pid ctrl-pre-y { constraint: <pre-approach.at-handle-y>, Kp: 80, Ki: 10, Kd: 24, decay: 0 },
        pid ctrl-pre-z { constraint: <pre-approach.at-handle-z>, Kp: 80, Ki: 10, Kd: 24, decay: 0 },
        feed-forward ctrl-pre-preclose { constraint: <pre-approach.preclose-gripper> }
    }
    solvers {
        <handler-approach.arm-solver>,
        <handler-approach.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-grasp {
    handles: <grasp-handle>
    runs-in: <dor.S_GRASP>
    monitors {
        mon-grasped: monitor <grasp-handle.until> {
            satisfied for 0.5 s {
                trigger: event <dor.E_GRASPED>
            },
        }
    }
    controllers {
        pid ctrl-g-elbow {
            constraint: <grasp-handle.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        pid ctrl-g-normal { constraint: <grasp-handle.normal-to-handle>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-g-align { constraint: <grasp-handle.align-approach>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-g-x { constraint: <grasp-handle.at-handle-x>, Kp: 80, Ki: 10, Kd: 24, decay: 0 },
        pid ctrl-g-y { constraint: <grasp-handle.at-handle-y>, Kp: 80, Ki: 10, Kd: 24, decay: 0 },
        pid ctrl-g-z { constraint: <grasp-handle.at-handle-z>, Kp: 80, Ki: 10, Kd: 24, decay: 0 },
        feed-forward ctrl-g-close { constraint: <grasp-handle.close-gripper> }
    }
    solvers {
        <handler-approach.arm-solver>,
        <handler-approach.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-unlatch {
    handles: <unlatch>
    runs-in: <dor.S_UNLATCH>
    monitors {
        mon-unlatched: monitor <unlatch.press-down> {
            satisfied for 0.3 s {
                trigger: event <dor.E_UNLATCHED>
            },
        }
    }
    controllers {
        pid ctrl-u-elbow {
            constraint: <unlatch.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        pid ctrl-u-normal { constraint: <unlatch.normal-to-handle>, output-saturation: saturation { max: <shared.spec.contact-ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.contact-ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-u-align { constraint: <unlatch.align-approach>, output-saturation: saturation { max: <shared.spec.contact-ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.contact-ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-u-x { constraint: <unlatch.at-handle-x>, Kp: 40, Ki: 0, Kd: 15, decay: 0 },
        pid ctrl-u-press { constraint: <unlatch.press-down>, integral-saturation: saturation { max: <shared.spec.press-integral-limit> }, Kp: 120, Ki: 60, Kd: 30, decay: 0 },
        pid ctrl-u-z { constraint: <unlatch.at-handle-z>, Kp: 40, Ki: 0, Kd: 15, decay: 0 },
        feed-forward ctrl-u-close { constraint: <unlatch.close-gripper> }
    }
    solvers {
        <handler-approach.arm-solver>,
        <handler-approach.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-swing {
    handles: <swing-open>
    runs-in: <dor.S_SWING>
    monitors {
        mon-swung: monitor <swing-open.swing-pull> {
            satisfied for 0.5 s {
                trigger: event <dor.E_OPENED>
            },
        }
    }
    controllers {
        pid ctrl-s-elbow {
            constraint: <swing-open.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        pid ctrl-s-normal { constraint: <swing-open.normal-to-handle>, output-saturation: saturation { max: <shared.spec.contact-ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.contact-ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-s-align { constraint: <swing-open.align-approach>, output-saturation: saturation { max: <shared.spec.contact-ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.contact-ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        pid ctrl-s-pull { constraint: <swing-open.swing-pull>, Kp: 100, Ki: 15, Kd: 30, decay: 0 },
        pid ctrl-s-press { constraint: <swing-open.press-down>, integral-saturation: saturation { max: <shared.spec.press-integral-limit> }, Kp: 80, Ki: 40, Kd: 24, decay: 0 },
        pid ctrl-s-z { constraint: <swing-open.at-handle-z>, Kp: 40, Ki: 0, Kd: 15, decay: 0 },
        feed-forward ctrl-s-close { constraint: <swing-open.close-gripper> }
    }
    solvers {
        <handler-approach.arm-solver>,
        <handler-approach.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-swing-full {
    handles: <swing-full>
    runs-in: <dor.S_SWING_FULL>
    monitors {
        mon-full-open: monitor <swing-full.until> {
            satisfied for 0.5 s {
                trigger: event <dor.E_FULL_OPEN>
            },
        },
        mon-bar-lost: monitor <swing-full.bar-lost> {
            satisfied for 0.2 s {
                trigger: event <dor.E_GRASP_LOST>
            },
        }
    }
    controllers {
        pid ctrl-f-elbow {
            constraint: <swing-full.hold-elbow>, output-saturation: saturation { max: <shared.spec.elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        pid ctrl-f-normal { constraint: <swing-full.normal-to-handle>, output-saturation: saturation { max: <shared.spec.contact-ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.contact-ori-integral-limit> }, Kp: 150, Ki: 15, Kd: 45, decay: 0 },
        // The 70 deg yaw target is a step at entry: overdamped gains rate-shape it (~0.7
        // rad/s) so the pads turn with the door instead of twisting off the stationary bar.
        pid ctrl-f-yaw { constraint: <swing-full.follow-yaw>, integral-saturation: saturation { max: <shared.spec.contact-ori-integral-limit> }, Kp: 25, Ki: 5, Kd: 35, decay: 0 },
        pid ctrl-f-pull { constraint: <swing-full.swing2-pull>, Kp: 60, Ki: 15, Kd: 25, decay: 0 },
        pid ctrl-f-track { constraint: <swing-full.swing2-track>, Kp: 40, Ki: 10, Kd: 18, decay: 0 },
        pid ctrl-f-release { constraint: <swing-full.release-lever>, Kp: 20, Ki: 0, Kd: 12, decay: 0 },
        feed-forward ctrl-f-close { constraint: <swing-full.close-gripper> }
    }
    solvers {
        <handler-approach.arm-solver>,
        <handler-approach.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-steady {
    handles: <steady>
    runs-in: <dor.S_STEADY>
    monitors {
        mon-steadied: monitor <steady.until> {
            satisfied for 0.8 s {
                trigger: event <dor.E_STEADIED>
            },
        }
    }
    controllers {
        pid ctrl-st-elbow {
            constraint: <steady.hold-elbow>, output-saturation: saturation { max: <shared.spec.rest-elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        pid ctrl-st-position { constraint: <steady.hold-position>, Kp: 60, Ki: 0, Kd: 35, decay: 0 },
        pid ctrl-st-orientation { constraint: <steady.hold-orientation>, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 30, Ki: 0, Kd: 30, decay: 0 },
        feed-forward ctrl-st-preclose { constraint: <steady.preclose-gripper> }
    }
    solvers {
        <handler-approach.arm-solver>,
        <handler-approach.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-regrasp {
    handles: <regrasp>
    runs-in: <dor.S_REGRASP>
    monitors {
        mon-recentered: monitor <regrasp.until> {
            satisfied for 0.3 s {
                trigger: event <dor.E_REGRASP_CENTERED>
            },
        }
    }
    controllers {
        pid ctrl-rg-elbow {
            constraint: <regrasp.hold-elbow>, output-saturation: saturation { max: <shared.spec.rest-elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        pid ctrl-rg-normal { constraint: <regrasp.normal-to-handle>, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 40, Ki: 5, Kd: 35, decay: 0 },
        pid ctrl-rg-align { constraint: <regrasp.align-approach>, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 40, Ki: 5, Kd: 35, decay: 0 },
        pid ctrl-rg-x { constraint: <regrasp.at-grip-x>, Kp: 60, Ki: 10, Kd: 24, decay: 0 },
        pid ctrl-rg-y { constraint: <regrasp.at-grip-y>, Kp: 60, Ki: 10, Kd: 24, decay: 0 },
        pid ctrl-rg-z { constraint: <regrasp.at-grip-z>, Kp: 60, Ki: 10, Kd: 24, decay: 0 },
        feed-forward ctrl-rg-preclose { constraint: <regrasp.preclose-gripper> }
    }
    solvers {
        <handler-approach.arm-solver>,
        <handler-approach.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-regrip {
    handles: <regrip>
    runs-in: <dor.S_REGRIP>
    monitors {
        mon-regrasped: monitor <regrip.until> {
            satisfied for 0.5 s {
                trigger: event <dor.E_REGRASPED>
            },
        },
        mon-regrip-missed: monitor <regrip.closed-on-air> {
            satisfied for 0.5 s {
                trigger: event <dor.E_REGRIP_MISSED>
            },
        }
    }
    controllers {
        pid ctrl-rr-elbow {
            constraint: <regrip.hold-elbow>, output-saturation: saturation { max: <shared.spec.rest-elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        pid ctrl-rr-normal { constraint: <regrip.normal-to-handle>, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 40, Ki: 5, Kd: 35, decay: 0 },
        pid ctrl-rr-align { constraint: <regrip.align-approach>, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 40, Ki: 5, Kd: 35, decay: 0 },
        pid ctrl-rr-x { constraint: <regrip.at-grip-x>, Kp: 60, Ki: 10, Kd: 24, decay: 0 },
        pid ctrl-rr-y { constraint: <regrip.at-grip-y>, Kp: 60, Ki: 10, Kd: 24, decay: 0 },
        pid ctrl-rr-z { constraint: <regrip.at-grip-z>, Kp: 60, Ki: 10, Kd: 24, decay: 0 },
        feed-forward ctrl-rr-close { constraint: <regrip.close-gripper> }
    }
    solvers {
        <handler-approach.arm-solver>,
        <handler-approach.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-release {
    handles: <release-door>
    runs-in: <dor.S_RELEASE>
    monitors {
        mon-released: monitor <release-door.until> {
            satisfied for 0.3 s {
                trigger: event <dor.E_DOOR_RELEASED>
            },
        }
    }
    controllers {
        pid ctrl-r-elbow {
            constraint: <release-door.hold-elbow>, output-saturation: saturation { max: <shared.spec.rest-elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        pid ctrl-r-position { constraint: <release-door.hold-position>, Kp: 120, Ki: 20, Kd: 40, decay: 0 },
        pid ctrl-r-orientation { constraint: <release-door.hold-orientation>, output-saturation: saturation { max: <shared.spec.ori-acc-limit> }, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 120, Ki: 15, Kd: 45, decay: 0 },
        feed-forward ctrl-r-open { constraint: <release-door.open-gripper> }
    }
    solvers {
        <handler-approach.arm-solver>,
        <handler-approach.gripper-command-solver>
    }
}

constraint-handler (ns=app) handler-retreat {
    handles: <retreat-clear>
    runs-in: <dor.S_RETREAT>
    monitors {
        mon-clear: monitor <retreat-clear.until> {
            satisfied for 0.5 s {
                trigger: event <dor.E_RETREATED>
            },
        }
    }
    controllers {
        pid ctrl-t-elbow {
            constraint: <retreat-clear.hold-elbow>, output-saturation: saturation { max: <shared.spec.rest-elbow-torque-limit> },
            Kp: 70, Ki: 0, Kd: 15, decay: 0, error-normalization: (-pi, pi) rad
        } as torque,
        pid ctrl-t-x { constraint: <retreat-clear.retreat-x>, Kp: 60, Ki: 10, Kd: 30, decay: 0 },
        pid ctrl-t-y { constraint: <retreat-clear.hold-y>, Kp: 80, Ki: 10, Kd: 24, decay: 0 },
        pid ctrl-t-z { constraint: <retreat-clear.hold-z>, Kp: 80, Ki: 10, Kd: 24, decay: 0 },
        pid ctrl-t-normal { constraint: <retreat-clear.rest-normal>, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 25, Ki: 5, Kd: 35, decay: 0 },
        pid ctrl-t-yaw { constraint: <retreat-clear.rest-yaw>, integral-saturation: saturation { max: <shared.spec.ori-integral-limit> }, Kp: 25, Ki: 5, Kd: 35, decay: 0 },
        feed-forward ctrl-t-open { constraint: <retreat-clear.open-gripper> }
    }
    solvers {
        <handler-approach.arm-solver>,
        <handler-approach.gripper-command-solver>
    }
}
