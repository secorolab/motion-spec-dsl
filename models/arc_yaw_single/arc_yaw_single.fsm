ns ays = "https://secorolab.github.io/models/arc-yaw-single/fsm/"

evt loop (ns=ays) arc_yaw_single_fsm_events {
    evt E_STEP,
    evt E_HOME_SETTLED,
    evt E_ARC_DONE
}

fsm (ns=ays) arc_yaw_single_fsm {
    description: "Settle in the home pose, then sweep the tool along an arc to the pose the arm reaches with joint 1 turned 90 degrees."

    states {
        S_START,
        S_HOME,
        S_ARC,
        S_DONE
    }

    evt loop: <arc_yaw_single_fsm_events>

    start: <S_START>
    end:   <S_DONE>

    transitions {
        T_START_HOME { from: <S_START>, to: <S_HOME> },
        T_HOME_ARC   { from: <S_HOME>,  to: <S_ARC> },
        T_ARC_DONE   { from: <S_ARC>,   to: <S_DONE> }
    }

    reactions {
        R_STEP_START { when: <arc_yaw_single_fsm_events.E_STEP>, do: <T_START_HOME> },
        R_HOME_SETTLED { when: <arc_yaw_single_fsm_events.E_HOME_SETTLED>, do: <T_HOME_ARC> },
        R_ARC_DONE { when: <arc_yaw_single_fsm_events.E_ARC_DONE>, do: <T_ARC_DONE> }
    }
}
