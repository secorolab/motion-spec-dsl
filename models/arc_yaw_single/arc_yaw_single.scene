ns ays_env = "https://secorolab.github.io/models/environments/arc-yaw-single/"
ns ays_agn = "https://secorolab.github.io/models/agents/arc-yaw-single/"
ns ays_scene = "https://secorolab.github.io/models/scenes/arc-yaw-single/"

obj set (ns=ays_env) workspace_objects {
    object table
}

ws set (ns=ays_env) workspaces {
    workspace table_ws
}

agn set (ns=ays_agn) agents {
    agent kinova_ft_2f85
}

comp (ns=ays_env) table_workspace of ws <workspaces.table_ws> {
    obj <workspace_objects.table>
}

scene (ns=ays_scene) arc_yaw_scene {
    ws comp <table_workspace>
    agn set <agents>
}
