ns ed_agn = "https://secorolab.github.io/models/agents/eddie-push/"
ns ed_scene = "https://secorolab.github.io/models/scenes/eddie-push/"

agn set (ns=ed_agn) agents {
    agent eddie
}

// The platform drives over open floor, so the scene holds no workspace and no object.
scene (ns=ed_scene) eddie_push_scene {
    agn set <agents>
}
