import "eddie_push.scene"
import "../eddie_base.ktree"

ns ep_mjc = "https://secorolab.github.io/models/scenes/eddie-push-mjc/"

ktree inst (ns=ep_mjc) eddie of <eddie_base_tree>

scene inst (ns=ep_mjc) eddie_push_scene_mjc {
    scene: <eddie_push_scene>

    // The anchor is the platform's own ground frame: nothing holds the base, and the MJCF's free
    // joint is what lets it drive away from where the scene stands it.
    kgraph (ns=ep_mjc) eddie_push_graph {
        anchor: <eddie.base_footprint.base_footprint_origin>
        tree <eddie>
    }

    agn <agents.eddie> {
        model eddie-mjc as mjcf {
            sys path = 'src/eddie_description/mujoco/mobile_platform.xml'
            map tree <eddie> to "base"
        }
    }
}
