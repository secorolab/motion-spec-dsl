import "pick_place_single.fsm"
ns app = "https://secorolab.github.io/models/pick-place-single/"
ns pp = "https://secorolab.github.io/models/pick-place-single/fsm/"

ENVIRONMENT (ns=app) pick-place-single-env {
    runtime: MuJoCo,
    timestep: 1.0 ms,
    ASSETS {
        kinova-mjcf: RobotAsset {
            model: KinovaGen3,
            xml: "src/mj_kdl_wrapper/third_party/menagerie/kinova_gen3/gen3.xml"
        },
        gripper-mjcf: AttachmentAsset {
            xml: "src/mj_kdl_wrapper/assets/robotiq_2f85/2f85.xml"
        },
        table-mjcf: SceneObject {
            xml: "src/mj_kdl_wrapper/assets/table.xml"
        },
        cube-object: SceneObject
    },
    ASSEMBLY {
        Object table using <table-mjcf> {
            position: { z: 0.72 m },
            orientation: {}
        },
        Robot robot using <kinova-mjcf> {
            attach-to: <table>.site(table_top),
            position: {},
            orientation: {},
            chain: { root: base_link, end: g_pinch }
        },
        Attachment gripper using <gripper-mjcf> {
            attach-to: <robot>.site(pinch_site),
            prefix: g_,
            tcp-site: g_pinch,
            actuator: g_fingers_actuator
        },
        Object cube using <cube-object> {
            position: { x: 0.50 m, z: 0.76 m },
            orientation: {},
            free: true,
            shape: Box,
            size: { x: 0.02 m, y: 0.02 m, z: 0.02 m },
            color: { r: 0.1, g: 0.35, b: 1.0, a: 1.0 },
            mass: 0.01,
            friction: { slide: 0.8, torsion: 0.01, roll: 0.0001 }
        }
    },
    TRACE {
        enabled: true,
        length: 2048,
        color: { r: 1.0, g: 0.2, b: 0.8, a: 1.0 }
    }
}

CONTEXT (ns=app) shared {
    world: World {
        cube:             SceneObject,
        table:            SceneObject,
        half-arm-2-link:  Link,
        gravity:          Gravity,
        pose-ee-base:     Pose { of: g_pinch, wrt: base_link, as-seen-by: base_link },
        twist-ee-base:    VelocityTwist { of: g_pinch, wrt: base_link, as-seen-by: base_link },
        pose-cube-base:   Pose { of: cube, wrt: base_link, as-seen-by: base_link },
        pose-elbow-base:  Pose { of: half_arm_2_link, wrt: base_link, as-seen-by: base_link },
        gripper-pos:      JointPosition { of: g_fingers_actuator }
    },
    spec: Spec {
        zero-linvel:    LinearVelocity = 0.0 m/s,
        zero-dist:      LinearDistance = 0.0 m,
        grasp-roll:     Angle = 3.14159 rad,
        grasp-pitch:    Angle = 0.0 rad,
        grasp-yaw:      Angle = 1.5708 rad,
        gravity-vec:    FreeVector { x = 0.0, y = 0.0, z = -9.81 m/s2 },
        gripper-closed: Angle = 0.8 rad,
        gripper-open:   Angle = 0.0 rad,
        lost-dist:      LinearDistance = 0.12 m
    }
}

MOTION_SPEC (ns=app) home {
    MOVE: "Hold the TCP at the startup home pose"

    CONTEXT {
        spec: Spec {
            home-pose:  Pose = Snapshot of <shared.world.pose-ee-base>
        }
    }

    WHEN {}

    WHILE {
        hold-position:    keeping <shared.world.pose-ee-base>.position    equal to <spec.home-pose>.position,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.home-pose>.orientation
    }

    UNTIL {}
}

MOTION_SPEC (ns=app) pick-above {
    MOVE: "Move TCP to the pre-grasp position above the cube (trajectory)"

    CONTEXT {
        spec: Spec {
            above-z:       LinearDistance = 0.26 m,
            alpha:         TrajectoryProgress,
            start-pose:    Pose = Snapshot of <shared.world.pose-ee-base>,
            start-cube-x:  LinearDistance = Snapshot of <shared.world.pose-cube-base>.position.x,
            start-cube-y:  LinearDistance = Snapshot of <shared.world.pose-cube-base>.position.y,
            goal-pose:  Pose {
                position: {
                    x: <spec.start-cube-x>,
                    y: <spec.start-cube-y>,
                    z: <spec.above-z>
                },
                orientation: {
                    roll:  <shared.spec.grasp-roll>,
                    pitch: <shared.spec.grasp-pitch>,
                    yaw:   <shared.spec.grasp-yaw>
                }
            },
            traj: Trajectory = Lerp {
                start: <spec.start-pose>,
                goal:  <spec.goal-pose>,
                alpha: <spec.alpha>
            }
        }
    }

    WHEN {
        gripper-ready: <shared.world.gripper-pos> equal to <shared.spec.gripper-open>
    }

    WHILE {
        follow-pos: keeping <shared.world.pose-ee-base>.position    equal to <spec.traj>.position,
        follow-ori: keeping <shared.world.pose-ee-base>.orientation equal to <spec.traj>.orientation
    }

    UNTIL {}
}

MOTION_SPEC (ns=app) pick {
    MOVE: "Lower TCP straight down to the grasp height at the cube"

    CONTEXT {
        spec: Spec {
            grasp-x:         LinearDistance = Snapshot of <shared.world.pose-cube-base>.position.x,
            grasp-y:         LinearDistance = Snapshot of <shared.world.pose-cube-base>.position.y,
            grasp-z:         LinearDistance = 0.015 m,
            pre-grasp-reach: LinearDistance = 0.3 m,
            support-lift:    LinearDistance = 0.06 m,
            support-z:       LinearDistance = Snapshot of <shared.world.pose-elbow-base>.position.z + <spec.support-lift>,
            pick-ori-pose: Pose {
                position: { x: 0.0 m, y: 0.0 m, z: 0.0 m },
                orientation: {
                    roll:  <shared.spec.grasp-roll>,
                    pitch: <shared.spec.grasp-pitch>,
                    yaw:   <shared.spec.grasp-yaw>
                }
            }
        }
    }

    WHEN {
        aligned-above: distance between <shared.world.pose-ee-base> and <shared.world.pose-cube-base> less than <pick.spec.pre-grasp-reach>
    }

    WHILE {
        hold-x:     keeping <shared.world.pose-ee-base>.position.x  equal to <spec.grasp-x>,
        hold-y:     keeping <shared.world.pose-ee-base>.position.y  equal to <spec.grasp-y>,
        lower-z:    keeping <shared.world.pose-ee-base>.position.z  equal to <spec.grasp-z>,
        follow-ori: keeping <shared.world.pose-ee-base>.orientation equal to <spec.pick-ori-pose>.orientation,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z equal to <spec.support-z>
    }

    UNTIL {}
}

MOTION_SPEC (ns=app) grasp-hold {
    MOVE: "Hold TCP at the current base-frame pose while the gripper closes"

    CONTEXT {
        spec: Spec {
            hold-x:       LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.x,
            hold-y:       LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.y,
            hold-z:       LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.z,
            support-lift: LinearDistance = 0.06 m,
            support-z:    LinearDistance = Snapshot of <shared.world.pose-elbow-base>.position.z + <spec.support-lift>,
            hold-orientation-pose: Pose = Snapshot of <shared.world.pose-ee-base>,
            grasp-reach:  LinearDistance = 0.015 m
        }
    }

    WHEN {
        near-cube: distance between <shared.world.pose-ee-base> and <shared.world.pose-cube-base> less than <grasp-hold.spec.grasp-reach>
    }

    WHILE {
        hold-x:          keeping <shared.world.pose-ee-base>.position.x equal to <spec.hold-x>,
        hold-y:          keeping <shared.world.pose-ee-base>.position.y equal to <spec.hold-y>,
        hold-z:          keeping <shared.world.pose-ee-base>.position.z equal to <spec.hold-z>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.hold-orientation-pose>.orientation,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z equal to <spec.support-z>,
        close-gripper:   keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-closed>
    }

    UNTIL {}
}

MOTION_SPEC (ns=app) lift {
    MOVE: "Raise TCP straight up while holding the cube"

    CONTEXT {
        spec: Spec {
            lift-z:          LinearDistance = 0.32 m,
            grasp-threshold: Angle = 0.15 rad,
            lift-start-x:    LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.x,
            lift-start-y:    LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.y,
            support-lift:    LinearDistance = 0.06 m,
            support-z:       LinearDistance = Snapshot of <shared.world.pose-elbow-base>.position.z + <spec.support-lift>,
            lift-ori-pose: Pose {
                position: { x: 0.0 m, y: 0.0 m, z: 0.0 m },
                orientation: {
                    roll:  <shared.spec.grasp-roll>,
                    pitch: <shared.spec.grasp-pitch>,
                    yaw:   <shared.spec.grasp-yaw>
                }
            }
        }
    }

    WHEN {
        grasped: <shared.world.gripper-pos> greater than <lift.spec.grasp-threshold>
    }

    WHILE {
        hold-x:        keeping <shared.world.pose-ee-base>.position.x  equal to <spec.lift-start-x>,
        hold-y:        keeping <shared.world.pose-ee-base>.position.y  equal to <spec.lift-start-y>,
        lift-z:        keeping <shared.world.pose-ee-base>.position.z  equal to <spec.lift-z>,
        follow-ori:    keeping <shared.world.pose-ee-base>.orientation equal to <spec.lift-ori-pose>.orientation,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z equal to <spec.support-z>,
        close-gripper: keeping <shared.world.gripper-pos>              equal to <shared.spec.gripper-closed>
    }

    UNTIL {
        grasp-lost: distance between <shared.world.pose-ee-base> and <shared.world.pose-cube-base> greater than <shared.spec.lost-dist>
    }
}

MOTION_SPEC (ns=app) place-above {
    MOVE: "Move TCP laterally to the pre-place position above the place location"

    CONTEXT {
        spec: Spec {
            place-x:           LinearDistance = 0.40 m,
            place-y:           LinearDistance = 0.24 m,
            place-above-z:     LinearDistance = 0.22 m,
            lifted-z:          LinearDistance = 0.30 m,
            support-lift:      LinearDistance = 0.06 m,
            support-z:         LinearDistance = Snapshot of <shared.world.pose-elbow-base>.position.z + <spec.support-lift>,
            goal-pose-above: Pose {
                position: {
                    x: <spec.place-x>,
                    y: <spec.place-y>,
                    z: <spec.place-above-z>
                },
                orientation: {
                    roll:  <shared.spec.grasp-roll>,
                    pitch: <shared.spec.grasp-pitch>,
                    yaw:   <shared.spec.grasp-yaw>
                }
            }
        }
    }

    WHEN {
        lifted: <shared.world.pose-ee-base>.position.z greater than <place-above.spec.lifted-z>
    }

    WHILE {
        reach-x:       keeping <shared.world.pose-ee-base>.position.x         equal to <spec.place-x>,
        reach-y:       keeping <shared.world.pose-ee-base>.position.y         equal to <spec.place-y>,
        reach-z:       keeping <shared.world.pose-ee-base>.position.z         equal to <spec.place-above-z>,
        align-ori:     keeping <shared.world.pose-ee-base>.orientation        equal to <spec.goal-pose-above>.orientation,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z   equal to <spec.support-z>,
        close-gripper: keeping <shared.world.gripper-pos>                 equal to <shared.spec.gripper-closed>
    }

    UNTIL {
        grasp-lost: distance between <shared.world.pose-ee-base> and <shared.world.pose-cube-base> greater than <shared.spec.lost-dist>
    }
}

MOTION_SPEC (ns=app) place {
    MOVE: "Lower TCP with cube straight down to the place height"

    CONTEXT {
        spec: Spec {
            place-x:           LinearDistance = 0.40 m,
            place-y:           LinearDistance = 0.24 m,
            place-z:           LinearDistance = 0.03 m,
            place-y-gate:      LinearDistance = 0.20 m,
            support-lift:      LinearDistance = 0.06 m,
            support-z:         LinearDistance = Snapshot of <shared.world.pose-elbow-base>.position.z + <spec.support-lift>,
            goal-pose-place: Pose {
                position: {
                    x: <spec.place-x>,
                    y: <spec.place-y>,
                    z: <spec.place-z>
                },
                orientation: {
                    roll:  <shared.spec.grasp-roll>,
                    pitch: <shared.spec.grasp-pitch>,
                    yaw:   <shared.spec.grasp-yaw>
                }
            }
        }
    }

    WHEN {
        at-pre-place: <shared.world.pose-ee-base>.position.y greater than <place.spec.place-y-gate>
    }

    WHILE {
        reach-x:       keeping <shared.world.pose-ee-base>.position.x         equal to <spec.place-x>,
        reach-y:       keeping <shared.world.pose-ee-base>.position.y         equal to <spec.place-y>,
        reach-z:       keeping <shared.world.pose-ee-base>.position.z         equal to <spec.place-z>,
        align-ori:     keeping <shared.world.pose-ee-base>.orientation        equal to <spec.goal-pose-place>.orientation,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z   equal to <spec.support-z>,
        close-gripper: keeping <shared.world.gripper-pos>                 equal to <shared.spec.gripper-closed>
    }

    UNTIL {
        grasp-lost: distance between <shared.world.pose-ee-base> and <shared.world.pose-cube-base> greater than <shared.spec.lost-dist>
    }
}

MOTION_SPEC (ns=app) open-grasp-hold {
    MOVE: "Hold TCP at place pose while the gripper opens"

    CONTEXT {
        spec: Spec {
            hold-x:    LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.x,
            hold-y:    LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.y,
            hold-z:    LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.z,
            support-lift: LinearDistance = 0.06 m,
            support-z: LinearDistance = Snapshot of <shared.world.pose-elbow-base>.position.z + <spec.support-lift>,
            hold-orientation-pose: Pose = Snapshot of <shared.world.pose-ee-base>,
            place-z:   LinearDistance = 0.03 m
        }
    }

    WHEN {
        at-place: <shared.world.pose-ee-base>.position.z equal to <open-grasp-hold.spec.place-z>
    }

    WHILE {
        hold-x:          keeping <shared.world.pose-ee-base>.position.x equal to <spec.hold-x>,
        hold-y:          keeping <shared.world.pose-ee-base>.position.y equal to <spec.hold-y>,
        hold-z:          keeping <shared.world.pose-ee-base>.position.z equal to <spec.hold-z>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.hold-orientation-pose>.orientation,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z equal to <spec.support-z>,
        open-gripper:    keeping <shared.world.gripper-pos> equal to <shared.spec.gripper-open>
    }

    UNTIL {}
}

MOTION_SPEC (ns=app) retreat {
    MOVE: "Move TCP straight up to the pre-grasp height above the place location"

    CONTEXT {
        spec: Spec {
            place-x:           LinearDistance = 0.40 m,
            place-y:           LinearDistance = 0.24 m,
            place-above-z:     LinearDistance = 0.22 m,
            support-lift:      LinearDistance = 0.06 m,
            support-z:         LinearDistance = Snapshot of <shared.world.pose-elbow-base>.position.z + <spec.support-lift>,
            goal-pose-retreat: Pose {
                position: {
                    x: <spec.place-x>,
                    y: <spec.place-y>,
                    z: <spec.place-above-z>
                },
                orientation: {
                    roll:  <shared.spec.grasp-roll>,
                    pitch: <shared.spec.grasp-pitch>,
                    yaw:   <shared.spec.grasp-yaw>
                }
            }
        }
    }

    WHEN {
        released: <shared.world.gripper-pos> equal to <shared.spec.gripper-open>
    }

    WHILE {
        reach-x:       keeping <shared.world.pose-ee-base>.position.x         equal to <spec.place-x>,
        reach-y:       keeping <shared.world.pose-ee-base>.position.y         equal to <spec.place-y>,
        reach-z:       keeping <shared.world.pose-ee-base>.position.z         equal to <spec.place-above-z>,
        align-ori:     keeping <shared.world.pose-ee-base>.orientation        equal to <spec.goal-pose-retreat>.orientation,
        support-elbow-z: keeping <shared.world.pose-elbow-base>.position.z   equal to <spec.support-z>,
        open-gripper:  keeping <shared.world.gripper-pos>                 equal to <shared.spec.gripper-open>
    }

    UNTIL all {
        at-retreat-settled: <shared.world.pose-ee-base> equal to <spec.goal-pose-retreat>
    }
}

MOTION_SPEC (ns=app) recover {
    MOVE: "Fallback recovery: capture the current pose on entry and hold it"

    CONTEXT {
        spec: Spec {
            hold-x:       LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.x,
            hold-y:       LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.y,
            hold-z:       LinearDistance = Snapshot of <shared.world.pose-ee-base>.position.z,
            support-lift: LinearDistance = 0.06 m,
            support-z:    LinearDistance = Snapshot of <shared.world.pose-elbow-base>.position.z + <spec.support-lift>,
            hold-orientation-pose: Pose = Snapshot of <shared.world.pose-ee-base>
        }
    }

    WHEN {}

    WHILE {
        hold-x:           keeping <shared.world.pose-ee-base>.position.x equal to <spec.hold-x>,
        hold-y:           keeping <shared.world.pose-ee-base>.position.y equal to <spec.hold-y>,
        hold-z:           keeping <shared.world.pose-ee-base>.position.z equal to <spec.hold-z>,
        hold-orientation: keeping <shared.world.pose-ee-base>.orientation equal to <spec.hold-orientation-pose>.orientation,
        support-elbow-z:  keeping <shared.world.pose-elbow-base>.position.z equal to <spec.support-z>
    }

    UNTIL {}
}

// ------------------ constraint handlers ------------------

CONSTRAINT_HANDLER (ns=app) handler-home {
    MOTION: <home>
    CONTROL_MODE: JointTorque
    CONTROLLERS {
        ctrl-hold-position:    PID { constraint: <home.hold-position>,    Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-hold-orientation: PID { constraint: <home.hold-orientation>, Kp = 120, Ki = 50,  Kd = 80, decay = 0 }
    }

    SOLVERS {
        arm-solver: Solver {
            robot:     <pick-place-single-env.robot>,
            algorithm: ACHD,
            root:      <pick-place-single-env.robot.chain.root>,
            end:       <pick-place-single-env.robot.chain.end>,
            gravity:   <shared.world.gravity> equal to <shared.spec.gravity-vec>
        }
    }
}

CONSTRAINT_HANDLER (ns=app) handler-pick-above {
    MOTION: <pick-above>
    CONTROL_MODE: JointTorque
    MONITORS {
        mon-pick-above-ready: monitor <pick-above.gripper-ready> and trigger event pp.E_PICK_ABOVE_READY when active fallback <home>
    }

    CONTROLLERS {
        ctrl-pa-follow-pos: PID { constraint: <pick-above.follow-pos>, Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-pa-follow-ori: PID { constraint: <pick-above.follow-ori>, Kp = 120, Ki = 50,  Kd = 80, decay = 0 }
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-pick {
    MOTION: <pick>
    CONTROL_MODE: JointTorque
    MONITORS {
        mon-pick-ready: monitor <pick.aligned-above> and trigger event pp.E_PICK_READY when active fallback <pick-above>
    }

    CONTROLLERS {
        ctrl-pk-hold-x:     PID { constraint: <pick.hold-x>,     Kp = 200, Ki = 20, Kd = 40, decay = 0 },
        ctrl-pk-hold-y:     PID { constraint: <pick.hold-y>,     Kp = 200, Ki = 30, Kd = 40, decay = 0 },
        ctrl-pk-lower-z:    PID { constraint: <pick.lower-z>,    Kp = 12, Ki = 5,  Kd = 15, decay = 0 },
        ctrl-pk-follow-ori: PID { constraint: <pick.follow-ori>, Kp = 120, Ki = 50, Kd = 80, decay = 0 },
        ctrl-pk-support-z:  Impedance { constraint: <pick.support-elbow-z>, Stiffness = 800, Damping = 80 }
            apply at <shared.world.half-arm-2-link>
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}

CONSTRAINT_HANDLER (ns=app) handler-close-grip {
    MOTION: <grasp-hold>
    CONTROL_MODE: JointTorque
    MONITORS {
        mon-grasp-ready: monitor <grasp-hold.near-cube> and trigger event pp.E_GRASP_READY when active fallback <pick>
    }

    CONTROLLERS {
        ctrl-cg-hold-x:      PID { constraint: <grasp-hold.hold-x>,      Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-cg-hold-y:      PID { constraint: <grasp-hold.hold-y>,      Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-cg-hold-z:      PID { constraint: <grasp-hold.hold-z>,      Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-cg-hold-orientation: PID { constraint: <grasp-hold.hold-orientation>, Kp = 120, Ki = 50, Kd = 80, decay = 0 },
        ctrl-cg-support-z:   Impedance { constraint: <grasp-hold.support-elbow-z>, Stiffness = 800, Damping = 80 }
            apply at <shared.world.half-arm-2-link>,
        ctrl-cg-close-gripper: FeedForward { constraint: <grasp-hold.close-gripper> }
    }

    SOLVERS {
        <handler-home.arm-solver>,
        gripper-command-solver: Solver {
            robot: <pick-place-single-env.robot>,
            algorithm: CommandForwarding
        }
    }
}

CONSTRAINT_HANDLER (ns=app) handler-lift {
    MOTION: <lift>
    CONTROL_MODE: JointTorque
    MONITORS {
        mon-lift-ready: monitor <lift.grasped> and trigger event pp.E_LIFT_READY when active fallback <grasp-hold>,
        mon-lift-grasp-lost: monitor <lift.until> and trigger event pp.E_GRASP_LOST_LIFT when active
    }

    CONTROLLERS {
        ctrl-lt-hold-x:        PID { constraint: <lift.hold-x>,     Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-lt-hold-y:        PID { constraint: <lift.hold-y>,     Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-lt-lift-z:        PID { constraint: <lift.lift-z>,     Kp = 15, Ki = 5,  Kd = 20, decay = 0 },
        ctrl-lt-follow-ori:    PID { constraint: <lift.follow-ori>, Kp = 120, Ki = 50, Kd = 80, decay = 0 },
        ctrl-lt-support-z:     Impedance { constraint: <lift.support-elbow-z>, Stiffness = 800, Damping = 80 }
            apply at <shared.world.half-arm-2-link>,
        ctrl-lt-close-gripper: FeedForward { constraint: <lift.close-gripper> }
    }

    SOLVERS {
        <handler-home.arm-solver>,
        gripper-command-solver: Solver {
            robot: <pick-place-single-env.robot>,
            algorithm: CommandForwarding
        }
    }
}

CONSTRAINT_HANDLER (ns=app) handler-place-above {
    MOTION: <place-above>
    CONTROL_MODE: JointTorque
    MONITORS {
        mon-place-above-ready: monitor <place-above.lifted> and trigger event pp.E_PLACE_ABOVE_READY when active fallback <lift>,
        mon-place-above-grasp-lost: monitor <place-above.until> and trigger event pp.E_GRASP_LOST_PLACE_ABOVE when active
    }

    CONTROLLERS {
        ctrl-pla-reach-x:        PID { constraint: <place-above.reach-x>,     Kp = 180, Ki = 40, Kd = 60, decay = 0 },
        ctrl-pla-reach-y:        PID { constraint: <place-above.reach-y>,     Kp = 180, Ki = 40, Kd = 60, decay = 0 },
        ctrl-pla-reach-z:        PID { constraint: <place-above.reach-z>,     Kp = 180, Ki = 40, Kd = 60, decay = 0 },
        ctrl-pla-align-ori:      PID { constraint: <place-above.align-ori>,   Kp = 120, Ki = 50, Kd = 80, decay = 0 },
        ctrl-pla-support-z:      Impedance { constraint: <place-above.support-elbow-z>, Stiffness = 800, Damping = 80 }
            apply at <shared.world.half-arm-2-link>,
        ctrl-pla-close-gripper:  FeedForward { constraint: <place-above.close-gripper> }
    }

    SOLVERS {
        <handler-home.arm-solver>,
        gripper-command-solver: Solver {
            robot: <pick-place-single-env.robot>,
            algorithm: CommandForwarding
        }
    }
}

CONSTRAINT_HANDLER (ns=app) handler-place {
    MOTION: <place>
    CONTROL_MODE: JointTorque
    MONITORS {
        mon-place-ready: monitor <place.at-pre-place> and trigger event pp.E_PLACE_READY when active fallback <place-above>,
        mon-place-grasp-lost: monitor <place.until> and trigger event pp.E_GRASP_LOST_PLACE when active
    }

    CONTROLLERS {
        ctrl-pl-reach-x:       PID { constraint: <place.reach-x>,     Kp = 140, Ki = 20, Kd = 55, decay = 0 },
        ctrl-pl-reach-y:       PID { constraint: <place.reach-y>,     Kp = 140, Ki = 20, Kd = 55, decay = 0 },
        ctrl-pl-reach-z:       PID { constraint: <place.reach-z>,     Kp = 15,  Ki = 5,  Kd = 40, decay = 0 },
        ctrl-pl-align-ori:     PID { constraint: <place.align-ori>,   Kp = 180, Ki = 30, Kd = 120, decay = 0 },
        ctrl-pl-support-z:     Impedance { constraint: <place.support-elbow-z>, Stiffness = 800, Damping = 160 }
            apply at <shared.world.half-arm-2-link>,
        ctrl-pl-close-gripper: FeedForward { constraint: <place.close-gripper> }
    }

    SOLVERS {
        <handler-home.arm-solver>,
        gripper-command-solver: Solver {
            robot: <pick-place-single-env.robot>,
            algorithm: CommandForwarding
        }
    }
}

CONSTRAINT_HANDLER (ns=app) handler-open-grip {
    MOTION: <open-grasp-hold>
    CONTROL_MODE: JointTorque
    MONITORS {
        mon-open-ready: monitor <open-grasp-hold.at-place> and trigger event pp.E_OPEN_READY when active fallback <place>
    }

    CONTROLLERS {
        ctrl-og-hold-x:      PID { constraint: <open-grasp-hold.hold-x>,      Kp = 140, Ki = 20, Kd = 55, decay = 0 },
        ctrl-og-hold-y:      PID { constraint: <open-grasp-hold.hold-y>,      Kp = 140, Ki = 20, Kd = 55, decay = 0 },
        ctrl-og-hold-z:      PID { constraint: <open-grasp-hold.hold-z>,      Kp = 140, Ki = 20, Kd = 55, decay = 0 },
        ctrl-og-hold-orientation: PID { constraint: <open-grasp-hold.hold-orientation>, Kp = 180, Ki = 30, Kd = 120, decay = 0 },
        ctrl-og-support-z:   Impedance { constraint: <open-grasp-hold.support-elbow-z>, Stiffness = 800, Damping = 160 }
            apply at <shared.world.half-arm-2-link>,
        ctrl-og-open-gripper: FeedForward { constraint: <open-grasp-hold.open-gripper> }
    }

    SOLVERS {
        <handler-home.arm-solver>,
        gripper-command-solver: Solver {
            robot: <pick-place-single-env.robot>,
            algorithm: CommandForwarding
        }
    }
}

CONSTRAINT_HANDLER (ns=app) handler-retreat {
    MOTION: <retreat>
    CONTROL_MODE: JointTorque
    MONITORS {
        mon-retreat-ready:   monitor <retreat.released> and trigger event pp.E_RETREAT_READY when active fallback <open-grasp-hold>,
        mon-retreat-settled: monitor <retreat.until>    and trigger event pp.E_RETREAT_SETTLED when active
    }

    CONTROLLERS {
        ctrl-ret-reach-x:       PID { constraint: <retreat.reach-x>,     Kp = 140, Ki = 20, Kd = 55, decay = 0 },
        ctrl-ret-reach-y:       PID { constraint: <retreat.reach-y>,     Kp = 140, Ki = 20, Kd = 55, decay = 0 },
        ctrl-ret-reach-z:       PID { constraint: <retreat.reach-z>,     Kp = 15,  Ki = 5,  Kd = 20, decay = 0 },
        ctrl-ret-align-ori:     PID { constraint: <retreat.align-ori>,   Kp = 180, Ki = 30, Kd = 120, decay = 0 },
        ctrl-ret-support-z:     Impedance { constraint: <retreat.support-elbow-z>, Stiffness = 800, Damping = 160 }
            apply at <shared.world.half-arm-2-link>,
        ctrl-ret-open-gripper:  FeedForward { constraint: <retreat.open-gripper> }
    }

    SOLVERS {
        <handler-home.arm-solver>,
        gripper-command-solver: Solver {
            robot: <pick-place-single-env.robot>,
            algorithm: CommandForwarding
        }
    }
}

CONSTRAINT_HANDLER (ns=app) handler-recover {
    MOTION: <recover>
    CONTROL_MODE: JointTorque
    MONITORS {
        mon-recover-hold: monitor <recover.hold-x> and trigger event pp.E_RECOVER when active
    }

    CONTROLLERS {
        ctrl-rc-hold-x:           PID { constraint: <recover.hold-x>,           Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-rc-hold-y:           PID { constraint: <recover.hold-y>,           Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-rc-hold-z:           PID { constraint: <recover.hold-z>,           Kp = 200, Ki = 100, Kd = 40, decay = 0 },
        ctrl-rc-hold-orientation: PID { constraint: <recover.hold-orientation>, Kp = 120, Ki = 50,  Kd = 80, decay = 0 },
        ctrl-rc-support-z:        Impedance { constraint: <recover.support-elbow-z>, Stiffness = 800, Damping = 160 }
            apply at <shared.world.half-arm-2-link>
    }

    SOLVERS {
        <handler-home.arm-solver>
    }
}
